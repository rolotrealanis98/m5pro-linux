# /etc/sudoers.d/m5pro  (on the M5, macOS): let the m5pro-linux host scripts run without a password
# over ssh. Install once, from the M5:
#   sudo install -m 0440 -o root -g wheel ~/Work/m5pro-linux/host/macos/sudoers-m5pro /etc/sudoers.d/m5pro
#   sudo visudo -cf /etc/sudoers.d/m5pro
# Scope: only these scripts. finish-install.sh/prep-stub.sh still run under them.
rolo ALL=(root) NOPASSWD: /Users/rolo/Work/m5pro-linux/host/macos/stage1-install.sh, /Users/rolo/Work/m5pro-linux/host/macos/refresh-stub-firmware.sh, /sbin/shutdown -h now, /usr/sbin/diskutil, /usr/bin/bless --info *
