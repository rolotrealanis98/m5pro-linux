diff --git a/patches/linux/0019-usb-typec-tipd-sn201202x-polled-no-spmi-irqs.patch b/patches/linux/0019-usb-typec-tipd-sn201202x-polled-no-spmi-irqs.patch
new file mode 100644
index 0000000..d410bc9
--- /dev/null
+++ b/patches/linux/0019-usb-typec-tipd-sn201202x-polled-no-spmi-irqs.patch
@@ -0,0 +1,258 @@
