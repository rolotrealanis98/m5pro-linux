diff --git a/dt/t6050-usb-host.dtsi b/dt/t6050-usb-host.dtsi
new file mode 100644
index 0000000..3e017e0
--- /dev/null
+++ b/dt/t6050-usb-host.dtsi
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * T6050 (M5 Pro/Max) USB-C ports: USB 2.0 host on one port, gadget on the
+ * others. Include AFTER t6050.dtsi (which pulls in t6050-storage-net.dtsi,
+ * where the three dwc3 nodes are defined in peripheral mode).
+ *
+ * Port map (ADT usb-drdN "port-number", omarchy-m5 usb-gadget-net.sh):
+ *   dwc3_0 = usb-drd0 @ 0x2a2280000, port 1, hpm0, left-back
+ *   dwc3_1 = usb-drd1 @ 0x2aa280000, port 2, hpm1, left-front
+ *   dwc3_2 = usb-drd2 @ 0x382280000, port 3, hpm2, right
+ *
+ * Role selection
+ * --------------
+ * T6050_USB_HOST_PORT (default 1 = left-front, the port the Studio tether
+ * does not use) is put in dual-role mode with a USB role switch that starts
+ * in host mode. The other two keep the plain peripheral-mode nodes from
+ * t6050-storage-net.dtsi untouched, so the CDC-EEM tether keeps working.
+ * At runtime the host port's role can be flipped from userspace:
+ *   echo device > /sys/class/usb_role/2aa280000.usb-role-switch/role
+ *   echo host   > /sys/class/usb_role/2aa280000.usb-role-switch/role
+ * Nothing switches roles automatically yet: that needs the SN201202x USB-PD
+ * driver (t6050-usb-pd.dtsi, generated from the ADT), which can then drive
+ * the same role switch through the connector graph.
+ *
+ * USB2 PHY
+ * --------
+ * Only the USB2 half of the Type-C PHY is driven (phy-apple-usb2, new); the
+ * PIPE mux stays on the dummy PHY m1n1 selected, so USB3/USB4/DP are off.
+ * The usb2phy addresses are NOT from the ADT yet: they follow the layout
+ * every earlier Apple SoC uses (usb2phy = dwc3 base + 0x810000; t8103,
+ * t6031, t8132 all match), and must be checked against ADT atc-phyN reg[0]
+ * (scripts gen-usb-dt.py --check).
+ *
+ * VBUS is not ours: the SN201202x PD controller sources it (or not) on its
+ * own. See REPORT.md.
+ */
+
+#ifndef T6050_USB_HOST_PORT
+#define T6050_USB_HOST_PORT 1
+#endif
+
+#define __T6050_USB_CAT(a, b) a##b
+#define T6050_USB_CAT(a, b) __T6050_USB_CAT(a, b)
+#define T6050_USB_HOST_DWC3 T6050_USB_CAT(dwc3_, T6050_USB_HOST_PORT)
+#define T6050_USB_HOST_PHY T6050_USB_CAT(usb2phy_, T6050_USB_HOST_PORT)
+
+&soc {
+	/* [INFERENCE] ADT atc-phy0 reg[0]; dwc3_0 + 0x810000 */
+	usb2phy_0: phy@2a2a90000 {
+		compatible = "apple,t6050-usb2phy";
+		reg = <0x2 0xa2a90000 0x0 0x4000>;
+		#phy-cells = <0>;
+	};
+
+	/* [INFERENCE] ADT atc-phy1 reg[0]; dwc3_1 + 0x810000 */
+	usb2phy_1: phy@2aaa90000 {
+		compatible = "apple,t6050-usb2phy";
+		reg = <0x2 0xaaa90000 0x0 0x4000>;
+		#phy-cells = <0>;
+	};
+
+	/* [INFERENCE] ADT atc-phy2 reg[0]; dwc3_2 + 0x810000 */
+	usb2phy_2: phy@382a90000 {
+		compatible = "apple,t6050-usb2phy";
+		reg = <0x3 0x82a90000 0x0 0x4000>;
+		#phy-cells = <0>;
+	};
+};
+
+/*
+ * The PHY must already be in host mode when dwc3 first resets it (plain
+ * dwc3 calls phy_set_mode() only after its core init), so tell the PHY.
+ */
+&T6050_USB_HOST_PHY {
+	apple,default-mode = "host";
+};
+
+&T6050_USB_HOST_DWC3 {
+	dr_mode = "otg";
+	usb-role-switch;
+	role-switch-default-mode = "host";
+	phys = <&T6050_USB_HOST_PHY>;
+	phy-names = "usb2-phy";
+	/* No USB3 PHY: keep the SuperSpeed side off. */
+	maximum-speed = "high-speed";
+	/*
+	 * Host-side USB 2.0 LPM off: nothing can take the PHY out of suspend
+	 * (same reason as the gadget's snps,usb2-gadget-lpm-disable).
+	 */
+	snps,usb2-lpm-disable;
+};
diff --git a/patches/linux/0010-hid-dockchannel-afe-reset-power-method-2.patch b/patches/linux/0010-hid-dockchannel-afe-reset-power-method-2.patch
new file mode 100644
index 0000000..2f8cd93
--- /dev/null
+++ b/patches/linux/0010-hid-dockchannel-afe-reset-power-method-2.patch
@@ -0,0 +1,227 @@
+From e2156105c652b729cc33f146b1ce58efc852a6de Mon Sep 17 00:00:00 2001
+From: rolotrealanis98 <122947376+rolotrealanis98@users.noreply.github.com>
+Date: Wed, 4 Nov 2026 18:39:35 -0500
+Subject: [PATCH 1/2] HID: dockchannel-hid: drive the AFE reset for power
+ method 2
+
+The M5-era MTP firmware (AppleMTPFirmwareMac-6320.x, ring transport)
+accepts only the nine-byte power request (method 2) and neither drives
+the trackpad analog front end (AFE) reset nor asks the host to. macOS
+runs the ADT function-afe-reset on the host between the "will change"
+and "has changed" halves (power-sequence: off = assert, 50 ms; on =
+release). Without it the AFE keeps whatever state the previous boot
+left, and the CBOR bootload fails intermittently with "Failed to attach
+to AFE (-6)" / "No HINT_L".
+
+Read apple,power-method from each interface node (default 2 in ring
+mode, 1 otherwise, i.e. unchanged). For method 2, look up an optional
+apple,afe-reset-gpios on the multi-touch node itself at first start
+(as-is, so its level does not change before the first transition is
+announced) and drive it between will/has: assert + 50 ms for OFF,
+release + 50 ms settle for ON. A missing property or a GPIO that is not
+available leaves the existing sequence untouched. The child-node lookup
+keeps the transport probe (and so the keyboard) independent of the SMC
+GPIO provider.
+
+A firmware GPIO request named afe-reset in ring mode reuses the
+host-held line, pulsed for 50 ms as macOS does; FIFO mode is unchanged.
+
+Compile-tested only.
+
+Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
+---
+ drivers/hid/dockchannel-hid/dockchannel-hid.c | 115 ++++++++++++++++--
+ 1 file changed, 105 insertions(+), 10 deletions(-)
+
+diff --git a/drivers/hid/dockchannel-hid/dockchannel-hid.c b/drivers/hid/dockchannel-hid/dockchannel-hid.c
+index 51391c1c4..43af7e5bb 100644
+--- a/drivers/hid/dockchannel-hid/dockchannel-hid.c
++++ b/drivers/hid/dockchannel-hid/dockchannel-hid.c
+@@ -87,6 +87,24 @@ struct dchid_init_hdr {
+ #define CMD_ENABLE_INTERFACE 0xb4
+ #define CMD_ACK_GPIO_CMD 0xa1
+ 
++/*
++ * Interface power requests (CMD_RESET_INTERFACE). Power method 1 is the
++ * four-byte form { 0x40, 1, iface, state }. Power method 2 is the nine-byte
++ * form { 0x40, 2, iface, state, has_changed, 0, 0, 0, 0 }: every transition
++ * is announced with has_changed = 0 ("will change") and confirmed with
++ * has_changed = 1 ("has changed"). With method 2 the coprocessor no longer
++ * pulses the trackpad AFE reset itself; macOS drives function-afe-reset
++ * between the two halves, following the multi-touch power-sequence
++ * { enable delay 0 ms, disable delay 50 ms, enable type 0, disable type 1 }:
++ * power-off asserts the reset and waits 50 ms, power-on releases it.
++ */
++#define DCHID_POWER_METHOD_1	1
++#define DCHID_POWER_METHOD_2	2
++#define DCHID_POWER_STATE_OFF	0
++#define DCHID_POWER_STATE_ON	2
++#define DCHID_AFE_RESET_HOLD_US	(50 * USEC_PER_MSEC)
++#define DCHID_AFE_SETTLE_US	(50 * USEC_PER_MSEC)
++
+ struct dchid_init_block_hdr {
+ 	__le16 type;
+ 	__le16 length;
+@@ -174,6 +192,10 @@ struct dchid_iface {
+ 	char gpio_name[MAX_GPIO_NAME];
+ 	int gpio_id;
+ 
++	u32 power_method;
++	/* Host-driven AFE reset line (power method 2), from the iface's OF node */
++	struct gpio_desc *afe_reset;
++
+ 	struct mutex out_mutex;
+ 	spinlock_t out_lock;
+ 	int out_error;
+@@ -267,6 +289,19 @@ dchid_get_interface(struct dockchannel_hid *dchid, int index, const char *name)
+ 			dev_warn(dchid->dev, "No OF node for subdevice %s, ignoring\n", name);
+ 			return NULL;
+ 		}
++
++		/* The ring-era firmware only accepts the nine-byte method 2 form. */
++		iface->power_method = dchid->use_ring ? DCHID_POWER_METHOD_2 :
++							DCHID_POWER_METHOD_1;
++		of_property_read_u32(iface->of_node, "apple,power-method",
++				     &iface->power_method);
++		if (iface->power_method != DCHID_POWER_METHOD_1 &&
++		    iface->power_method != DCHID_POWER_METHOD_2) {
++			dev_warn(dchid->dev, "Unsupported power method %u for %s\n",
++				 iface->power_method, name);
++			iface->power_method = dchid->use_ring ? DCHID_POWER_METHOD_2 :
++								DCHID_POWER_METHOD_1;
++		}
+ 	}
+ 
+ 	iface->wq = alloc_ordered_workqueue("dchid-%s", WQ_MEM_RECLAIM, iface->name);
+@@ -453,23 +488,74 @@ static int dchid_enable_interface(struct dchid_iface *iface)
+ 
+ static int dchid_reset_interface(struct dchid_iface *iface, int state)
+ {
+-	u8 msg[] = { CMD_RESET_INTERFACE, 1, iface->index, state };
+-	u8 msg2[] = { CMD_RESET_INTERFACE, 2, iface->index, state, 0, 0, 0, 0, 0 };
++	struct dockchannel_hid *dchid = iface->dchid;
++	u8 msg[] = { CMD_RESET_INTERFACE, DCHID_POWER_METHOD_1, iface->index, state };
++	u8 msg2[] = { CMD_RESET_INTERFACE, DCHID_POWER_METHOD_2, iface->index, state,
++		      0, 0, 0, 0, 0 };
+ 	int ret;
+ 
+-	if (!iface->dchid->use_ring)
+-		return dchid_comm_cmd(iface->dchid, msg, sizeof(msg));
++	if (iface->power_method == DCHID_POWER_METHOD_1)
++		return dchid_comm_cmd(dchid, msg, sizeof(msg));
+ 
+ 	/*
+ 	 * T8132 boot capture: state 0 then 2, each with byte 4 equal to 0
+ 	 * then 1. This is only the observed provisioning sequence, not a
+ 	 * contract for suspend, wake, or arbitrary interface power changes.
+ 	 */
+-	ret = dchid_comm_cmd(iface->dchid, msg2, sizeof(msg2));
++	ret = dchid_comm_cmd(dchid, msg2, sizeof(msg2));
+ 	if (ret < 0)
+ 		return ret;
++
++	/*
++	 * Between "will change" and "has changed" the host drives the AFE
++	 * reset (ADT function-afe-reset; the M5-era MTP firmware neither
++	 * drives it nor asks for it). Without a line, keep the old behaviour.
++	 */
++	if (iface->afe_reset) {
++		bool off = state == DCHID_POWER_STATE_OFF;
++
++		ret = gpiod_set_value_cansleep(iface->afe_reset, off);
++		if (ret < 0) {
++			dev_err(dchid->dev, "%s: failed to %s AFE reset: %d\n",
++				iface->name, off ? "assert" : "release", ret);
++			return ret;
++		}
++		dev_info(dchid->dev, "%s: AFE reset %s\n", iface->name,
++			 off ? "asserted" : "released");
++		fsleep(off ? DCHID_AFE_RESET_HOLD_US : DCHID_AFE_SETTLE_US);
++	}
++
+ 	msg2[4] = 1;
+-	return dchid_comm_cmd(iface->dchid, msg2, sizeof(msg2));
++	return dchid_comm_cmd(dchid, msg2, sizeof(msg2));
++}
++
++/*
++ * The AFE reset line is optional and only used with power method 2. It is
++ * looked up on the interface's own node, so the parent probe never waits
++ * for (or defers on) the SMC GPIO provider, and it is requested as-is so
++ * its level does not change before the first transition is announced. Any
++ * failure leaves afe_reset NULL, i.e. the pre-existing behaviour; a later
++ * start retries the lookup.
++ */
++static void dchid_get_afe_reset(struct dchid_iface *iface)
++{
++	struct device *dev = iface->dchid->dev;
++	struct gpio_desc *gpio;
++
++	if (iface->afe_reset || iface->power_method != DCHID_POWER_METHOD_2 ||
++	    !of_property_present(iface->of_node, "apple,afe-reset-gpios"))
++		return;
++
++	gpio = devm_fwnode_gpiod_get(dev, of_fwnode_handle(iface->of_node),
++				     "apple,afe-reset", GPIOD_ASIS, "afe-reset");
++	if (IS_ERR(gpio)) {
++		dev_warn(dev, "%s: AFE reset line unavailable (%pe), continuing without it\n",
++			 iface->name, gpio);
++		return;
++	}
++
++	dev_info(dev, "%s: host-driven AFE reset, power method 2\n", iface->name);
++	iface->afe_reset = gpio;
+ }
+ 
+ static int dchid_register_ring(struct dockchannel_hid *dchid)
+@@ -615,6 +701,11 @@ static int dchid_request_gpio(struct dchid_iface *iface)
+ 	 * SMC reset keys. Do not substitute a guessed software pulse.
+ 	 */
+ 	if (iface->dchid->use_ring) {
++		/* A request for the AFE line reuses the host-held descriptor. */
++		if (iface->afe_reset && !strcmp(iface->gpio_name, "afe-reset")) {
++			iface->gpio = iface->afe_reset;
++			return 0;
++		}
+ 		dev_err_once(iface->dchid->dev, "T8132 SMC reset GPIO operation is not established\n");
+ 		return -EOPNOTSUPP;
+ 	}
+@@ -671,6 +762,7 @@ static int dchid_start_interface(struct dchid_iface *iface)
+ 
+ 	/* Only multi-touch has firmware */
+ 	if (fw && size) {
++		dchid_get_afe_reset(iface);
+ 
+ 		/* Send firmware to the device */
+ 		dev_info(iface->dchid->dev, "Sending firmware for %s\n", iface->name);
+@@ -682,10 +774,10 @@ static int dchid_start_interface(struct dchid_iface *iface)
+ 
+ 		/* After loading firmware, multi-touch needs a reset */
+ 		dev_info(iface->dchid->dev, "Resetting %s\n", iface->name);
+-		ret = dchid_reset_interface(iface, 0);
++		ret = dchid_reset_interface(iface, DCHID_POWER_STATE_OFF);
+ 		if (ret < 0)
+ 			goto err;
+-		ret = dchid_reset_interface(iface, 2);
++		ret = dchid_reset_interface(iface, DCHID_POWER_STATE_ON);
+ 		if (ret < 0)
+ 			goto err;
+ 	}
+@@ -1083,9 +1175,12 @@ static void dchid_handle_gpio(struct dockchannel_hid *dchid, void *data, size_t
+ 
+ 	switch (cmd->cmd) {
+ 	case 3:
+-		/* Pulse.  */
++		/* Pulse. macOS holds a requested pulse for 50 ms. */
+ 		gpiod_set_value_cansleep(iface->gpio, 1);
+-		msleep(10); /* Random guess... */
++		if (dchid->use_ring)
++			fsleep(DCHID_AFE_RESET_HOLD_US);
++		else
++			msleep(10); /* Random guess... */
+ 		gpiod_set_value_cansleep(iface->gpio, 0);
+ 		retcode = 0;
+ 		break;
+-- 
+2.56.0
+
diff --git a/patches/linux/0011-hwmon-macsmc-keep-fans-with-missing-optional-keys.patch b/patches/linux/0011-hwmon-macsmc-keep-fans-with-missing-optional-keys.patch
new file mode 100644
index 0000000..9e7b8e0
--- /dev/null
+++ b/patches/linux/0011-hwmon-macsmc-keep-fans-with-missing-optional-keys.patch
@@ -0,0 +1,76 @@
+hwmon: (macsmc) keep a fan whose optional keys are missing
+
+macsmc_hwmon_create_fan() returned an error, dropping the whole fan, when
+any of apple,fan-minimum/-maximum/-target/-mode named a key the SMC does
+not have. The T6050 (M5 Pro) SMC spells the mode key F0md instead of
+F0Md, so with the shared hwmon-fan*.dtsi both fans disappeared. Treat the
+optional keys as optional: warn, drop that attribute, and only allow
+manual control when mode, target, minimum and maximum keys all exist.
+
+diff --git a/drivers/hwmon/macsmc-hwmon.c b/drivers/hwmon/macsmc-hwmon.c
+index 1500ec2cc..58d3dba5d 100644
+--- a/drivers/hwmon/macsmc-hwmon.c
++++ b/drivers/hwmon/macsmc-hwmon.c
+@@ -524,37 +524,43 @@ static int macsmc_hwmon_create_fan(struct device *dev, struct apple_smc *smc,
+ 		fan->attrs |= HWMON_F_LABEL;
+ 	}
+ 
+-	/* The following keys are not required to simply monitor fan speed */
++	/*
++	 * The following keys are not required to simply monitor fan speed.
++	 * A key the firmware lacks (the T6050 SMC spells the mode key F0md,
++	 * not F0Md) drops only that attribute, not the whole fan.
++	 */
+ 	if (!of_property_read_string(fan_node, "apple,fan-minimum", &min)) {
+-		ret = macsmc_hwmon_parse_key(dev, smc, &fan->min, min);
+-		if (ret)
+-			return ret;
+-
+-		fan->attrs |= HWMON_F_MIN;
++		if (macsmc_hwmon_parse_key(dev, smc, &fan->min, min))
++			dev_warn(dev, "Fan %s: no minimum key %s\n", now, min);
++		else
++			fan->attrs |= HWMON_F_MIN;
+ 	}
+ 
+ 	if (!of_property_read_string(fan_node, "apple,fan-maximum", &max)) {
+-		ret = macsmc_hwmon_parse_key(dev, smc, &fan->max, max);
+-		if (ret)
+-			return ret;
+-
+-		fan->attrs |= HWMON_F_MAX;
++		if (macsmc_hwmon_parse_key(dev, smc, &fan->max, max))
++			dev_warn(dev, "Fan %s: no maximum key %s\n", now, max);
++		else
++			fan->attrs |= HWMON_F_MAX;
+ 	}
+ 
+ 	if (!of_property_read_string(fan_node, "apple,fan-target", &set)) {
+-		ret = macsmc_hwmon_parse_key(dev, smc, &fan->set, set);
+-		if (ret)
+-			return ret;
+-
+-		fan->attrs |= HWMON_F_TARGET;
++		if (macsmc_hwmon_parse_key(dev, smc, &fan->set, set))
++			dev_warn(dev, "Fan %s: no target key %s\n", now, set);
++		else
++			fan->attrs |= HWMON_F_TARGET;
+ 	}
+ 
+ 	if (!of_property_read_string(fan_node, "apple,fan-mode", &mode)) {
+-		ret = macsmc_hwmon_parse_key(dev, smc, &fan->mode, mode);
+-		if (ret)
+-			return ret;
++		if (macsmc_hwmon_parse_key(dev, smc, &fan->mode, mode))
++			dev_warn(dev, "Fan %s: no mode key %s, manual control disabled\n",
++				 now, mode);
+ 	}
+ 
++	/* Manual control needs the minimum, maximum and target keys too */
++	if ((fan->attrs & (HWMON_F_MIN | HWMON_F_MAX | HWMON_F_TARGET)) !=
++	    (HWMON_F_MIN | HWMON_F_MAX | HWMON_F_TARGET))
++		fan->mode.macsmc_key = 0;
++
+ 	/* Initialise fan control mode to automatic */
+ 	fan->manual = false;
+ 
diff --git a/patches/linux/0012-power-supply-macsmc-power-init-work-before-notifier.patch b/patches/linux/0012-power-supply-macsmc-power-init-work-before-notifier.patch
new file mode 100644
index 0000000..8c5a346
--- /dev/null
+++ b/patches/linux/0012-power-supply-macsmc-power-init-work-before-notifier.patch
@@ -0,0 +1,42 @@
+power: supply: macsmc-power: initialise work items before the notifier
+
+Probe initialised critical_work twice: once via devm_work_autocancel() and
+again (plus dbg_log_work) after blocking_notifier_chain_register(). An SMC
+critical-battery event (0x71020000) arriving between the two would have its
+queued work re-initialised under the workqueue, corrupting it. Initialise
+both before the notifier is registered and drop the second INIT_WORK.
+
+diff --git a/drivers/power/supply/macsmc-power.c b/drivers/power/supply/macsmc-power.c
+index addb43489..f5d4ec0c2 100644
+--- a/drivers/power/supply/macsmc-power.c
++++ b/drivers/power/supply/macsmc-power.c
+@@ -834,11 +834,18 @@ static int macsmc_power_probe(struct platform_device *pdev)
+ 	power->smc = smc;
+ 	dev_set_drvdata(dev, power);
+ 
+-	INIT_WORK(&power->critical_work, macsmc_power_critical_work);
++	/* devm_work_autocancel() initialises critical_work */
+ 	ret = devm_work_autocancel(dev, &power->critical_work, macsmc_power_critical_work);
+ 	if (ret)
+ 		return ret;
+ 
++	/*
++	 * Must be ready before the notifier is registered below: an SMC event
++	 * can arrive as soon as it is, and re-initialising a work item that
++	 * is already queued corrupts the workqueue.
++	 */
++	INIT_DELAYED_WORK(&power->dbg_log_work, macsmc_dbg_work);
++
+ 	/*
+ 	 * Check for battery presence.
+ 	 * B0AV is a fundamental key.
+@@ -1039,9 +1046,6 @@ static int macsmc_power_probe(struct platform_device *pdev)
+ 	power->nb.notifier_call = macsmc_power_event;
+ 	blocking_notifier_chain_register(&smc->event_handlers, &power->nb);
+ 
+-	INIT_WORK(&power->critical_work, macsmc_power_critical_work);
+-	INIT_DELAYED_WORK(&power->dbg_log_work, macsmc_dbg_work);
+-
+ 	g_power = power;
+ 
+ 	if (log_power)
diff --git a/patches/linux/0013-mfd-macsmc-initialise-spinlock.patch b/patches/linux/0013-mfd-macsmc-initialise-spinlock.patch
new file mode 100644
index 0000000..0bef08b
--- /dev/null
+++ b/patches/linux/0013-mfd-macsmc-initialise-spinlock.patch
@@ -0,0 +1,18 @@
+mfd: macsmc: initialise the atomic-write spinlock
+
+smc->lock (used by apple_smc_write_atomic(), i.e. macsmc-reboot) was never
+spin_lock_init()ed; it only worked because the struct is zero-allocated and
+CONFIG_DEBUG_SPINLOCK is off.
+
+diff --git a/drivers/mfd/macsmc.c b/drivers/mfd/macsmc.c
+index 31540f67d..68f7bb832 100644
+--- a/drivers/mfd/macsmc.c
++++ b/drivers/mfd/macsmc.c
+@@ -419,6 +419,7 @@ static int apple_smc_probe(struct platform_device *pdev)
+ 		return -ENOMEM;
+ 
+ 	mutex_init(&smc->mutex);
++	spin_lock_init(&smc->lock);
+ 	smc->dev = &pdev->dev;
+ 	smc->sram_base = devm_platform_get_and_ioremap_resource(pdev, 1, &smc->sram);
+ 	if (IS_ERR(smc->sram_base))
diff --git a/patches/linux/0014-cpufreq-apple-soc-nearest-opp-for-p-state.patch b/patches/linux/0014-cpufreq-apple-soc-nearest-opp-for-p-state.patch
new file mode 100644
index 0000000..0f43172
--- /dev/null
+++ b/patches/linux/0014-cpufreq-apple-soc-nearest-opp-for-p-state.patch
@@ -0,0 +1,72 @@
+From 24058addd55262695a8851206e069bc532c0fc45 Mon Sep 17 00:00:00 2001
+From: rolotrealanis98 <122947376+rolotrealanis98@users.noreply.github.com>
+Date: Wed, 4 Nov 2026 17:57:20 -0500
+Subject: [PATCH 1/3] cpufreq: apple-soc: report the nearest OPP for p-states
+ outside the table
+
+apple_soc_cpufreq_get_rate() returns 0 when the hardware reports a
+p-state that has no OPP. cpufreq_online() treats 0 from ->get() as fatal
+("->get() failed"), so the policy is torn down and the cluster stays at
+whatever p-state the bootloader left it in.
+
+On T6050 (M5 Pro) the OPP tables deliberately start at p-state 2 (the
+lowest entry of the cluster's ADT voltage-states table) and leave out
+p-states the cluster refuses, so a cluster that firmware left in one of
+those states would never get a policy. Return the frequency of the
+nearest table entry instead and warn (ratelimited), so the policy comes
+up and the first ->target_index() moves the cluster into the table.
+
+Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
+---
+ drivers/cpufreq/apple-soc-cpufreq.c | 25 ++++++++++++++++++++-----
+ 1 file changed, 20 insertions(+), 5 deletions(-)
+
+diff --git a/drivers/cpufreq/apple-soc-cpufreq.c b/drivers/cpufreq/apple-soc-cpufreq.c
+index 5ad274a1e..6c7c9e084 100644
+--- a/drivers/cpufreq/apple-soc-cpufreq.c
++++ b/drivers/cpufreq/apple-soc-cpufreq.c
+@@ -137,7 +137,7 @@ static unsigned int apple_soc_cpufreq_get_rate(unsigned int cpu)
+ 	struct cpufreq_policy *policy;
+ 	struct apple_cpu_priv *priv;
+ 	struct cpufreq_frequency_table *p;
+-	unsigned int pstate;
++	unsigned int pstate, dist, best_dist = UINT_MAX, best_freq = 0;
+ 
+ 	policy = cpufreq_cpu_get_raw(cpu);
+ 	if (unlikely(!policy))
+@@ -159,13 +159,28 @@ static unsigned int apple_soc_cpufreq_get_rate(unsigned int cpu)
+ 		pstate = FIELD_GET(APPLE_DVFS_CMD_PS1, reg);
+ 	}
+ 
+-	cpufreq_for_each_valid_entry(p, policy->freq_table)
++	cpufreq_for_each_valid_entry(p, policy->freq_table) {
+ 		if (p->driver_data == pstate)
+ 			return p->frequency;
+ 
+-	dev_err(priv->cpu_dev, "could not find frequency for pstate %d\n",
+-		pstate);
+-	return 0;
++		dist = p->driver_data > pstate ? p->driver_data - pstate :
++						  pstate - p->driver_data;
++		if (dist < best_dist) {
++			best_dist = dist;
++			best_freq = p->frequency;
++		}
++	}
++
++	/*
++	 * The OPP table need not cover every hardware p-state: T6050 leaves
++	 * out the lowest ones and the ones the cluster refuses. Returning 0
++	 * here makes cpufreq_online() fail ("->get() failed") and leaves the
++	 * whole cluster unmanaged, so report the nearest table entry instead.
++	 */
++	dev_warn_ratelimited(priv->cpu_dev,
++			     "p-state %u is not in the OPP table, reporting %u kHz\n",
++			     pstate, best_freq);
++	return best_freq;
+ }
+ 
+ static int apple_soc_cpufreq_set_target(struct cpufreq_policy *policy,
+-- 
+2.56.0
+
diff --git a/patches/linux/0015-cpufreq-apple-soc-log-dvfs-handover.patch b/patches/linux/0015-cpufreq-apple-soc-log-dvfs-handover.patch
new file mode 100644
index 0000000..42ce1d5
--- /dev/null
+++ b/patches/linux/0015-cpufreq-apple-soc-log-dvfs-handover.patch
@@ -0,0 +1,91 @@
+From aa7512027d1c2e04c55ea66f6171c165b0fc9c73 Mon Sep 17 00:00:00 2001
+From: rolotrealanis98 <122947376+rolotrealanis98@users.noreply.github.com>
+Date: Wed, 4 Nov 2026 17:57:43 -0500
+Subject: [PATCH 2/3] cpufreq: apple-soc: log the DVFS state handed over and
+ warn if APSC is off
+
+m1n1 initialises the cluster DVFS block (APSC enable, default p-state)
+only on SoCs it has a table for; on T6050 (M5 Pro) it prints "cpufreq:
+Chip 0x6050 is unsupported" and leaves the clusters as iBoot set them.
+Print the raw command and status registers once per policy so the boot
+p-state of every cluster is in the log, and warn when the APSC disable
+bit (bit 22 on M1, bit 23 on M2 and later, as named by m1n1) is set,
+because the cluster then ignores p-state requests.
+
+Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
+---
+ drivers/cpufreq/apple-soc-cpufreq.c | 23 +++++++++++++++++++++++
+ 1 file changed, 23 insertions(+)
+
+diff --git a/drivers/cpufreq/apple-soc-cpufreq.c b/drivers/cpufreq/apple-soc-cpufreq.c
+index 6c7c9e084..f986a7d81 100644
+--- a/drivers/cpufreq/apple-soc-cpufreq.c
++++ b/drivers/cpufreq/apple-soc-cpufreq.c
+@@ -30,6 +30,9 @@
+ #define APPLE_DVFS_CMD_PS2			GENMASK(15, 12)
+ #define APPLE_DVFS_CMD_PS1			GENMASK(4, 0)
+ #define APPLE_DVFS_CMD_PS1_SHIFT		0
++/* APSC (hardware DVFS sequencer) disable, as named by m1n1's cpufreq.c */
++#define APPLE_DVFS_CMD_M1_APSC_DIS		BIT(22)
++#define APPLE_DVFS_CMD_M2_APSC_DIS		BIT(23)
+ 
+ /* Same timebase as CPU counter (24MHz) */
+ #define APPLE_DVFS_LAST_CHG_TIME	0x38
+@@ -67,6 +70,7 @@ struct apple_soc_cpufreq_info {
+ 	u64 cur_pstate_shift;
+ 	u64 ps1_mask;
+ 	u64 ps1_shift;
++	u64 apsc_dis;
+ };
+ 
+ struct apple_cpu_priv {
+@@ -93,6 +97,7 @@ static const struct apple_soc_cpufreq_info soc_t8103_info = {
+ 	.cur_pstate_shift = APPLE_DVFS_STATUS_CUR_PS_SHIFT_T8103,
+ 	.ps1_mask = APPLE_DVFS_CMD_PS1,
+ 	.ps1_shift = APPLE_DVFS_CMD_PS1_SHIFT,
++	.apsc_dis = APPLE_DVFS_CMD_M1_APSC_DIS,
+ };
+ 
+ static const struct apple_soc_cpufreq_info soc_t8112_info = {
+@@ -102,6 +107,7 @@ static const struct apple_soc_cpufreq_info soc_t8112_info = {
+ 	.cur_pstate_shift = APPLE_DVFS_STATUS_CUR_PS_SHIFT_T8112,
+ 	.ps1_mask = APPLE_DVFS_CMD_PS1,
+ 	.ps1_shift = APPLE_DVFS_CMD_PS1_SHIFT,
++	.apsc_dis = APPLE_DVFS_CMD_M2_APSC_DIS,
+ };
+ 
+ static const struct apple_soc_cpufreq_info soc_default_info = {
+@@ -257,6 +263,8 @@ static int apple_soc_cpufreq_init(struct cpufreq_policy *policy)
+ 	struct apple_cpu_priv *priv;
+ 	const struct apple_soc_cpufreq_info *info;
+ 	struct cpufreq_frequency_table *freq_table;
++	u64 cmd;
++	u32 status = 0;
+ 
+ 	cpu_dev = get_cpu_device(policy->cpu);
+ 	if (!cpu_dev) {
+@@ -276,6 +284,21 @@ static int apple_soc_cpufreq_init(struct cpufreq_policy *policy)
+ 		return ret;
+ 	}
+ 
++	/*
++	 * Log the state the bootloader handed over: on SoCs that m1n1's
++	 * cpufreq does not initialise (T6050) this is the only record of the
++	 * boot p-state and of whether the APSC is enabled. With the APSC
++	 * disabled the cluster ignores p-state requests.
++	 */
++	cmd = readq_relaxed(reg_base + APPLE_DVFS_CMD);
++	if (info->cur_pstate_mask)
++		status = readl_relaxed(reg_base + APPLE_DVFS_STATUS);
++	dev_info(cpu_dev, "DVFS for CPUs %*pbl: cmd %#llx status %#x\n",
++		 cpumask_pr_args(policy->cpus), cmd, status);
++	if (info->apsc_dis && (cmd & info->apsc_dis))
++		dev_warn(cpu_dev, "APSC is disabled (cmd %#llx), p-state changes will not take effect\n",
++			 cmd);
++
+ 	ret = dev_pm_opp_set_sharing_cpus(cpu_dev, policy->cpus);
+ 	if (ret) {
+ 		dev_err(cpu_dev, "%s: failed to mark OPPs as shared: %d\n", __func__, ret);
+-- 
+2.56.0
+
diff --git a/patches/linux/0016-dt-bindings-cpufreq-apple-add-t6050.patch b/patches/linux/0016-dt-bindings-cpufreq-apple-add-t6050.patch
new file mode 100644
index 0000000..11a8f8f
--- /dev/null
+++ b/patches/linux/0016-dt-bindings-cpufreq-apple-add-t6050.patch
@@ -0,0 +1,34 @@
+From c92c7c3b7950f5ea1a51bd2972efd282116649a9 Mon Sep 17 00:00:00 2001
+From: rolotrealanis98 <122947376+rolotrealanis98@users.noreply.github.com>
+Date: Wed, 4 Nov 2026 17:58:41 -0500
+Subject: [PATCH 3/3] dt-bindings: cpufreq: apple,cluster-cpufreq: Add T6050
+
+The T6050 (M5 Pro) cluster DVFS block has the T8112 register layout:
+p-state request in bits 4:0 of the command register at +0x20, current
+p-state in bits 9:5 of the status register at +0x50 (measured on the
+J714s and J716s). Like T6020 it is described as
+"apple,t6050-cluster-cpufreq", "apple,t8112-cluster-cpufreq".
+
+Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
+---
+ .../devicetree/bindings/cpufreq/apple,cluster-cpufreq.yaml    | 4 +++-
+ 1 file changed, 3 insertions(+), 1 deletion(-)
+
+diff --git a/Documentation/devicetree/bindings/cpufreq/apple,cluster-cpufreq.yaml b/Documentation/devicetree/bindings/cpufreq/apple,cluster-cpufreq.yaml
+index b51913a81..c96ce28f2 100644
+--- a/Documentation/devicetree/bindings/cpufreq/apple,cluster-cpufreq.yaml
++++ b/Documentation/devicetree/bindings/cpufreq/apple,cluster-cpufreq.yaml
+@@ -36,7 +36,9 @@ properties:
+           - const: apple,s5l8960x-cluster-cpufreq
+       - const: apple,s5l8960x-cluster-cpufreq
+       - items:
+-          - const: apple,t6020-cluster-cpufreq
++          - enum:
++              - apple,t6020-cluster-cpufreq
++              - apple,t6050-cluster-cpufreq
+           - const: apple,t8112-cluster-cpufreq
+ 
+   reg:
+-- 
+2.56.0
+
diff --git a/patches/linux/0017-phy-apple-usb2-only-type-c-phy-t6050.patch b/patches/linux/0017-phy-apple-usb2-only-type-c-phy-t6050.patch
new file mode 100644
index 0000000..e03e258
--- /dev/null
+++ b/patches/linux/0017-phy-apple-usb2-only-type-c-phy-t6050.patch
@@ -0,0 +1,325 @@
+phy: apple: USB2-only Type-C port PHY driver for T6050 (phy-apple-usb2). m5pro-linux agents/usb.
+
+diff --git a/drivers/phy/apple/Kconfig b/drivers/phy/apple/Kconfig
+index 8409b67f6..fadbae011 100644
+--- a/drivers/phy/apple/Kconfig
++++ b/drivers/phy/apple/Kconfig
+@@ -21,3 +21,15 @@ config PHY_APPLE_DPTX
+ 	  such as the M2.
+ 	  This driver provides support for DisplayPort and is used on the
+ 	  Mac mini (M2 and M2 Pro, 2023).
++
++config PHY_APPLE_USB2
++	tristate "Apple Type-C port USB2-only PHY"
++	depends on ARCH_APPLE || COMPILE_TEST
++	select GENERIC_PHY
++	help
++	  Enable this for USB 2.0 host or device mode on the Type-C ports of
++	  Apple SoCs whose full Type-C PHY (PHY_APPLE_ATC) is not supported
++	  yet, such as the M5 Pro (T6050). Only the USB2 PHY is driven; USB3,
++	  USB4 and DisplayPort stay unavailable.
++
++	  If M is selected the module will be called 'phy-apple-usb2'.
+diff --git a/drivers/phy/apple/Makefile b/drivers/phy/apple/Makefile
+index b9e7bf3e4..2613dd42c 100644
+--- a/drivers/phy/apple/Makefile
++++ b/drivers/phy/apple/Makefile
+@@ -5,3 +5,6 @@ phy-apple-atc-y			:= atc.o
+ 
+ obj-$(CONFIG_PHY_APPLE_DPTX)	+= phy-apple-dptx.o
+ phy-apple-dptx-y		+= dptx.o
++
++obj-$(CONFIG_PHY_APPLE_USB2)	+= phy-apple-usb2.o
++phy-apple-usb2-y		+= usb2.o
+diff --git a/drivers/phy/apple/usb2.c b/drivers/phy/apple/usb2.c
+new file mode 100644
+index 000000000..6cd58bb3b
+--- /dev/null
++++ b/drivers/phy/apple/usb2.c
+@@ -0,0 +1,286 @@
++// SPDX-License-Identifier: GPL-2.0-only OR MIT
++/*
++ * Apple Type-C port USB2 PHY, USB 2.0 only.
++ *
++ * The USB2 half of the Apple Type-C PHY ("atc-phy" in the ADT, whose reg[0]
++ * is this block) without any of the USB3/USB4/DisplayPort machinery that
++ * phy-apple-atc drives. It exists for SoCs where the full ATC PHY is not
++ * supported yet (T6050, M5 Pro), so that a dwc3 controller can run in host
++ * mode over the USB 2.0 pairs while its PIPE interface stays on the dummy
++ * PHY that the bootloader (m1n1 usb_phy_bringup()) selected.
++ *
++ * Bring-up (.init) is the exact register sequence m1n1 uses on T6050 (which
++ * is known to work there for device mode), plus the host-mode bits that
++ * phy-apple-atc sets in USB2PHY_SIG on M1..M4. VBUS detection stays forced
++ * valid in both modes, like m1n1 and phy-apple-atc do: VBUS itself is owned
++ * by the USB-PD controller, not by this PHY.
++ *
++ * Copyright The Asahi Linux Contributors
++ */
++
++#include <linux/bits.h>
++#include <linux/delay.h>
++#include <linux/io.h>
++#include <linux/mod_devicetable.h>
++#include <linux/module.h>
++#include <linux/mutex.h>
++#include <linux/of.h>
++#include <linux/phy/phy.h>
++#include <linux/platform_device.h>
++#include <linux/string.h>
++
++#define USB2PHY_USBCTL			0x00
++#define USB2PHY_USBCTL_USB_MODE		0x7
++#define USB2PHY_USBCTL_RUN		2
++#define USB2PHY_USBCTL_ISOLATION	4
++
++#define USB2PHY_CTL			0x04
++#define USB2PHY_CTL_RESET		BIT(0)
++#define USB2PHY_CTL_PORT_RESET		BIT(1)
++#define USB2PHY_CTL_APB_RESET_N		BIT(2)
++#define USB2PHY_CTL_SIDDQ		BIT(3)
++
++#define USB2PHY_SIG			0x08
++#define USB2PHY_SIG_VBUSDET_FORCE_VAL	BIT(0)
++#define USB2PHY_SIG_VBUSDET_FORCE_EN	BIT(1)
++#define USB2PHY_SIG_VBUSVLDEXT_FORCE_VAL BIT(2)
++#define USB2PHY_SIG_VBUSVLDEXT_FORCE_EN	BIT(3)
++#define USB2PHY_SIG_HOST		(7 << 12)
++/* Full USB2PHY_SIG value m1n1 writes on every SoC, T6050 included */
++#define USB2PHY_SIG_M1N1		0x01c1000f
++
++#define USB2PHY_MISCTUNE		0x1c
++#define USB2PHY_MISCTUNE_APBCLK_GATE_OFF BIT(29)
++#define USB2PHY_MISCTUNE_REFCLK_GATE_OFF BIT(30)
++/* MISCTUNE value m1n1 writes (clock gates off, tuning as left by iBoot) */
++#define USB2PHY_MISCTUNE_M1N1		0x008c0813
++
++struct apple_usb2phy {
++	struct device *dev;
++	void __iomem *regs;
++	struct phy *phy;
++	struct mutex lock;
++	bool host;
++	bool powered;
++};
++
++static void apple_usb2phy_hw_on(struct apple_usb2phy *p)
++{
++	u32 sig = USB2PHY_SIG_M1N1 & ~USB2PHY_SIG_HOST;
++
++	if (p->host)
++		sig |= USB2PHY_SIG_HOST;
++
++	/* m1n1 src/usb.c usb_phy_bringup(), verbatim apart from the HOST bits */
++	writel(sig, p->regs + USB2PHY_SIG);
++	writel(USB2PHY_CTL_RESET | USB2PHY_CTL_PORT_RESET, p->regs + USB2PHY_CTL);
++	udelay(10);
++	writel(readl(p->regs + USB2PHY_CTL) & ~USB2PHY_CTL_RESET, p->regs + USB2PHY_CTL);
++	udelay(10);
++	writel(readl(p->regs + USB2PHY_CTL) & ~USB2PHY_CTL_PORT_RESET, p->regs + USB2PHY_CTL);
++	udelay(10);
++	writel(USB2PHY_MISCTUNE_M1N1, p->regs + USB2PHY_MISCTUNE);
++	writel(USB2PHY_USBCTL_RUN, p->regs + USB2PHY_USBCTL);
++	udelay(10);
++}
++
++static void apple_usb2phy_hw_off(struct apple_usb2phy *p)
++{
++	u32 v;
++
++	/* phy-apple-atc atcphy_usb2_power_off() */
++	v = readl(p->regs + USB2PHY_USBCTL);
++	v &= ~USB2PHY_USBCTL_USB_MODE;
++	v |= USB2PHY_USBCTL_ISOLATION;
++	writel(v, p->regs + USB2PHY_USBCTL);
++	udelay(10);
++	writel(readl(p->regs + USB2PHY_CTL) | USB2PHY_CTL_SIDDQ, p->regs + USB2PHY_CTL);
++	udelay(10);
++	writel(readl(p->regs + USB2PHY_CTL) | USB2PHY_CTL_PORT_RESET, p->regs + USB2PHY_CTL);
++	udelay(10);
++	writel(readl(p->regs + USB2PHY_CTL) | USB2PHY_CTL_RESET, p->regs + USB2PHY_CTL);
++	udelay(10);
++	writel(readl(p->regs + USB2PHY_CTL) & ~USB2PHY_CTL_APB_RESET_N, p->regs + USB2PHY_CTL);
++	udelay(10);
++	writel(readl(p->regs + USB2PHY_MISCTUNE) | USB2PHY_MISCTUNE_APBCLK_GATE_OFF |
++	       USB2PHY_MISCTUNE_REFCLK_GATE_OFF, p->regs + USB2PHY_MISCTUNE);
++}
++
++/*
++ * The full reset sequence runs in .init, not .power_on: dwc3 calls
++ * phy_init() before its core soft reset and phy_power_on() after it, and
++ * the PHY must be up (in the right mode) before dwc3 resets (the order
++ * phy-apple-atc + dwc3-apple use on M1..M4).
++ *
++ * It runs even if the bootloader left the PHY running: the eUSB2 repeater
++ * between PHY and connector is reset out of band by the USB-PD controller on
++ * every CC (dis)connect, and only a PHY reset re-synchronises the two (see
++ * dwc3-apple.c). Unbinding and rebinding dwc3 therefore re-syncs the port.
++ */
++static int apple_usb2phy_init(struct phy *phy)
++{
++	struct apple_usb2phy *p = phy_get_drvdata(phy);
++
++	guard(mutex)(&p->lock);
++
++	apple_usb2phy_hw_on(p);
++	p->powered = true;
++	dev_dbg(p->dev, "on, %s mode, SIG=%#x\n", p->host ? "host" : "device",
++		readl(p->regs + USB2PHY_SIG));
++	return 0;
++}
++
++static int apple_usb2phy_exit(struct phy *phy)
++{
++	struct apple_usb2phy *p = phy_get_drvdata(phy);
++
++	guard(mutex)(&p->lock);
++
++	apple_usb2phy_hw_off(p);
++	p->powered = false;
++	return 0;
++}
++
++static int apple_usb2phy_power_on(struct phy *phy)
++{
++	struct apple_usb2phy *p = phy_get_drvdata(phy);
++
++	guard(mutex)(&p->lock);
++
++	/* Normally a no-op: .init already brought the PHY up. */
++	if (!p->powered) {
++		apple_usb2phy_hw_on(p);
++		p->powered = true;
++	}
++	return 0;
++}
++
++static int apple_usb2phy_power_off(struct phy *phy)
++{
++	/*
++	 * Keep the PHY running until .exit: after a power-off only the full
++	 * reset sequence brings it back, and dwc3 also calls power_off on
++	 * paths (suspend) where it does not call init again.
++	 */
++	return 0;
++}
++
++static int apple_usb2phy_set_mode(struct phy *phy, enum phy_mode mode, int submode)
++{
++	struct apple_usb2phy *p = phy_get_drvdata(phy);
++	bool host;
++
++	switch (mode) {
++	case PHY_MODE_USB_HOST:
++	case PHY_MODE_USB_HOST_LS:
++	case PHY_MODE_USB_HOST_FS:
++	case PHY_MODE_USB_HOST_HS:
++		host = true;
++		break;
++	case PHY_MODE_USB_DEVICE:
++	case PHY_MODE_USB_DEVICE_LS:
++	case PHY_MODE_USB_DEVICE_FS:
++	case PHY_MODE_USB_DEVICE_HS:
++		host = false;
++		break;
++	case PHY_MODE_USB_OTG:
++		return 0;
++	default:
++		return -EINVAL;
++	}
++
++	guard(mutex)(&p->lock);
++
++	if (host == p->host)
++		return 0;
++	p->host = host;
++
++	/*
++	 * phy-apple-atc flips only the SIG bits here, with the PHY running and
++	 * the dwc3 core held in reset. Plain dwc3 calls set_mode after its core
++	 * init, so mirror the bit flip but keep everything else as it is; the
++	 * initial mode should come from "apple,default-mode" so that the PHY is
++	 * already in the right mode when dwc3 first resets it.
++	 */
++	if (p->powered) {
++		u32 sig = readl(p->regs + USB2PHY_SIG);
++
++		if (host)
++			sig |= USB2PHY_SIG_HOST;
++		else
++			sig &= ~USB2PHY_SIG_HOST;
++		writel(sig, p->regs + USB2PHY_SIG);
++	}
++	dev_info(p->dev, "switched to %s mode\n", host ? "host" : "device");
++	return 0;
++}
++
++static const struct phy_ops apple_usb2phy_ops = {
++	.owner = THIS_MODULE,
++	.init = apple_usb2phy_init,
++	.exit = apple_usb2phy_exit,
++	.power_on = apple_usb2phy_power_on,
++	.power_off = apple_usb2phy_power_off,
++	.set_mode = apple_usb2phy_set_mode,
++};
++
++static int apple_usb2phy_probe(struct platform_device *pdev)
++{
++	struct device *dev = &pdev->dev;
++	struct phy_provider *provider;
++	struct apple_usb2phy *p;
++	const char *mode;
++
++	p = devm_kzalloc(dev, sizeof(*p), GFP_KERNEL);
++	if (!p)
++		return -ENOMEM;
++
++	p->dev = dev;
++	mutex_init(&p->lock);
++
++	p->regs = devm_platform_ioremap_resource(pdev, 0);
++	if (IS_ERR(p->regs))
++		return PTR_ERR(p->regs);
++
++	/* The bootloader leaves the PHY in device mode (m1n1's USB gadget). */
++	p->host = false;
++	if (!of_property_read_string(dev->of_node, "apple,default-mode", &mode)) {
++		if (!strcmp(mode, "host"))
++			p->host = true;
++		else if (strcmp(mode, "device"))
++			return dev_err_probe(dev, -EINVAL, "bad apple,default-mode \"%s\"\n",
++					     mode);
++	}
++
++	p->phy = devm_phy_create(dev, NULL, &apple_usb2phy_ops);
++	if (IS_ERR(p->phy))
++		return PTR_ERR(p->phy);
++	phy_set_drvdata(p->phy, p);
++
++	provider = devm_of_phy_provider_register(dev, of_phy_simple_xlate);
++	if (IS_ERR(provider))
++		return PTR_ERR(provider);
++
++	dev_info(dev, "USB2 PHY, default %s mode, USBCTL=%#x CTL=%#x SIG=%#x\n",
++		 p->host ? "host" : "device", readl(p->regs + USB2PHY_USBCTL),
++		 readl(p->regs + USB2PHY_CTL), readl(p->regs + USB2PHY_SIG));
++	return 0;
++}
++
++static const struct of_device_id apple_usb2phy_of_match[] = {
++	{ .compatible = "apple,t6050-usb2phy" },
++	{}
++};
++MODULE_DEVICE_TABLE(of, apple_usb2phy_of_match);
++
++static struct platform_driver apple_usb2phy_driver = {
++	.probe = apple_usb2phy_probe,
++	.driver = {
++		.name = "phy-apple-usb2",
++		.of_match_table = apple_usb2phy_of_match,
++	},
++};
++module_platform_driver(apple_usb2phy_driver);
++
++MODULE_DESCRIPTION("Apple Type-C port USB2-only PHY");
++MODULE_LICENSE("Dual MIT/GPL");
diff --git a/patches/linux/0018-usb-typec-build-tipd-for-sn201202x-only.patch b/patches/linux/0018-usb-typec-build-tipd-for-sn201202x-only.patch
new file mode 100644
index 0000000..60ab4c4
