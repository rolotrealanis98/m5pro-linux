{
  "manifest_version": 3,
  "name": "YouTube Mini Player (yt-pip)",
  "version": "1.1.0",
  "description": "Adds a mini player button and settings to YouTube's player; opens Chrome's picture-in-picture that the Omarchy yt-pip helper keeps across workspaces.",
  "key": "",
  "permissions": [
    "scripting",
    "activeTab",
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_title": "YouTube mini player (Alt+Shift+P)",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
