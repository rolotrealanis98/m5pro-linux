+  // G502 X over HID++ (g502.py talks to the LIGHTSPEED receiver directly).
+  readonly property string g502Path: Qt.resolvedUrl("g502.py").toString().replace(/^file:\/\//, "")
+  property var g502: ({ ok: false, error: "", present: false })
+  property var g502Pending: null
+  readonly property bool g502Ready: g502.ok === true && g502.present === true
+  readonly property var g502DpiPresets: [400, 800, 1600, 3200, 6400]
+  readonly property string g502BatteryText: g502.battery !== undefined && g502.battery !== null ? g502.battery + "%" : "—"
+  readonly property string g502StateText: !g502Ready ? "" : g502.charging ? "Charging" : g502.battery_full ? "Full" : g502.external_power ? "Plugged in" : "On battery"
+
+  function g502Run(args) {
+    if (g502Proc.running) { g502Pending = args; return }
+    g502Pending = null
+    g502Proc.command = ["python3", g502Path].concat(args)
+    g502Proc.running = true
+  }
+  function g502Refresh() { if (!g502Proc.running) g502Run(["--read"]) }
+  function g502SetDpi(v) {
+    var n = Math.round(Number(v))
+    if (!(n > 0)) return
+    var next = Object.assign({}, g502); next.dpi = n; g502 = next
+    g502Run(["--set-dpi", String(n)])
+  }
+  function g502SetRate(ms) {
+    var next = Object.assign({}, g502); next.rate_ms = Number(ms); g502 = next
+    g502Run(["--set-rate", String(ms)])
+  }
+  function g502SetOnboard(on) {
+    var next = Object.assign({}, g502); next.onboard = on; g502 = next
+    g502Run(["--onboard", on ? "on" : "off"])
+  }
+  function g502Snap(v) {
+    var step = g502.dpi_step || 50
+    var lo = g502.dpi_min || 100
+    return Math.round((v - lo) / step) * step + lo
+  }
+
