RATE = 48000
AMP_DEFAULT = -20.0
AMP_MIN = -40.0
AMP_MAX = -12.0  # hard ceiling for generated files; never exceeded
AMP_LEVELS = [-40.0, -38.0, -35.0, -32.0, -29.0, -26.0, -23.0, -20.0, -17.0, -14.0, -12.0]
FREQS = [60, 100, 150, 200, 300, 500, 1000, 2000, 5000, 10000]
DUR_CHOICES = [3, 6, 10, 20]
TONE_DUR = 3
PINK_DUR = 10
SWEEP_DUR = 20
SWEEP_F0, SWEEP_F1 = 40.0, 20000.0
VOL_STEPS = [0.10, 0.20, 0.30, 0.40, 0.55, 0.70, 0.85, 1.00]
GRAPH_DB_TABLE = {0.55: -35.0, 0.70: -26.5, 0.85: -18.0, 1.00: -10.0}  # LISTENING-TEST.md section 2
GRAPH_DB_MIN, GRAPH_DB_MAX = -65.0, -10.0  # capture.volumes in graph.json
POWER_LIMIT_W = 0.10
GAIN_LIMIT_DB = -0.05
STALE_S = 4.0
CARD = "AppleJ716"
SINK = "@DEFAULT_AUDIO_SINK@"
RATINGS = {1: "clean", 2: "quiet/faint", 3: "dull/thin", 4: "harsh", 5: "buzz/rattle/distortion"}
MUSIC_EXT = (".wav", ".flac", ".ogg", ".opus", ".mp3", ".m4a", ".aiff")

SPK_RE = re.compile(
    r"(?P<name>[A-Za-z][A-Za-z ]*?\s*\d*):\s+Coil\s+(?P<coil>-?\d+(?:\.\d+)?)\s*\S?C\b"
    r"(?:.*?Magnet\s+(?P<magnet>-?\d+(?:\.\d+)?))?"
    r".*?Power\s+(?P<power>-?\d+(?:\.\d+)?)\s*W"
    r"(?:\s+Gain\s+(?P<gain>-?\d+(?:\.\d+)?)\s*dB)?")
FAULT_RE = re.compile(r"tas2764.*fault", re.I)
DMESG_INFO_RE = re.compile(r"tas2764|spkr|macaudio|Speaker volume", re.I)
RESTART_RE = re.compile(r"^(Started|Starting|Stopping|Stopped)\b|Main process exited|Failed with result|"
                        r"Scheduled restart job|Max temperature|Config file")
CEILING_RE = re.compile(r"Speaker volume ceiling[^\d-]*(-?\d+(?:\.\d+)?)\s*dB")


# --------------------------------------------------------------------------- signals

def check_amp(amp_db):
    if not (AMP_MIN - 1e-9 <= amp_db <= AMP_MAX + 1e-9):
        raise ValueError("amplitude %.1f dBFS outside %.0f..%.0f" % (amp_db, AMP_MIN, AMP_MAX))


def peak_for(amp_db):
    return int(math.floor(10 ** (amp_db / 20.0) * 32767 + 1e-9))


def fmt_num(x):
    return ("%g" % x).replace(".", "p")


def _fade(mono, secs):
    n = len(mono)
    nf = min(int(secs * RATE), n // 2)
    for i in range(nf):
        g = math.sin(math.pi / 2 * i / nf)
        mono[i] = int(round(mono[i] * g))
        mono[n - 1 - i] = int(round(mono[n - 1 - i] * g))
    mono[n - 1] = 0
    return mono


def mono_sine(freq, amp_db, dur):
    if not 20 <= freq <= 20000:
        raise ValueError("frequency %s Hz outside 20..20000" % freq)
    a = peak_for(amp_db)
    w = 2 * math.pi * freq / RATE
    m = array.array("h", (int(round(a * math.sin(w * i))) for i in range(int(dur * RATE))))
    return _fade(m, 0.02)


def mono_sweep(amp_db, dur=SWEEP_DUR):
    a = peak_for(amp_db)
    k = SWEEP_F1 / SWEEP_F0
    lk = math.log(k)
    c = 2 * math.pi * SWEEP_F0 * dur / lk
    m = array.array("h", (int(round(a * math.sin(c * (math.exp(lk * (i / RATE) / dur) - 1))))
                          for i in range(int(dur * RATE))))
    return _fade(m, 0.05)


def pink_unit(cache_dir):
    """10 s of pink noise, peak = 32767, as int16. Paul Kellet's filter on seeded white noise,
    20 Hz one-pole high-pass, hard-clipped at 3 sigma (crest 9.5 dB), cached on disk."""
    n = PINK_DUR * RATE
    path = os.path.join(cache_dir, "pink-unit.s16")
    u = array.array("h")
    try:
        with open(path, "rb") as f:
            u.fromfile(f, n)
        if len(u) == n:
            if sys.byteorder == "big":
                u.byteswap()
            return u
    except (OSError, EOFError):
        pass
    rnd = random.Random(716)
    b0 = b1 = b2 = b3 = b4 = b5 = b6 = 0.0
    hp_a = math.exp(-2 * math.pi * 20 / RATE)
    px = py = 0.0
    x = []
    for i in range(n + 4000):
        w = rnd.uniform(-1.0, 1.0)
        b0 = 0.99886 * b0 + w * 0.0555179
        b1 = 0.99332 * b1 + w * 0.0750759
        b2 = 0.96900 * b2 + w * 0.1538520
        b3 = 0.86650 * b3 + w * 0.3104856
        b4 = 0.55000 * b4 + w * 0.5329522
        b5 = -0.7616 * b5 - w * 0.0168980
        p = b0 + b1 + b2 + b3 + b4 + b5 + b6 + w * 0.5362
        b6 = w * 0.115926
        y = hp_a * (py + p - px)
        px, py = p, y
        if i >= 4000:
            x.append(y)
    sigma = math.sqrt(sum(v * v for v in x) / len(x))
    lim = 3 * sigma
    x = [max(-lim, min(lim, v)) for v in x]
    peak = max(abs(v) for v in x)
    u = array.array("h", (int(round(v / peak * 32767)) for v in x))
    os.makedirs(cache_dir, exist_ok=True)
    out = array.array("h", u)
    if sys.byteorder == "big":
        out.byteswap()
    tmp = path + ".tmp"
    with open(tmp, "wb") as f:
        out.tofile(f)
    os.replace(tmp, path)
    return u


def mono_pink(amp_db, cache_dir):
    a = peak_for(amp_db) / 32767.0
    m = array.array("h", (int(round(v * a)) for v in pink_unit(cache_dir)))
    return _fade(m, 0.05)


def write_wav(path, mono, ch):
    n = len(mono)
    st = array.array("h", [0]) * (2 * n)
    if ch in ("L", "C"):
        st[0::2] = mono
    if ch in ("R", "C"):
        st[1::2] = mono
    if sys.byteorder == "big":
        st.byteswap()
    tmp = path + ".tmp"
    with wave.open(tmp, "wb") as w:
        w.setnchannels(2)
        w.setsampwidth(2)
        w.setframerate(RATE)
        w.writeframes(st.tobytes())
    os.replace(tmp, path)


def signal_name(kind, freq, ch, amp_db, dur):
    base = {"sine": "sine%s" % fmt_num(freq), "pink": "pink", "sweep": "sweep"}[kind]
    return "%s_%s_m%d_%ds.wav" % (base, ch, int(round(-amp_db)), dur)


def signal_label(kind, freq, dur):
    if kind == "sine":
        return "sine %g Hz" % freq
    if kind == "pink":
        return "pink noise"
    return "sweep %g-%g Hz %d s" % (SWEEP_F0, SWEEP_F1, SWEEP_DUR)


def ensure_signal(base_dir, kind, freq, ch, amp_db, dur):
    """Return the path of the WAV for this signal, generating it if missing or invalid."""
    check_amp(amp_db)
    if ch not in ("L", "R", "C"):
        raise ValueError("channel must be L, R or C")
    if kind == "pink":
        dur = PINK_DUR
    elif kind == "sweep":
        dur = SWEEP_DUR
    path = os.path.join(base_dir, signal_name(kind, freq, ch, amp_db, dur))
    try:
        with wave.open(path, "rb") as w:
            if (w.getnchannels(), w.getsampwidth(), w.getframerate(), w.getnframes()) == (2, 2, RATE, dur * RATE):
                return path
    except (OSError, EOFError, wave.Error):
        pass
    os.makedirs(base_dir, exist_ok=True)
    if kind == "sine":
        mono = mono_sine(freq, amp_db, dur)
    elif kind == "pink":
        mono = mono_pink(amp_db, os.path.join(base_dir, ".cache"))
    else:
        mono = mono_sweep(amp_db, dur)
    write_wav(path, mono, ch)
    return path


# --------------------------------------------------------------------------- volume

def graph_db(v):
    for k, d in GRAPH_DB_TABLE.items():
        if abs(v - k) < 0.005:
            return d
    return max(GRAPH_DB_MIN, min(GRAPH_DB_MAX, GRAPH_DB_MIN + (GRAPH_DB_MAX - GRAPH_DB_MIN) * v))


def step_volume(v, direction):
    if direction > 0:
        up = [s for s in VOL_STEPS if s > v + 0.005]
        return up[0] if up else VOL_STEPS[-1]
    down = [s for s in VOL_STEPS if s < v - 0.005]
    return down[-1] if down else VOL_STEPS[0]


def step_amp(a, direction):
    if direction > 0:
        up = [s for s in AMP_LEVELS if s > a + 0.01]
        return up[0] if up else AMP_MAX
    down = [s for s in AMP_LEVELS if s < a - 0.01]
    return down[-1] if down else AMP_MIN


def classify_sink(name, desc):
    s = ("%s %s" % (name or "", desc or "")).lower()
    if "bringup" in s or "bring-up" in s:
        return "bringup"
    if "j716-convolver" in s or (desc or "") == "MacBook Pro J716 Speakers":
        return "profile"
    return "other"


# --------------------------------------------------------------------------- safety

class Safety:
    """Parses speakersafetyd (journal) and kernel (dmesg) lines, applies the stop rules."""

    def __init__(self, on_trip=None):
        self.lock = threading.RLock()
        self.on_trip = on_trip
        self.speakers = {}
        self.tripped = False
        self.reasons = []
        self.play_active = False
        self.play_max = 0.0
        self.session_max = 0.0
        self.last_speaker_t = None
        self.faults_new = 0
        self.other = collections.deque(maxlen=6)
        self.journal_lines = 0
        self.dmesg_lines = 0
        self.suppressed = 0

    def trip(self, reason):
        with self.lock:
            first = not self.tripped
            self.tripped = True
            if reason not in self.reasons:
                self.reasons.append(reason)
        if first and self.on_trip:
            self.on_trip(reason)

    def reset(self):
        with self.lock:
            self.tripped = False
            self.reasons = []
            self.last_speaker_t = None  # telemetry must come back before the next play
            for s in self.speakers.values():
                s["play_max"] = 0.0

    def begin_play(self):
        with self.lock:
            self.play_active = True
            self.play_t0 = time.time()
            self.play_max = 0.0
            for s in self.speakers.values():
                s["play_max"] = 0.0

    def end_play(self):
        with self.lock:
            self.play_active = False
            return self.play_max

    def telemetry_age(self, now=None):
        with self.lock:
            if self.last_speaker_t is None:
                return None
            return (now or time.time()) - self.last_speaker_t

    def check_stale(self, now=None):
        # The daemon prints per-speaker lines only while a stream is active (one set every 85 ms),
        # so staleness is judged only during play, after a short grace for the first lines.
        if self.play_active and (now or time.time()) - getattr(self, "play_t0", 0.0) > 3.0:
            age = self.telemetry_age(now)
            if age is None or age > STALE_S:
                self.trip("speakersafetyd telemetry lost (no speaker line for %.0f s)" % (STALE_S if age is None else age))

    def feed_journal(self, line, now=None):
        line = line.rstrip("\n")
        if not line.strip():
            return
        now = now or time.time()
        low = line.lower()
        with self.lock:
            self.journal_lines += 1
        if "panic" in low:
            self.trip("speakersafetyd panic: " + line.strip()[:80])
        if "gain limited" in low:
            self.trip("speakersafetyd: gain limited")
        m = SPK_RE.search(line)
        if m:
            name = " ".join(m.group("name").split())
            power = float(m.group("power"))
            gain = float(m.group("gain")) if m.group("gain") is not None else None
            with self.lock:
                s = self.speakers.setdefault(name, {"play_max": 0.0, "all_max": 0.0})
                s.update(coil=float(m.group("coil")), power=power, gain=gain, t=now,
                         magnet=float(m.group("magnet")) if m.group("magnet") else None)
                self.last_speaker_t = now
                s["all_max"] = max(s["all_max"], power)
                self.session_max = max(self.session_max, power)
                if self.play_active:
                    s["play_max"] = max(s["play_max"], power)
                    self.play_max = max(self.play_max, power)
            if power > POWER_LIMIT_W:
                self.trip("%s: %.3f W is above %.2f W" % (name, power, POWER_LIMIT_W))
            if power < 0:
                self.trip("%s: negative power %.3f W" % (name, power))
            if gain is not None and gain < GAIN_LIMIT_DB:
                self.trip("%s: gain limited (%.2f dB)" % (name, gain))
            return
        if RESTART_RE.search(line.strip()):
            self.trip("speakersafetyd restarted/stopped: " + line.strip()[:80])
        elif "suppressed" in low:
            with self.lock:
                self.suppressed += 1
        with self.lock:
            self.other.append("journal: " + line.strip()[:100])

    def feed_dmesg(self, line):
        line = line.rstrip("\n")
        with self.lock:
            self.dmesg_lines += 1
        if FAULT_RE.search(line):
            with self.lock:
                self.faults_new += 1
                self.other.append("dmesg: " + line.strip()[:100])
            self.trip("amp fault: " + line.strip()[:90])
        elif DMESG_INFO_RE.search(line):
            with self.lock:
                self.other.append("dmesg: " + line.strip()[:100])


# --------------------------------------------------------------------------- system backends

def run(cmd, timeout=4):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, errors="replace",
                           stdin=subprocess.DEVNULL)
    except FileNotFoundError:
        return None
    except subprocess.TimeoutExpired:
        return (124, "", "timeout")
    except OSError as e:
        return (126, "", str(e))
    return (p.returncode, p.stdout, p.stderr)


class Stream(threading.Thread):
    """Follows a command's output line by line into a callback."""

    def __init__(self, cmd, callback, name):
        super().__init__(daemon=True, name=name)
        self.cmd = cmd
        self.callback = callback
        self.proc = None
        self.error = None
        self.alive = False
        self.stopping = False
        self.lines = 0
        self.last = None

    def run(self):
        try:
            self.proc = subprocess.Popen(self.cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                         stdin=subprocess.DEVNULL, text=True, errors="replace", bufsize=1)
        except OSError as e:
            self.error = "cannot start %s: %s" % (self.cmd[0], e)
            return
        self.alive = True
        for line in self.proc.stdout:
            self.lines += 1
            self.last = time.time()
            try:
                self.callback(line)
            except Exception as e:  # never let a parse bug kill the watcher
                self.error = "callback: %r" % (e,)
        self.alive = False
        rc = self.proc.wait()
        if not self.stopping:
            self.error = "%s exited rc=%s" % (self.name, rc)

    def stop(self):
        self.stopping = True
        if self.proc and self.proc.poll() is None:
            try:
                self.proc.terminate()
            except OSError:
                pass


class RealPlayer:
    def __init__(self, path):
        self.path = path
        self.t0 = time.time()
        self.killed = False
        self.err = ""
        self.proc = subprocess.Popen(["pw-play", path], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                     stderr=subprocess.PIPE, text=True, start_new_session=True)
        with wave.open(path, "rb") as w:
            self.length = w.getnframes() / float(w.getframerate())

    def running(self):
        return self.proc.poll() is None

    def returncode(self):
        return self.proc.returncode

    def elapsed(self):
        return time.time() - self.t0

    def kill(self):
        self.killed = True
        if self.proc.poll() is None:
            try:
                self.proc.kill()
            except OSError:
                pass

    def stop(self):
        self.killed = True
        if self.proc.poll() is None:
            try:
                self.proc.terminate()
                self.proc.wait(0.6)
            except (OSError, subprocess.TimeoutExpired):
                self.kill()
        self.collect()

    def collect(self):
        try:
            self.err = (self.proc.stderr.read() or "").strip()
        except (OSError, ValueError):
            pass


class RealSys:
    fake = False

    def __init__(self):
        self.journal_sudo = False
        self.dmesg_sudo = False
        self.streams = []

    # --- tools
    def have(self, tool):
        return shutil.which(tool) is not None

    def sink_info(self):
        r = run(["wpctl", "inspect", SINK])
        if not r or r[0] != 0:
            return None
        name = re.search(r'node\.name = "([^"]*)"', r[1])
        desc = re.search(r'node\.description = "([^"]*)"', r[1])
        name = name.group(1) if name else None
        desc = desc.group(1) if desc else None
        return {"name": name, "desc": desc, "kind": classify_sink(name, desc)}

    def get_volume(self):
        r = run(["wpctl", "get-volume", SINK])
        if not r or r[0] != 0:
            return None
        m = re.search(r"Volume:\s*([0-9.]+)", r[1])
        if not m:
            return None
        return float(m.group(1)), "MUTED" in r[1]

    def set_volume(self, v):
        r = run(["wpctl", "set-volume", SINK, "%.2f" % v])
        return bool(r) and r[0] == 0

    def set_mute(self, on):
        r = run(["wpctl", "set-mute", SINK, "1" if on else "0"])
        return bool(r) and r[0] == 0

    def speaker_switch(self):
        r = run(["amixer", "-c", CARD, "cget", "name=Speaker Switch"])
        if not r or r[0] != 0:
            return None
        m = re.search(r"values=(on|off)", r[1])
        return m.group(1) if m else None

    def amixer_set(self, on):
        """Plain amixer first (desktop ACL), then sudo -n. Returns (ok, needs_interactive_sudo)."""
        cmd = ["amixer", "-c", CARD, "cset", "name=Speaker Switch", "on" if on else "off"]
        r = run(cmd)
        if r and r[0] == 0:
            return True, False
        r = run(["sudo", "-n"] + cmd)
        if r and r[0] == 0:
            return True, False
        return False, True

    def amixer_cmd(self, on):
        return ["sudo", "amixer", "-c", CARD, "cset", "name=Speaker Switch", "on" if on else "off"]

    def play(self, path, meta):
        return RealPlayer(path)

    def dmesg_text(self):
        r = run(["dmesg"], timeout=6)
        if r and r[0] == 0:
            return r[1], False
        r2 = run(["sudo", "-n", "dmesg"], timeout=6)
        if r2 and r2[0] == 0:
            return r2[1], True
        return None, False

    def journal_probe(self):
        """(readable, via_sudo, lines)"""
        cmd = ["journalctl", "-u", "speakersafetyd", "-o", "cat", "-n", "20", "--no-pager"]
        for sudo in (False, True):
            r = run((["sudo", "-n"] if sudo else []) + cmd, timeout=6)
            if not r:
                return False, False, []
            blob = r[1] + r[2]
            if r[0] == 0 and "insufficient permissions" not in blob and "not seeing messages" not in blob:
                return True, sudo, [l for l in r[1].splitlines() if l.strip() and not l.startswith("--")]
        return False, False, []

    def service_state(self):
        r = run(["systemctl", "is-active", "speakersafetyd"])
        state = r[1].strip() if r else "unknown"
        e = run(["systemctl", "show", "-p", "ExecStart", "--value", "speakersafetyd"])
        verbose = None
        if e and e[0] == 0 and e[1].strip():
            verbose = bool(re.search(r"argv\[\]=[^;]*\s-v(\s|;|$)", e[1]) or re.search(r"\s-v\b", e[1]))
        return state, verbose

    def prepare_access(self, interactive):
        notes = []
        ok, self.journal_sudo, _ = self.journal_probe()
        text, self.dmesg_sudo = self.dmesg_text()
        need = (not ok) or text is None or self.journal_sudo or self.dmesg_sudo
        if need and interactive and self.have("sudo"):
            print("j716-listen: reading dmesg / the speakersafetyd journal needs root here; running `sudo -v`.")
            subprocess.call(["sudo", "-v"])
            ok, self.journal_sudo, _ = self.journal_probe()
            text, self.dmesg_sudo = self.dmesg_text()
        if not ok:
            notes.append("speakersafetyd journal NOT readable (even with sudo)")
        if text is None:
            notes.append("dmesg NOT readable (even with sudo)")
        return notes

    def start_streams(self, safety):
        pre = ["sudo", "-n"] if self.journal_sudo else []
        j = Stream(pre + ["journalctl", "-u", "speakersafetyd", "-o", "cat", "-f", "-n", "0", "--no-pager"],
                   safety.feed_journal, "journal")
        pre = ["sudo", "-n"] if self.dmesg_sudo else []
        d = Stream(pre + ["dmesg", "-W"], safety.feed_dmesg, "dmesg")
        self.journal, self.dmesg = j, d
        for s in (j, d):
            s.start()
            self.streams.append(s)

    def stream_status(self):
        out = {}
        for key in ("journal", "dmesg"):
            s = getattr(self, key, None)
            if s is None:
                out[key] = (False, "not started")
            elif s.alive:
                out[key] = (True, "ok")
            else:
                out[key] = (False, s.error or "starting")
        return out

    def close(self):
        for s in self.streams:
            s.stop()


class FakePlayer:
    def __init__(self, path, meta, sysobj):
        self.path = path
        self.meta = meta
        self.t0 = time.time()
        self.killed = False
        self.err = ""
        with wave.open(path, "rb") as w:
            self.length = w.getnframes() / float(w.getframerate())
        self.sys = sysobj
        sysobj.player = self

    def running(self):
        return not self.killed and time.time() - self.t0 < self.length

    def returncode(self):
        return 0

    def elapsed(self):
        return time.time() - self.t0

    def kill(self):
        self.killed = True

    stop = kill


class FakeSys:
    """Simulator: plays nothing, emits plausible speakersafetyd/dmesg lines."""
    fake = True
    NAMES = ["Left Woofer 1", "Right Woofer 1", "Left Woofer 2", "Right Woofer 2", "Left Tweeter", "Right Tweeter"]

    def __init__(self):
        self.vol = 0.70
        self.muted = False
        self.kind = "profile"
        self.switch = "on"
        self.player = None
        self.safety = None
        self.stop_evt = threading.Event()
        self.coil = {n: 25.0 for n in self.NAMES}
        self.trip_mode = os.environ.get("J716_LISTEN_FAKE_TRIP", "")
        self.trip_after = float(os.environ.get("J716_LISTEN_FAKE_TRIP_AFTER", "2"))
        self.tripped_once = False
        self.thread = None

    def have(self, tool):
        return True

    def sink_info(self):
        if self.kind == "profile":
            return {"name": "audio_effect.j716-convolver", "desc": "MacBook Pro J716 Speakers", "kind": "profile"}
        return {"name": "audio_effect.j716-bringup", "desc": "MacBook Pro J716 Speakers (bring-up)", "kind": "bringup"}

    def get_volume(self):
        return self.vol, self.muted

    def set_volume(self, v):
        self.vol = v
        return True

    def set_mute(self, on):
        self.muted = on
        return True

    def speaker_switch(self):
        return self.switch

    def amixer_set(self, on):
        self.switch = "on" if on else "off"
        return True, False

    def amixer_cmd(self, on):
        return ["true"]

    def play(self, path, meta):
        return FakePlayer(path, meta, self)

    def dmesg_text(self):
        return ("[    1.0] macaudio: Speaker volume ceiling -30 dB\n[    1.1] macaudio: Speaker volumes unlocked\n", False)

    def journal_probe(self):
        return True, False, ["Left Woofer 1: Coil 25.00 °C Magnet 25.00 °C Power 0.00 W Gain 0.00 dB"]

    def service_state(self):
        return "active", True

    def prepare_access(self, interactive):
        return []

    def ab_switch(self, target):
        self.kind = target

    def start_streams(self, safety):
        self.safety = safety
        self.thread = threading.Thread(target=self._loop, daemon=True)
        self.thread.start()

    def stream_status(self):
        return {"journal": (True, "ok (fake)"), "dmesg": (True, "ok (fake)")}

    def _power(self, name):
        p = self.player
        if not p or not p.running() or self.muted or self.switch == "off":
            return 0.0
        meta = p.meta
        side = meta.get("ch", "C")
        if (side == "L" and name.startswith("Right")) or (side == "R" and name.startswith("Left")):
            return 0.0
        amp = meta.get("amp", -20.0)
        w = 1.0 if "Woofer" in name else 0.5
        return 0.04 * (self.vol ** 3) * (10 ** ((amp + 20) / 10.0)) * w

    def _loop(self):
        t_inject = None
        while not self.stop_evt.wait(0.085):
            playing = self.player is not None and self.player.running()
            if playing and t_inject is None:
                t_inject = time.time()
            if not playing:
                t_inject = None
            for n in self.NAMES:
                p = self._power(n)
                self.coil[n] += (0.0 + p * 40.0) * 0.002 - (self.coil[n] - 25.0) * 0.0005
                gain = 0.0
                if (self.trip_mode == "power" and t_inject and time.time() - t_inject > self.trip_after
                        and not self.tripped_once and n == "Left Woofer 1"):
                    p = 0.25
                    self.tripped_once = True
                if self.trip_mode == "gain" and t_inject and time.time() - t_inject > self.trip_after and n == "Left Tweeter":
                    gain = -1.5
                if self.trip_mode == "stale" and t_inject and time.time() - t_inject > self.trip_after:
                    continue
                self.safety.feed_journal("%s: Coil %.2f °C Magnet %.2f °C Power %.2f W Gain %.2f dB"
                                         % (n, self.coil[n], 25.0 + (self.coil[n] - 25.0) * 0.3, p, gain))
            if t_inject and time.time() - t_inject > self.trip_after and not self.tripped_once:
                if self.trip_mode == "fault":
                    self.tripped_once = True
                    self.safety.feed_dmesg("[  99.0] tas2764 0-0038: fault 0x08 (over temperature)")
                elif self.trip_mode == "restart":
                    self.tripped_once = True
                    self.safety.feed_journal("Started Speaker Safety Daemon.")

    def close(self):
        self.stop_evt.set()


