RESULT_HEADER = ("| time | graph | wpctl vol | graph dB | signal | amp dBFS | ch | played s | rating | note | max W |\n"
                 "|---|---|---|---|---|---|---|---|---|---|---|\n")


def md(s):
    return str(s).replace("|", "/").replace("\n", " ").strip()


def append_result(path, rec):
    new = not os.path.exists(path) or os.path.getsize(path) == 0
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a", encoding="utf-8") as f:
        if new:
            f.write("# J716 listening results\n\nRating: 1 clean, 2 quiet/faint, 3 dull/thin, 4 harsh, "
                    "5 buzz/rattle/distortion. Max W is the highest speakersafetyd power reading during the play "
                    "(stop at 0.10 W).\n\n" + RESULT_HEADER)
        elif not _ends_with_table(path):
            f.write("\n" + RESULT_HEADER)
        r = rec
        rating = "%d %s" % (r["rating"], RATINGS[r["rating"]]) if r.get("rating") else "-"
        f.write("| %s | %s | %s | %s | %s | %s | %s | %s | %s | %s | %s |\n" % (
            md(r["time"]), md(r["graph"]), md(r["vol"]), md(r["gdb"]), md(r["signal"]), md(r["amp"]), md(r["ch"]),
            md(r["played"]), md(rating), md(r.get("note", "")), md(r["maxw"])))


def _ends_with_table(path):
    try:
        with open(path, "rb") as f:
            f.seek(max(0, os.path.getsize(path) - 400))
            tail = f.read().decode("utf-8", "replace").strip().splitlines()
        return bool(tail) and tail[-1].startswith("|")
    except OSError:
        return False


