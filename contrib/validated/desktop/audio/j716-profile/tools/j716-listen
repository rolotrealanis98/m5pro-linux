class App:
    def __init__(self, sysobj, base_dir, allow_blind=False):
        self.sys = sysobj
        self.dir = base_dir
        self.music_dir = os.path.join(base_dir, "music")
        self.results = os.path.join(base_dir, "results.md")
        self.allow_blind = allow_blind
        self.safety = Safety(on_trip=self.on_trip)
        self.kind = "sine"
        self.fi = FREQS.index(1000)
        self.freq = 1000.0
        self.ch = "C"
        self.amp = AMP_DEFAULT
        self.dur = TONE_DUR
        self.music = []
        self.mi = 0
        self.player = None
        self.cur = None
        self.pending = None
        self.msg = ""
        self.help = False
        self.scr = None
        self.info = {"sink": None, "vol": None, "switch": None}
        self.info_lock = threading.Lock()
        self.stop_poll = threading.Event()
        self.tripped_handled = False
        self.muted_by_trip = False
        self.ceiling = None
        self.ceiling_line = "(not read)"
        self.unlocked_line = ""
        self.faults_history = 0
        self.access_notes = []
        self.scan_music()

    # --- state helpers
    def scan_music(self):
        try:
            self.music = sorted(f for f in os.listdir(self.music_dir) if f.lower().endswith(MUSIC_EXT))
        except OSError:
            self.music = []
        self.mi = min(self.mi, max(0, len(self.music) - 1))

    def read_kernel(self):
        text, _ = self.sys.dmesg_text()
        if text is None:
            self.ceiling_line = "dmesg not readable"
            return
        c = [l for l in text.splitlines() if "Speaker volume ceiling" in l]
        u = [l for l in text.splitlines() if "Speaker volumes unlocked" in l or "Speaker volumes locked" in l]
        self.ceiling_line = c[-1].strip() if c else "no 'Speaker volume ceiling' line in dmesg"
        self.unlocked_line = u[-1].strip() if u else ""
        m = CEILING_RE.search(self.ceiling_line)
        self.ceiling = float(m.group(1)) if m else None
        self.faults_history = sum(1 for l in text.splitlines() if FAULT_RE.search(l))

    def poll_loop(self):
        while not self.stop_poll.is_set():
            self.refresh_info()
            self.stop_poll.wait(1.0)

    def refresh_info(self):
        sink = self.sys.sink_info()
        vol = self.sys.get_volume()
        sw = self.sys.speaker_switch()
        with self.info_lock:
            self.info = {"sink": sink, "vol": vol, "switch": sw}

    def get_info(self):
        with self.info_lock:
            return dict(self.info)

    def graph_kind(self):
        s = self.get_info()["sink"]
        return s["kind"] if s else "unknown"

    def volume(self):
        v = self.get_info()["vol"]
        return v[0] if v else None

    # --- trip
    def on_trip(self, reason):
        p = self.player
        if p:
            p.kill()
        info = self.get_info()
        if not (info["vol"] and info["vol"][1]):
            if self.sys.set_mute(True):
                self.muted_by_trip = True

    def handle_trip(self):
        if self.safety.tripped and not self.tripped_handled:
            self.tripped_handled = True
            reason = "; ".join(self.safety.reasons)
            note = "AUTO-STOP: " + reason
            if self.player or self.cur:
                self.finish_play(note=note)
            elif self.pending:
                self.pending["note"] = (self.pending["note"] + "; " + note).strip("; ")
            self.commit_pending()
            self.msg = "STOP: " + reason

    # --- play
    def cannot_play(self):
        if self.safety.tripped:
            return "STOP active: fix the cause, then press x (see banner)"
        if not self.allow_blind:
            st = self.sys.stream_status()
            for k in ("journal", "dmesg"):
                if not st[k][0]:
                    return "%s monitor not running (%s); stop rules blind. Restart with sudo access" % (k, st[k][1])
            # Idle speakersafetyd prints nothing; it reports per speaker only while a stream runs.
            # Require the daemon active and verbose here; the lines are checked once play starts.
            state, verbose = self.sys.service_state()
            if state != "active":
                return "speakersafetyd is %s: not playing" % state
            if verbose is False:
                return "speakersafetyd is not verbose (-v): run it verbose (LISTENING-TEST.md section 0)"
        if self.ceiling is not None and self.ceiling > -30.0 + 1e-6:
            return "kernel ceiling is %g dB, not -30 dB: not playing" % self.ceiling
        v = self.volume()
        if v is not None and v > 1.0 + 1e-6:
            return "wpctl volume %.2f is above 1.00: step it down with -" % v
        if not self.sys.have("pw-play"):
            return "pw-play not found"
        return None

    def current_label(self):
        if self.kind == "music":
            return "music: " + (self.music[self.mi] if self.music else "(none)")
        return signal_label(self.kind, self.freq, self.dur)

    def prepare(self):
        if self.kind == "music":
            if not self.music:
                raise ValueError("no music files in %s" % self.music_dir)
            return os.path.join(self.music_dir, self.music[self.mi]), {"ch": "C", "amp": -20.0}
        path = ensure_signal(self.dir, self.kind, self.freq, self.ch, self.amp, self.dur)
        return path, {"ch": self.ch, "amp": self.amp}

    def play_current(self):
        self.stop_play()
        self.commit_pending()
        why = self.cannot_play()
        if why:
            self.msg = "cannot play: " + why
            return
        self.msg = "preparing %s ..." % self.current_label()
        self.draw()
        try:
            path, meta = self.prepare()
            player = self.sys.play(path, meta)
        except (OSError, ValueError, wave.Error) as e:
            self.msg = "cannot play: %s" % e
            return
        info = self.get_info()
        v = self.volume()
        self.player = player
        self.cur = {
            "time": datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "graph": self.graph_kind(),
            "vol": ("%.2f" % v) if v is not None else "?",
            "gdb": ("%.1f" % graph_db(v)) if v is not None else "?",
            "signal": self.current_label(),
            "amp": ("%g" % self.amp) if self.kind != "music" else "file",
            "ch": self.ch if self.kind != "music" else "file",
            "t0": time.time(), "rating": None, "note": "",
        }
        if info["vol"] and info["vol"][1]:
            self.cur["note"] = "sink muted"
        self.safety.begin_play()
        self.msg = "playing %s" % self.current_label()

    def finish_play(self, note=""):
        if not self.player and not self.cur:
            return
        p = self.player
        if p:
            p.stop() if not p.killed else None
            if hasattr(p, "collect"):
                p.collect()
        maxw = self.safety.end_play()
        if self.cur:
            self.cur["played"] = "%.1f" % min(time.time() - self.cur["t0"], p.length if p else 1e9)
            self.cur["maxw"] = "%.3f" % maxw
            if note:
                self.cur["note"] = (self.cur["note"] + "; " + note).strip("; ")
            if p and p.err:
                self.cur["note"] = (self.cur["note"] + "; pw-play: " + p.err[:80]).strip("; ")
            self.pending = self.cur
        self.player = None
        self.cur = None

    def stop_play(self):
        if self.player:
            self.finish_play()

    def commit_pending(self):
        if self.cur and not self.player:
            self.pending = self.cur
            self.cur = None
        if self.pending:
            rec = self.pending
            rec.setdefault("played", "0.0")
            rec.setdefault("maxw", "%.3f" % self.safety.play_max)
            try:
                append_result(self.results, rec)
            except OSError as e:
                self.msg = "cannot write results.md: %s" % e
                return
            self.pending = None

    def tick(self):
        self.safety.check_stale()
        self.handle_trip()
        if self.player and not self.player.running():
            rc = self.player.returncode()
            killed = self.player.killed
            self.finish_play()
            if rc not in (0, None) and not killed:
                self.msg = "pw-play failed (rc %s)" % rc
            elif not killed:
                self.msg = "finished; rate it 1-5, n for a note"

    # --- drawing
    def attrs(self):
        self.A = {"ok": curses.color_pair(1), "warn": curses.color_pair(2) | curses.A_BOLD,
                  "bad": curses.color_pair(3) | curses.A_BOLD, "info": curses.color_pair(4),
                  "banner": curses.color_pair(5) | curses.A_BOLD, "dim": curses.A_DIM, "bold": curses.A_BOLD,
                  "": 0}

    def put(self, y, text, attr=""):
        h, w = self.scr.getmaxyx()
        if y >= h - 1:
            return
        try:
            self.scr.addnstr(y, 0, text.ljust(w - 1), w - 1, self.A[attr] if isinstance(attr, str) else attr)
        except curses.error:
            pass

    def draw(self, prompt=None):
        scr = self.scr
        scr.erase()
        h, w = scr.getmaxyx()
        if h < 24 or w < 70:
            scr.addnstr(0, 0, "terminal too small (%dx%d), need 70x24" % (w, h), w - 1)
            scr.refresh()
            return
        y = 0
        sf = self.safety
        with sf.lock:
            tripped, reasons = sf.tripped, list(sf.reasons)
            spk = {k: dict(v) for k, v in sf.speakers.items()}
            other = list(sf.other)
            age = sf.telemetry_age()
            play_max, sess_max = sf.play_max, sf.session_max
            faults_new = sf.faults_new
        if tripped:
            for i, row in enumerate(BANNER):
                self.put(y, ("   " + row) + "   STOP  STOP  STOP", "banner")
                y += 1
            self.put(y, " " + "; ".join(reasons)[:w - 3], "banner")
            y += 1
            self.put(y, " playback killed, sink muted.  o = Speaker Switch OFF (amixer/sudo)   x = acknowledge/reset   "
                        "q = quit", "banner")
            y += 2
        info = self.get_info()
        sink, vol, sw = info["sink"], info["vol"], info["switch"]
        self.put(y, " J716 listen   %s" % time.strftime("%H:%M:%S") + ("   [FAKE BACKEND]" if self.sys.fake else ""), "bold")
        y += 1
        if sink:
            kind = sink["kind"]
            tag = {"profile": "PROFILE", "bringup": "BRING-UP", "other": "OTHER SINK (not a J716 sink!)"}[kind]
            self.put(y, " sink:   %s   [%s]   (%s)" % (sink["desc"], tag, sink["name"]),
                     "ok" if kind in ("profile", "bringup") else "bad")
        else:
            self.put(y, " sink:   unknown (wpctl missing or no default sink)", "warn")
        y += 1
        if vol:
            v, muted = vol
            col = "bad" if v > 1.0 else "ok"
            self.put(y, " volume: wpctl %.2f   graph %s dB%s%s   steps: %s" % (
                v, ("%.1f" % graph_db(v)) if v <= 1.0 else "?", "  MUTED" if muted else "",
                "  ABOVE 1.00!" if v > 1.0 else "", " ".join("%.2f" % s for s in VOL_STEPS if s >= 0.55)),
                "bad" if (muted or v > 1.0) else col)
        else:
            self.put(y, " volume: unknown", "warn")
        y += 1
        sw_attr = "ok" if sw == "on" else ("bad" if sw == "off" else "warn")
        self.put(y, " signal: %s    amp %g dBFS    ch %s    tone dur %d s    speaker switch: %s" % (
            self.current_label(), self.amp, self.ch, self.dur, sw or "?"), "bold")
        y += 1
        if self.player:
            self.put(y, " play:   PLAYING %.1f / %.1f s" % (self.player.elapsed(), self.player.length), "warn")
        else:
            self.put(y, " play:   stopped", "dim")
        y += 1
        rec = self.cur or self.pending
        if rec:
            self.put(y, " result: %s | rating %s | note: %s   %s" % (
                rec["signal"], ("%d %s" % (rec["rating"], RATINGS[rec["rating"]])) if rec["rating"] else "-",
                rec["note"] or "-", "" if self.cur else "(saved at next play / Enter / q)"), "info")
        else:
            self.put(y, " result: -   (rate with 1-5 after a play; results: %s)" % self.results, "dim")
        y += 2
        self.put(y, " speakersafetyd   telemetry age %s   max this play %.3f W   session max %.3f W   stop above %.2f W" % (
            "%.1fs" % age if age is not None else "none", play_max, sess_max, POWER_LIMIT_W), "bold")
        y += 1
        order = sorted(spk, key=lambda n: (("Tweeter" in n), n))
        if not order:
            self.put(y, "   no speaker lines yet (daemon verbose? -v)", "warn")
            y += 1
        for n in order:
            s = spk[n]
            stale = time.time() - s["t"] > STALE_S
            p = s["power"]
            attr = "bad" if (p > POWER_LIMIT_W or p < 0) else ("warn" if p > 0.05 else "ok")
            if stale:
                attr = "dim"
            self.put(y, "   %-15s coil %6.1f C   power %6.3f W   gain %s   max play %.3f W%s" % (
                n, s["coil"], p, ("%5.2f dB" % s["gain"]) if s["gain"] is not None else "   ?   ", s["play_max"],
                "   (stale)" if stale else ""), attr)
            y += 1
        y += 1
        st = self.sys.stream_status()
        self.put(y, " kernel:  %s%s" % (self.ceiling_line, ("   | " + self.unlocked_line) if self.unlocked_line else ""),
                 "bad" if (self.ceiling is not None and self.ceiling > -30.0) else ("warn" if self.ceiling is None else "ok"))
        y += 1
        self.put(y, " dmesg:   %s   new tas2764 fault lines: %d (history at start: %d)" % (
            "watching" if st["dmesg"][0] else "NOT WATCHING: " + st["dmesg"][1], faults_new, self.faults_history),
            "bad" if (faults_new or not st["dmesg"][0]) else ("warn" if self.faults_history else "ok"))
        y += 1
        self.put(y, " journal: %s" % ("watching speakersafetyd" if st["journal"][0] else "NOT WATCHING: " + st["journal"][1]),
                 "ok" if st["journal"][0] else "bad")
        y += 1
        for l in other[-3:]:
            self.put(y, "   " + l, "dim")
            y += 1
        for n in self.access_notes:
            self.put(y, " ! " + n, "bad")
            y += 1
        y += 1
        self.put(y, " " + self.msg, "warn" if self.msg.startswith(("cannot", "STOP")) else "info")
        y += 2
        if self.help:
            lines = [
                " space play/stop   arrows left/right: tone frequency   f: type a frequency   t: sine   d: tone length",
                " p pink   s sweep   l / r / c: left / right / centre   m play music   M next music file",
                " a / z amplitude +3/-3 dB (-40..-12 dBFS)   + / - sink volume step   b bring-up/profile (sudo)",
                " 1 clean  2 quiet/faint  3 dull/thin  4 harsh  5 buzz/rattle/distortion   n note   Enter save row",
                " o speakers off (sudo)   O speakers on   x reset STOP   ? help   q quit",
            ]
        else:
            lines = [" space play/stop  <-/-> freq  p pink  s sweep  l/r/c ch  m music  +/- vol  a/z amp  b A/B  "
                     "1-5 rate  n note  ? help  q quit"]
        for l in lines:
            self.put(y, l, "dim")
            y += 1
        if prompt is not None:
            self.put(h - 2, prompt, "bold")
            try:
                scr.move(h - 2, min(len(prompt), w - 2))
            except curses.error:
                pass
        scr.refresh()
        dump = os.environ.get("J716_LISTEN_DUMP")  # test hook: screen text to a file
        if dump:
            try:
                with open(dump + ".tmp", "w") as f:
                    for row in range(h):
                        f.write(scr.instr(row, 0, w).decode("utf-8", "replace").rstrip() + "\n")
                os.replace(dump + ".tmp", dump)
            except (OSError, curses.error):
                pass

    # --- modal input
    def read_line(self, label, initial=""):
        buf = initial
        curses.curs_set(1)
        last = 0
        try:
            while True:
                self.tick()
                if time.time() - last > 0.3:
                    self.draw(prompt=label + buf)
                    last = time.time()
                ch = self.scr.getch()
                if ch == -1:
                    continue
                last = 0
                if ch in (10, 13, curses.KEY_ENTER):
                    return buf
                if ch == 27:
                    return None
                if ch in (127, 8, curses.KEY_BACKSPACE):
                    buf = buf[:-1]
                elif 32 <= ch < 127:
                    buf += chr(ch)
        finally:
            curses.curs_set(0)

    def confirm(self, text):
        r = self.read_line(text + " [y/N] ")
        return bool(r) and r.strip().lower().startswith("y")

    def suspend_run(self, cmd):
        curses.def_prog_mode()
        curses.endwin()
        print("\n$ " + " ".join(cmd))
        rc = subprocess.call(cmd)
        input("\n[rc %d] press Enter to return to j716-listen " % rc)
        curses.reset_prog_mode()
        self.scr.refresh()
        return rc

    # --- actions
    def select_freq(self, delta):
        self.kind = "sine"
        self.fi = max(0, min(len(FREQS) - 1, self.fi + delta)) if self.freq in FREQS else \
            (min(range(len(FREQS)), key=lambda i: abs(FREQS[i] - self.freq)))
        self.freq = float(FREQS[self.fi])
        if self.player:
            self.play_current()

    def do_volume(self, direction):
        v = self.volume()
        if v is None:
            self.msg = "cannot read the sink volume (wpctl missing?)"
            return
        nv = step_volume(v, direction)
        if abs(nv - v) < 0.005:
            self.msg = "volume already at the %s step (%.2f)" % ("top" if direction > 0 else "bottom", v)
            return
        if self.sys.set_volume(nv):
            self.msg = "wpctl set-volume %s %.2f  (graph %.1f dB)" % (SINK, nv, graph_db(nv))
        else:
            self.msg = "wpctl set-volume failed"
        self.refresh_info()

    def do_ab(self):
        kind = self.graph_kind()
        target = "bringup" if kind == "profile" else "profile"
        if not self.confirm("Switch to %s with `sudo j716-audio-ab %s` (stops playback, restarts PipeWire)?" % (target, target)):
            self.msg = "switch cancelled"
            return
        self.stop_play()
        self.commit_pending()
        if self.sys.fake:
            self.sys.ab_switch(target)
        else:
            tool = shutil.which("j716-audio-ab") or "/usr/local/bin/j716-audio-ab"
            if self.suspend_run(["sudo", tool, target]) != 0:
                self.msg = "j716-audio-ab %s failed" % target
                return
            self.msg = "switched; waiting for the sink to come back ..."
            self.draw()
            time.sleep(2.5)
        self.refresh_info()
        self.msg = "graph now: %s" % self.graph_kind()

    def do_speakers(self, on):
        if not self.safety.tripped and not self.sys.fake:
            if not self.confirm("Speaker Switch %s (amixer -c %s cset name='Speaker Switch' %s)?" % (
                    "ON" if on else "OFF", CARD, "on" if on else "off")):
                self.msg = "cancelled"
                return
        ok, interactive = self.sys.amixer_set(on)
        if not ok and interactive:
            ok = self.suspend_run(self.sys.amixer_cmd(on)) == 0
        self.refresh_info()
        self.msg = "Speaker Switch %s" % (("on" if on else "off") if ok else "change FAILED")

    def reset_trip(self):
        if not self.safety.tripped:
            self.msg = "no STOP active"
            return
        self.safety.reset()
        self.tripped_handled = False
        if self.muted_by_trip:
            self.sys.set_mute(False)
            self.muted_by_trip = False
        self.refresh_info()
        self.msg = "STOP cleared (sink unmuted). Speaker Switch unchanged; telemetry must resume before playing."

    def rate(self, n):
        rec = self.cur or self.pending
        if not rec:
            self.msg = "nothing to rate yet: play something first"
            return
        rec["rating"] = n
        self.msg = "rated %d %s" % (n, RATINGS[n])

    def add_note(self):
        rec = self.cur or self.pending
        if not rec:
            self.msg = "nothing to annotate yet: play something first"
            return
        t = self.read_line("note: ", rec["note"])
        if t is not None:
            rec["note"] = t.strip()
            self.msg = "note set"

    def enter_freq(self):
        t = self.read_line("frequency Hz (20-20000): ")
        if t is None or not t.strip():
            return
        try:
            f = float(t.replace("hz", "").replace("Hz", "").strip())
            if not 20 <= f <= 20000:
                raise ValueError
        except ValueError:
            self.msg = "cannot play: '%s' is not a frequency between 20 and 20000 Hz" % t
            return
        self.kind, self.freq = "sine", f
        if f in FREQS:
            self.fi = FREQS.index(f)
        self.msg = "sine %g Hz selected; space plays" % f

    def handle_key(self, ch):
        if ch == ord(" "):
            if self.player:
                self.stop_play()
                self.msg = "stopped; rate it 1-5, n for a note"
            else:
                self.play_current()
        elif ch in (curses.KEY_RIGHT, curses.KEY_UP):
            self.select_freq(+1)
        elif ch in (curses.KEY_LEFT, curses.KEY_DOWN):
            self.select_freq(-1)
        elif ch == ord("f"):
            self.enter_freq()
        elif ch == ord("t"):
            self.kind = "sine"
            self.msg = "sine %g Hz selected" % self.freq
        elif ch == ord("d"):
            self.dur = DUR_CHOICES[(DUR_CHOICES.index(self.dur) + 1) % len(DUR_CHOICES)] if self.dur in DUR_CHOICES else TONE_DUR
            self.msg = "tone length %d s (pink and sweep keep their length)" % self.dur
        elif ch == ord("p"):
            self.kind = "pink"
            self.play_current()
        elif ch == ord("s"):
            self.kind = "sweep"
            self.play_current()
        elif ch in (ord("l"), ord("r"), ord("c")):
            self.ch = chr(ch).upper()
            self.play_current()
        elif ch == ord("m"):
            self.scan_music()
            if not self.music:
                self.msg = "no music in %s (put .wav/.flac/.ogg files there)" % self.music_dir
            else:
                self.kind = "music"
                self.play_current()
        elif ch == ord("M"):
            self.scan_music()
            if self.music:
                self.mi = (self.mi + 1) % len(self.music)
                self.kind = "music"
                self.msg = "music: %s (m plays)" % self.music[self.mi]
        elif ch == ord("a"):
            self.amp = step_amp(self.amp, +1)
            self.msg = "amplitude %g dBFS (next play)" % self.amp
        elif ch == ord("z"):
            self.amp = step_amp(self.amp, -1)
            self.msg = "amplitude %g dBFS (next play)" % self.amp
        elif ch in (ord("+"), ord("=")):
            self.do_volume(+1)
        elif ch in (ord("-"), ord("_")):
            self.do_volume(-1)
        elif ch == ord("b"):
            self.do_ab()
        elif ch == ord("o"):
            self.do_speakers(False)
        elif ch == ord("O"):
            self.do_speakers(True)
        elif ch == ord("x"):
            self.reset_trip()
        elif ch in (ord("1"), ord("2"), ord("3"), ord("4"), ord("5")):
            self.rate(ch - ord("0"))
        elif ch == ord("n"):
            self.add_note()
        elif ch in (10, 13, curses.KEY_ENTER):
            if self.pending and not self.player:
                self.commit_pending()
                self.msg = "row saved to %s" % self.results
        elif ch == ord("?"):
            self.help = not self.help

    def main(self, scr):
        self.scr = scr
        curses.curs_set(0)
        curses.start_color()
        try:
            curses.use_default_colors()
            bg = -1
        except curses.error:
            bg = curses.COLOR_BLACK
        curses.init_pair(1, curses.COLOR_GREEN, bg)
        curses.init_pair(2, curses.COLOR_YELLOW, bg)
        curses.init_pair(3, curses.COLOR_RED, bg)
        curses.init_pair(4, curses.COLOR_CYAN, bg)
        curses.init_pair(5, curses.COLOR_WHITE, curses.COLOR_RED)
        self.attrs()
        scr.timeout(100)
        scr.keypad(True)
        last = 0
        self.msg = "start at wpctl 0.55 and work up (LISTENING-TEST.md section 2). ? for keys."
        while True:
            self.tick()
            now = time.time()
            if now - last >= 0.5:
                self.draw()
                last = now
            ch = scr.getch()
            if ch == -1:
                continue
            if ch == curses.KEY_RESIZE:
                last = 0
                continue
            if ch == ord("q"):
                break
            self.handle_key(ch)
            self.draw()
            last = time.time()
        self.stop_play()
        self.commit_pending()

    def run(self):
        locale.setlocale(locale.LC_ALL, "")
        self.read_kernel()
        self.refresh_info()
        self.sys.start_streams(self.safety)
        poller = threading.Thread(target=self.poll_loop, daemon=True)
        poller.start()
        try:
            curses.wrapper(self.main)
        finally:
            self.stop_poll.set()
            if self.player:
                self.player.kill()
            try:
                self.commit_pending()
            except Exception:
                pass
            self.sys.close()
        print("results: %s" % self.results)


# --------------------------------------------------------------------------- --check

def do_check(sysobj, base_dir):
    problems = []
    print("j716-listen check%s" % ("  [FAKE BACKEND]" if sysobj.fake else ""))
    for t in ("pw-play", "wpctl", "amixer", "journalctl", "dmesg", "sudo", "j716-audio-ab"):
        p = shutil.which(t) if not sysobj.fake else "(fake)"
        print("  tool %-14s %s" % (t, p or "MISSING"))
        if not p and t in ("pw-play", "wpctl", "journalctl", "dmesg", "amixer"):
            problems.append("%s missing" % t)
    sink = sysobj.sink_info()
    if sink:
        print("default sink: %s  (%s)  -> graph: %s" % (sink["desc"], sink["name"], sink["kind"]))
        if sink["kind"] == "other":
            problems.append("default sink is not a J716 sink")
    else:
        print("default sink: unknown (wpctl missing, or no PipeWire session)")
        problems.append("default sink unknown")
    vol = sysobj.get_volume()
    if vol:
        print("volume: wpctl %.2f%s, graph %.1f dB" % (vol[0], " MUTED" if vol[1] else "", graph_db(vol[0])))
        if vol[0] > 1.0:
            problems.append("volume above 1.00")
    else:
        print("volume: unknown")
    text, via = sysobj.dmesg_text()
    if text is None:
        print("kernel: dmesg not readable (needs root: run with sudo -v first or `sudo j716-listen`)")
        problems.append("dmesg not readable")
    else:
        c = [l.strip() for l in text.splitlines() if "Speaker volume ceiling" in l]
        u = [l.strip() for l in text.splitlines() if "Speaker volumes unlocked" in l or "Speaker volumes locked" in l]
        faults = sum(1 for l in text.splitlines() if FAULT_RE.search(l))
        print("kernel: %s%s" % (c[-1] if c else "no 'Speaker volume ceiling' line", "  (via sudo)" if via else ""))
        print("kernel: %s" % (u[-1] if u else "no 'Speaker volumes (un)locked' line"))
        print("dmesg tas2764 fault lines since boot: %d" % faults)
        m = CEILING_RE.search(c[-1]) if c else None
        if not m:
            problems.append("kernel ceiling line not found")
        elif float(m.group(1)) > -30.0:
            problems.append("kernel ceiling above -30 dB")
        if faults:
            problems.append("%d tas2764 fault line(s) in dmesg history" % faults)
    state, verbose = sysobj.service_state()
    ok, via, lines = sysobj.journal_probe()
    parsed = [SPK_RE.search(l) for l in lines]
    parsed = [m for m in parsed if m]
    print("speakersafetyd: %s, verbose flag: %s" % (state, {True: "yes", False: "no", None: "unknown"}[verbose]))
    if ok:
        print("journal: readable%s; %d speaker lines in the last 20" % (" via sudo" if via else " as this user", len(parsed)))
        if parsed:
            print("  latest: " + lines[-1].strip()[:110])
            worst = max(float(m.group("power")) for m in parsed)
            print("  max power in those lines: %.3f W" % worst)
        else:
            print("  no speaker lines: run the daemon verbose (-v), LISTENING-TEST.md section 0")
            problems.append("no verbose speakersafetyd lines")
    else:
        print("journal: NOT readable (needs root: add the user to systemd-journal, or sudo -v)")
        problems.append("speakersafetyd journal not readable")
    if state != "active":
        problems.append("speakersafetyd not active")
    print("Speaker Switch: %s" % (sysobj.speaker_switch() or "unknown"))
    print("signals: %s" % base_dir)
    md_dir = os.path.join(base_dir, "music")
    n = len([f for f in os.listdir(md_dir) if f.lower().endswith(MUSIC_EXT)]) if os.path.isdir(md_dir) else 0
    print("music files in %s: %d" % (md_dir, n))
    print("RESULT: %s" % ("ok" if not problems else "problems: " + "; ".join(problems)))
    return 0 if not problems else 1


# --------------------------------------------------------------------------- --selftest

def goertzel_power(samples, freq):
    w = 2 * math.pi * freq / RATE
    c = 2 * math.cos(w)
    s1 = s2 = 0.0
    for x in samples:
        s0 = x + c * s1 - s2
        s2 = s1
        s1 = s0
    return s1 * s1 + s2 * s2 - c * s1 * s2


def do_selftest():
    fails = []
    n_ok = [0]

    def check(cond, what):
        if cond:
            n_ok[0] += 1
        else:
            fails.append(what)
            print("FAIL: " + what)

    tmp = tempfile.mkdtemp(prefix="j716-listen-selftest-")
    try:
        specs = [("sine", float(f), "C", AMP_DEFAULT, TONE_DUR) for f in FREQS]
        specs += [("pink", 0, "C", AMP_DEFAULT, PINK_DUR), ("sweep", 0, "C", AMP_DEFAULT, SWEEP_DUR)]
        for ch in ("L", "R"):
            specs += [("sine", 1000.0, ch, AMP_DEFAULT, TONE_DUR), ("pink", 0, ch, AMP_DEFAULT, PINK_DUR),
                      ("sweep", 0, ch, AMP_DEFAULT, SWEEP_DUR)]
        specs += [("sine", 150.0, "C", AMP_MIN, 6), ("sine", 150.0, "C", AMP_MAX, 10), ("sine", 63.5, "C", -26.0, 20),
                  ("pink", 0, "C", AMP_MAX, PINK_DUR), ("sweep", 0, "C", AMP_MIN, SWEEP_DUR)]
        files = {}
        t0 = time.time()
        for kind, freq, ch, amp, dur in specs:
            path = ensure_signal(tmp, kind, freq, ch, amp, dur)
            label = os.path.basename(path)
            files[(kind, freq, ch, amp, dur)] = path
            raw = open(path, "rb").read()
            check(raw[:4] == b"RIFF" and raw[8:12] == b"WAVE", label + ": RIFF/WAVE magic")
            check(int.from_bytes(raw[4:8], "little") == len(raw) - 8, label + ": RIFF size field")
            check(raw[12:16] == b"fmt ", label + ": fmt chunk first")
            with wave.open(path, "rb") as w:
                nch, sw, rate, nf = w.getnchannels(), w.getsampwidth(), w.getframerate(), w.getnframes()
                check((nch, sw, rate) == (2, 2, RATE), label + ": 2 ch, 16 bit, 48 kHz (got %s/%s/%s)" % (nch, sw, rate))
                d = array.array("h")
                d.frombytes(w.readframes(nf))
                if sys.byteorder == "big":
                    d.byteswap()
            exp_dur = {"pink": PINK_DUR, "sweep": SWEEP_DUR}.get(kind, dur)
            check(nf == exp_dur * RATE, label + ": %d frames, expected %d" % (nf, exp_dur * RATE))
            left, right = d[0::2], d[1::2]
            pk = max(max(left), -min(left), max(right), -min(right))
            want = peak_for(amp)
            check(pk <= want, label + ": peak %d exceeds %d (%.1f dBFS)" % (pk, want, amp))
            check(pk >= want * 0.98, label + ": peak %d is below target %d" % (pk, want))
            check(pk <= peak_for(AMP_MAX), label + ": peak above the -12 dBFS cap")
            check(abs(left[0]) <= 1 and abs(right[0]) <= 1 and abs(left[-1]) <= 1 and abs(right[-1]) <= 1,
                  label + ": file does not start/end at zero")
            lmax, rmax = max(map(abs, left)), max(map(abs, right))
            if ch == "L":
                check(rmax == 0 and lmax > 0, label + ": L variant leaks into R")
            elif ch == "R":
                check(lmax == 0 and rmax > 0, label + ": R variant leaks into L")
            else:
                check(left == right and lmax > 0, label + ": centre variant not identical on both channels")
        print("generated %d files in %.1f s" % (len(specs), time.time() - t0))

        # sine frequency is where it should be
        d = array.array("h")
        with wave.open(files[("sine", 1000.0, "C", AMP_DEFAULT, TONE_DUR)], "rb") as w:
            d.frombytes(w.readframes(w.getnframes()))
        seg = d[0::2][RATE // 2:RATE // 2 + 4800]
        on = goertzel_power(seg, 1000.0)
        off = goertzel_power(seg, 1500.0)
        check(on > off * 1e4, "1 kHz tone: energy not at 1 kHz")

        # pink slope: ~ -3 dB/octave means 125 Hz is ~9 dB above 1 kHz in bin power
        d = array.array("h")
        with wave.open(files[("pink", 0, "C", AMP_DEFAULT, PINK_DUR)], "rb") as w:
            d.frombytes(w.readframes(w.getnframes()))
        mono = [float(x) for x in d[0::2][RATE:2 * RATE]]
        p125 = sum(goertzel_power(mono, 120 + k) for k in range(0, 16)) / 16
        p1k = sum(goertzel_power(mono, 990 + k) for k in range(0, 16)) / 16
        slope = 10 * math.log10(p125 / p1k)
        check(5.5 <= slope <= 12.5, "pink slope 125 Hz vs 1 kHz is %.1f dB, expected about 9" % slope)
        rms = math.sqrt(sum(x * x for x in mono) / len(mono))
        print("pink: peak %d, rms %.0f (%.1f dBFS), 125 Hz/1 kHz %.1f dB" % (
            max(map(abs, d)), rms, 20 * math.log10(rms / 32767), slope))

        # sweep: first quarter second is low, last is high (zero-crossing rate)
        d = array.array("h")
        with wave.open(files[("sweep", 0, "C", AMP_DEFAULT, SWEEP_DUR)], "rb") as w:
            d.frombytes(w.readframes(w.getnframes()))
        m = d[0::2]

        def zc(a):
            return sum(1 for i in range(1, len(a)) if (a[i - 1] < 0) != (a[i] < 0))
        f_start = zc(m[int(0.1 * RATE):int(0.6 * RATE)]) / 2 / 0.5
        f_end = zc(m[int(19.4 * RATE):int(19.9 * RATE)]) / 2 / 0.5
        check(30 <= f_start <= 90, "sweep start frequency about %.0f Hz, expected 40-70" % f_start)
        check(f_end >= 12000, "sweep end frequency about %.0f Hz, expected above 12 kHz" % f_end)

        # amplitude guard
        for bad in (-11.9, -5.0, 0.0, -40.5):
            try:
                ensure_signal(tmp, "sine", 1000.0, "C", bad, 3)
                check(False, "amplitude %.1f dBFS was not refused" % bad)
            except ValueError:
                check(True, "")
        for bad in (10.0, 30000.0):
            try:
                ensure_signal(tmp, "sine", bad, "C", AMP_DEFAULT, 3)
                check(False, "frequency %g was not refused" % bad)
            except ValueError:
                check(True, "")
        # amp/volume stepping
        a = AMP_DEFAULT
        seq = []
        for _ in range(12):
            a = step_amp(a, +1)
            seq.append(a)
        check(max(seq) == AMP_MAX and a == AMP_MAX, "amplitude step does not stop at -12")
        for _ in range(14):
            a = step_amp(a, -1)
        check(a == AMP_MIN, "amplitude step does not stop at -40")
        check(step_volume(0.55, +1) == 0.70 and step_volume(0.70, +1) == 0.85 and step_volume(0.85, +1) == 1.0
              and step_volume(1.0, +1) == 1.0 and step_volume(1.4, -1) == 1.0 and step_volume(0.55, -1) == 0.40,
              "volume steps")
        check([graph_db(v) for v in (0.55, 0.70, 0.85, 1.00)] == [-35.0, -26.5, -18.0, -10.0], "graph dB table")
        check(classify_sink("audio_effect.j716-bringup", "MacBook Pro J716 Speakers (bring-up)") == "bringup", "classify bringup")
        check(classify_sink("audio_effect.j716-convolver", "MacBook Pro J716 Speakers") == "profile", "classify profile")

        # safety parser and rules
        tr = []
        s = Safety(on_trip=tr.append)
        s.begin_play()
        s.feed_journal("Left Woofer 1: Coil 80.69 °C Magnet 55.20 °C Power 0.00 W Gain 0.00 dB")
        s.feed_journal("[2026-11-08T10:00:00Z INFO  speakersafetyd] Right Tweeter: Coil 31.10 °C Magnet 28.00 °C Power 0.041 W Gain 0.00 dB")
        check(not s.tripped and len(s.speakers) == 2, "parser: two speakers, no trip")
        check(abs(s.speakers["Left Woofer 1"]["coil"] - 80.69) < 1e-9, "parser: coil")
        check(abs(s.speakers["Right Tweeter"]["power"] - 0.041) < 1e-9 and abs(s.play_max - 0.041) < 1e-9, "parser: power / max")
        s.feed_journal("Left Woofer 2: Coil 25.00 °C Magnet 25.00 °C Power -0.00 W Gain 0.00 dB")
        check(not s.tripped, "-0.00 W must not trip")
        for line, what in [
            ("Left Woofer 2: Coil 25.00 °C Magnet 25.00 °C Power 0.10 W Gain 0.00 dB", None),
            ("Left Woofer 2: Coil 25.00 °C Magnet 25.00 °C Power 0.101 W Gain 0.00 dB", "0.101"),
            ("Left Woofer 2: Coil 25.00 °C Magnet 25.00 °C Power -0.012 W Gain 0.00 dB", "negative"),
            ("Left Woofer 2: Coil 25.00 °C Magnet 25.00 °C Power 0.01 W Gain -3.20 dB", "gain limited"),
            ("thread 'main' panicked at src/main.rs:1", "panic"),
            ("speakersafetyd: gain limited on Left Woofer 1", "gain limited"),
            ("Started Speaker Safety Daemon.", "restarted"),
            ("Stopping Speaker Safety Daemon...", "restarted"),
        ]:
            s2 = Safety()
            s2.feed_journal(line)
            check((s2.tripped and what is not None and any(what in r for r in s2.reasons)) or (not s2.tripped and what is None),
                  "journal rule: %r -> %r" % (line[:50], s2.reasons))
        s3 = Safety()
        s3.feed_dmesg("[  12.3] tas2764 0-0038: fault 0x04")
        check(s3.tripped and s3.faults_new == 1, "dmesg fault trips")
        s3 = Safety()
        s3.feed_dmesg("[  12.3] macaudio sound: Speaker volume ceiling -30 dB")
        check(not s3.tripped, "dmesg ceiling line does not trip")
        s4 = Safety()
        s4.begin_play()
        s4.check_stale(time.time())
        check(s4.tripped, "stale telemetry during play trips")
        s4.reset()
        check(not s4.tripped, "reset clears the trip")

        for line, want in (("[ 1.0] macaudio sound: Speaker volume ceiling -30 dB", -30.0),
                           ("Speaker volume ceiling: -12.5 dB (locked)", -12.5), ("Speaker volume ceiling 0 dB", 0.0)):
            m = CEILING_RE.search(line)
            check(bool(m) and float(m.group(1)) == want, "ceiling regex: %r" % line)

        # results file
        rpath = os.path.join(tmp, "res", "results.md")
        rec = {"time": "2026-11-08 10:00:00", "graph": "profile", "vol": "0.55", "gdb": "-35.0", "signal": "sine 1000 Hz",
               "amp": "-20", "ch": "C", "played": "3.0", "rating": 4, "note": "pipe | in note\nnewline", "maxw": "0.012"}
        append_result(rpath, rec)
        append_result(rpath, dict(rec, rating=None, note=""))
        txt = open(rpath, encoding="utf-8").read()
        rows = [l for l in txt.splitlines() if l.startswith("| 2026")]
        check(len(rows) == 2 and all(r.count("|") == 12 for r in rows), "results rows have 11 columns: %r" % rows)
        check("4 harsh" in rows[0] and "| - |" in rows[1], "results rating text")

        # fail-soft system calls (pw-play / wpctl absent on the Studio)
        if not shutil.which("wpctl"):
            rs = RealSys()
            check(rs.sink_info() is None and rs.get_volume() is None and rs.set_volume(0.55) is False,
                  "wpctl absent: calls fail soft")
        print("selftest: %d checks passed, %d failed" % (n_ok[0], len(fails)))
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    return 1 if fails else 0


# --------------------------------------------------------------------------- main

def main(argv=None):
    ap = argparse.ArgumentParser(description="J716s speaker listening test TUI (see LISTENING-TEST.md)")
    ap.add_argument("--check", action="store_true", help="print the environment and exit")
    ap.add_argument("--selftest", action="store_true", help="generate and validate every signal, play nothing")
    ap.add_argument("--dir", default=os.environ.get("J716_LISTEN_DIR") or os.path.expanduser("~/j716-listen"),
                    help="signal/results directory (default ~/j716-listen)")
    ap.add_argument("--allow-blind", action="store_true",
                    help="play even if dmesg / speakersafetyd monitoring is not live (not recommended)")
    ap.add_argument("--no-sudo", action="store_true", help="never run `sudo -v` at start")
    args = ap.parse_args(argv)
    if args.selftest:
        return do_selftest()
    fake = os.environ.get("J716_LISTEN_FAKE") == "1"
    sysobj = FakeSys() if fake else RealSys()
    if args.check:
        sysobj.prepare_access(False)
        return do_check(sysobj, args.dir)
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        print("j716-listen needs a terminal", file=sys.stderr)
        return 2
    if os.geteuid() == 0 and not fake:
        print("j716-listen: run as the desktop user (rolo), not root: pw-play/wpctl need your PipeWire session.",
              file=sys.stderr)
        return 2
    os.makedirs(args.dir, exist_ok=True)
    app = App(sysobj, args.dir, allow_blind=args.allow_blind)
    app.access_notes = sysobj.prepare_access(not args.no_sudo)
    app.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
