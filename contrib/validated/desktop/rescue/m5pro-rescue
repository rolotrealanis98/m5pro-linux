#!/bin/bash
# m5pro-rescue: get the Omarchy desktop back after a Hyprland crash or a black screen on the J716s.
# Run as root (sudo m5pro-rescue) from a text console: press Ctrl+Alt+F3, log in as rolo.
#   m5pro-rescue            diagnose, restart the desktop session, and if the panel is wedged offer a reboot
#   m5pro-rescue status     diagnosis only
#   m5pro-rescue session    restart the desktop session (getty@tty2) and verify it draws
#   m5pro-rescue reboot     save evidence, settle 30 s, reboot
# Evidence for the GPU-recovery work lands in /root/wedge-<HHMM>/ (dmesg, Hyprland log, blocked tasks, fences).
set -u
U=${M5PRO_USER:-rolo}; UIDN=$(id -u "$U" 2>/dev/null || echo 1001); X=/run/user/$UIDN
[ "$(id -u)" = 0 ] || { echo "run as root: sudo m5pro-rescue $*"; exit 1; }
live_sig() { for d in "$X"/hypr/*/; do p=$(head -1 "$d/hyprland.lock" 2>/dev/null); [ -n "$p" ] && kill -0 "$p" 2>/dev/null && { basename "$d"; return; }; done; }
hc() { local s; s=$(live_sig); [ -n "$s" ] && runuser -u "$U" -- env XDG_RUNTIME_DIR="$X" HYPRLAND_INSTANCE_SIGNATURE="$s" WAYLAND_DISPLAY=wayland-1 hyprctl "$@" 2>/dev/null; }
swaps() { mountpoint -q /sys/kernel/tracing || mount -t tracefs tracefs /sys/kernel/tracing 2>/dev/null; echo 1 > /sys/kernel/tracing/events/dcp/iomfb_swap_complete/enable 2>/dev/null; grep -c iomfb_swap_complete /sys/kernel/tracing/trace 2>/dev/null || echo 0; }
has_dcp() { for c in /sys/class/drm/card[0-9]; do [ "$(basename "$(readlink "$c/device/driver")")" = apple-drm ] && return 0; done; return 1; }
draws() {  # returns 0 if a forced redraw reaches the panel (DCP) or Hyprland answers (simpledrm)
  if has_dcp; then local a b; a=$(swaps); hc dispatch exec "alacritty --title m5pro-rescue-probe -e sleep 2" >/dev/null; sleep 3; b=$(swaps); hc dispatch closewindow "title:m5pro-rescue-probe" >/dev/null 2>&1; [ $((b-a)) -gt 0 ]
  else hc monitors >/dev/null; fi; }
status() {
  echo "kernel $(uname -r), slot $(tr -d '\0' < /proc/device-tree/chosen/m5pro,boot-slot 2>/dev/null), cards: $(for c in /sys/class/drm/card[0-9]; do echo -n "$(basename "$c")=$(basename "$(readlink "$c/device/driver")") "; done)"
  echo "Hyprland: $(pgrep -xc Hyprland) running; crash reports this boot: $(find /home/$U/.cache/hyprland -name 'hyprlandCrashReport*.txt' -newermt "@$(( $(date +%s) - $(cut -d. -f1 /proc/uptime) ))" 2>/dev/null | wc -l)"
  echo "GPU recoveries this boot: $(dmesg | grep -c 'recovery fault'); clients hit: $(dmesg | grep -E 'GPU work of a client failed' | sed -E 's/.*client ([A-Za-z0-9_.-]+)\[.*/\1/' | sort | uniq -c | tr '\n' ' ')"
  local L; L=$(ls -t "$X"/hypr/*/hyprland.log 2>/dev/null | head -1); [ -n "$L" ] && echo "page flips stuck (log): $(tr -d '\000' < "$L" | grep -ac 'page-flip is awaiting')"
  if [ "$(pgrep -xc Hyprland)" -gt 0 ]; then
    # start-hyprland relaunches a crashed Hyprland with --safe-mode (no config, no bar,
    # default keybinds). That session draws, but it is not the desktop: restart it.
    if pgrep -xa Hyprland | grep -q -- '--safe-mode'; then echo "RESULT: Hyprland is in SAFE MODE (relaunched after a crash, your config is not loaded)."; return 3; fi
    if draws; then echo "RESULT: the desktop draws."; return 0; else echo "RESULT: Hyprland runs but nothing reaches the panel (display pipeline wedged)."; return 2; fi
  else echo "RESULT: Hyprland is not running."; return 1; fi; }
evidence() { local D=/root/wedge-$(date +%H%M); mkdir -p "$D"; dmesg > "$D/dmesg.txt"; cp "$X"/hypr/*/hyprland.log "$D"/ 2>/dev/null; cp /home/$U/.cache/hyprland/hyprlandCrashReport*.txt "$D"/ 2>/dev/null; mount -t debugfs none /sys/kernel/debug 2>/dev/null; cp /sys/kernel/debug/dma_buf/bufinfo "$D/bufinfo.txt" 2>/dev/null; echo w > /proc/sysrq-trigger; sleep 1; dmesg | awk '/sysrq: Show Blocked State/{f=1} f' > "$D/blocked.txt"; cat /sys/kernel/debug/dri/*/state > "$D/drm-state.txt" 2>/dev/null; echo "evidence saved in $D"; }
session() { echo "restarting the desktop session..."; systemctl restart getty@tty2; sleep 20; status; }
do_reboot() { evidence; echo "syncing and settling 30 s, then rebooting (the boot slot is unchanged)"; sync; sleep 30; systemctl reboot; }
case "${1:-auto}" in
  status) status ;;
  session) session ;;
  reboot) do_reboot ;;
  auto)
    status; rc=$?
    if [ $rc = 0 ]; then echo "nothing to do (if your screen is black anyway, press Ctrl+Alt+F2 to return to the desktop)"; exit 0; fi
    evidence; session; rc=$?
    if [ $rc = 0 ]; then echo "recovered: press Ctrl+Alt+F2 to return to the desktop"; exit 0; fi
    if [ $rc = 3 ]; then echo; echo "The restarted session crashed again at once and is in safe mode; retrying once."; session; rc=$?; [ $rc = 0 ] && { echo "recovered: press Ctrl+Alt+F2 to return to the desktop"; exit 0; }; fi
    echo; echo "The session came back but the panel is wedged; only a reboot clears it."
    read -r -p "reboot now? [y/N] " a; [ "$a" = y ] && do_reboot || echo "not rebooting; run: sudo m5pro-rescue reboot" ;;
  *) echo "usage: m5pro-rescue [status|session|reboot]"; exit 2 ;;
esac
