From 0b895ca35ee15b9eb45ce18250e941200768e843 Mon Sep 17 00:00:00 2001
From: Rolando Trevino <rolotrealanis@gmail.com>
Date: Sat, 7 Nov 2026 15:26:08 -0500
Subject: [PATCH 06/12] dt-bindings: arm: apple: Add the MacBook Pro (16-inch,
 M5 Pro)

The 16-inch MacBook Pro with the M5 Pro (J716s, Mac17,8) is built on the
T6050, like the 14-inch M5 Max (J714c): its Apple Device Tree and m1n1
identify the SoC as T6050. Add it to the Apple platform binding as an
M5 Pro T6050 board.

Signed-off-by: Rolando Trevino <rolotrealanis@gmail.com>
---
 Documentation/devicetree/bindings/arm/apple.yaml | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/Documentation/devicetree/bindings/arm/apple.yaml b/Documentation/devicetree/bindings/arm/apple.yaml
index 7e082afdde82..51ee748ce191 100644
--- a/Documentation/devicetree/bindings/arm/apple.yaml
+++ b/Documentation/devicetree/bindings/arm/apple.yaml
@@ -360,6 +360,12 @@ properties:
           - const: apple,t8142
           - const: apple,arm-platform
 
+      - description: Apple M5 Pro SoC based platforms
+        items:
+          - const: apple,j716s # MacBook Pro (16-inch, M5 Pro, 2026)
+          - const: apple,t6050
+          - const: apple,arm-platform
+
       - description: Apple M5 Max SoC based platforms
         items:
           - const: apple,j714c # MacBook Pro (14-inch, M5 Max, 2026)
-- 
2.56.0

