From 063f6e5da5029dabefcd73ec580c329e738b2bf9 Mon Sep 17 00:00:00 2001
From: Rolando Trevino <rolotrealanis@gmail.com>
Date: Sat, 7 Nov 2026 15:25:18 -0500
Subject: [PATCH 03/11] arm64: idle: T6050 idles in WFI even with idle=nop

m1n1 appends "idle=nop arm64.nowfxt" to the command line on every chip
whose Apple system registers are locked (M4 and later, T8140 aside), for
kernels that do not preserve the state WFI loses there. It appends them
after the user's arguments, so an idle= on the command line cannot
override it. This kernel preserves that state (apple_wfi_quirk_init()),
and idreg-override forces WFxT off on M4 and later, so on T6050
idle=nop only makes every idle CPU spin: cpuidle's WFI state calls
cpu_do_idle(), which does nothing with idle=nop.

Keep WFI as the idle method on T6050 (MIDR parts 0x064 and 0x065, added
to cputype.h). The switch is made in apple_wfi_quirk_init(), after the
register-saving key is enabled and before the secondary CPUs start; the
boot CPU spins until then, as it does today. Other chips are not
changed.

Add apple_keep_idle_nop to keep idle=nop for comparisons and as a
fallback that needs no new kernel.

Tested on J716s (MacBook Pro 16-inch, M5 Pro) in the tree these changes
come from: the system draws 9.8 W at idle on the charger instead of
16.4 W (SMC total system power), and a 56-minute idle soak with an FP
consistency check on all 18 CPUs and four s2idle steps up to a real
suspend/resume passed. On the 14-inch M5 Pro (J714s), betizzel measured
5.6 W against 15.3 W, and a per-CPU register check passed 250,000 1 ms
sleeps on each of its 15 CPUs. On this tree: compile-tested.

Link: https://github.com/betizzel/omarchy-m5/commit/a5df9e4df61b60dd6195e13a2a3a043d76b92c0f
Signed-off-by: Rolando Trevino <rolotrealanis@gmail.com>
Assisted-by: LLM Claude
---
 .../admin-guide/kernel-parameters.txt         |  7 +++++
 arch/arm64/include/asm/cputype.h              |  4 +++
 arch/arm64/kernel/idle.c                      | 26 +++++++++++++++++++
 3 files changed, 37 insertions(+)

diff --git a/Documentation/admin-guide/kernel-parameters.txt b/Documentation/admin-guide/kernel-parameters.txt
index c5e4ab0ba915..a0a655039415 100644
--- a/Documentation/admin-guide/kernel-parameters.txt
+++ b/Documentation/admin-guide/kernel-parameters.txt
@@ -549,6 +549,13 @@ Kernel parameters
 	apm=		[APM] Advanced Power Management
 			See header of arch/x86/kernel/apm_32.c.
 
+	apple_keep_idle_nop
+			[ARM64,EARLY] On T6050, keep idle=nop. These cores
+			idle in WFI by default, and an idle=nop that the boot
+			loader appends is ignored, because the kernel
+			preserves the registers WFI loses there. With this
+			flag idle=nop spins the idle loop as elsewhere.
+
 	apparmor=	[APPARMOR] Disable or enable AppArmor at boot time
 			Format: { "0" | "1" }
 			See security/apparmor/Kconfig help text
diff --git a/arch/arm64/include/asm/cputype.h b/arch/arm64/include/asm/cputype.h
index 4a3fd1fabeec..2bbac9135758 100644
--- a/arch/arm64/include/asm/cputype.h
+++ b/arch/arm64/include/asm/cputype.h
@@ -158,6 +158,8 @@
 #define APPLE_CPU_PART_TAHITI_P		0x061
 #define APPLE_CPU_PART_T8142_E		0x062
 #define APPLE_CPU_PART_T8142_P		0x063
+#define APPLE_CPU_PART_T6050_M		0x064
+#define APPLE_CPU_PART_T6050_P		0x065
 #define APPLE_CPU_PART_T8152_E		0x072
 #define APPLE_CPU_PART_T8152_P		0x073
 
@@ -257,6 +259,8 @@
 #define MIDR_APPLE_TAHITI_P MIDR_CPU_MODEL(ARM_CPU_IMP_APPLE, APPLE_CPU_PART_TAHITI_P)
 #define MIDR_APPLE_T8142_E MIDR_CPU_MODEL(ARM_CPU_IMP_APPLE, APPLE_CPU_PART_T8142_E)
 #define MIDR_APPLE_T8142_P MIDR_CPU_MODEL(ARM_CPU_IMP_APPLE, APPLE_CPU_PART_T8142_P)
+#define MIDR_APPLE_T6050_M MIDR_CPU_MODEL(ARM_CPU_IMP_APPLE, APPLE_CPU_PART_T6050_M)
+#define MIDR_APPLE_T6050_P MIDR_CPU_MODEL(ARM_CPU_IMP_APPLE, APPLE_CPU_PART_T6050_P)
 #define MIDR_APPLE_T8152_E MIDR_CPU_MODEL(ARM_CPU_IMP_APPLE, APPLE_CPU_PART_T8152_E)
 #define MIDR_APPLE_T8152_P MIDR_CPU_MODEL(ARM_CPU_IMP_APPLE, APPLE_CPU_PART_T8152_P)
 #define MIDR_AMPERE1 MIDR_CPU_MODEL(ARM_CPU_IMP_AMPERE, AMPERE_CPU_PART_AMPERE1)
diff --git a/arch/arm64/kernel/idle.c b/arch/arm64/kernel/idle.c
index f632551030d1..4478bb6f89bb 100644
--- a/arch/arm64/kernel/idle.c
+++ b/arch/arm64/kernel/idle.c
@@ -46,13 +46,39 @@ early_param("idle", setup_idle);
  * patched-out branch.
  */
 static DEFINE_STATIC_KEY_FALSE(apple_wfi_loses_regs);
+static bool apple_keep_idle_nop __initdata;
+
+/*
+ * The boot loader appends idle=nop after the user's arguments, so it cannot
+ * be overridden on the command line. This flag keeps it anyway.
+ */
+static int __init setup_apple_keep_idle_nop(char *arg)
+{
+	apple_keep_idle_nop = true;
+	return 0;
+}
+early_param("apple_keep_idle_nop", setup_apple_keep_idle_nop);
 
 static int __init apple_wfi_quirk_init(void)
 {
+	u32 model = read_cpuid_id() & MIDR_CPU_MODEL_MASK;
+
 	if (midr_is_apple_m4_or_later(read_cpuid_id())) {
 		static_branch_enable(&apple_wfi_loses_regs);
 		pr_info("Apple: preserving registers across WFI\n");
 	}
+	/*
+	 * m1n1 passes idle=nop on M4 and later for kernels that do not
+	 * preserve the registers WFI loses there. This one does, from here
+	 * on, so on T6050 spinning only keeps every idle core busy: the
+	 * system draws about 7 W more at idle. The secondary CPUs are not up
+	 * yet, and the boot CPU has spun until now, so WFI is safe from here.
+	 */
+	if (idle == ARM64_IDLE_NOP && !apple_keep_idle_nop &&
+	    (model == MIDR_APPLE_T6050_M || model == MIDR_APPLE_T6050_P)) {
+		idle = ARM64_IDLE_WFI;
+		pr_info("Apple: idling in WFI, ignoring idle=nop\n");
+	}
 	return 0;
 }
 early_initcall(apple_wfi_quirk_init);
-- 
