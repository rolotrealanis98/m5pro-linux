diff --git a/tests/python/test_t8103_inherited_reservation.py b/tests/python/test_t8103_inherited_reservation.py
index 0e871b9..4e38b9e 100644
--- a/tests/python/test_t8103_inherited_reservation.py
+++ b/tests/python/test_t8103_inherited_reservation.py
@@ -18,7 +18,9 @@ SOURCE = Path(os.environ.get("DART_DISPLAY_SOURCE", Path(__file__).resolve().par
