diff --git a/arch/arm64/boot/dts/apple/t6050-base.dtsi b/arch/arm64/boot/dts/apple/t6050-base.dtsi
new file mode 100644
index 000000000000..1be5e14cb12f
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6050-base.dtsi
@@ -0,0 +1,292 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * Nodes common to every Apple T6050 (M5 Max, M5 Ultra) SoC
+ *
+ * A T6050 is one or two identical dies: t6050-max.dtsi describes the
+ * one-die part and t6050-ultra.dtsi the two-die one. Each includes this
+ * file, t6050-die0.dtsi (the blocks used on die 0 only) and, once per die,
+ * the per-die template t6050-dieX.dtsi. Die 0's MMIO window is
+ * 0x2_00000000 and die 1's 0x42_00000000 (die stride 0x40_00000000); each
+ * die has its own simple-bus, which the boot loader looks up by unit
+ * address. Unit addresses are CPU physical addresses. The boot loader
+ * starts the secondary CPUs and fills in their release addresses, the
+ * memory node and its own reservations.
+ *
+ * A smaller (binned) one-die part can build on t6050-max.dtsi, as
+ * t6034.dtsi does on t6031.dtsi: the boot loader removes the CPU nodes of
+ * the cores a part lacks.
+ *
+ * Copyright The Asahi Linux Contributors
+ */
+
+/*
+ * The per-die template's addressing: before each inclusion of
+ * t6050-dieX.dtsi, the including file defines
+ *  DIE		the label suffix (empty for die 0, _die1 for die 1),
+ *  DIE_NO	the die number (the AIC's die cell),
+ *  DIE_UNIT_PREFIX	the die's MMIO offset as a unit-address prefix
+ *		(empty for die 0, 4 for die 1),
+ *  DIE_ATC1	the port name of the die's ATC1 (die d's ATCn is port 4d + n),
+ *  SOC_NODE	the die's bus.
+ * DIE_UNIT() and DIE_HI() then give a die-0 address on that die.
+ */
+#define DIE_UNIT(addr)		__concat(DIE_UNIT_PREFIX, addr)
+#define DIE_HI(hi)		((hi) + 0x40 * DIE_NO)
+#define DIE_ATC1_LABEL(suffix)	__stringify(__concat(DIE_ATC1, suffix))
+
+/*
+ * CPU nodes. Die d, cluster c, core n has MPIDR Aff2 4 for the two M-tier
+ * (apple,sawtooth) clusters and 1 for the P-tier (apple,everest) cluster,
+ * Aff1 0x10 * d + c and Aff0 n; the unit address is the MPIDR. Labels
+ * number the cores 18 * d + 6 * c + n. The boot loader removes the nodes of
+ * the cores it did not start.
+ */
+#define T6050_CPU(label, mpidr, type, opp, cluster)		\
+	label: cpu@mpidr {					\
+		compatible = type;				\
+		device_type = "cpu";				\
+		reg = <0x0 0x ## mpidr>;			\
+		enable-method = "spin-table";			\
+		operating-points-v2 = <&opp>;			\
+		performance-domains = <&cluster>;		\
+		cpu-release-addr = <0 0>; /* to be filled by the loader */ \
+	}
+
+#define T6050_M_CPU(label, mpidr, cluster) \
+	T6050_CPU(label, mpidr, "apple,sawtooth", mcluster_opp, cluster)
+#define T6050_P_CPU(label, mpidr, cluster) \
+	T6050_CPU(label, mpidr, "apple,everest", pcluster_opp, cluster)
+
+/ {
+	compatible = "apple,t6050", "apple,arm-platform";
+	#address-cells = <2>;
+	#size-cells = <2>;
+	interrupt-parent = <&aic>;
+
+	/* The boot loader replaces reg with the usable RAM. */
+	memory@10000000000 {
+		device_type = "memory";
+		reg = <0x100 0x0 0x0 0x0>;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+		/* The boot loader adds its own reservations. */
+	};
+
+	/* The size's file lists its CPUs (T6050_M_CPU, T6050_P_CPU). */
+	cpus {
+		#address-cells = <2>;
+		#size-cells = <0>;
+	};
+
+	/*
+	 * CPU OPPs, from the ADT: /arm-io/pmgr acc-clusters maps clusters 0, 1 and 2 of each die to
+	 * voltage-states 22, 23 and 5, and their -sram tables give the frequencies (kHz). 22 and 23
+	 * list the same frequencies, so the two M clusters share one table. Levels are DVFS command
+	 * states: state 1 is 300 MHz and state k the table's (k-1)-th entry from state 2, as on T8142
+	 * (measured on J775D: every state's clock from a dependent-add chain). iBoot leaves M cluster
+	 * 0 of each die in state 6 (2652 MHz), the other clusters in state 2.
+	 *
+	 * Bring-up: the clusters' controllers (t6050-dieX.dtsi) assert apple,firmware-managed-thermal,
+	 * which the T6050 profile requires, before that ownership is qualified on this boot chain (no
+	 * Linux PMP driver runs; the SMC drives the fans). A qualification settles it: an all-core
+	 * load at the top states, watching TCMb, the fans and the measured clock.
+	 */
+	mcluster_opp: opp-table-mcluster {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp01 {
+			opp-hz = /bits/ 64 <300000000>;
+			opp-level = <1>;
+		};
+		opp02 {
+			opp-hz = /bits/ 64 <1344000000>;
+			opp-level = <2>;
+		};
+		opp03 {
+			opp-hz = /bits/ 64 <1644000000>;
+			opp-level = <3>;
+		};
+		opp04 {
+			opp-hz = /bits/ 64 <1992000000>;
+			opp-level = <4>;
+		};
+		opp05 {
+			opp-hz = /bits/ 64 <2304000000>;
+			opp-level = <5>;
+		};
+		opp06 {
+			opp-hz = /bits/ 64 <2652000000>;
+			opp-level = <6>;
+		};
+		opp07 {
+			opp-hz = /bits/ 64 <2964000000>;
+			opp-level = <7>;
+		};
+		opp08 {
+			opp-hz = /bits/ 64 <3240000000>;
+			opp-level = <8>;
+		};
+		opp09 {
+			opp-hz = /bits/ 64 <3504000000>;
+			opp-level = <9>;
+		};
+		opp10 {
+			opp-hz = /bits/ 64 <3696000000>;
+			opp-level = <10>;
+		};
+		opp11 {
+			opp-hz = /bits/ 64 <3876000000>;
+			opp-level = <11>;
+		};
+		opp12 {
+			opp-hz = /bits/ 64 <4044000000>;
+			opp-level = <12>;
+		};
+		opp13 {
+			opp-hz = /bits/ 64 <4176000000>;
+			opp-level = <13>;
+		};
+		opp14 {
+			opp-hz = /bits/ 64 <4284000000>;
+			opp-level = <14>;
+		};
+		opp15 {
+			opp-hz = /bits/ 64 <4308000000>;
+			opp-level = <15>;
+		};
+		opp16 {
+			opp-hz = /bits/ 64 <4380000000>;
+			opp-level = <16>;
+		};
+	};
+
+	pcluster_opp: opp-table-pcluster {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp01 {
+			opp-hz = /bits/ 64 <300000000>;
+			opp-level = <1>;
+		};
+		opp02 {
+			opp-hz = /bits/ 64 <1308000000>;
+			opp-level = <2>;
+		};
+		opp03 {
+			opp-hz = /bits/ 64 <1620000000>;
+			opp-level = <3>;
+		};
+		opp04 {
+			opp-hz = /bits/ 64 <1980000000>;
+			opp-level = <4>;
+		};
+		opp05 {
+			opp-hz = /bits/ 64 <2292000000>;
+			opp-level = <5>;
+		};
+		opp06 {
+			opp-hz = /bits/ 64 <2580000000>;
+			opp-level = <6>;
+		};
+		opp07 {
+			opp-hz = /bits/ 64 <2880000000>;
+			opp-level = <7>;
+		};
+		opp08 {
+			opp-hz = /bits/ 64 <3180000000>;
+			opp-level = <8>;
+		};
+		opp09 {
+			opp-hz = /bits/ 64 <3432000000>;
+			opp-level = <9>;
+		};
+		opp10 {
+			opp-hz = /bits/ 64 <3648000000>;
+			opp-level = <10>;
+		};
+		opp11 {
+			opp-hz = /bits/ 64 <3828000000>;
+			opp-level = <11>;
+		};
+		opp12 {
+			opp-hz = /bits/ 64 <3984000000>;
+			opp-level = <12>;
+		};
+		opp13 {
+			opp-hz = /bits/ 64 <4104000000>;
+			opp-level = <13>;
+		};
+		opp14 {
+			opp-hz = /bits/ 64 <4188000000>;
+			opp-level = <14>;
+		};
+		opp15 {
+			opp-hz = /bits/ 64 <4236000000>;
+			opp-level = <15>;
+		};
+		opp16 {
+			opp-hz = /bits/ 64 <4284000000>;
+			opp-level = <16>;
+		};
+		opp17 {
+			opp-hz = /bits/ 64 <4308000000>;
+			opp-level = <17>;
+		};
+		opp18 {
+			opp-hz = /bits/ 64 <4332000000>;
+			opp-level = <18>;
+		};
+		opp19 {
+			opp-hz = /bits/ 64 <4428000000>;
+			opp-level = <19>;
+		};
+		opp20 {
+			opp-hz = /bits/ 64 <4512000000>;
+			opp-level = <20>;
+		};
+		opp21 {
+			opp-hz = /bits/ 64 <4608000000>;
+			opp-level = <21>;
+		};
+	};
+
+	/* The 24 MHz reference clock of the watchdog */
+	clkref: clock-ref {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <24000000>;
+		clock-output-names = "clkref";
+	};
+
+	/* The QSPI controller's input: ADT /arm-io/qspi clock-ids 440, /arm-io clock-frequencies[440 - 256] */
+	clk_405m: clock-405m {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <405000000>;
+		clock-output-names = "clk_405m";
+	};
+
+	timer {
+		compatible = "arm,armv8-timer";
+		interrupt-parent = <&aic>;
+		interrupt-names = "phys", "virt", "hyp-phys", "hyp-virt";
+		interrupts = <AIC_FIQ 0 AIC_TMR_GUEST_PHYS IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_FIQ 0 AIC_TMR_GUEST_VIRT IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_FIQ 0 AIC_TMR_HV_PHYS IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_FIQ 0 AIC_TMR_HV_VIRT IRQ_TYPE_LEVEL_HIGH>;
+	};
+
+	/* Die 0 MMIO */
+	die0: soc@200000000 {
+		compatible = "simple-bus";
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges = <0x2 0x0 0x2 0x0 0x3 0xc0000000>;
+		nonposted-mmio;
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/t6050-die0.dtsi b/arch/arm64/boot/dts/apple/t6050-die0.dtsi
new file mode 100644
index 000000000000..768ec932f7b8
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6050-die0.dtsi
@@ -0,0 +1,1006 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * Nodes of the Apple T6050 (M5 Max, M5 Ultra) used on die 0 only: the
+ * interrupt controller, which serves every die, and the blocks a two-die
+ * part runs from die 0 (the SMC, storage, PCIe, the SPMI buses, the AOP,
+ * the boot NOR) or so far describes there only (ATC2 and ATC3, the I2C
+ * buses).
+ *
+ * Copyright The Asahi Linux Contributors
+ */
+
+&die0 {
+	/* One AIC3 for every die, 3104 interrupts each */
+	aic: interrupt-controller@280400000 {
+		compatible = "apple,t6050-aic3", "apple,t8122-aic3";
+		interrupt-controller;
+		#interrupt-cells = <4>;
+		reg = <0x2 0x80400000 0x0 0x1cc000>,
+		      <0x2 0x80440000 0x0 0x4000>;
+		reg-names = "core", "event";
+	};
+
+	/*
+	 * DockChannel channel 1, the one the USB debug link carries.
+	 * Its FIFO raises no interrupt on receive, so it is drained in
+	 * software.
+	 */
+	dockchannel: serial@288e3c000 {
+		compatible = "apple,dockchannel-uart";
+		reg = <0x2 0x88e3c000 0x0 0x30>,
+		      <0x2 0x88e38000 0x0 0x8>,
+		      <0x2 0x88e0c000 0x0 0x18>;
+		reg-names = "data", "config", "irq";
+		interrupts = <AIC_IRQ 0 360 IRQ_TYPE_LEVEL_HIGH>;
+		apple,channel = <1>;
+		apple,sw-drain;
+		status = "disabled";
+	};
+
+	wdt: watchdog@28836c000 {
+		compatible = "apple,t6050-wdt", "apple,t8103-wdt";
+		reg = <0x2 0x8836c000 0x0 0x4000>;
+		clocks = <&clkref>;
+		interrupts = <AIC_IRQ 0 721 IRQ_TYPE_LEVEL_HIGH>;
+	};
+
+	/*
+	 * /arm-io/smc: reg[0] 0x8c600000 +0x88000 (the ASC; the SMC driver maps none of it), its mailbox
+	 * the ASC v4 block at +0x8000 as on ANS. ADT interrupts [900, 899, 902, 901]: 899..902 in the
+	 * send-empty, send-not-empty, recv-empty, recv-not-empty order. iop-smc-nub region-base
+	 * 0x28de00000 +0x140000 is already a CPU address: the SRAM its RTKit buffers and key replies use.
+	 * iBoot leaves the firmware (t6050smc) running.
+	 */
+	smc_mbox: mailbox@28c608000 {
+		compatible = "apple,t6050-asc-mailbox", "apple,asc-mailbox-v4";
+		reg = <0x2 0x8c608000 0x0 0x4000>;
+		interrupts = <AIC_IRQ 0 899 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 0 900 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 0 901 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 0 902 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "send-empty", "send-not-empty",
+				  "recv-empty", "recv-not-empty";
+		#mbox-cells = <0>;
+	};
+
+	/*
+	 * The AOP's GPIO controller (ADT /arm-io/aop-gpio0, gpio,t8101, 85 pins). The AOP keeps
+	 * interrupt groups 0-3; the AP's are 4-6 (supported-int-groups), AIC 572-574. Like T8132's, the block has slots
+	 * that fault when read, so it is matched as T8132's (no register cache read-back).
+	 * Pin 15 (force-dpfu) is never requested.
+	 */
+	pinctrl_aop: pinctrl@290824000 {
+		compatible = "apple,t6050-pinctrl", "apple,t8132-pinctrl";
+		reg = <0x2 0x90824000 0x0 0x4000>;
+		gpio-controller;
+		#gpio-cells = <2>;
+		gpio-ranges = <&pinctrl_aop 0 0 85>;
+		apple,npins = <85>;
+		interrupt-controller;
+		#interrupt-cells = <2>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 0 572 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 0 573 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 0 574 IRQ_TYPE_LEVEL_HIGH>;
+		apple,irq-group-base = <4>;
+		/* Enabled by the board, or by Aura with a display engine whose hotplug input it has */
+		status = "disabled";
+	};
+
+	smc: smc@28c600000 {
+		compatible = "apple,t6050-smc";
+		reg = <0x2 0x8c600000 0x0 0x4000>,
+		      <0x2 0x8de00000 0x0 0x140000>;
+		reg-names = "smc", "sram";
+		mboxes = <&smc_mbox>;
+
+		/* T8142's key discovery (every readable T* float key); boards add their fan and power keys. */
+		smc_hwmon: hwmon {
+			compatible = "apple,smc-hwmon";
+			apple,discover-temperatures;
+			/* macsmc_soc_die: the SoC hotspot the SMC computes (TCMb, 47.8 C at idle) */
+			apple,soc-die-keys = "TCMb";
+		};
+
+		/* The PMU's legacy scratchpad (info-leg_scrpad 0xf800) cells, as on T6040. */
+		smc_reboot: reboot {
+			compatible = "apple,smc-reboot";
+			nvmem-cells = <&shutdown_flag>, <&boot_stage>,
+				      <&boot_error_count>, <&panic_count>;
+			nvmem-cell-names = "shutdown_flag", "boot_stage",
+					   "boot_error_count", "panic_count";
+		};
+
+		/*
+		 * The SMC's pcIO power outputs: the board lists its lines (apple,output-commands) as
+		 * pKW8('pcIO', lo, hi) templates, (hi << 32) | lo, with the level in bits 15:0.
+		 */
+		smc_pcio: gpio {
+			compatible = "apple,smc-pcio-gpio";
+			gpio-controller;
+			#gpio-cells = <2>;
+		};
+
+		/* ADT info-clock_offset [0x2100, 6]: M1-style 32768 Hz ticks, as on T6040. */
+		smc_rtc: rtc {
+			compatible = "apple,smc-rtc";
+			nvmem-cells = <&rtc_offset>;
+			nvmem-cell-names = "rtc_offset";
+		};
+	};
+
+	/*
+	 * The storage SART. The boot loader's entries (outside the
+	 * kernel's memory) stay in place.
+	 */
+	ans_sart: iommu@41dc50000 {
+		compatible = "apple,t6050-sart";
+		reg = <0x4 0x1dc50000 0x0 0xc000>;
+	};
+
+	ans_mbox: mailbox@419608000 {
+		compatible = "apple,t6050-asc-mailbox", "apple,asc-mailbox-v4";
+		reg = <0x4 0x19608000 0x0 0x4000>;
+		interrupts = <AIC_IRQ 0 1347 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 0 1348 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 0 1349 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 0 1350 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "send-empty", "send-not-empty",
+				  "recv-empty", "recv-not-empty";
+		#mbox-cells = <0>;
+	};
+
+	/*
+	 * The boot loader leaves ANS running with the controller shut
+	 * down. Its power stays with the firmware, and post-M4 ANS is
+	 * never reset through PMGR, so the node names no power domain
+	 * and no reset.
+	 */
+	nvme: nvme@45dcc0000 {
+		compatible = "apple,t6050-nvme-ans2";
+		reg = <0x4 0x5dcc0000 0x0 0x10000>,
+		      <0x4 0x19600000 0x0 0x4000>,
+		      <0x4 0x1dcc0000 0x0 0x60000>;
+		reg-names = "nvme", "ans", "nvmmu";
+		interrupts = <AIC_IRQ 0 2338 IRQ_TYPE_LEVEL_HIGH>;
+		mboxes = <&ans_mbox>;
+		apple,sart = <&ans_sart>;
+	};
+
+	/* The DARTs of PCIe ports 2 and 3 */
+	dart_apcie2: iommu@412000000 {
+		compatible = "apple,t6050-dart", "apple,t8110-dart";
+		reg = <0x4 0x12000000 0x0 0x20000>;
+		interrupts = <AIC_IRQ 0 1540 IRQ_TYPE_LEVEL_HIGH>;
+		#iommu-cells = <1>;
+		status = "disabled";
+	};
+
+	/*
+	 * /arm-io/dart-apcie0: apcie port 0's, which carries the N1 (its mappers Control, Alpha and
+	 * Beta on streams 1, 2 and 3). Disabled, like port 0, until the bootloader trains that port.
+	 */
+	dart_apcie0: iommu@410000000 {
+		compatible = "apple,t6050-dart", "apple,t8110-dart";
+		reg = <0x4 0x10000000 0x0 0x20000>;
+		interrupts = <AIC_IRQ 0 1524 IRQ_TYPE_LEVEL_HIGH>;
+		#iommu-cells = <1>;
+		status = "disabled";
+	};
+
+	dart_apcie3: iommu@413000000 {
+		compatible = "apple,t6050-dart", "apple,t8110-dart";
+		reg = <0x4 0x13000000 0x0 0x20000>;
+		interrupts = <AIC_IRQ 0 1548 IRQ_TYPE_LEVEL_HIGH>;
