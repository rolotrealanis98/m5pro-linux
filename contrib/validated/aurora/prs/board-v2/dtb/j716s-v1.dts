		pwm@505040000 {
			#pwm-cells = <0x02>;
			clocks = <0x1e>;
			compatible = "apple,t6050-fpwm", "apple,s5l-fpwm";
			phandle = <0x4f>;
			power-domains = <0x49>;
			reg = <0x05 0x5040000 0x00 0x4000>;
		};

		reset-controller@280620000 {
			#reset-cells = <0x01>;
			compatible = "apple,t6050-cio-reset";
			phandle = <0x31>;
			reg = <0x02 0x80620000 0x00 0x4000>;
			status = "okay";
		};

		serial@288e3c000 {
			apple,channel = <0x01>;
			apple,sw-drain;
			apple,tx-never-wait;
			compatible = "apple,dockchannel-uart";
			interrupts = <0x00 0x00 0x168 0x04>;
			reg = <0x02 0x88e3c000 0x00 0x30 0x02 0x88e38000 0x00 0x08 0x02 0x88e0c000 0x00 0x18>;
			reg-names = "data", "config", "irq";
			status = "okay";
		};

		smc@28c600000 {
			compatible = "apple,t6050-smc";
			mboxes = <0x20>;
			reg = <0x02 0x8c600000 0x00 0x4000 0x02 0x8de00000 0x00 0x140000>;
			reg-names = "smc", "sram";

			gpio@67700000 {
				#gpio-cells = <0x02>;
				compatible = "apple,smc-low-gpio";
				gpio-controller;
				phandle = <0x48>;
			};

			hwmon {
				apple,discover-temperatures;
				apple,soc-die-keys = "TCMb";
				compatible = "apple,smc-hwmon";
				status = "disabled";
			};

			reboot {
				compatible = "apple,smc-reboot";
				nvmem-cell-names = "shutdown_flag", "boot_stage", "boot_error_count", "panic_count", "pm_setting";
				nvmem-cells = <0x21 0x22 0x23 0x24 0x25>;
			};

			rtc {
				compatible = "apple,smc-rtc";
				nvmem-cell-names = "rtc_offset";
				nvmem-cells = <0x26>;
			};
		};

		spi@505118000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			clocks = <0x3f>;
			compatible = "apple,t6050-qspi", "apple,t8140-qspi";
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x00 0x55d 0x04>;
			power-domains = <0x40>;
			reg = <0x05 0x5118000 0x00 0x4800>;
			status = "disabled";
		};

		spmi@28a014000 {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			compatible = "apple,t6050-spmi", "apple,t8142-spmi";
			reg = <0x02 0x8a014000 0x00 0x4000>;

			pmic@e {
				compatible = "apple,abbey-pmic", "apple,spmi-nvmem";
				reg = <0x0e 0x00>;

				nvmem-layout {
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					compatible = "fixed-layout";

					boot-error-count@f802,0 {
						bits = <0x00 0x04>;
						phandle = <0x23>;
						reg = <0xf802 0x01>;
					};

					boot-stage@f801 {
						phandle = <0x22>;
						reg = <0xf801 0x01>;
					};

					panic-count@f802,4 {
						bits = <0x04 0x04>;
						phandle = <0x24>;
						reg = <0xf802 0x01>;
					};

					pm-setting@2001 {
						phandle = <0x25>;
						reg = <0x2001 0x01>;
					};

					rtc-offset@2100 {
						phandle = <0x26>;
						reg = <0x2100 0x06>;
					};

					shutdown-flag@f80f,3 {
						bits = <0x03 0x01>;
						phandle = <0x21>;
						reg = <0xf80f 0x01>;
					};
				};
			};
		};

		spmi@28a188000 {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			compatible = "apple,t6050-spmi", "apple,t8142-spmi";
			reg = <0x02 0x8a188000 0x00 0x4000>;

			usb-pd@a {
				compatible = "apple,sn201202x";
				reg = <0x0a 0x00>;

				connector {
					compatible = "usb-c-connector";
					data-role = "dual";
					label = "USB-C Left-front";
					power-role = "dual";

					ports {
						#address-cells = <0x01>;
						#size-cells = <0x00>;

						port@0 {
							reg = <0x00>;

							endpoint {
								phandle = <0x1d>;
								remote-endpoint = <0x2c>;
							};
						};

						port@1 {
							reg = <0x01>;

							endpoint {
								phandle = <0x19>;
								remote-endpoint = <0x2d>;
							};
						};
					};
				};
			};
		};

		spmi@28a1a8000 {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			compatible = "apple,t6050-spmi", "apple,t8142-spmi";
			reg = <0x02 0x8a1a8000 0x00 0x4000>;
