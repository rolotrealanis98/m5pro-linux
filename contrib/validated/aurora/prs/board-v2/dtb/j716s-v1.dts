			};

			power-controller@190 {
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				label = "atc3_usb_aon";
				phandle = <0x0f>;
				reg = <0x190 0x04>;
			};

			power-controller@198 {
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				label = "atc3_usb";
				phandle = <0x38>;
				power-domains = <0x07 0x0f>;
				reg = <0x198 0x04>;
			};

			power-controller@1a0 {
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				label = "atc3_phymxwrap";
				phandle = <0x37>;
				power-domains = <0x07 0x0f>;
				reg = <0x1a0 0x04>;
			};
