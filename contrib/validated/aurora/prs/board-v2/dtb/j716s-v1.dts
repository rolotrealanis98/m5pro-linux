				phandle = <0x32>;
				power-domains = <0x08>;
				reg = <0x410 0x04>;
				status = "disabled";
			};

			power-controller@418 {
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				label = "atc3_cio_usb";
				phandle = <0x33>;
				power-domains = <0x08>;
				reg = <0x418 0x04>;
				status = "disabled";
			};

			power-controller@420 {
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				label = "atc3_cio_auss";
				phandle = <0x34>;
				power-domains = <0x08 0x09>;
				reg = <0x420 0x04>;
				status = "disabled";
			};
		};

		power-management@280900000 {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			compatible = "apple,t6050-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
			reg = <0x02 0x80900000 0x00 0x4000>;

			power-controller@2a8 {
				#power-domain-cells = <0x00>;
