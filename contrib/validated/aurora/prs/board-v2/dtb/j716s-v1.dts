/dts-v1/;

/ {
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	chassis-type = "laptop";
	compatible = "apple,j716s", "apple,t6050", "apple,arm-platform";
	interrupt-parent = <0x01>;
	model = "Apple MacBook Pro (16-inch, M5 Pro, 2026)";

	aliases {
		bluetooth0 = "/pcie@1cb0000000/pci@0,0/bluetooth@0,2";
		keyboard = "/soc@200000000/fifo@294b14000/input@8000/keyboard";
		serial0 = "/soc@200000000/serial@288e3c000";
		wifi0 = "/pcie@1cb0000000/pci@0,0/wifi@0,1";
	};

	chosen {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		bootargs = "maxcpus=1";
		ranges;

		framebuffer@0 {
			apple,internal-panel;
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0x00 0x00 0x00 0x00>;
			status = "disabled";
		};
	};

	clock-405m {
		#clock-cells = <0x00>;
		clock-frequency = <0x1823cf40>;
		clock-output-names = "clk_405m";
		compatible = "fixed-clock";
		phandle = <0x3f>;
	};

	clock-ref {
		#clock-cells = <0x00>;
		clock-frequency = <0x16e3600>;
		clock-output-names = "clkref";
		compatible = "fixed-clock";
		phandle = <0x1e>;
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@10200 {
			compatible = "apple,everest";
			cpu-release-addr = <0x00 0x00>;
			device_type = "cpu";
			enable-method = "spin-table";
			operating-points-v2 = <0x05>;
			performance-domains = <0x06>;
			reg = <0x00 0x10200>;
		};

		cpu@10201 {
			compatible = "apple,everest";
			cpu-release-addr = <0x00 0x00>;
			device_type = "cpu";
			enable-method = "spin-table";
			operating-points-v2 = <0x05>;
			performance-domains = <0x06>;
			reg = <0x00 0x10201>;
		};

		cpu@10202 {
			compatible = "apple,everest";
			cpu-release-addr = <0x00 0x00>;
			device_type = "cpu";
			enable-method = "spin-table";
			operating-points-v2 = <0x05>;
			performance-domains = <0x06>;
			reg = <0x00 0x10202>;
		};

		cpu@10203 {
			compatible = "apple,everest";
			cpu-release-addr = <0x00 0x00>;
			device_type = "cpu";
			enable-method = "spin-table";
			operating-points-v2 = <0x05>;
			performance-domains = <0x06>;
			reg = <0x00 0x10203>;
		};

		cpu@10204 {
			compatible = "apple,everest";
			cpu-release-addr = <0x00 0x00>;
			device_type = "cpu";
			enable-method = "spin-table";
			operating-points-v2 = <0x05>;
			performance-domains = <0x06>;
			reg = <0x00 0x10204>;
		};

		cpu@10205 {
			compatible = "apple,everest";
			cpu-release-addr = <0x00 0x00>;
			device_type = "cpu";
			enable-method = "spin-table";
			operating-points-v2 = <0x05>;
			performance-domains = <0x06>;
			reg = <0x00 0x10205>;
		};

		cpu@40000 {
			compatible = "apple,sawtooth";
			cpu-release-addr = <0x00 0x00>;
			device_type = "cpu";
			enable-method = "spin-table";
			operating-points-v2 = <0x02>;
			performance-domains = <0x03>;
			reg = <0x00 0x40000>;
		};

		cpu@40001 {
			compatible = "apple,sawtooth";
			cpu-release-addr = <0x00 0x00>;
			device_type = "cpu";
			enable-method = "spin-table";
			operating-points-v2 = <0x02>;
			performance-domains = <0x03>;
			reg = <0x00 0x40001>;
		};

		cpu@40002 {
			compatible = "apple,sawtooth";
			cpu-release-addr = <0x00 0x00>;
			device_type = "cpu";
			enable-method = "spin-table";
			operating-points-v2 = <0x02>;
			performance-domains = <0x03>;
			reg = <0x00 0x40002>;
