			device_type = "cpu";
			enable-method = "spin-table";
			operating-points-v2 = <0x02>;
			performance-domains = <0x03>;
			reg = <0x00 0x40003>;
		};

		cpu@40004 {
			compatible = "apple,sawtooth";
			cpu-release-addr = <0x00 0x00>;
			device_type = "cpu";
			enable-method = "spin-table";
			operating-points-v2 = <0x02>;
			performance-domains = <0x03>;
			reg = <0x00 0x40004>;
		};

		cpu@40005 {
			compatible = "apple,sawtooth";
			cpu-release-addr = <0x00 0x00>;
			device_type = "cpu";
			enable-method = "spin-table";
			operating-points-v2 = <0x02>;
			performance-domains = <0x03>;
			reg = <0x00 0x40005>;
		};

		cpu@40100 {
			compatible = "apple,sawtooth";
			cpu-release-addr = <0x00 0x00>;
			device_type = "cpu";
			enable-method = "spin-table";
			operating-points-v2 = <0x02>;
			performance-domains = <0x04>;
			reg = <0x00 0x40100>;
		};

		cpu@40101 {
			compatible = "apple,sawtooth";
			cpu-release-addr = <0x00 0x00>;
			device_type = "cpu";
			enable-method = "spin-table";
			operating-points-v2 = <0x02>;
			performance-domains = <0x04>;
			reg = <0x00 0x40101>;
		};

		cpu@40102 {
			compatible = "apple,sawtooth";
			cpu-release-addr = <0x00 0x00>;
			device_type = "cpu";
			enable-method = "spin-table";
			operating-points-v2 = <0x02>;
			performance-domains = <0x04>;
			reg = <0x00 0x40102>;
		};

		cpu@40103 {
			compatible = "apple,sawtooth";
			cpu-release-addr = <0x00 0x00>;
			device_type = "cpu";
			enable-method = "spin-table";
			operating-points-v2 = <0x02>;
			performance-domains = <0x04>;
			reg = <0x00 0x40103>;
		};

		cpu@40104 {
			compatible = "apple,sawtooth";
			cpu-release-addr = <0x00 0x00>;
			device_type = "cpu";
			enable-method = "spin-table";
			operating-points-v2 = <0x02>;
			performance-domains = <0x04>;
			reg = <0x00 0x40104>;
		};

		cpu@40105 {
			compatible = "apple,sawtooth";
			cpu-release-addr = <0x00 0x00>;
			device_type = "cpu";
			enable-method = "spin-table";
			operating-points-v2 = <0x02>;
			performance-domains = <0x04>;
			reg = <0x00 0x40105>;
		};
	};

	led-controller {
		compatible = "pwm-leds";

		led-0 {
			color = <0x00>;
			default-state = "keep";
			function = "kbd_backlight";
			label = "kbd_backlight";
			max-brightness = <0xff>;
			pwms = <0x4f 0x00 0x9c40>;
		};
	};

	memory@10000000000 {
		device_type = "memory";
		reg = <0x100 0x00 0x00 0x00>;
	};

	opp-table-mcluster {
		compatible = "operating-points-v2";
