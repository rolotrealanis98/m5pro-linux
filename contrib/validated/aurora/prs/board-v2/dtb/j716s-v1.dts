			#address-cells = <0x02>;
			#size-cells = <0x00>;
			compatible = "apple,t6050-spmi", "apple,t8142-spmi";
			reg = <0x02 0x8a1c8000 0x00 0x4000>;
			status = "disabled";
		};

		usb@2a2280000 {
			compatible = "snps,dwc3";
			dr_mode = "peripheral";
			interrupts = <0x00 0x00 0x58b 0x04>;
			iommus = <0x4a 0x00 0x4b 0x01>;
			maximum-speed = "high-speed";
			reg = <0x02 0xa2280000 0x00 0xcd00>;
			snps,dis_enblslpm_quirk;
			snps,dis_u2_susphy_quirk;
			snps,dis_u3_susphy_quirk;
			snps,usb2-gadget-lpm-disable;
		};

		usb@2aa280000 {
			apple,tunable-cfg-host = <0x20 0xff 0x1b>;
			apple,tunable-cio = <0x20 0xff0000 0x1e0000>;
			apple,tunable-dbg = <0x00 0x08 0x08>;
			apple,tunable-gbl-default = <0x64 0x02 0x00 0x10 0xfff80000 0x680000>;
			apple,tunable-gbl-host = <0x04 0x1ef00 0x2f00 0x1c 0x100 0x00 0x2c 0xa07ff 0x800c8 0x100 0x2000100 0x2000100 0x504 0x1000 0x00 0x528 0xff0000ff 0x6000006 0x52c 0xff0000ff 0x8000008 0x580 0xffffffff 0x6f000006 0x584 0xffffffff 0x60000>;
			apple,tunable-link = <0x10 0xff000000 0xff000000 0x20 0x7ff00000 0x4e900000 0x24 0x1f8000 0xb8000 0x60 0x3ffff 0x600>;
			compatible = "apple,t6050-dwc3", "apple,t8103-dwc3";
			dr_mode = "otg";
			interrupts = <0x00 0x00 0x5ab 0x04>;
			iommus = <0x1a 0x00 0x1b 0x01>;
			phy-names = "usb2-phy", "usb3-phy";
			phys = <0x1c 0x03 0x1c 0x04>;
			power-domains = <0x18>;
			reg = <0x02 0xaa280000 0x00 0xcd00 0x02 0xaa28cd00 0x00 0x4b00 0x02 0xaa200000 0x00 0x4000>;
			reg-names = "dwc3-core", "dwc3-apple", "drd-cfg";
			resets = <0x1c 0x00>;
			role-switch-default-mode = "host";
			usb-role-switch;

			port {

				endpoint {
					phandle = <0x2c>;
					remote-endpoint = <0x1d>;
				};
			};
		};

		usb@382280000 {
			apple,tunable-cfg-host = <0x20 0xff 0x1b>;
			apple,tunable-cio = <0x20 0xff0000 0x1e0000>;
			apple,tunable-dbg = <0x00 0x08 0x08>;
			apple,tunable-gbl-default = <0x64 0x02 0x00 0x10 0xfff80000 0x680000>;
			apple,tunable-gbl-host = <0x04 0x1ef00 0x2f00 0x1c 0x100 0x00 0x2c 0xa07ff 0x800c8 0x100 0x2000100 0x2000100 0x504 0x1000 0x00 0x528 0xff0000ff 0x6000006 0x52c 0xff0000ff 0x8000008 0x580 0xffffffff 0x6f000006 0x584 0xffffffff 0x60000>;
			apple,tunable-link = <0x10 0xff000000 0xff000000 0x20 0x7ff00000 0x4e900000 0x24 0x1f8000 0xb8000 0x60 0x3ffff 0x600>;
			compatible = "apple,t6050-dwc3", "apple,t8103-dwc3";
			dr_mode = "otg";
			interrupts = <0x00 0x00 0x5cb 0x04>;
			iommus = <0x2e 0x00 0x2f 0x01>;
			phy-names = "usb2-phy", "usb3-phy";
			phys = <0x13 0x03 0x13 0x04>;
			power-domains = <0x2b>;
			reg = <0x03 0x82280000 0x00 0xcd00 0x03 0x8228cd00 0x00 0x4b00 0x03 0x82200000 0x00 0x4000>;
			reg-names = "dwc3-core", "dwc3-apple", "drd-cfg";
			resets = <0x13 0x00>;
			role-switch-default-mode = "host";
			status = "disabled";
			usb-role-switch;
		};

		usb@38a280000 {
			apple,tunable-cfg-host = <0x20 0xff 0x1b>;
			apple,tunable-cio = <0x20 0xff0000 0x1e0000>;
			apple,tunable-dbg = <0x00 0x08 0x08>;
			apple,tunable-gbl-default = <0x64 0x02 0x00 0x10 0xfff80000 0x680000>;
			apple,tunable-gbl-host = <0x04 0x1ef00 0x2f00 0x1c 0x100 0x00 0x2c 0xa07ff 0x800c8 0x100 0x2000100 0x2000100 0x504 0x1000 0x00 0x528 0xff0000ff 0x6000006 0x52c 0xff0000ff 0x8000008 0x580 0xffffffff 0x6f000006 0x584 0xffffffff 0x60000>;
			apple,tunable-link = <0x10 0xff000000 0xff000000 0x20 0x7ff00000 0x4e900000 0x24 0x1f8000 0xb8000 0x60 0x3ffff 0x600>;
			compatible = "apple,t6050-dwc3", "apple,t8103-dwc3";
			dr_mode = "otg";
			interrupts = <0x00 0x00 0x5eb 0x04>;
			iommus = <0x39 0x00 0x3a 0x01>;
			phy-names = "usb2-phy", "usb3-phy";
			phys = <0x3b 0x03 0x3b 0x04>;
			power-domains = <0x38>;
			reg = <0x03 0x8a280000 0x00 0xcd00 0x03 0x8a28cd00 0x00 0x4b00 0x03 0x8a200000 0x00 0x4000>;
			reg-names = "dwc3-core", "dwc3-apple", "drd-cfg";
			resets = <0x3b 0x00>;
			role-switch-default-mode = "host";
			status = "disabled";
			usb-role-switch;
		};

		watchdog@28836c000 {
			clocks = <0x1e>;
			compatible = "apple,t6050-wdt", "apple,t8103-wdt";
			interrupts = <0x00 0x00 0x2d1 0x04>;
			reg = <0x02 0x8836c000 0x00 0x4000>;
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-names = "phys", "virt", "hyp-phys", "hyp-virt";
		interrupt-parent = <0x01>;
		interrupts = <0x01 0x00 0x02 0x04 0x01 0x00 0x03 0x04 0x01 0x00 0x00 0x04 0x01 0x00 0x01 0x04>;
	};
};
