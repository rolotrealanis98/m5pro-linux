	pcie@1cb0000000 {
		#address-cells = <0x03>;
		#size-cells = <0x02>;
		apple,msi-vector-base = <0x40>;
		bus-range = <0x00 0x04>;
		compatible = "apple,t6050-pcie";
		device_type = "pci";
		dma-coherent;
		interrupt-names = "port0";
		interrupts = <0x00 0x00 0x5f3 0x04>;
		iommu-map = <0x100 0x4d 0x01 0x03>;
		iommu-map-mask = <0xffff>;
		linux,pci-domain = <0x00>;
		msi-controller;
		msi-parent = <0x4c>;
		msi-ranges = <0x01 0x00 0x00 0x760 0x01 0x40>;
		nonposted-mmio;
		phandle = <0x4c>;
		ranges = <0x2000000 0x00 0x80000000 0x0b 0x80000000 0x00 0x40000000 0x43000000 0x0b 0xc0000000 0x0b 0xc0000000 0x00 0x20000000>;
		reg = <0x1c 0xb0000000 0x00 0x10000000 0x04 0x14000000 0x00 0x4000 0x04 0x10028000 0x00 0x8000 0x04 0x17010000 0x00 0x4000 0x04 0x10024000 0x00 0x4000>;
		reg-names = "config", "rc", "port0", "phy0", "intr2axi0";

		pci@0,0 {
			#address-cells = <0x03>;
			#interrupt-cells = <0x01>;
			#size-cells = <0x02>;
			apple,link-trained-by-bootloader;
			bus-range = <0x01 0x01>;
			device_type = "pci";
			interrupt-controller;
			interrupt-map = <0x00 0x00 0x00 0x01 0x4e 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x02 0x4e 0x00 0x00 0x00 0x01 0x00 0x00 0x00 0x03 0x4e 0x00 0x00 0x00 0x02 0x00 0x00 0x00 0x04 0x4e 0x00 0x00 0x00 0x03>;
			interrupt-map-mask = <0x00 0x00 0x00 0x07>;
			phandle = <0x4e>;
			ranges;
			reg = <0x00 0x00 0x00 0x00 0x00>;
			reset-gpios = <0x3c 0x50 0x01>;
			status = "disabled";

			bluetooth@0,2 {
				compatible = "pci106b,1903";
				local-bd-address = [00 00 00 00 00 00];
				reg = <0x10200 0x00 0x00 0x00 0x00>;
			};

			control@0,0 {
				apple,centauri-platform-id = <0xc6050>;
				apple,centauri-protocol = <0x1b>;
				compatible = "pci106b,1900";
				firmware-name = "apple/centauri/j716s-ftab.bin";
				reg = <0x10000 0x00 0x00 0x00 0x00>;
			};

			wifi@0,1 {
				compatible = "pci106b,1902";
				local-mac-address = [00 00 00 00 00 00];
				reg = <0x10100 0x00 0x00 0x00 0x00>;
			};
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
	};

	soc@200000000 {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		nonposted-mmio;
		ranges = <0x02 0x00 0x02 0x00 0x03 0xc0000000>;

		aop@290c00000 {
			apple,dma-range = <0x110 0x00 0x10 0x00>;
			compatible = "apple,t6050-aop", "apple,t8152-aop";
			iommus = <0x41 0x00>;
			mbox-names = "mbox";
			mboxes = <0x42>;
			reg = <0x02 0x90c00000 0x00 0x1e0000 0x02 0x90600000 0x00 0x4000>;
			reg-names = "mmio", "asc";
			status = "disabled";

			audio {
				#sound-dai-cells = <0x01>;
				compatible = "apple,t6050-aop-audio";
				dma-names = "cout", "cin", "spkr", "sense";
				dmas = <0x43 0x04 0x43 0x05 0x43 0x00 0x43 0x01>;
			};
		};

		cio@389ac0000 {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			compatible = "apple,t6050-usb4-acio";
			mboxes = <0x30>;
			nonposted-mmio;
			power-domains = <0x08 0x32 0x33 0x34>;
			ranges = <0x00 0x03 0x89000000 0x1000000>;
			reg = <0x03 0x89ac0000 0x00 0xc000 0x03 0x89080000 0x00 0x26000 0x03 0x89100000 0x00 0x4000>;
			reg-names = "rc", "sram", "cpu";
			resets = <0x31 0x03>;
			status = "disabled";
			thunderbolt-switch;

			iommu@a80000 {
				#iommu-cells = <0x05>;
				compatible = "apple,t6050-dart", "apple,t8110-dart";
				interrupt-parent = <0x01>;
				interrupts = <0x00 0x00 0x6a6 0x04>;
				phandle = <0x35>;
				reg = <0xa80000 0xc000>;
			};

			nhi@f00000 {
				apple,thunderbolt-drom = [00];
				compatible = "apple,t6050-usb4-nhi";
				interrupt-names = "txring0", "txring1", "txring2", "txring3", "txring4", "txring5", "txring6", "txring7", "txring8", "txring9", "txring10", "txring11", "rxring0", "rxring1", "rxring2", "rxring3", "rxring4", "rxring5", "rxring6", "rxring7", "rxring8", "rxring9", "rxring10", "rxring11";
				interrupt-parent = <0x01>;
				interrupts = <0x00 0x00 0x68b 0x04 0x00 0x00 0x68c 0x04 0x00 0x00 0x68d 0x04 0x00 0x00 0x68e 0x04 0x00 0x00 0x68f 0x04 0x00 0x00 0x690 0x04 0x00 0x00 0x691 0x04 0x00 0x00 0x692 0x04 0x00 0x00 0x693 0x04 0x00 0x00 0x694 0x04 0x00 0x00 0x695 0x04 0x00 0x00 0x696 0x04 0x00 0x00 0x697 0x04 0x00 0x00 0x698 0x04 0x00 0x00 0x699 0x04 0x00 0x00 0x69a 0x04 0x00 0x00 0x69b 0x04 0x00 0x00 0x69c 0x04 0x00 0x00 0x69d 0x04 0x00 0x00 0x69e 0x04 0x00 0x00 0x69f 0x04 0x00 0x00 0x6a0 0x04 0x00 0x00 0x6a1 0x04 0x00 0x00 0x6a2 0x04>;
				iommus = <0x35 0x00 0x100 0x00 0x300 0x00 0x35 0x01 0x100 0x00 0x300 0x00 0x35 0x02 0x100 0x00 0x300 0x00 0x35 0x03 0x100 0x00 0x300 0x00 0x35 0x04 0x100 0x00 0x300 0x00 0x35 0x05 0x100 0x00 0x300 0x00 0x35 0x06 0x100 0x00 0x300 0x00 0x35 0x07 0x100 0x00 0x300 0x00 0x35 0x08 0x100 0x00 0x300 0x00 0x35 0x09 0x100 0x00 0x300 0x00 0x35 0x0a 0x100 0x00 0x300 0x00 0x35 0x0b 0x100 0x00 0x300 0x00 0x35 0x10 0x100 0x00 0x300 0x00 0x35 0x11 0x100 0x00 0x300 0x00 0x35 0x12 0x100 0x00 0x300 0x00 0x35 0x13 0x100 0x00 0x300 0x00 0x35 0x14 0x100 0x00 0x300 0x00 0x35 0x15 0x100 0x00 0x300 0x00 0x35 0x16 0x100 0x00 0x300 0x00 0x35 0x17 0x100 0x00 0x300 0x00 0x35 0x18 0x100 0x00 0x300 0x00 0x35 0x19 0x100 0x00 0x300 0x00 0x35 0x1a 0x100 0x00 0x300 0x00 0x35 0x1b 0x100 0x00 0x300 0x00>;
				reg = <0xf00000 0x100000>;
				reg-names = "nhi";
			};
		};

		dcp@2b2e00000 {
			apple,bw-scratch = <0x12 0x00 0x05 0x2c000>;
			apple,clock-ids;
			apple,connector-type = "USB-C";
			apple,dcp-index = <0x01>;
			apple,dptx-die = <0x00>;
			apple,typec-dptx-phys = <0x02>;
			apple,typec-mux-indices = <0x00>;
			compatible = "apple,t6050-dcpext", "apple,dcpext";
			iommus = <0x11 0x17>;
			mbox-names = "mbox";
			mboxes = <0x10>;
			mux-control-names = "typec0";
			mux-controls = <0x14 0x00>;
			phy-names = "typec0";
			phys = <0x13 0x06>;
			reg = <0x02 0xb2e00000 0x00 0x4000 0x02 0xb0000000 0x00 0x4000000 0x02 0xb2240000 0x00 0x10000 0x02 0xb23ac000 0x00 0x4000 0x02 0xb2800000 0x00 0x800000 0x02 0x86700000 0x00 0x114000 0x02 0xb2850000 0x00 0x4000>;
			reg-names = "coproc", "disp-0", "disp-1", "disp-2", "disp-3", "disp-4", "iop-vbar";
			status = "disabled";

			piodma {
				iommus = <0x15 0x10>;
			};

			typec-routes {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				route@0 {
					mode-switch;
					reg = <0x00>;
				};
			};
		};

		dma-controller@293800000 {
			#dma-cells = <0x01>;
			apple,dma-range = <0x110 0x00 0x00 0x10000000>;
			compatible = "apple,t6050-admac", "apple,t8140-admac";
			dma-channels = <0x0d>;
			interrupts-extended = <0x01 0x00 0x00 0x27d 0x04 0x00 0x00 0x00>;
			iommus = <0x41 0x08>;
			phandle = <0x43>;
			reg = <0x02 0x93800000 0x00 0x34000>;
			status = "disabled";
		};

		fifo@294b14000 {
			#address-cells = <0x01>;
			#interrupt-cells = <0x02>;
			#size-cells = <0x01>;
			compatible = "apple,t6050-dockchannel", "apple,dockchannel";
			interrupt-controller;
			interrupts = <0x00 0x00 0x294 0x04>;
			nonposted-mmio;
			phandle = <0x46>;
