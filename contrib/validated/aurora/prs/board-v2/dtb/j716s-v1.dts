				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				label = "fpwm0";
				phandle = <0x49>;
				reg = <0x2a8 0x04>;
			};

			power-controller@2c8 {
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				label = "i2c1";
				phandle = <0x3d>;
				reg = <0x2c8 0x04>;
			};

			power-controller@2d0 {
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				label = "i2c2";
				phandle = <0x3e>;
				reg = <0x2d0 0x04>;
			};

			power-controller@308 {
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				label = "spi_p";
				phandle = <0x0a>;
				reg = <0x308 0x04>;
			};

			power-controller@350 {
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				label = "qspi";
				phandle = <0x40>;
				power-domains = <0x0a>;
				reg = <0x350 0x04>;
			};
		};

		power-management@286806000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			apple,static-voters = <0x01 0x03>;
			compatible = "apple,t6050-pmc";
			reg = <0x02 0x86806000 0x00 0x3000 0x02 0x86700000 0x00 0x14000>;
			reg-names = "rails", "voters";

			performance-controller@1 {
				compatible = "apple,t6050-clpc", "apple,t6041-clpc";
				reg = <0x01>;
			};
		};

		power-management@288300000 {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			compatible = "apple,t6050-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
			reg = <0x02 0x88300000 0x00 0xc000>;

			power-controller@160 {
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				label = "atc1_usb_aon";
				phandle = <0x0c>;
				reg = <0x160 0x04>;
