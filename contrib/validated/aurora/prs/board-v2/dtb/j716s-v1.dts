			power-controller@168 {
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				label = "atc1_usb";
				phandle = <0x18>;
				power-domains = <0x0b 0x0c>;
				reg = <0x168 0x04>;
