			power-controller@178 {
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				label = "atc2_usb_aon";
				phandle = <0x0e>;
				reg = <0x178 0x04>;
				status = "disabled";
			};

			power-controller@180 {
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
				label = "atc2_usb";
				phandle = <0x2b>;
				power-domains = <0x0d 0x0e>;
