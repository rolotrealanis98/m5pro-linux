+/// The G17S builds the M5 Pro admits, newest first. The boot loader loads both roles' TEXT back
+/// to back into `fw-text`: the primary's 0x50000, then the secondary's 0x54000, each with its own
+/// GKTS/ECAP entropy records. Per role, two load fields of the image header and the boot loader's
+/// two boot-argument sections are zeroed, so a loaded copy normalizes to the digest of the
+/// firmware file's TEXT on every boot.
+const M5_PRO_BUILDS: &[crate::g17::fw::variant::Build] = &[
+    crate::g17::fw::variant::Build {
+        os_version: [27, 3, 0],
+        name: "27.3 (26C5035r), G17S",
+        images: &[crate::fwid::FirmwareBuild {
+            name: "26C5035r for T6050 G17S, primary then secondary",
+            text_size: 0xa4000,
+            data_size: 0x184000,
+            entropy: &[[0x49eac, 0x49f8f], [0x9d92c, 0x9da0f]],
+            boot_filled: &[
+                (0x224, 4),
+                (0x23c, 8),
+                (0x4976c, 0x740),
+                (0x49eac, 0x231),
+                (0x50224, 4),
+                (0x5023c, 8),
+                (0x9d1ec, 0x740),
+                (0x9d92c, 0x231),
+            ],
+            text_sha256: [
+                0xb5, 0x53, 0x7c, 0x8f, 0x06, 0xbd, 0x19, 0xeb, 0xf0, 0xef, 0xd0, 0xcb, 0xfb, 0x65,
+                0x52, 0x33, 0x9a, 0x10, 0xd4, 0xaf, 0xc4, 0xed, 0xa9, 0xd2, 0x1c, 0xbe, 0xdc, 0x36,
+                0x66, 0x76, 0x36, 0x00,
+            ],
+        }],
+        variant: &crate::g17::fw::variant::V26B123_M5,
+    },
+    crate::g17::fw::variant::Build {
+        os_version: [27, 2, 0],
+        name: "27.2 (26B123), G17S",
+        images: &[crate::fwid::FirmwareBuild {
+            name: "26B123 for T6050 G17S, primary then secondary",
+            text_size: 0xa4000,
+            data_size: 0x184000,
+            entropy: &[[0x49ea4, 0x49f87], [0x9d92c, 0x9da0f]],
+            boot_filled: &[
+                (0x224, 4),
+                (0x23c, 8),
+                (0x49764, 0x740),
+                (0x49ea4, 0x231),
+                (0x50224, 4),
