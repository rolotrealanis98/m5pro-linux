From 62dd8d8e7aba79906a6890d4ecb32974217c93e1 Mon Sep 17 00:00:00 2001
From: Rolando Trevino <rolotrealanis@gmail.com>
Date: Sat, 7 Nov 2026 12:48:23 -0500
Subject: [PATCH 09/13] drm/asahi: g17: m5: lay the power policy out for the
 firmware build

The M5 graph's policy encoders (encode_m5_bundle_policy() and the
boards' controller defaults) write the 26A428 layout. Keep the build's
policy map in InitData, set through set_m5_policy_layouts() from the
identified firmware's M5Layouts, and lay the policy out for it in
build_m5() once the controller defaults have run: the 26B123 layout
moves every word above 0x4910 and adds the 26B123 controller words
where the board's defaults applied. The maximum-power word read for
region C (0xa18) does not move.

The relayout stays within the build's own policy allocation: a policy
larger than the space before block_68 of the shared layout is refused.
The diagnostic policy read is bounded by the build's policy size.

The map defaults to 26A428, so the 26A428 graph is unchanged.

Signed-off-by: Rolando Trevino <rolotrealanis@gmail.com>
Assisted-by: LLM Claude
---
 drivers/gpu/drm/asahi/g17/initdata.rs    |  3 +++
 drivers/gpu/drm/asahi/g17/initdata/m5.rs | 28 ++++++++++++++++++++++--
 2 files changed, 29 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/asahi/g17/initdata.rs b/drivers/gpu/drm/asahi/g17/initdata.rs
index c444c385fef1..afe9f087950d 100644
--- a/drivers/gpu/drm/asahi/g17/initdata.rs
+++ b/drivers/gpu/drm/asahi/g17/initdata.rs
@@ -174,6 +174,8 @@ pub(super) struct InitData {
     m5: bool,
     /// The layout of the M5 graph, once [`InitData::build_m5`] has chosen it.
     m5_layout: &'static super::fw::m5::initdata::M5Layout,
+    /// Power-policy layout of the M5 firmware build.
+    m5_policy: &'static crate::g17::fw::m5::initdata::M5PolicyMap,
     outer_credits: Option<Arc<outer_credit::Credits>>,
     // Live publication uses interior writes under the device mutex. This owner is Send but not
     // Sync, so safe host code cannot issue those writes concurrently through shared references.
@@ -287,6 +289,7 @@ pub(super) fn new() -> Self {
         Self {
             m5: false,
             m5_layout: &super::fw::m5::initdata::M5_LAYOUT_26A428,
+            m5_policy: &crate::g17::fw::m5::initdata::M5_26A428_POLICY,
             outer_credits: None,
             _single_publisher: core::marker::PhantomData,
             aliases: KVec::new(),
diff --git a/drivers/gpu/drm/asahi/g17/initdata/m5.rs b/drivers/gpu/drm/asahi/g17/initdata/m5.rs
index 19b372582735..a987ee8a5b0c 100644
--- a/drivers/gpu/drm/asahi/g17/initdata/m5.rs
+++ b/drivers/gpu/drm/asahi/g17/initdata/m5.rs
@@ -38,7 +38,16 @@ pub(in crate::g17) fn m5_lower_links(canonical: core::ops::Range<u64>)
             ring(0), ring(1), ring(2), ring(3), page(canonical.start)]
     }
 
-    /// Diagnostic-only read of an aligned word within the existing policy allocation.
+    /// Selects the power-policy layout of the M5 firmware build `build_m5` encodes for.
+    pub(in crate::g17) fn set_m5_policy_layouts(
+        &mut self,
+        layouts: crate::g17::fw::variant::M5Layouts,
+    ) {
+        self.m5_policy = m::m5_policy(layouts);
+    }
+
+    /// Diagnostic-only read of an aligned word within the existing policy allocation, at the
+    /// firmware build's own offset.
     /// Callers hold the device state mutex, retaining this mapping for the entire sample.
     pub(crate) fn m5_policy_telemetry_word(&self, offset: usize) -> Result<u32> {
         let layout = self.m5_layout;
@@ -199,13 +208,28 @@ pub(crate) fn build_m5(
                 calibration.as_ref().is_ok_and(|words| words.as_slice() == expected)
             }
         };
-        if let Some(defaults) = board.controller_defaults.filter(|_| calibrated) {
+        let controller_defaults = board.controller_defaults.filter(|_| calibrated);
+        if let Some(defaults) = controller_defaults {
             defaults(self.object_mut(self.bundle)?.bytes_mut()).map_err(|_| EINVAL)?;
             let maximum = self.object(self.bundle)?.word(shared.policy + m::M5_POLICY_MAXIMUM_POWER)?
                 .load(Ordering::Relaxed);
             m::set_m5_region_maximum_power(self.object_mut(self.region_c)?.bytes_mut(), maximum)
                 .map_err(|_| EINVAL)?;
         }
+        // The policy encoders write the 26A428 layout; a build with another one gets it laid out
+        // in place, within its own allocation.
+        let policy = self.m5_policy;
+        let policy_end = shared.policy.checked_add(policy.size).ok_or(EINVAL)?;
+        if policy_end > shared.block_68 {
+            return Err(EINVAL);
+        }
+        m::relayout_m5_policy(
+            policy,
+            board,
+            controller_defaults.is_some(),
+            &mut self.object_mut(self.bundle)?.bytes_mut()[shared.policy..policy_end],
+        )
+        .map_err(|_| EINVAL)?;
         if let Some(microseconds) = board.idle_standby_us {
             m::set_m5_region_idle_standby(self.object_mut(self.region_c)?.bytes_mut(), microseconds)
                 .map_err(|_| EINVAL)?;
-- 
