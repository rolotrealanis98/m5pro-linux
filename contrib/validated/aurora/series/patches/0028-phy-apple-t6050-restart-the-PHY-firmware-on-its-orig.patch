From 244e40b46d3398256d77d4f8db1a58747dc371b1 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Wed, 4 Nov 2026 12:17:36 -0500
Subject: [PATCH 28/58] phy: apple: t6050: restart the PHY firmware on its
 original data

The PHY firmware is preloaded by the boot loader, data segment
included, and keeps its state in that segment. Restarted after a
stop, it ran on what its last run had left there and never finished
calibrating the lanes: UC_TNBL_DONE did not come, and every second
connection of a port failed, in USB as in CIO mode, until reboot.

Save the data SRAM when the firmware is first started and put it back
before every later start.

Developed with Claude Code.
Signed-off-by: Erik Bourget <erik@ebourget.net>
---
 drivers/phy/apple/atc-t6050-dp.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/drivers/phy/apple/atc-t6050-dp.c b/drivers/phy/apple/atc-t6050-dp.c
index 01c666bb9e7d..eb74b1e50181 100644
--- a/drivers/phy/apple/atc-t6050-dp.c
+++ b/drivers/phy/apple/atc-t6050-dp.c
@@ -94,6 +94,7 @@ struct t6050_dp {
 	struct apple_rtkit *rtkit;
 	void __iomem *fw_data;
 	bool fw_running;
+	void *fw_data_saved;	/* the firmware data SRAM as the first start found it */
 };
 
 static int atc_domain_set(struct atc_domain *pd, bool active)
@@ -180,6 +181,20 @@ static int atc_firmware(struct t6050_dp *dp, bool start)
 	if (dp->fw_running == start)
 		return 0;
 	if (start) {
+		/*
+		 * The firmware is the boot loader's, preloaded with its data segment, and keeps
+		 * its state there: restarted on the state its last run left, it never finishes
+		 * calibrating the lanes (UC_TNBL_DONE). Give every start the data segment the
+		 * first one found. The PHY's domains are on here, so the SRAM is accessible.
+		 */
+		if (!dp->fw_data_saved) {
+			dp->fw_data_saved = devm_kmalloc(dp->dev, 0x10000, GFP_KERNEL);
+			if (!dp->fw_data_saved)
+				return -ENOMEM;
+			memcpy_fromio(dp->fw_data_saved, dp->fw_data, 0x10000);
+		} else {
+			memcpy_toio(dp->fw_data, dp->fw_data_saved, 0x10000);
+		}
 		/* Native coprocessor run, after its +0x40 firmware enable. */
 		writel(BIT(4), dp->banks[38] + 0x28);
 		ret = apple_rtkit_wake(dp->rtkit);
