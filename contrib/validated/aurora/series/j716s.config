# MacBook Pro (16-inch, M5 Pro, 2026), J716s: the drivers on its boot path
# built in (the root file system carries no modules), on top of defconfig
# and asahi.config:
#   make ARCH=arm64 LLVM=1 defconfig asahi.config j716s.config

# Rust: the AOP (aop.rs) and its audio backend (aop_audio.rs,
# aop_t8140.rs) are Rust drivers. APPLE_PMP, which Rust turns on by
# default on ARCH_APPLE, is not brought up on the T6050 and stays off.
CONFIG_RUST=y
# CONFIG_APPLE_PMP is not set
CONFIG_DRM_APPLE=n
# The GPU is not brought up; DRM_ASAHI=m would still build its Rust DRM
# helpers (scheduler, GPUVM) into the kernel
# CONFIG_DRM_ASAHI is not set

# Storage: ANS NVMe behind SART, RTKit
CONFIG_NVME_APPLE=y
CONFIG_APPLE_SART=y
CONFIG_APPLE_RTKIT_HELPER=y

# SMC and its consumers
CONFIG_GPIO_MACSMC=y
CONFIG_INPUT_MACSMC_INPUT=y
CONFIG_POWER_RESET_MACSMC=y
CONFIG_SENSORS_MACSMC_HWMON=y
CONFIG_MACSMC_POWER=y

# CPU frequency
CONFIG_ARM_APPLE_SOC_CPUFREQ=y

# Pins (PCIe port 0's PERST#)
CONFIG_PINCTRL_APPLE_GPIO=y

# Keyboard and trackpad: DockChannel HID. HID_MAGICMOUSE drives the
# trackpad and depends on HID_APPLE_MTP_HAPTIC || !HID_APPLE_MTP_HAPTIC, so
# the MTP haptic driver (the trackpad's click actuator) is built in with it:
# asahi.config has the haptic driver as =m, which would cap magicmouse at =m.
CONFIG_APPLE_DOCKCHANNEL=y
CONFIG_HID_DOCKCHANNEL=y
CONFIG_HID_APPLE=y
CONFIG_HID_APPLE_MTP_HAPTIC=y
CONFIG_HID_MAGICMOUSE=y
CONFIG_HIDRAW=y

# Keyboard backlight and the backlight class
CONFIG_PWM_APPLE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# Type-C: combo PHY, dwc3, the SN201202x PD controller
CONFIG_TYPEC=y
CONFIG_TYPEC_TPS6598X=y
CONFIG_TYPEC_SN201202X=y
CONFIG_PHY_APPLE_ATC=y
CONFIG_PHY_APPLE_T6040_USB2=y
CONFIG_PHY_APPLE_T6050_DP=y
CONFIG_USB_DWC3_APPLE=y
CONFIG_USB_UAS=y

# USB network adapters used for bring-up
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_RTL8152=y

# Wi-Fi and Bluetooth: the N1 (centauri) on PCIe port 0
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_APPLE_CENTAURI=y
CONFIG_APPLE_CENTAURI_WIFI=y
CONFIG_BT=y
CONFIG_BT_HCICENTAURI=y

# Kernel crypto for iwd and wpa_supplicant: both do all of their hashing,
# ciphers and key derivation through AF_ALG, so the user API and every
# algorithm they name must be built in (the root has no modules)
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_AEAD=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_ARC4=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_ECDH=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_MD4=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y

# Audio: the AOP (co-processor, setup port, RTKit and mailbox), its T6050
# audio backend (jack and speaker CPU DAIs, the microphone card), the
# base-ns and LEAP-S ADMACs, the three I2C buses and the audio GPIOs, and
# macaudio with the SN012776 amps and the CS42L84 jack codec. The six amps
# share their shutdown GPIO, which needs the shared GPIO proxy.
CONFIG_APPLE_AOP=y
CONFIG_SND_SOC_APPLE_AOP_AUDIO=y
CONFIG_DMADEVICES=y
CONFIG_APPLE_ADMAC=y
CONFIG_I2C_APPLE=y
CONFIG_GPIO_SHARED=y
CONFIG_GPIO_SHARED_PROXY=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_PROC_FS=y
CONFIG_SND_DMAENGINE_PCM=y
CONFIG_SND_SOC_APPLE_MACAUDIO=y
CONFIG_SND_SOC_TAS2764=y
CONFIG_SND_SOC_CS42L84=y
# selected by macaudio; listed so they are not left at =m
CONFIG_SND_SOC_APPLE_MCA=y
CONFIG_SND_SOC_TAS2770=y
CONFIG_SND_SOC_CS42L83=y
CONFIG_SND_SOC_MAX98357A=y
CONFIG_SND_SIMPLE_CARD_UTILS=y
CONFIG_COMMON_CLK_APPLE_NCO=y
# /dev/i2c-* for reading the amps' registers with i2c-tools, and dynamic
# debug for the AOP and macaudio
CONFIG_I2C_CHARDEV=y
CONFIG_DYNAMIC_DEBUG=y

# Sleep: s2idle is the only state. PM_DEBUG adds /sys/power/pm_test, which
# runs the suspend path and resumes on its own after 5 s
CONFIG_PM_DEBUG=y

# Crash logs (no serial console). netconsole streams
# the log over the USB Ethernet adapter once userspace has configured a
# target through configfs (the adapter appears too late for netconsole=).
# A panic restarts after 10 s instead of waiting for the watchdog.
# pstore/ramoops is built in for a loader that supplies a ramoops node; the
# DT has none, since iBoot clears both ordinary DRAM and its /pram region at
# every boot, so nothing in RAM survives a reset on this machine today.
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
# CONFIG_PSTORE_FTRACE is not set
CONFIG_NETCONSOLE=y
CONFIG_NETCONSOLE_DYNAMIC=y
CONFIG_PRINTK_TIME=y
CONFIG_PANIC_TIMEOUT=10

# Userspace: pacman's download sandbox, compressed swap, /dev/mem
CONFIG_SECURITY_LANDLOCK=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_DEVMEM=y

# Virtual input devices: /dev/uinput (ydotool, key remappers, Steam Input,
# bluetoothd's AVRCP keys) and /dev/uhid (bluetoothd's HID over GATT, which
# every Bluetooth LE keyboard and mouse goes through)
CONFIG_INPUT_UINPUT=y
CONFIG_UHID=y

# Desktop networking (the root has no modules, so all of it is built in).
# Policy routing: Tailscale's router installs ip rules and table 52
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y

# WireGuard in the kernel (Tailscale, wg-quick)
CONFIG_WIREGUARD=y

# nftables, its NAT and conntrack, and the xtables compat layer that
# iptables-nft (ufw, Docker, Podman, Tailscale) goes through
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_MATCH_IPV6HEADER=y
CONFIG_IP6_NF_MATCH_RT=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_INGRESS=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_CONNMARK=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_HL=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_FTP=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_LOG_SYSLOG=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_FTP=y
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_NF_REJECT_IPV4=y
CONFIG_NF_REJECT_IPV6=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_CT=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_NAT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y

# Containers: veth pairs, a bridge with netfilter, overlayfs, FUSE
# (rootless Podman, Docker, Flatpak)
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_VETH=y
