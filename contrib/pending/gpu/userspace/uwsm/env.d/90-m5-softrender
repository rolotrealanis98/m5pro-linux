# J716s (M5 Pro) software rendering: Mesa llvmpipe on simpledrm.
# Install: ~/.config/uwsm/env.d/90-m5-softrender  (read by uwsm at session start;
# Omarchy's own defaults live in /usr/share/omarchy/default/uwsm/env.d/10-omarchy).
# Changes need a logout/login.

# Gallium software driver. llvmpipe is Mesa's default when there is no GPU
# driver; pinning it keeps softpipe (much slower) or zink-on-lavapipe out.
export GALLIUM_DRIVER=llvmpipe

# Vulkan: only lavapipe exists. Pin it so a stray ICD (vulkan-asahi) is not
# probed first. VK_DRIVER_FILES is the current loader variable,
# VK_ICD_FILENAMES the old one; both point at the same file.
export VK_DRIVER_FILES=/usr/share/vulkan/icd.d/lvp_icd.aarch64.json
export VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/lvp_icd.aarch64.json

# llvmpipe rasterizer threads per GL context. Default = online CPUs (18 here).
# Leave unset first; if many GL clients plus the compositor oversubscribe the
# cores, try 8 and compare with userspace/bin/m5-softrender-check --bench.
# export LP_NUM_THREADS=8

# GBM (the compositor's buffers): go straight to kms_swrast. Without it Mesa
# asks the loader for a simpledrm driver, then tries zink, then falls back to
# kms_swrast (src/gbm/backends/dri/gbm_dri.c). REMOVE once an AGX driver exists.
export GBM_ALWAYS_SOFTWARE=1

# Optional, measure before keeping (see README "Per-toolkit renderers"):
# export GSK_RENDERER=cairo        # GTK4 apps draw with cairo on the CPU
# export QT_QUICK_BACKEND=software # Qt Quick apps; may break Quickshell effects
