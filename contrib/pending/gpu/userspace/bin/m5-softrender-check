#!/bin/bash
# m5-softrender-check: report how the J716s draws without a GPU driver.
# Read-only: it opens DRM nodes, asks Mesa for its renderer and reads sysfs.
# It never writes registers, never touches /dev/mem, never loads modules.
#
#   m5-softrender-check            # inventory
#   m5-softrender-check --bench    # plus a 60 s glmark2 run and CPU numbers
#                                  # (run inside the Wayland session)
# Install: /usr/local/bin/m5-softrender-check
# Output is plain text; paste it into the bring-up log.

set -u
bench=0
[[ ${1:-} == --bench ]] && bench=1

section() { printf '\n== %s\n' "$1"; }
have() { command -v "$1" >/dev/null 2>&1; }

section "kernel"
uname -r
nproc
for sym in DRM_SIMPLEDRM UDMABUF DMABUF_HEAPS_SYSTEM SYNC_FILE DRM_ASAHI; do
  if [[ -r /proc/config.gz ]]; then
    printf '%-22s %s\n' "$sym" "$(zgrep -E "^(# )?CONFIG_${sym}[= ]" /proc/config.gz | head -1)"
  fi
done
[[ -r /proc/config.gz ]] || echo "(no /proc/config.gz; CONFIG_IKCONFIG_PROC is off)"
ls -l /dev/udmabuf /dev/dma_heap 2>/dev/null

section "DRM devices"
for card in /sys/class/drm/card[0-9]*; do
  [[ -e $card/device ]] || continue
  case $card in *-*) continue ;; esac
  drv=$(basename "$(readlink -f "$card/device/driver")" 2>/dev/null)
  echo "$(basename "$card"): driver=$drv"
  for conn in "$card"-*; do
    [[ -e $conn/status ]] || continue
    printf '  %s %s modes: %s\n' "$(basename "$conn")" "$(cat "$conn/status")" \
      "$(tr '\n' ' ' <"$conn/modes" 2>/dev/null)"
  done
done
ls /dev/dri 2>/dev/null
if have drm_info; then
  # Formats and planes of the simpledrm device: shows whether the native
  # format is XRGB8888 or a 10-bit one that simpledrm converts on every blit.
  drm_info 2>/dev/null | grep -E 'Driver:|Plane [0-9]|type:|formats|XRGB|XBGR|2101010|Mode:' | head -40
else
  echo "(drm_info not installed)"
fi
for fb in /sys/class/graphics/fb*; do
  [[ -e $fb ]] || continue
  echo "$(basename "$fb"): $(cat "$fb/name" 2>/dev/null) $(cat "$fb/virtual_size" 2>/dev/null) bpp=$(cat "$fb/bits_per_pixel" 2>/dev/null) stride=$(cat "$fb/stride" 2>/dev/null)"
done

section "Mesa / EGL (GBM platform, as the compositor sees it)"
if have eglinfo; then
  eglinfo -B -p gbm 2>/dev/null | grep -E 'GBM platform|EGL driver name|OpenGL( ES)? (profile )?(renderer|version)' | head -8
  [[ -n ${WAYLAND_DISPLAY:-} ]] && eglinfo -B -p wayland 2>/dev/null | grep -E 'renderer' | head -2
else
  echo "(eglinfo not installed: pacman -S mesa-utils)"
fi
echo "GALLIUM_DRIVER=${GALLIUM_DRIVER:-<unset>} LP_NUM_THREADS=${LP_NUM_THREADS:-<unset>}"

section "Vulkan"
if have vulkaninfo; then
  vulkaninfo --summary 2>/dev/null | grep -E 'deviceName|driverName|apiVersion' | head -6
else
  echo "(vulkaninfo not installed)"
fi

section "compositor"
if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && have hyprctl; then
  hyprctl version 2>/dev/null | head -1
  hyprctl monitors 2>/dev/null | grep -E 'Monitor|@|scale' | head -4
  for o in animations:enabled decoration:blur:enabled decoration:shadow:enabled cursor:no_hardware_cursors misc:vfr; do
    printf '  %-28s %s\n' "$o" "$(hyprctl -j getoption "$o" 2>/dev/null | tr -d '\n ' | head -c 120)"
  done
  marker="${XDG_RUNTIME_DIR:-}/hypr/$HYPRLAND_INSTANCE_SIGNATURE/omarchy-software-rendering"
  [[ -e $marker ]] && echo "  Omarchy software-rendering mark: $(cat "$marker")"
elif [[ -n ${SWAYSOCK:-} ]]; then
  echo "sway, WLR_RENDERER=${WLR_RENDERER:-<unset>}"
else
  echo "(not inside a Hyprland or sway session)"
fi

if (( bench )); then
  section "bench"
  if [[ -z ${WAYLAND_DISPLAY:-} ]]; then
    echo "run --bench inside the Wayland session"; exit 0
  fi
  idle=$(awk '/^cpu /{print $5+$6, $2+$3+$4+$5+$6+$7+$8}' /proc/stat)
  sleep 10
  idle2=$(awk '/^cpu /{print $5+$6, $2+$3+$4+$5+$6+$7+$8}' /proc/stat)
  read -r i1 t1 <<<"$idle"; read -r i2 t2 <<<"$idle2"
  echo "idle desktop, 10 s: CPU busy $(( 100 * ((t2-t1) - (i2-i1)) / (t2-t1) ))% of 18 cores"
  if have glmark2-es2-wayland; then
    # Windowed 1280x720 so the compositor's own work is included.
    timeout 120 glmark2-es2-wayland -s 1280x720 2>&1 | grep -E 'GL_RENDERER|glmark2 Score'
  else
    echo "(glmark2 not installed)"
  fi
fi
