#!/bin/bash
# Verify the DCP desktop path after a boot of the daily with the apple DRM
# driver: Hyprland on the GPU, scanout through the DCP at 120 Hz, VRR ready.
# Run as root on the MacBook while the tty2 session is up (sudo from a terminal
# in the session, or over ssh):
#   hypr-dcp-verify            static checks + 120 Hz, direct scanout and VRR runs (~2 min)
#   hypr-dcp-verify --static   read-only: cards, logs, hyprctl state (no clients, no tracing)
#   hypr-dcp-verify --quick    skip glmark2 and the direct scanout run
#   SECONDS_RUN=20 (vkcube/glmark2 run length), MAX_TOTAL=300 (watchdog)
# Loop-safe: no reboot, no session restart; every step has a timeout; the
# trace instance, test clients and misc:vrr are restored on exit (also on
# Ctrl-C or the watchdog). Opens test windows on the current workspace: do not
# touch the keyboard or trackpad while it runs (a visible cursor recomposites
# and blocks direct scanout). Results: /root/hypr-dcp-verify-<time>/.
# shellcheck disable=SC2015,SC2001,SC2329,SC2045,SC2010
set -u
MODE=full
for a in "$@"; do case $a in --static) MODE=static;; --quick) MODE=quick;; -h|--help) sed -n '2,15p' "$0"; exit 0;; esac; done
RUN=${SECONDS_RUN:-20}
MAX_TOTAL=${MAX_TOTAL:-300}
OUT=${OUT:-/root/hypr-dcp-verify-$(date +%Y%m%d-%H%M%S)}
[ "$(id -u)" = 0 ] || OUT=${OUT/#\/root/$HOME}
mkdir -p "$OUT"; exec > >(tee "$OUT/summary.txt") 2>&1
LIB=/usr/local/lib/hypr-cards.sh
pass=0 fail=0 warn=0
ok()   { pass=$((pass + 1)); echo "PASS  $*"; }
bad()  { fail=$((fail + 1)); echo "FAIL  $*"; }
meh()  { warn=$((warn + 1)); echo "WARN  $*"; }
info() { echo "      $*"; }
hdr()  { echo; echo "=== $*"; }

# --- watchdog and cleanup --------------------------------------------------
TRI='' VRR_ORIG='' HUID='' CLIENT_TAG=hypr-dcp-client
cleanup() {
  trap - EXIT INT TERM
  [ -n "$HUID" ] && pkill -TERM -u "$HUID" -f "^$CLIENT_TAG" 2>/dev/null && sleep 1 && pkill -KILL -u "$HUID" -f "^$CLIENT_TAG" 2>/dev/null
  if [ -n "$TRI" ] && [ -d "$TRI" ]; then
    echo 0 > "$TRI/tracing_on" 2>/dev/null
    for e in "$TRI"/events/*/*/enable; do echo 0 > "$e" 2>/dev/null; done
    rmdir "$TRI" 2>/dev/null
  fi
  [ -n "$VRR_ORIG" ] && hc eval "hl.config({ misc = { vrr = $VRR_ORIG } })" >/dev/null 2>&1
  [ -n "${WD:-}" ] && kill "$WD" 2>/dev/null
}
trap cleanup EXIT
trap 'echo "interrupted"; exit 130' INT TERM
( sleep "$MAX_TOTAL"; echo "watchdog: ${MAX_TOTAL}s reached, stopping"; kill -TERM $$ ) & WD=$!

# --- the running session ---------------------------------------------------
# Found from /proc and /run/user alone: works from root over ssh with no
# session environment. hyprland.lock in the instance dir holds Hyprland's pid
# (line 1) and its Wayland socket (line 2).
HPID=$(pgrep -x Hyprland | head -1)
if [ -z "$HPID" ]; then echo "FAIL  no Hyprland running (tty2 session down?)"; exit 2; fi
HUID=$(stat -c %u /proc/"$HPID"); HUSER=$(id -nu "$HUID"); HHOME=$(getent passwd "$HUSER" | cut -d: -f6)
XRD=/run/user/$HUID HIS='' WLD=''
for d in "$XRD"/hypr/*/; do
  d=${d%/}; [ -S "$d/.socket.sock" ] || continue
  if [ "$(sed -n 1p "$d/hyprland.lock" 2>/dev/null)" = "$HPID" ]; then HIS=${d##*/}; WLD=$(sed -n 2p "$d/hyprland.lock"); break; fi
done
if [ -z "$HIS" ]; then  # no matching lock: newest instance with a live socket
  for d in $(ls -td "$XRD"/hypr/*/ 2>/dev/null); do d=${d%/}; [ -S "$d/.socket.sock" ] && { HIS=${d##*/}; WLD=$(sed -n 2p "$d/hyprland.lock" 2>/dev/null); break; }; done
fi
[ -n "$HIS" ] || { echo "FAIL  no Hyprland instance socket under $XRD/hypr"; exit 2; }
[ -n "$WLD" ] || WLD=$(cd "$XRD" && ls wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | head -1)
# Client environment: a child of this Hyprland instance (same Mesa variables
# apps get); otherwise built from the instance and /etc/mesa-aurora/session.env.
CENV=()
for p in $(pgrep -u "$HUID"); do
  [ "$p" = "$HPID" ] && continue
  if tr '\0' '\n' < /proc/"$p"/environ 2>/dev/null | grep -qx "HYPRLAND_INSTANCE_SIGNATURE=$HIS"; then
    tr '\0' '\n' < /proc/"$p"/environ | grep -q '^WAYLAND_DISPLAY=' || continue
    mapfile -d '' CENV < /proc/"$p"/environ; CENV_FROM="pid $p"; break
  fi
done
if [ ${#CENV[@]} = 0 ]; then
  CENV=(HOME="$HHOME" USER="$HUSER" LOGNAME="$HUSER" PATH=/usr/local/bin:/usr/bin:/bin XDG_RUNTIME_DIR="$XRD"
        WAYLAND_DISPLAY="$WLD" HYPRLAND_INSTANCE_SIGNATURE="$HIS" XDG_SESSION_TYPE=wayland LANG=C.UTF-8)
  [ -r /etc/mesa-aurora/session.env ] && mapfile -t -O ${#CENV[@]} CENV < <(grep -E '^[A-Za-z_][A-Za-z0-9_]*=' /etc/mesa-aurora/session.env)
  CENV_FROM="built (instance + session.env)"
fi
HLOG=$XRD/hypr/$HIS/hyprland.log; SLOG=$HHOME/.cache/hyprland-gpu.log
# as_user SECONDS cmd...: run a client in the session as its user, with a
# timeout. (timeout cannot run shell functions; it runs inside runuser here.)
as_user() {
  local t=$1; shift
  if [ "$(id -u)" = "$HUID" ]; then timeout --kill-after=3 "$t" env -i "${CENV[@]}" "$@"
  else runuser -u "$HUSER" -- timeout --kill-after=3 "$t" env -i "${CENV[@]}" "$@"; fi
}
hc() { as_user 5 hyprctl "$@"; }
getopt_int() { hc getoption "$1" 2>/dev/null | awk '/^(int|bool):/{print $2; exit}'; }

echo "hypr-dcp-verify $(date -Is) kernel $(uname -r) mode $MODE"
echo "session: Hyprland pid $HPID user $HUSER instance $HIS wayland $WLD (client env: $CENV_FROM)"
echo "logs: $HLOG , $SLOG ; results $OUT"
# NUL bytes stripped: Hyprland's systeminfo block carries one, and GNU grep then
# treats the whole log as binary and prints no matching lines.
tr -d '\000' < "$HLOG" > "$OUT/hyprland.log" 2>/dev/null; tr -d '\000' < "$SLOG" > "$OUT/hyprland-gpu.log" 2>/dev/null
HL=$OUT/hyprland.log SL=$OUT/hyprland-gpu.log
v=$(hc version 2>&1 | head -1)
case $v in *Hyprland*) ok "hyprctl reaches instance $HIS";; *) bad "hyprctl cannot reach the instance: $v";; esac
dmesg > "$OUT/dmesg.txt" 2>/dev/null

# --- 1. cards --------------------------------------------------------------
hdr "1. cards (by driver)"
APPLE_CARD='' APPLE_CONNECTOR='' AURORA_CARD='' AURORA_RENDER='' SIMPLE_CARD='' RENDER_COUNT=0
if [ -r "$LIB" ]; then
  # shellcheck source=hypr-cards.sh
  . "$LIB"; hypr_cards_scan
else
  bad "missing $LIB (install.sh not run?)"
fi
for c in /sys/class/drm/card* /sys/class/drm/renderD*; do
  n=${c##*/}; [[ $n =~ ^(card|renderD)[0-9]+$ ]] || continue
  d=$(readlink -f "$c/device/driver"); info "$n -> ${d##*/}"
done
[ -n "$APPLE_CARD" ] && ok "apple display card $APPLE_CARD, panel $APPLE_CONNECTOR connected" || bad "no apple card with a connected eDP"
[ -n "$AURORA_RENDER" ] && ok "GPU render node $AURORA_RENDER (card ${AURORA_CARD:-?})" || bad "no aurora/asahi render node"
[ "$RENDER_COUNT" = 1 ] && ok "one renderD on the system (aquamarine pairs the apple card with it)" || bad "$RENDER_COUNT renderD nodes: aquamarine refuses to pick one -> software rendering"
[ -n "${SIMPLE_CARD:-}" ] && info "simpledrm still registered at $SIMPLE_CARD (not used by the session)"

# --- 2. launcher and backend log --------------------------------------------
hdr "2. launcher and backend (Hyprland log)"
l=$(grep -a -m1 'DCP path:' "$SL" 2>/dev/null)
[ -n "$l" ] && ok "launcher took the DCP path" && info "${l#*: }" || bad "launcher did not take the DCP path: $(grep -a -m1 'path' "$SL" 2>/dev/null)"
g() { grep -a -m1 -E "$1" "$HL" 2>/dev/null | sed -E 's/^[A-Z]+ +(from aquamarine +)?\]: (\[[^]]*\] )?//'; }
[ -s "$HL" ] || bad "Hyprland log $HLOG empty or unreadable"
l=$(g 'drm: Starting backend for'); info "$l"
if [[ $l == *"with driver apple"* ]] && [[ -z "$APPLE_CARD" || $l == *"$APPLE_CARD"* ]]; then ok "aquamarine drives the apple card"; else bad "aquamarine backend is not the apple card"; fi
l=$(g 'falling back to sole renderD|refusing to guess'); [ -n "$l" ] && info "$l"
l=$(g 'Creating CDRMRenderer on gpu'); info "$l"
[[ $l == *"${AURORA_RENDER:-renderD}"* ]] && ok "aquamarine renderer on the GPU render node" || bad "aquamarine renderer not on ${AURORA_RENDER:-the render node}"
l=$(grep -a -A4 'Creating the Hypr OpenGL Renderer' "$HL" 2>/dev/null | grep -a -m1 'Renderer: ' | sed 's/.*Renderer: //')
info "Hyprland GL renderer: $l"
case $l in *llvmpipe*|*softpipe*|'') bad "Hyprland renders in software (or no renderer line)";; *Apple*|*AGX*|*M5*) ok "Hyprland renders on the GPU ($l)";; *) meh "unexpected renderer: $l";; esac
l=$(g 'eglDeviceFromDRMFD: Using device'); [ -n "$l" ] && info "$l"
info "panel modes: $(grep -a -oE 'drm: Mode [0-9]+: [0-9x@.]+Hz( +\(preferred\))?' "$HL" 2>/dev/null | sed 's/drm: Mode [0-9]*: //' | sort -u | tr '\n' ' ')"
l=$(grep -a -m1 -E 'GBM: Allocated a new buffer with size .*3456.*2234' "$HL" 2>/dev/null | sed 's/.*GBM: //')
if [ -n "$l" ]; then
  info "scanout buffer: $l"
  case $l in *LINEAR*|*INVALID*|*0xffffffffffffff*) ok "scanout buffers 3456x2234, linear (GPU renders straight into them; no copy)";; *) meh "scanout buffer modifier is not LINEAR: $l";; esac
else meh "no 3456x2234 GBM allocation line found (log buffered or trace level?)"; fi
grep -a -q 'Using modifier-less allocation\|falling back to modifier-less' "$HL" 2>/dev/null && info "aquamarine used modifier-less GBM allocation (AQ_NO_MODIFIERS / kms_swrast GBM)"
l=$(g 'drm: Explicit sync (supported|unsupported)'); info "${l:-no explicit-sync line}"
[[ $l == *supported* && $l != *unsupported* ]] && ok "KMS explicit sync (IN_FENCE_FD/OUT_FENCE_PTR) available" || meh "KMS explicit sync unsupported (implicit sync only)"
for k in 'DisplayNode syncobj timeline support' 'RenderNode syncobj timeline support'; do info "$(g "$k")"; done
l=$(g 'crtc is (capable|incapable) of vrr'); info "$l"
VRR_LOG=0; [[ $l == *"is capable of vrr"* ]] && VRR_LOG=1

# --- 3. hyprctl state -------------------------------------------------------
hdr "3. hyprctl"
hc monitors -j > "$OUT/monitors.json" 2>&1
hc systeminfo > "$OUT/systeminfo.txt" 2>&1
mon() { jq -r "[.[] | select(.name|test(\"^eDP-\"))][0] | $1" "$OUT/monitors.json" 2>/dev/null; }
name=$(mon .name); w=$(mon .width); h=$(mon .height); hz=$(mon .refreshRate)
info "monitor ${name:-?}: ${w}x${h}@${hz} scale $(mon .scale) format $(mon .currentFormat) vrr $(mon .vrr) vrrCapable $(mon .hardwareDetails.vrrCapable) hwcursor $(mon .hardwareCursorsInUse)"
[ "$w" = 3456 ] && [ "$h" = 2234 ] && ok "mode 3456x2234" || bad "mode is ${w}x${h}"
awk -v r="${hz:-0}" 'BEGIN{exit !(r>119.5 && r<120.5)}' && ok "refresh $hz Hz" || bad "refresh $hz Hz (want 120.00000)"
case $(mon .currentFormat) in XRGB8888|XR24) ok "scanout format $(mon .currentFormat) (8-bit)";; *) meh "scanout format $(mon .currentFormat)";; esac
# VRR offered? Same sources as hypr-dcp-precheck/the launcher (vrr_capable via
# modetest, else appledrm.fw27_panel_vrr), cross-checked with Hyprland's view
# and aquamarine's log; any of them saying yes runs the VRR test.
VRR_HC=$(mon .hardwareDetails.vrrCapable); VRR_LIB=$(declare -F hypr_panel_vrr >/dev/null && hypr_panel_vrr || echo '?')
VRRCAP=false; { [ "$VRR_HC" = true ] || [ "$VRR_LIB" = 1 ] || [ "$VRR_LOG" = 1 ]; } && VRRCAP=true
info "VRR offered: hyprctl vrrCapable=$VRR_HC, vrr_capable/module param=$VRR_LIB, aquamarine log=$VRR_LOG -> $VRRCAP; vrr active now: $(mon .vrr)"
[ "$VRRCAP" = true ] && { [ "$VRR_HC" = true ] && [ "$VRR_LIB" = 1 ] || meh "VRR sources disagree (hyprctl $VRR_HC, kernel $VRR_LIB, log $VRR_LOG)"; }
info "direct scanout blocked by: $(jq -c '[.[] | select(.name|test("^eDP-"))][0].directScanoutBlockedBy' "$OUT/monitors.json" 2>/dev/null)"
grep -a -E '^(Explicit sync|GL ver|FP16|Backend):|Panel |explicit|vrr capable' "$OUT/systeminfo.txt" | sed 's/^\s*/      /'
grep -a -q '^Explicit sync: supported' "$OUT/systeminfo.txt" && ok "EGL native fence sync (explicit sync to KMS and clients)" || meh "EGL_ANDROID_native_fence_sync missing: implicit sync"
ds=$(getopt_int render:direct_scanout); vr=$(getopt_int misc:vrr); hw=$(getopt_int cursor:no_hardware_cursors)
info "options: render:direct_scanout=$ds misc:vrr=$vr cursor:no_hardware_cursors=$hw debug:vfr=$(getopt_int debug:vfr) animations:enabled=$(getopt_int animations:enabled) blur=$(getopt_int decoration:blur:enabled)"
# The launcher turns direct scanout off without modifiers (M5PRO_DCP_DIRECT_SCANOUT=0).
want_ds=$(tr '\0' '\n' < "/proc/$HPID/environ" 2>/dev/null | sed -n 's/^M5PRO_DCP_DIRECT_SCANOUT=//p'); want_ds=${want_ds:-1}
[ "$hw" = 1 ] && [ "$ds" = "$want_ds" ] && ok "m5pro-dcp profile active (direct_scanout=$ds as the launcher set)" || bad "m5pro-dcp profile not active (direct_scanout=$ds, launcher wants $want_ds, no_hardware_cursors=$hw): check hyprland.lua profile switch and M5PRO_HYPR_PROFILE"

# --- 4. kernel health -------------------------------------------------------
hdr "4. kernel log"
k=$(grep -a -iE 'DCP has crashed|swap failed|swap timed out|set_digital_out_mode (timed out|returned)|adaptive swap timed out|apple-drm.*(error|fail)|aurora.*(fault|timeout|hang)' "$OUT/dmesg.txt" | tail -8)
[ -z "$k" ] && ok "no DCP/GPU errors in dmesg" || { bad "DCP/GPU errors in dmesg:"; sed 's/^/      /' <<<"$k"; }

if [ "$MODE" = static ]; then
  hdr "summary: $pass passed, $fail failed, $warn warnings (static)"; exit $((fail > 0))
fi
if [ "$(id -u)" != 0 ]; then meh "not root: no tracing, skipping the timed runs"; hdr "summary: $pass passed, $fail failed, $warn warnings"; exit $((fail > 0)); fi

# --- 5. tracing -------------------------------------------------------------
hdr "5. page-flip timing (dcp:iomfb_swap_complete)"
TR=/sys/kernel/tracing
[ -d $TR/instances ] || mount -t tracefs nodev $TR 2>/dev/null
if [ ! -d $TR/events/dcp/iomfb_swap_complete ]; then
  bad "no dcp:iomfb_swap_complete tracepoint (CONFIG_TRACING off or apple-drm not built in): timed runs skipped"
  hdr "summary: $pass passed, $fail failed, $warn warnings"; exit 1
fi
TRI=$TR/instances/hypr-dcp-verify-$$
mkdir "$TRI" || { bad "cannot create trace instance"; exit 1; }
echo mono > "$TRI/trace_clock" 2>/dev/null
echo 8192 > "$TRI/buffer_size_kb"
for e in dcp/iomfb_swap_submit dcp/iomfb_swap_complete drm/drm_vblank_event_delivered; do
  [ -e "$TRI/events/$e/enable" ] && echo 1 > "$TRI/events/$e/enable" 2>/dev/null
done
if [ "$(cat "$TRI/events/dcp/iomfb_swap_complete/enable" 2>/dev/null)" = 1 ]; then ok "trace instance ${TRI##*/}: dcp:iomfb_swap_complete enabled"
else bad "could not enable dcp:iomfb_swap_complete in ${TRI##*/}"; fi
echo 0 > "$TRI/tracing_on"

cat > "$OUT/analyze.py" <<'PY'
# analyze.py TRACE LABEL NOMINAL_MS: page-flip interval statistics from
# dcp:iomfb_swap_complete timestamps (internal DCP = the one with most events).
# Prints {"swaps": 0, ...} only when nothing was captured; callers must treat
# swaps == 0 as a failed run.
import re, sys, json, statistics as st
path, label, nominal = sys.argv[1], sys.argv[2], float(sys.argv[3])
ev = re.compile(r'\s(\d+\.\d+):\s+(iomfb_swap_complete|iomfb_swap_submit):\s+dcp=([0-9a-f]+), swap_id=(\d+)')
comp, subm = {}, {}
for line in open(path, errors='replace'):
    m = ev.search(line)
    if not m: continue
    t, name, dcp, sid = float(m.group(1)), m.group(2), m.group(3), int(m.group(4))
    (comp if name == 'iomfb_swap_complete' else subm).setdefault(dcp, []).append((t, sid))
if not comp or max(len(v) for v in comp.values()) < 3:
    print(json.dumps({'label': label, 'swaps': 0})); sys.exit(0)
dcp = max(comp, key=lambda k: len(comp[k]))
ts = [t for t, _ in comp[dcp]]
iv = [(b - a) * 1000 for a, b in zip(ts, ts[1:])]
span = ts[-1] - ts[0]
persec = [0] * (int(span) + 1)
for t in ts: persec[min(int(t - ts[0]), len(persec) - 1)] += 1
persec = persec[:-1] or persec          # drop the partial last second
def pct(v, p):
    v = sorted(v); return v[min(len(v) - 1, int(round(p / 100 * (len(v) - 1))))] if v else 0
def hist(step):
    h = {}
    for x in iv:
        k = max(1, round(x / step)); h[k] = h.get(k, 0) + 1
    return dict(sorted(h.items()))
lat = []
sub = {sid: t for t, sid in subm.get(dcp, [])}
for t, sid in comp[dcp]:
    if sid in sub and t >= sub[sid]: lat.append((t - sub[sid]) * 1000)
print(json.dumps({
    'label': label, 'swaps': len(ts), 'seconds': round(span, 2),
    'rate_per_s': {'min': min(persec), 'median': st.median(persec), 'max': max(persec)},
    'per_second': persec,
    'interval_ms': {k: round(pct(iv, p), 3) for k, p in (('p1', 1), ('p5', 5), ('p50', 50), ('p95', 95), ('p99', 99), ('max', 100))},
    'mean_ms': round(st.mean(iv), 3), 'stdev_ms': round(st.pstdev(iv), 3),
    'within_05': round(sum(abs(x - nominal) <= 0.5 for x in iv) / len(iv), 3),
    'within_15': round(sum(abs(x - nominal) <= 1.5 for x in iv) / len(iv), 3),
    'late': sum(x >= 1.5 * nominal for x in iv),
    'periods_120hz': hist(1000 / 120),        # whole 8.33 ms refreshes per interval
    'subframes_240hz': hist(1000 / 240),      # DCP 4.17 ms subframes per interval (VRR steps)
    'submit_to_complete_ms': {'p50': round(pct(lat, 50), 3), 'p99': round(pct(lat, 99), 3)} if lat else None,
}))
PY

# record LABEL SECONDS NOMINAL_MS cmd...: start the client, let it settle 3 s,
# trace SECONDS, sample hyprctl monitors at the midpoint, stop the client.
# Returns 0 only when swap events were captured (callers then judge the numbers).
record() {
  local label=$1 secs=$2 nominal=$3 cpid sw; shift 3
  as_user $((secs + 10)) bash -c "exec -a $CLIENT_TAG \"\$0\" \"\$@\"" "$@" > "$OUT/$label.client.txt" 2>&1 &
  cpid=$!
  sleep 3
  if ! pgrep -u "$HUID" -f "^$CLIENT_TAG" >/dev/null; then
    bad "$label: client did not start: $(tail -2 "$OUT/$label.client.txt" | tr '\n' ' ')"; wait "$cpid" 2>/dev/null; return 1
  fi
  echo > "$TRI/trace"; echo 1 > "$TRI/tracing_on"
  sleep $((secs / 2)); hc monitors -j > "$OUT/$label.monitors.json" 2>&1; sleep $((secs - secs / 2))
  echo 0 > "$TRI/tracing_on"
  cp "$TRI/trace" "$OUT/$label.trace"
  pkill -TERM -u "$HUID" -f "^$CLIENT_TAG"; sleep 1; pkill -KILL -u "$HUID" -f "^$CLIENT_TAG" 2>/dev/null; wait "$cpid" 2>/dev/null
  timeout 30 python3 -I "$OUT/analyze.py" "$OUT/$label.trace" "$label" "$nominal" > "$OUT/$label.json" 2> "$OUT/$label.analyze.err"
  sw=$(jv "$label" .swaps)
  jq -r --arg l "$label" '[.[] | select(.name|test("^eDP-"))][0] | "      \($l) midpoint: vrr \(.vrr) directScanoutTo \(.directScanoutTo) blockedBy \(.directScanoutBlockedBy|tostring)"' "$OUT/$label.monitors.json" 2>/dev/null
  if [ -z "$sw" ] || [ "$sw" = 0 ] || [ "$sw" = null ]; then
    bad "$label: no swap events captured ($(grep -c iomfb_swap "$OUT/$label.trace" 2>/dev/null) trace lines; $(head -c 200 "$OUT/$label.analyze.err" 2>/dev/null))"; return 1
  fi
  jq -r '"      \(.label): \(.swaps) swaps in \(.seconds) s; per second min/median/max \(.rate_per_s.min)/\(.rate_per_s.median)/\(.rate_per_s.max); interval ms p1 \(.interval_ms.p1) p50 \(.interval_ms.p50) p95 \(.interval_ms.p95) p99 \(.interval_ms.p99) max \(.interval_ms.max); stdev \(.stdev_ms); late(>=1.5x nominal) \(.late)\n      refreshes(8.33 ms) \(.periods_120hz|tostring); subframes(4.17 ms) \(.subframes_240hz|tostring); submit->complete ms \(.submit_to_complete_ms|tostring)"' "$OUT/$label.json"
  return 0
}
jv() { jq -r "$2" "$OUT/$1.json" 2>/dev/null; }
VRR_NOW=$(getopt_int misc:vrr)

# a) idle desktop: VFR means (almost) no swaps
echo > "$TRI/trace"; echo 1 > "$TRI/tracing_on"; sleep 3; echo 0 > "$TRI/tracing_on"
n=$(grep -c 'iomfb_swap_complete' "$TRI/trace"); info "idle desktop: $n swaps in 3 s"
[ "$n" -le 30 ] && ok "VFR: an idle desktop does not flip at 120 Hz ($n swaps/3 s)" || meh "idle desktop flips $n times in 3 s (something is animating, or VFR off)"

# b) vkcube, composited (FIFO at the refresh rate): 120 swaps/s expected
VK=(vkcube); vkcube --help 2>&1 | grep -q -- '--wsi' && VK+=(--wsi wayland)
info "timed runs b-d with misc:vrr=$VRR_NOW (the profile's setting)"
if command -v vkcube >/dev/null && record vkcube "$RUN" 8.333 "${VK[@]}"; then
  med=$(jv vkcube .rate_per_s.median); p50=$(jv vkcube .interval_ms.p50); late=$(jv vkcube .late); sw=$(jv vkcube .swaps)
  if awk -v m="$med" -v p="$p50" -v l="$late" -v s="$sw" 'BEGIN{exit !(s>0 && m>=115 && p>8.0 && p<8.7 && l/s<0.02)}'; then ok "vkcube composited at 120 Hz (median $med swaps/s, p50 $p50 ms, $late late of $sw)"
  elif awk -v m="$med" 'BEGIN{exit !(m>=100)}'; then meh "vkcube near 120 Hz with stutter (median $med/s, p50 $p50 ms, $late late of $sw)"
  else bad "vkcube not at 120 Hz (median $med swaps/s, p50 $p50 ms)"; fi
fi

# c) glmark2 fullscreen: the GPU saturated by an unthrottled client. glmark2's
# FPS is its own render rate (most frames are replaced before display); the
# swap rate is what the DCP showed. Informational: how late compositor frames
# land (16.7 ms at fixed 120 Hz, 12.5 ms = 3 subframes with VRR).
if [ "$MODE" = full ] && command -v glmark2-es2-wayland >/dev/null; then
  swapchains() { tr -d '\000' < "$HLOG" 2>/dev/null | grep -ac 'Reconfigured a swapchain'; }
  sc0=$(swapchains)
  if record glmark2 "$RUN" 8.333 glmark2-es2-wayland --fullscreen -b "build:duration=$((RUN + 5))"; then
    sc=$(( $(swapchains) - sc0 ))
    # Each reconfigure allocates 3 scanout buffers (31 MB dumb buffers); a
    # direct-scanout retry storm does 2 per client frame and leaks them.
    [ "$sc" -le 4 ] && ok "glmark2: swapchain reconfigured $sc times" || bad "glmark2: swapchain reconfigured $sc times (direct-scanout retry storm; 3 new 31 MB buffers each)"
    info "glmark2 client: $(grep -m1 'GL_RENDERER' "$OUT/glmark2.client.txt" | sed 's/^ *//') ; $(grep -m1 -oE 'FPS: [0-9]+ FrameTime: [0-9.]+ ms' "$OUT/glmark2.client.txt")"
    grep -q 'cannot encode\|dropping work' "$OUT/glmark2.client.txt" && meh "glmark2: Mesa skipped draws (shader the AGX backend refused): its FPS overstates the GPU"
    ok "glmark2 fullscreen traced: display showed $(jv glmark2 .rate_per_s.median) frames/s while the client rendered unthrottled"
  fi
fi

# mpv test source: lavfi in-process, or a generated file if this mpv lacks lavfi
MPV=(mpv --no-config --really-quiet --no-audio --hwdec=no --loop-file=inf --keep-open=yes)
mpvsrc() {  # mpvsrc RATE -> a playable URL/file (empty when neither works)
  local f=/tmp/hypr-dcp-verify-$1.mkv
  if as_user 8 mpv --no-config --really-quiet --no-audio --vo=null --frames=5 "av://lavfi:testsrc2=size=1280x720:rate=$1" >/dev/null 2>&1; then
    echo "av://lavfi:testsrc2=size=1280x720:rate=$1"; return
  fi
  [ -s "$f" ] || as_user 60 ffmpeg -loglevel error -y -f lavfi -i "testsrc2=size=1280x720:rate=$1" -t 40 -c:v libx264 -preset ultrafast -pix_fmt yuv420p "$f" >/dev/null 2>&1
  [ -s "$f" ] && echo "$f"
}

# d) direct scanout: HiDPI-aware fullscreen client (buffer = 3456x2234)
if [ "$MODE" = full ] && command -v mpv >/dev/null; then
  src=$(mpvsrc 120)
  if [ -z "$src" ]; then bad "mpv-fs: no test source (mpv lavfi and ffmpeg both failed)"
  elif record mpv-fs 10 8.333 "${MPV[@]}" --fs "$src"; then
    dst=$(jq -r '[.[] | select(.name|test("^eDP-"))][0].directScanoutTo' "$OUT/mpv-fs.monitors.json" 2>/dev/null)
    if [ -n "$dst" ] && [ "$dst" != 0 ] && [ "$dst" != null ]; then ok "direct scanout active for the fullscreen client ($dst)"
    else meh "no direct scanout for fullscreen mpv (blockedBy $(jq -c '[.[] | select(.name|test("^eDP-"))][0].directScanoutBlockedBy' "$OUT/mpv-fs.monitors.json" 2>/dev/null)); composited instead"; fi
  fi
fi

# --- 6. VRR -----------------------------------------------------------------
hdr "6. VRR with a 50 fps client (20 ms frames)"
if command -v mpv >/dev/null && src50=$(mpvsrc 50) && [ -n "$src50" ]; then
  VRR_ORIG=${VRR_NOW:-0}
  if [ "$VRR_ORIG" != 0 ]; then hc eval 'hl.config({ misc = { vrr = 0 } })' >/dev/null; sleep 2; fi   # VRR_ENABLED change: ~200 ms dark
  if record mpv50-fixed 15 20.0 "${MPV[@]}" "$src50"; then
    info "VRR off: 20 ms frames land on whole 120 Hz refreshes (2 or 3 = 16.7/25 ms, judder): $(jv mpv50-fixed '.periods_120hz|tostring')"
  fi
  if [ "$VRRCAP" = true ]; then
    hc eval 'hl.config({ misc = { vrr = 1 } })' >/dev/null; sleep 2
    v=$(hc monitors -j | jq -r '[.[] | select(.name|test("^eDP-"))][0].vrr')
    [ "$v" = true ] && ok "misc:vrr=1 -> monitor vrr true" || bad "misc:vrr=1 but monitor vrr $v"
    if record mpv50-vrr 15 20.0 "${MPV[@]}" "$src50"; then
      p50=$(jv mpv50-vrr .interval_ms.p50); w=$(jv mpv50-vrr .within_15); wf=$(jv mpv50-fixed .within_15)
      if awk -v p="$p50" -v w="$w" 'BEGIN{exit !(p>19 && p<21.5 && w>=0.7)}'; then
        ok "VRR follows the client: p50 $p50 ms, $(awk -v w="$w" 'BEGIN{printf "%d", w*100}')% within 1.5 ms of 20 ms (VRR off: $(awk -v w="${wf:-0}" 'BEGIN{printf "%d", w*100}')%)"
      else bad "VRR not pacing at 20 ms (p50 $p50 ms, within 1.5 ms: $w; VRR off: ${wf:-?})"; fi
    fi
    k=$(dmesg | tail -300 | grep -a -iE 'VRR_ENABLED|adaptive_sync|VRR=|watchdog|swap timed out' | tail -6); [ -n "$k" ] && { info "kernel (VRR):"; sed 's/^/      /' <<<"$k"; }
  else
    info "panel does not offer VRR on this boot (all sources say no; boot with appledrm.fw27_panel_vrr=1): VRR run skipped"
  fi
  hc eval "hl.config({ misc = { vrr = $VRR_ORIG } })" >/dev/null; VRR_ORIG=''
else
  meh "VRR run skipped: no mpv test source"
fi

hdr "Hyprland rolling log (last lines)"
as_user 3 hyprctl rollinglog 2>/dev/null | tail -15 | cut -c1-200 | sed 's/^/      /'
hdr "summary: $pass passed, $fail failed, $warn warnings; details in $OUT"
exit $((fail > 0))
