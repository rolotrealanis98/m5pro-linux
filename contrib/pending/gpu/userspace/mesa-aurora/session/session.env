# Mesa environment for the GPU desktop session on the M5 Pro (aurora DRM
# driver): GL and GLES on zink over the Borealis Vulkan driver, all from the
# Aurora Mesa build in /opt/mesa-aurora. Read by /usr/local/bin/hypr-gpu-session,
# which exports it to Hyprland (and so to everything Hyprland starts: waybar,
# hypridle/hyprlock, terminals, browsers, Xwayland) and to the systemd user
# manager and D-Bus activation environment (portals and other user services).
# Plain KEY=VALUE lines only; the software session removes these keys again.
LD_LIBRARY_PATH=/opt/mesa-aurora/lib
__EGL_VENDOR_LIBRARY_FILENAMES=/opt/mesa-aurora/share/glvnd/egl_vendor.d/50_aurora.json
__GLX_VENDOR_LIBRARY_NAME=aurora
LIBGL_DRIVERS_PATH=/opt/mesa-aurora/lib/dri
GBM_BACKENDS_PATH=/opt/mesa-aurora/lib/gbm
VK_DRIVER_FILES=/opt/mesa-aurora/share/vulkan/icd.d/asahi_icd.aarch64.json
VK_ICD_FILENAMES=/opt/mesa-aurora/share/vulkan/icd.d/asahi_icd.aarch64.json
ASAHI_M5_BRINGUP=1
MESA_LOADER_DRIVER_OVERRIDE=zink
