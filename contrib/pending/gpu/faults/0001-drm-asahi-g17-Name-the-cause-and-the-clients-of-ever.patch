 /// Firmware recovery reason for a GPU MMU fault.
 pub(crate) const PAGE_FAULT: u32 = 3;
+/// M5 firmware recovery reason (27.2 on) for a scheduling pause the hardware did not acknowledge
+/// within the HW data's pause timeout; macOS names it "DSF Pause Timeout".
+pub(crate) const DSF_PAUSE_TIMEOUT: u32 = 5;
+/// M5 firmware recovery reason (27.3 on) for a GPU that did not reach forced idle after a sleep
+/// request; macOS names it "Sleep Forced Idle Timeout".
+pub(crate) const SLEEP_FORCED_IDLE_TIMEOUT: u32 = 6;
+
+/// What a firmware recovery reason means, as far as the firmware and the macOS kext name it.
+/// The M5 firmware stores 3 on a GPU page fault, 5 when a scheduling pause times out and 6 when
+/// forced idle times out; macOS gives 0 to 4 no name of their own.
+pub(crate) fn cause(reason: u32) -> &'static str {
+    match reason {
+        PAGE_FAULT => "GPU MMU page fault",
+        DSF_PAUSE_TIMEOUT => "DSF pause timeout: the GPU did not pause scheduling in time",
+        SLEEP_FORCED_IDLE_TIMEOUT => "sleep forced-idle timeout",
+        0..=4 => "unnamed firmware reason",
+        _ => "unknown firmware reason",
+    }
+}
+
+/// The macOS kext's restart reason for a firmware reason (`processFirmwareInitiatedRecovery`), to
+/// match a Linux log against macOS's.
+fn macos_restart_reason(reason: u32) -> Option<u32> {
+    match reason {
+        0 | 1 => Some(2),
+        2..=6 => Some(reason + 2),
+        _ => None,
+    }
+}
