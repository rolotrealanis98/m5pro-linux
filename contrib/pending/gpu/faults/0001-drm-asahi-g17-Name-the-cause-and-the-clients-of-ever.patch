+/// The rest of the M5 firmware's recovery record in the primary status B, beside the slot mask.
+/// Its recovery routine fills them from the recovery report (bundle view 3) before it announces
+/// the restart (26C5035r primary TEXT 0x7808..0x7834; 26B123 has the same code):
+///
+/// - +0x4aa0: view 3 +0x38, the number of busy slots the routine walked;
+/// - +0x4aa8: word +0x44 of the hardware record (register 0xc0f8) of the slot the report names
+///   (view 3 +0x24), or 0 without one;
+/// - +0x4aac: the reason, view 3 +0x48 (`recovery::cause`);
+/// - +0x4ab0: view 3 +0x40, a u64 the reason's raiser leaves (a page fault stores its latched
+///   MMU fault status there).
+///
+/// With the report's host-request word (view 3 +0x4) set, the routine zeroes the whole recovery
+/// area (0x4298..0x4ac0) instead, and every word, the slot mask included, reads 0.
+pub(crate) const M5_RECOVERY_SLOTS_WALKED: usize = 0x4aa0;
+pub(crate) const M5_RECOVERY_SLOT_WORD: usize = 0x4aa8;
+pub(crate) const M5_RECOVERY_REASON: usize = 0x4aac;
+pub(crate) const M5_RECOVERY_DETAIL: usize = 0x4ab0;
+
 pub(crate) const M5_STATUS_CONFIG_LINK_WORD: usize = 0x774;
 
 pub(crate) const M5_STATUS_CONFIG_LINK_PTR: usize = 0x778;
