 clkref: clock-ref {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <24000000>;
  clock-output-names = "clkref";
 };


 clk_405m: clock-405m {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <405000000>;
  clock-output-names = "clk_405m";
 };

 timer {
  compatible = "arm,armv8-timer";
  interrupt-parent = <&aic>;
  interrupt-names = "phys", "virt", "hyp-phys", "hyp-virt";
  interrupts = <1 0 2 4>,
        <1 0 3 4>,
        <1 0 0 4>,
        <1 0 1 4>;
 };


 die0: soc@200000000 {
  compatible = "simple-bus";
  #address-cells = <2>;
  #size-cells = <2>;
  ranges = <0x2 0x0 0x2 0x0 0x3 0xc0000000>;
  nonposted-mmio;
 };
};
