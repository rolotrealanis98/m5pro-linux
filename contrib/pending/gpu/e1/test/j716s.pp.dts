/ {
 compatible = "apple,t6050", "apple,arm-platform";
 #address-cells = <2>;
 #size-cells = <2>;
 interrupt-parent = <&aic>;


 memory@10000000000 {
  device_type = "memory";
  reg = <0x100 0x0 0x0 0x0>;
 };

 reserved-memory {
  #address-cells = <2>;
  #size-cells = <2>;
  ranges;

 };


 cpus {
  #address-cells = <2>;
  #size-cells = <0>;
 };
# 98 "arch/arm64/boot/dts/apple/t6050-base.dtsi"
