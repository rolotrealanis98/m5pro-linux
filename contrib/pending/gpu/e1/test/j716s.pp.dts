  cpu1: cpu@40001 { compatible = "apple,sawtooth"; device_type = "cpu"; reg = <0x0 0x40001>; enable-method = "spin-table"; operating-points-v2 = <&mcluster_opp>; performance-domains = <&cpufreq_mc0>; cpu-release-addr = <0 0>; };
  cpu2: cpu@40002 { compatible = "apple,sawtooth"; device_type = "cpu"; reg = <0x0 0x40002>; enable-method = "spin-table"; operating-points-v2 = <&mcluster_opp>; performance-domains = <&cpufreq_mc0>; cpu-release-addr = <0 0>; };
  cpu3: cpu@40003 { compatible = "apple,sawtooth"; device_type = "cpu"; reg = <0x0 0x40003>; enable-method = "spin-table"; operating-points-v2 = <&mcluster_opp>; performance-domains = <&cpufreq_mc0>; cpu-release-addr = <0 0>; };
  cpu4: cpu@40004 { compatible = "apple,sawtooth"; device_type = "cpu"; reg = <0x0 0x40004>; enable-method = "spin-table"; operating-points-v2 = <&mcluster_opp>; performance-domains = <&cpufreq_mc0>; cpu-release-addr = <0 0>; };
  cpu5: cpu@40005 { compatible = "apple,sawtooth"; device_type = "cpu"; reg = <0x0 0x40005>; enable-method = "spin-table"; operating-points-v2 = <&mcluster_opp>; performance-domains = <&cpufreq_mc0>; cpu-release-addr = <0 0>; };
