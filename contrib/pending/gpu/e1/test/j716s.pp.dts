  cpu7: cpu@40101 { compatible = "apple,sawtooth"; device_type = "cpu"; reg = <0x0 0x40101>; enable-method = "spin-table"; operating-points-v2 = <&mcluster_opp>; performance-domains = <&cpufreq_mc1>; cpu-release-addr = <0 0>; };
  cpu8: cpu@40102 { compatible = "apple,sawtooth"; device_type = "cpu"; reg = <0x0 0x40102>; enable-method = "spin-table"; operating-points-v2 = <&mcluster_opp>; performance-domains = <&cpufreq_mc1>; cpu-release-addr = <0 0>; };
  cpu9: cpu@40103 { compatible = "apple,sawtooth"; device_type = "cpu"; reg = <0x0 0x40103>; enable-method = "spin-table"; operating-points-v2 = <&mcluster_opp>; performance-domains = <&cpufreq_mc1>; cpu-release-addr = <0 0>; };
  cpu10: cpu@40104 { compatible = "apple,sawtooth"; device_type = "cpu"; reg = <0x0 0x40104>; enable-method = "spin-table"; operating-points-v2 = <&mcluster_opp>; performance-domains = <&cpufreq_mc1>; cpu-release-addr = <0 0>; };
  cpu11: cpu@40105 { compatible = "apple,sawtooth"; device_type = "cpu"; reg = <0x0 0x40105>; enable-method = "spin-table"; operating-points-v2 = <&mcluster_opp>; performance-domains = <&cpufreq_mc1>; cpu-release-addr = <0 0>; };
  cpu12: cpu@10200 { compatible = "apple,everest"; device_type = "cpu"; reg = <0x0 0x10200>; enable-method = "spin-table"; operating-points-v2 = <&pcluster_opp>; performance-domains = <&cpufreq_pc>; cpu-release-addr = <0 0>; };
  cpu13: cpu@10201 { compatible = "apple,everest"; device_type = "cpu"; reg = <0x0 0x10201>; enable-method = "spin-table"; operating-points-v2 = <&pcluster_opp>; performance-domains = <&cpufreq_pc>; cpu-release-addr = <0 0>; };
