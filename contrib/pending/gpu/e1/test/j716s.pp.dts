&nub_spmi_a0 {
 hpm1: usb-pd@a {
  compatible = "apple,sn201202x";
  reg = <0xa 0>;

  typec1: connector {
   compatible = "usb-c-connector";
   label = "USB-C Left-front";
   power-role = "dual";
   data-role = "dual";

   ports {
    #address-cells = <1>;
    #size-cells = <0>;

    port@0 {
     reg = <0>;
     typec1_hs: endpoint {
      remote-endpoint = <&usb_drd1_hs>;
