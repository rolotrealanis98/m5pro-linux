+   if ((!agx_chip_native_agx3(chip) && !agx_chip_g17_m5(chip)) || !base)
       return false;
 
    const unsigned start = ALIGN_POT(MAX2(occupied_halfs, 8), 2);
diff --git a/src/asahi/lib/agx_zls_pixels.h b/src/asahi/lib/agx_zls_pixels.h
index dde54efd8d6..b2afb9cf665 100644
--- a/src/asahi/lib/agx_zls_pixels.h
+++ b/src/asahi/lib/agx_zls_pixels.h
@@ -14,10 +14,10 @@
  * The depth/stencil pixel dimensions the ISP is told about. AGX2 packs them
  * through CR_ISP_ZLS_PIXELS, but the AGX3 generations do not agree: G17P
  * keeps the 15-bit pair (a native 256x256 render publishes 0x007f80ff) while
- * G17G widens the second field to 16 bits (the same render publishes
- * 0x00ff00ff). Both treat zero as the inactive encoding rather than a
- * minus-one 1x1 surface, so a render with no depth or stencil storage
- * publishes zero on either. Honeykrisp's hk_drm_*_zls_pixels() are the
+ * the M5 parts (G17G, G17S, G17C) widen the second field to 16 bits (the
+ * same render publishes 0x00ff00ff). Both treat zero as the inactive
+ * encoding rather than a minus-one 1x1 surface, so a render with no depth or
+ * stencil storage publishes zero on either. Honeykrisp's hk_drm_*_zls_pixels() are the
  * witnesses for these three rules; this is the same packing where Gallium
  * and the Vulkan driver can share it.
  */
@@ -29,7 +29,7 @@ agx_zls_pixels(enum agx_chip chip, uint32_t width, uint32_t height,
    if ((depth_base | depth_meta | stencil_base | stencil_meta) == 0)
       return 0;
 
-   const unsigned shift = chip == AGX_CHIP_G17G ? 16 : 15;
+   const unsigned shift = agx_chip_g17_m5(chip) ? 16 : 15;
    assert(width >= 1 && width <= (1u << shift));
    assert(height >= 1 && height <= (1u << shift));
    return (width - 1) | ((height - 1) << shift);
