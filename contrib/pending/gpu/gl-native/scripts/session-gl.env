# Mesa environment for the GPU desktop session on the M5 Pro, A/B variant:
# GL and GLES on the native Gallium asahi driver from /opt/mesa-aurora-gl
# (agx3c + the gl-native series), Vulkan on Borealis from the same tree.
# Same keys as /etc/mesa-aurora/session.env, without
# MESA_LOADER_DRIVER_OVERRIDE=zink. To use it:
#   cp -n /etc/mesa-aurora/session.env /etc/mesa-aurora/session.env.zink
#   cp session-gl.env /etc/mesa-aurora/session.env
# Back to zink: cp /etc/mesa-aurora/session.env.zink /etc/mesa-aurora/session.env
LD_LIBRARY_PATH=/opt/mesa-aurora-gl/lib
__EGL_VENDOR_LIBRARY_FILENAMES=/opt/mesa-aurora-gl/share/glvnd/egl_vendor.d/50_aurora.json
__GLX_VENDOR_LIBRARY_NAME=aurora
LIBGL_DRIVERS_PATH=/opt/mesa-aurora-gl/lib/dri
GBM_BACKENDS_PATH=/opt/mesa-aurora-gl/lib/gbm
VK_DRIVER_FILES=/opt/mesa-aurora-gl/share/vulkan/icd.d/asahi_icd.aarch64.json
VK_ICD_FILENAMES=/opt/mesa-aurora-gl/share/vulkan/icd.d/asahi_icd.aarch64.json
ASAHI_M5_BRINGUP=1
