# Mesa environment for the GPU desktop session on the M5 Pro, A/B variant 2:
# GL and GLES on the native Gallium asahi driver from /opt/mesa-aurora-gl2
# (agx3c + gl-native patches 0001-0008, branch g17s-gallium-native-v2),
# Vulkan on Borealis from the same tree. Same keys as session-gl.env, only the
# prefix differs; no MESA_LOADER_DRIVER_OVERRIDE=zink.
#
# For the A/B, do NOT copy this over /etc/mesa-aurora/session.env. Export it for
# one process instead (see AB-GL2.md):
#   set -a; . ./session-gl2.env; set +a; <app>
# To switch the session (only after the AB-GL2.md criterion is met):
#   cp -n /etc/mesa-aurora/session.env /etc/mesa-aurora/session.env.zink
#   cp session-gl2.env /etc/mesa-aurora/session.env
# Back to zink: cp /etc/mesa-aurora/session.env.zink /etc/mesa-aurora/session.env
LD_LIBRARY_PATH=/opt/mesa-aurora-gl2/lib
__EGL_VENDOR_LIBRARY_FILENAMES=/opt/mesa-aurora-gl2/share/glvnd/egl_vendor.d/50_aurora.json
__GLX_VENDOR_LIBRARY_NAME=aurora
LIBGL_DRIVERS_PATH=/opt/mesa-aurora-gl2/lib/dri
GBM_BACKENDS_PATH=/opt/mesa-aurora-gl2/lib/gbm
VK_DRIVER_FILES=/opt/mesa-aurora-gl2/share/vulkan/icd.d/asahi_icd.aarch64.json
VK_ICD_FILENAMES=/opt/mesa-aurora-gl2/share/vulkan/icd.d/asahi_icd.aarch64.json
ASAHI_M5_BRINGUP=1
