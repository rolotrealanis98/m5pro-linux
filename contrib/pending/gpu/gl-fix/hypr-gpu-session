#!/bin/bash
# Hyprland rendering on the Apple GPU (aurora render node) while scanout stays
# on simpledrm. Used instead of hypr-session when /run/hypr-gpu exists (one
# boot only: /run is tmpfs). Path:
#   Hyprland -> GBM/EGL -> zink on the Vulkan driver (Borealis) on the aurora
#   render node; scanout buffers are LINEAR buffers imported into simpledrm,
#   which copies them to the boot framebuffer with the CPU. The Asahi Gallium
#   driver declines the M5 Pro (the G17 kernel runtime refuses its renders),
#   so GL is zink. Zink renders only through a render node: a GBM device that
#   aquamarine opens on the simpledrm card itself gets Mesa's software
#   fallback. The renderer Hyprland picked is in the log below.
P=/opt/mesa-aurora
card=
for c in /sys/class/drm/card[0-9]; do
  [ "$(basename "$(readlink -f "$c/device/driver")")" = simple-framebuffer ] && card=/dev/dri/${c##*/}
done
card=${card:-/dev/dri/card0}

export LD_LIBRARY_PATH=$P/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
export __EGL_VENDOR_LIBRARY_FILENAMES=$P/share/glvnd/egl_vendor.d/50_aurora.json
export __GLX_VENDOR_LIBRARY_NAME=aurora
export LIBGL_DRIVERS_PATH=$P/lib/dri
export GBM_BACKENDS_PATH=$P/lib/gbm
export VK_DRIVER_FILES=$P/share/vulkan/icd.d/asahi_icd.aarch64.json
export ASAHI_M5_BRINGUP=1
unset LIBGL_ALWAYS_SOFTWARE GALLIUM_DRIVER
export MESA_LOADER_DRIVER_OVERRIDE=zink
# The aurora card has no KMS, so only the display card is listed; aquamarine
# would skip the render-only card anyway.
export AQ_DRM_DEVICES=$card
# simpledrm scans out LINEAR only. Without modifiers the scanout buffers are
# allocated LINEAR (first-frame step 4b checks that path on zink); if 4b fails
# and 4a passes, drop AQ_NO_MODIFIERS so aquamarine passes simpledrm's LINEAR
# modifier instead.
export AQ_NO_MODIFIERS=1
export WLR_NO_HARDWARE_CURSORS=1
export HYPRLAND_NO_RT=1
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=Hyprland XDG_SESSION_DESKTOP=Hyprland
export LANG=C.UTF-8
export PATH=$HOME/.local/bin:$PATH
export XCURSOR_THEME=Adwaita XCURSOR_SIZE=24
export QT_QPA_PLATFORM="wayland;xcb" ELECTRON_OZONE_PLATFORM_HINT=wayland MOZ_ENABLE_WAYLAND=1
export TERMINAL=alacritty EDITOR=nvim BROWSER=chromium
log=$HOME/.cache/hyprland-gpu.log
[ -f "$log" ] && mv -f "$log" "$log.old"
echo "hypr-gpu-session: display card $card, Mesa $(cat $P/MESA_COMMIT 2>/dev/null)" > "$log"
exec start-hyprland >> "$log" 2>&1
