# omarchy-m5: software-rendered Wayland desktop on simpledrm (no GPU driver)
#
# Merged after omarchy-bringup.config. The Arch root carries no kernel modules,
# so everything here is =y.
#
# Display: m1n1's boot framebuffer through simpledrm (already =y in bring-up).
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
# The legacy fbdev simplefb driver would grab the same framebuffer first.
# CONFIG_FB_SIMPLE is not set
#
# dma-buf plumbing that Mesa's software drivers and Wayland clients use:
# udmabuf lets llvmpipe/lavapipe export shared-memory buffers as dma-bufs
# (linux-dmabuf instead of wl_shm copies, where Mesa supports it); the system
# heap serves PipeWire/GStreamer and screen capture; sync_file carries
# explicit-sync fences between client and compositor.
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_UDMABUF=y
CONFIG_SYNC_FILE=y
