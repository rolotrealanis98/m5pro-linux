From c27e1982983e79aa964f6979e068ddd4e0eb2365 Mon Sep 17 00:00:00 2001
From: Rolando Trevino <rolotrealanis@gmail.com>
Date: Sat, 7 Nov 2026 12:42:27 -0500
Subject: [PATCH 15/15] drm/apple: Add the firmware 27.3 IOMFB method table and
 swap layout

The macOS 27.3 beta 1 stub (26C5035) carries DCP firmware
AppleDCP-1317.60.10. It inserts one IOMobileFramebufferAP method at
A521, so the 27.2 AP tags from A521 up move up by one:
set_display_refresh_properties A526, flush_supports_power A529,
abort_swaps_dcp A530, register_dfb_surface A534, set_power_state A535,
pipe_query_474 A536, pipe_set_476 A538 and pipe_query_478 A540. The
UnifiedPipeline tags are those of 27.2. Emulating both method switches
of the firmware finds all 41 tags of the new table, each at the handler
the 27.2 tag reaches in 27.2.

The same firmware grew IOMFBSwap from 0x6e0 to 0x830 bytes: its
swap_submit handler takes at least 0x1144 bytes where 27.2 takes 0xff4,
and finds the surfaces at 0x830 instead of 0x6e0. The swap fields this
driver sets keep their order: swap_id through bg_color are 0x40 bytes
further on and the brightness fields 0x60 bytes, and the blocks in
between are new. Send that layout to a 27.3 DCP, as the 27.2 record with
zeros inserted. The other 40 methods take the sizes they take in 27.2.

Accept apple,firmware-compat "27.3.0" and choose these with it.

Signed-off-by: Rolando Trevino <rolotrealanis@gmail.com>
Assisted-by: LLM Claude
---
 drivers/gpu/drm/apple/dcp-internal.h          |  2 +
 .../gpu/drm/apple/iomfb-peer-runtime-v27.inc  | 12 ++-
 drivers/gpu/drm/apple/iomfb_template.c        | 15 ++--
 drivers/gpu/drm/apple/iomfb_v27.c             | 88 +++++++++++++++++++
 drivers/gpu/drm/apple/iomfb_v27.h             | 35 ++++++++
 5 files changed, 141 insertions(+), 11 deletions(-)

diff --git a/drivers/gpu/drm/apple/dcp-internal.h b/drivers/gpu/drm/apple/dcp-internal.h
index 45493e4b871a..48a469790055 100644
--- a/drivers/gpu/drm/apple/dcp-internal.h
+++ b/drivers/gpu/drm/apple/dcp-internal.h
@@ -539,6 +539,8 @@ struct apple_dcp {
 	struct dcp_swap_submit_req_v27 present_v27;
 	/* Both paired wire records belong to the primary endpoint lock. */
 	struct dcp_swap_submit_req_v27 peer_present_v27;
+	/* The firmware 27.3 copy of either record (iomfb_v27_swap_wire()). */
+	struct dcp_swap_submit_req_v27_3 present_v27_3;
 
 	/* DCP shared memory */
 	void *shmem;
diff --git a/drivers/gpu/drm/apple/iomfb-peer-runtime-v27.inc b/drivers/gpu/drm/apple/iomfb-peer-runtime-v27.inc
index 0c0089e1ce97..171819f41874 100644
--- a/drivers/gpu/drm/apple/iomfb-peer-runtime-v27.inc
+++ b/drivers/gpu/drm/apple/iomfb-peer-runtime-v27.inc
@@ -60,6 +60,8 @@ static void dcp_peer_started_on_owner(struct apple_dcp *owner, void *data, void
 	struct dcp_swap_start_resp_h17p *resp = data;
 	struct apple_dcp *peer = dcp_peer_scanout_v27(owner);
 	u32 id = owner->swap.h17p.swap.swap_id;
+	void *wire;
+	u32 len;
 
 	lockdep_assert_held(&owner->iomfb.lock);
 	if (IS_ERR_OR_NULL(peer) || peer != cookie || resp->ret || resp->swap_id != id) {
@@ -83,13 +85,15 @@ static void dcp_peer_started_on_owner(struct apple_dcp *owner, void *data, void
 	dcp_peer_swap_armed_v27(owner, id);
 	trace_iomfb_swap_submit(owner, id);
 	trace_iomfb_swap_submit(peer, id);
-	dcp_push(owner, false, &owner->v27_methods[dcpep_swap_submit], sizeof(owner->present_v27),
-		 sizeof(struct dcp_swap_submit_resp_v27), &owner->present_v27,
+	wire = iomfb_v27_swap_wire(owner, &owner->present_v27, &owner->present_v27_3, &len);
+	dcp_push(owner, false, &owner->v27_methods[dcpep_swap_submit], len,
+		 sizeof(struct dcp_swap_submit_resp_v27), wire,
 		 dcp_peer_submitted, owner);
 	if (READ_ONCE(owner->crashed))
 		return;
-	dcp_push(peer, false, &peer->v27_methods[dcpep_swap_submit], sizeof(owner->peer_present_v27),
-		 sizeof(struct dcp_swap_submit_resp_v27), &owner->peer_present_v27,
+	wire = iomfb_v27_swap_wire(peer, &owner->peer_present_v27, &owner->present_v27_3, &len);
+	dcp_push(peer, false, &peer->v27_methods[dcpep_swap_submit], len,
+		 sizeof(struct dcp_swap_submit_resp_v27), wire,
 		 dcp_peer_submitted, owner);
 	if (READ_ONCE(peer->crashed))
 		dcp_peer_swap_error(owner, "peer publication", -EIO);
diff --git a/drivers/gpu/drm/apple/iomfb_template.c b/drivers/gpu/drm/apple/iomfb_template.c
index 165d864ff330..824924238fa4 100644
--- a/drivers/gpu/drm/apple/iomfb_template.c
+++ b/drivers/gpu/drm/apple/iomfb_template.c
@@ -362,6 +362,11 @@ static void dcp_swap_submit(struct apple_dcp *dcp, bool oob,
 			    dcp_callback_t cb, void *cookie)
 {
 	const void *data = request;
+#if (DCP_FW_H17(DCP_FW_VER) && DCP_FW_VER >= DCP_FW_VERSION(27, 0, 0))
+	u32 len = sizeof(struct dcp_swap_submit_req_v27);
+#else
+	u32 len = sizeof(*request);
+#endif
 
 	if (dcp->hw.iomfb_method_profile != DCP_IOMFB_METHODS_H17G) {
 		iomfb_serialize_present_h17p(&dcp->present_h17p, request);
@@ -376,18 +381,14 @@ static void dcp_swap_submit(struct apple_dcp *dcp, bool oob,
 			dcp->present_h17p.swap[0x354] & 1;
 		dcp->present_v27.swap.brightness_nits =
 			get_unaligned_le64(dcp->present_h17p.swap + 0x35e);
-		data = &dcp->present_v27;
+		data = iomfb_v27_swap_wire(dcp, &dcp->present_v27,
+					   &dcp->present_v27_3, &len);
 #else
 		data = &dcp->present_h17p;
 #endif
 	}
 
-	dcp_push(dcp, oob, &dcp_methods[dcpep_swap_submit],
-#if (DCP_FW_H17(DCP_FW_VER) && DCP_FW_VER >= DCP_FW_VERSION(27, 0, 0))
-		 sizeof(struct dcp_swap_submit_req_v27),
-#else
-		 sizeof(*request),
-#endif
+	dcp_push(dcp, oob, &dcp_methods[dcpep_swap_submit], len,
 		 sizeof(struct dcp_swap_submit_resp_h17p), (void *)data, cb, cookie);
 }
 #else
diff --git a/drivers/gpu/drm/apple/iomfb_v27.c b/drivers/gpu/drm/apple/iomfb_v27.c
index 5bf01266b574..550edb45bf71 100644
--- a/drivers/gpu/drm/apple/iomfb_v27.c
+++ b/drivers/gpu/drm/apple/iomfb_v27.c
@@ -150,15 +150,103 @@ static const struct dcp_method_entry dcp_methods_27_2[dcpep_num_methods] = {
 	IOMFB_METHOD("A533", dcpep_register_dfb_surface),
 };
 
+/*
+ * Firmware 27.3 inserts one IOMobileFramebufferAP method at A521, so the
+ * 27.2 AP tags from A521 up move up by one (set_power_state A535,
+ * register_dfb_surface A534); the tags below A521 and the UnifiedPipeline
+ * tags are those of 27.2. Read from the 27.3 (26C5035) firmware's method
+ * dispatch.
+ */
+static const struct dcp_method_entry dcp_methods_27_3[dcpep_num_methods] = {
+	IOMFB_METHOD("A000", dcpep_late_init_signal),
+	IOMFB_METHOD("A027", dcpep_setup_video_limits),
+	IOMFB_METHOD("A136", iomfbep_a131_pmu_service_matched),
+	IOMFB_METHOD("A137", iomfbep_a132_backlight_service_matched),
+	IOMFB_METHOD("A390", dcpep_set_create_dfb),
+	IOMFB_METHOD("A391", iomfbep_a358_vi_set_temperature_hint),
+	IOMFB_METHOD("A451", dcpep_start_signal),
+	IOMFB_METHOD("A456", dcpep_swap_start),
+	IOMFB_METHOD("A458", dcpep_swap_submit),
+	IOMFB_METHOD("A461", dcpep_set_display_device),
+	IOMFB_METHOD("A462", dcpep_is_main_display),
+	IOMFB_METHOD("A463", dcpep_set_digital_out_mode),
+	IOMFB_METHOD("A473", iomfbep_set_matrix),
+	IOMFB_METHOD("A477", iomfbep_get_color_remap_mode),
+	IOMFB_METHOD("A500", dcpep_set_parameter_dcp),
+	IOMFB_METHOD("A504", dcpep_create_default_fb),
+	IOMFB_METHOD("A037", dcpep_get_dfb_compression_info),
+	IOMFB_METHOD("A036", dcpep_get_dfb_info),
+	IOMFB_METHOD("A103", dcpep_get_dfb_layout),
+	IOMFB_METHOD("A503", dcpep_get_dfb_state),
+	IOMFB_METHOD("A104", dcpep_set_dfb_dimensions),
+	IOMFB_METHOD("A105", dcpep_commit_dfb_info),
+	IOMFB_METHOD("A035", dcpep_dfb_query),
+	IOMFB_METHOD("A385", dcpep_dfb_ready_query),
+	IOMFB_METHOD("A353", dcpep_pipe_query_353),
+	IOMFB_METHOD("A352", dcpep_pipe_set_352),
+	IOMFB_METHOD("A465", dcpep_pipe_cfg_415),
+	IOMFB_METHOD("A033", dcpep_pipe_cfg_031),
+	IOMFB_METHOD("A464", dcpep_pipe_cfg_414),
+	IOMFB_METHOD("A540", dcpep_pipe_query_478),
+	IOMFB_METHOD("A536", dcpep_pipe_query_474),
+	IOMFB_METHOD("A538", dcpep_pipe_set_476),
+	IOMFB_METHOD("A478", iomfbep_set_brightness_correction),
+	IOMFB_METHOD("A508", dcpep_enable_disable_video_power_savings),
+	IOMFB_METHOD("A516", dcpep_first_client_open),
+	IOMFB_METHOD("A517", iomfbep_last_client_close),
+	IOMFB_METHOD("A526", dcpep_set_display_refresh_properties),
+	IOMFB_METHOD("A529", dcpep_flush_supports_power),
+	IOMFB_METHOD("A530", iomfbep_abort_swaps_dcp),
+	IOMFB_METHOD("A535", dcpep_set_power_state),
+	IOMFB_METHOD("A534", dcpep_register_dfb_surface),
+};
+
 const struct dcp_method_entry *iomfb_v27_methods(const char *compat)
 {
 	if (!strcmp(compat, "27.0.0"))
 		return dcp_methods_27_0;
 	if (!strcmp(compat, "27.2.0"))
 		return dcp_methods_27_2;
+	if (!strcmp(compat, "27.3.0"))
+		return dcp_methods_27_3;
 	return NULL;
 }
 
+/*
+ * The swap_submit request @dcp's firmware takes for @request: @request itself,
+ * or on firmware 27.3 a copy in @scratch with the 27.3 IOMFBSwap. dcp_push()
+ * copies the request it is given, so one scratch record serves consecutive
+ * pushes.
+ */
+void *iomfb_v27_swap_wire(const struct apple_dcp *dcp,
+			  struct dcp_swap_submit_req_v27 *request,
+			  struct dcp_swap_submit_req_v27_3 *scratch, u32 *len)
+{
+	const u8 *swap = (const u8 *)&request->swap;
+	u8 *out = scratch->swap;
+
+	if (dcp->v27_methods != dcp_methods_27_3) {
+		*len = sizeof(*request);
+		return request;
+	}
+
+	memset(out, 0, sizeof(scratch->swap));
+	memcpy(out, swap, DCP_SWAP_V27_3_GAP0);
+	out += DCP_SWAP_V27_3_GAP0 + DCP_SWAP_V27_3_GAP0_LEN;
+	memcpy(out, swap + DCP_SWAP_V27_3_GAP0,
+	       DCP_SWAP_V27_3_GAP1 - DCP_SWAP_V27_3_GAP0);
+	out += DCP_SWAP_V27_3_GAP1 - DCP_SWAP_V27_3_GAP0 + DCP_SWAP_V27_3_GAP1_LEN;
+	memcpy(out, swap + DCP_SWAP_V27_3_GAP1,
+	       DCP_SWAP_V27_3_GAP2 - DCP_SWAP_V27_3_GAP1);
+	out += DCP_SWAP_V27_3_GAP2 - DCP_SWAP_V27_3_GAP1 + DCP_SWAP_V27_3_GAP2_LEN;
+	memcpy(out, swap + DCP_SWAP_V27_3_GAP2,
+	       sizeof(request->swap) - DCP_SWAP_V27_3_GAP2);
+	memcpy(scratch->surf, request->surf, sizeof(scratch->surf));
+	memcpy(scratch->args, &request->surf_iova, sizeof(scratch->args));
+	*len = sizeof(*scratch);
+	return scratch;
+}
+
 /* The template's calls resolve through the table probe chose for this build. */
 #define dcp_methods (dcp->v27_methods)
 
diff --git a/drivers/gpu/drm/apple/iomfb_v27.h b/drivers/gpu/drm/apple/iomfb_v27.h
index ac1ded5eb047..6a33e13bf6de 100644
--- a/drivers/gpu/drm/apple/iomfb_v27.h
+++ b/drivers/gpu/drm/apple/iomfb_v27.h
@@ -78,8 +78,43 @@ static_assert(offsetof(struct dcp_swap_submit_req_v27, swap_null) == 0xfea);
 static_assert(offsetof(struct dcp_swap_v27, brightness_update) == 0x354);
 static_assert(offsetof(struct dcp_swap_v27, brightness_nits) == 0x35e);
 
+/*
+ * Firmware 27.3 grew IOMFBSwap from 0x6e0 to 0x830 bytes, so its swap_submit
+ * request is 0x150 bytes longer; the rest of the request is unchanged. Of the
+ * 27.2 swap fields, those from swap_id (0x98) up to 0x298 are 0x40 bytes
+ * further on, those from 0x2cc up to 0x534 0x60 bytes and those from 0x6b8 on
+ * 0x150 bytes, so the new bytes lie before swap_id, between 0x298 and 0x2cc
+ * and between 0x534 and 0x6b8. This driver sends zeros in all three ranges,
+ * so the 27.3 swap is the 27.2 one with that many zeros inserted at one point
+ * of each range.
+ */
+#define DCP_SWAP_V27_3_GAP0	0x098
+#define DCP_SWAP_V27_3_GAP0_LEN	0x40
+#define DCP_SWAP_V27_3_GAP1	0x2cc
+#define DCP_SWAP_V27_3_GAP1_LEN	0x20
+#define DCP_SWAP_V27_3_GAP2	0x6b8
+#define DCP_SWAP_V27_3_GAP2_LEN	0xf0
+#define DCP_SWAP_V27_3_SIZE	0x830
+
+struct dcp_swap_submit_req_v27_3 {
+	u8 swap[DCP_SWAP_V27_3_SIZE];
+	struct dcp_surface_v27 surf[SWAP_SURFACES];
+	u8 args[sizeof(struct dcp_swap_submit_req_v27) -
+		offsetof(struct dcp_swap_submit_req_v27, surf_iova)];
+} __packed;
+
+static_assert(sizeof(struct dcp_swap_v27) + DCP_SWAP_V27_3_GAP0_LEN +
+	      DCP_SWAP_V27_3_GAP1_LEN + DCP_SWAP_V27_3_GAP2_LEN ==
+	      DCP_SWAP_V27_3_SIZE);
+static_assert(sizeof(struct dcp_swap_submit_req_v27_3) == 0x1144);
+static_assert(offsetof(struct dcp_swap_submit_req_v27_3, surf) == 0x830);
+
 void iomfb_serialize_present_v27(struct dcp_swap_submit_req_v27 *wire,
 				const struct dcp_swap_submit_req_h17p *request);
+struct apple_dcp;
+void *iomfb_v27_swap_wire(const struct apple_dcp *dcp,
+			  struct dcp_swap_submit_req_v27 *request,
+			  struct dcp_swap_submit_req_v27_3 *scratch, u32 *len);
 bool iomfb_v27_callback_size_valid(unsigned int tag, u32 input, u32 output);
 void iomfb_firmware_state_cleanup_v27(void *data);
 int iomfb_modeset_v27(struct apple_dcp *dcp, struct drm_crtc_state *state);
-- 
