From 28ac06e25f1b76bec2b39d39ceb9cbc48e167539 Mon Sep 17 00:00:00 2001
From: Rolando Trevino <rolotrealanis@gmail.com>
Date: Wed, 4 Nov 2026 18:10:17 -0500
Subject: [PATCH 5/5] arm64: configs: add omarchy-usb-host.config fragment

USB 2.0 host on T6050: xHCI platform, phy-apple-usb2, Ethernet (r8152,
ax88179, cdc_ether/ncm/eem, rndis), UAS, Wi-Fi dongles (rtl8xxxu, mt7601u,
mt76x2u) and the SN201202x PD driver, all built in because the kernel is
shipped without modules.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Rolando Trevino <rolotrealanis@gmail.com>

---
 arch/arm64/configs/omarchy-usb-host.config | 50 ++++++++++++++++++++++
 1 file changed, 50 insertions(+)
 create mode 100644 arch/arm64/configs/omarchy-usb-host.config

diff --git a/arch/arm64/configs/omarchy-usb-host.config b/arch/arm64/configs/omarchy-usb-host.config
new file mode 100644
index 000000000..d71538ea7
--- /dev/null
+++ b/arch/arm64/configs/omarchy-usb-host.config
@@ -0,0 +1,50 @@
+# omarchy-m5 / m5pro-linux: USB 2.0 host on the T6050 Type-C ports.
+# Merge AFTER omarchy-storage-net.config. Everything a first test needs is
+# =y: the kernel is shipped as Image.gz without modules_install, so =m
+# drivers are not on the target.
+
+# --- dwc3 dual role (already =y) + xHCI platform host ------------------
+CONFIG_USB_DWC3=y
+CONFIG_USB_DWC3_DUAL_ROLE=y
+CONFIG_USB_XHCI_HCD=y
+CONFIG_USB_XHCI_PLATFORM=y
+CONFIG_USB_ROLE_SWITCH=y
+CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
+
+# --- USB2-only Type-C PHY (new driver, drivers/phy/apple/usb2.c) --------
+CONFIG_PHY_APPLE_USB2=y
+
+# --- Ethernet dongles ---------------------------------------------------
+CONFIG_USB_NET_DRIVERS=y
+CONFIG_USB_USBNET=y
+CONFIG_USB_RTL8152=y
+CONFIG_USB_NET_AX8817X=y
+CONFIG_USB_NET_AX88179_178A=y
+CONFIG_USB_NET_CDCETHER=y
+CONFIG_USB_NET_CDC_NCM=y
+CONFIG_USB_NET_CDC_EEM=y
+CONFIG_USB_NET_RNDIS_HOST=y
+
+# --- Storage, input, hubs (USB_STORAGE/USB_HID already =y) --------------
+CONFIG_USB_STORAGE=y
+CONFIG_USB_UAS=y
+CONFIG_BLK_DEV_SD=y
+CONFIG_VFAT_FS=y
+CONFIG_EXFAT_FS=y
+CONFIG_USB_HID=y
+CONFIG_HID_GENERIC=y
+
+# --- Wi-Fi dongles (need /lib/firmware on the root fs) -----------------
+# cfg80211 depends on RFKILL || !RFKILL: RFKILL=m would cap it at m
+CONFIG_RFKILL=y
+CONFIG_CFG80211=y
+CONFIG_MAC80211=y
+CONFIG_RTL8XXXU=y
+CONFIG_MT7601U=y
+CONFIG_MT76x2U=y
+
+# --- USB-PD controller (milestone 1b; binds only with t6050-usb-pd.dtsi) -
+CONFIG_TYPEC=y
+CONFIG_TYPEC_SN201202X=y
+# CONFIG_TYPEC_TPS6598X is not set
+
-- 
2.56.0

