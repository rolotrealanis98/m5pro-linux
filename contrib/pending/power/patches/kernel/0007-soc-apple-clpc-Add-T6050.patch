From 2cda253d2ef79430d11056f846f7c48c40b9e154 Mon Sep 17 00:00:00 2001
From: Rolando Trevino <rolotrealanis@gmail.com>
Date: Sat, 7 Nov 2026 15:31:08 -0500
Subject: [PATCH 07/13] soc: apple: clpc: Add T6050

The T6050 CLPC falls back to the T6040 table, whose DCS 0-5 and fabric
0-2 stop short of T6050's rails: the ADT lists eight DCS and four SOC
voltage states, so DCS runs 0-7 and the fabric 0-3, and a busy cluster
under the T6040 table never asks for the top two DCS states or the top
fabric state.

Give "apple,t6050-clpc" its own table: T8142's DCS columns (same DCS
range), the fabric one state lower for its four states, T6040's
three-sample busy streak, and the GPU's work in flight taking both
rails to the top of the map. Accept the T6050 CLPC as a GPU's CLPC.
The table is provisional until the bandwidth and power of each state
are measured.

Assisted-by: LLM Claude
Signed-off-by: Rolando Trevino <rolotrealanis@gmail.com>
---
 drivers/soc/apple/clpc.c | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/drivers/soc/apple/clpc.c b/drivers/soc/apple/clpc.c
index c7b29f0e6a49..65495cac1e0e 100644
--- a/drivers/soc/apple/clpc.c
+++ b/drivers/soc/apple/clpc.c
@@ -231,6 +231,7 @@ int apple_clpc_gpu_get(struct device *dev, struct apple_clpc_gpu **out)
 	if (!np)
 		return of_find_property(dev->of_node, "apple,clpc", NULL) ? -EINVAL : 0;
 	if (!of_device_is_compatible(np, "apple,t6041-clpc") &&
+	    !of_device_is_compatible(np, "apple,t6050-clpc") &&
 	    !of_device_is_compatible(np, "apple,t8132-clpc") &&
 	    !of_device_is_compatible(np, "apple,t8140-clpc") &&
 	    !of_device_is_compatible(np, "apple,t8142-clpc")) {
@@ -974,6 +975,28 @@ static const struct apple_clpc_hw apple_clpc_hw_t8142 = {
 	.gpu_input = true,
 };
 
+/*
+ * T6050 (M5 Pro/Max): DCS states 0-7 on rail 0 and fabric states 0-3 on
+ * rail 1, from the eight DCS and four SOC voltage states in the ADT. The
+ * columns follow T8142, which has the same DCS range, with the fabric one
+ * state lower for its four states; a busy cluster asks for the top states
+ * at full speed. As on T6040, a cluster requests only after three busy
+ * samples in a row: eighteen cores give more short bursts of background
+ * work than the four to twelve of the other tables. The GPU driver reports
+ * its work in flight, which takes both rails to the top of the map.
+ * Provisional: neither the bandwidth nor the power of each state has been
+ * measured on T6050.
+ */
+static const struct apple_clpc_hw apple_clpc_hw_t6050 = {
+	.rail = { [APPLE_CLPC_DCS] = 0, [APPLE_CLPC_SOC] = 1 },
+	.map = {
+		[APPLE_CLPC_DCS] = { 2, 4, 6, 7 },
+		[APPLE_CLPC_SOC] = { 0, 1, 2, 3 },
+	},
+	.sustain = 3,
+	.gpu_input = true,
+};
+
 #if IS_BUILTIN(CONFIG_KUNIT) && !defined(MODULE)
 #include <kunit/test.h>
 #include <linux/completion.h>
@@ -1156,6 +1179,7 @@ static const struct of_device_id apple_clpc_of_match[] = {
 	{ .compatible = "apple,t8142-clpc", .data = &apple_clpc_hw_t8142 },
 	{ .compatible = "apple,t8152-clpc", .data = &apple_clpc_hw_t8152 },
 	{ .compatible = "apple,t6041-clpc", .data = &apple_clpc_hw_t6040 },
+	{ .compatible = "apple,t6050-clpc", .data = &apple_clpc_hw_t6050 },
 	{}
 };
 MODULE_DEVICE_TABLE(of, apple_clpc_of_match);
-- 
