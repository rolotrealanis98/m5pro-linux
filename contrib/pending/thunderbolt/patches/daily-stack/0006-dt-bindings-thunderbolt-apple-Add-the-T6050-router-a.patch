From 7153c1b6874338afd2094452260298ceb9e61b17 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Wed, 4 Nov 2026 18:08:06 -0500
Subject: [PATCH 06/16] dt-bindings: thunderbolt: apple: Add the T6050 router
 and NHI

The T6050 host router has the T8132 MxWrap CPU wrapper and LSTX pin,
four ACIO power domains instead of three, and a PCIe router AP
firmware block with its own tunables. Its NHI has a single register
range, one DART stream per ring, and an SRAM parity interrupt after
its 24 ring interrupts.

Developed with Claude Code.

Signed-off-by: Erik Bourget <erik@ebourget.net>
---
 .../thunderbolt/apple,t8103-usb4-acio.yaml    | 48 ++++++++++++++++---
 .../thunderbolt/apple,t8103-usb4-nhi.yaml     | 29 +++++++++--
 2 files changed, 67 insertions(+), 10 deletions(-)

diff --git a/Documentation/devicetree/bindings/thunderbolt/apple,t8103-usb4-acio.yaml b/Documentation/devicetree/bindings/thunderbolt/apple,t8103-usb4-acio.yaml
index 434a833cd31a..03b77ad8fd8a 100644
--- a/Documentation/devicetree/bindings/thunderbolt/apple,t8103-usb4-acio.yaml
+++ b/Documentation/devicetree/bindings/thunderbolt/apple,t8103-usb4-acio.yaml
@@ -30,6 +30,7 @@ properties:
     oneOf:
       - const: apple,t8103-usb4-acio
       - const: apple,t8142-usb4-acio
+      - const: apple,t6050-usb4-acio
       - items:
           - enum:
               - apple,t6000-usb4-acio
@@ -50,7 +51,8 @@ properties:
           PCIe adapter configuration space of the USB4 router. Present where
           the root complex exposes the adapter separately, so that the tunnel
           can be configured before a PCIe-C link is brought up.
-      - description: MxWrap co-processor control registers, on T8132
+      - description: MxWrap co-processor control registers, on T8132 and T6050
+      - description: PCIe router AP firmware registers, on T6050
 
   reg-names:
     minItems: 2
@@ -59,6 +61,7 @@ properties:
       - const: sram
       - const: pcie-adapter
       - const: cpu
+      - const: router-ap-fw
 
   mboxes:
     maxItems: 1
@@ -71,11 +74,12 @@ properties:
 
   power-domains:
     minItems: 3
-    maxItems: 4
+    maxItems: 5
     description: |
-      The first three domains power the ACIO co-processor complex. When
-      apple,pcie-tunnel is present, the fourth domain powers its PCIe-C
-      controller and is enabled only after the USB4 PCIe tunnel is active.
+      The first three domains (four on T6050) power the ACIO co-processor
+      complex. When apple,pcie-tunnel is present, the domain after them powers
+      its PCIe-C controller and is enabled only after the USB4 PCIe tunnel is
+      active.
 
   thunderbolt-switch:
     type: boolean
@@ -118,6 +122,18 @@ properties:
       named by the pcie-adapter reg entry. Only meaningful where that entry is
       present.
 
+  apple,tunable-router-ap-fw:
+    $ref: /schemas/types.yaml#/definitions/uint32-matrix
+    items:
+      items:
+        - description: Register offset
+        - description: Mask of bits to clear
+        - description: Bits to set
+    description: |
+      As apple,tunable-rc, but applied to the PCIe router AP firmware
+      registers named by the router-ap-fw reg entry, with the other router
+      tunables once the co-processor firmware is ready.
+
   '#address-cells':
     const: 1
 
@@ -191,7 +207,9 @@ allOf:
       properties:
         compatible:
           contains:
-            const: apple,t8132-usb4-acio
+            enum:
+              - apple,t6050-usb4-acio
+              - apple,t8132-usb4-acio
     then:
       properties:
         reg:
@@ -204,6 +222,24 @@ allOf:
     else:
       properties:
         lstx-gpios: false
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: apple,t6050-usb4-acio
+    then:
+      properties:
+        reg:
+          minItems: 5
+        reg-names:
+          minItems: 5
+        power-domains:
+          minItems: 4
+    else:
+      properties:
+        power-domains:
+          maxItems: 4
+        apple,tunable-router-ap-fw: false
 
 additionalProperties: false
 
diff --git a/Documentation/devicetree/bindings/thunderbolt/apple,t8103-usb4-nhi.yaml b/Documentation/devicetree/bindings/thunderbolt/apple,t8103-usb4-nhi.yaml
index d6dffe3ec8ca..aeb8eac0ad00 100644
--- a/Documentation/devicetree/bindings/thunderbolt/apple,t8103-usb4-nhi.yaml
+++ b/Documentation/devicetree/bindings/thunderbolt/apple,t8103-usb4-nhi.yaml
@@ -22,6 +22,7 @@ properties:
     oneOf:
       - const: apple,t8103-usb4-nhi
       - const: apple,t8142-usb4-nhi
+      - const: apple,t6050-usb4-nhi
       - items:
           - enum:
               - apple,t6000-usb4-nhi
@@ -50,10 +51,12 @@ properties:
   interrupts:
     description:
       One interrupt for each of the 12 transmit rings followed by one for each
-      of the 12 receive rings.
-    maxItems: 24
+      of the 12 receive rings. On T6050 an SRAM parity interrupt follows them.
+    minItems: 24
+    maxItems: 25
 
   interrupt-names:
+    minItems: 24
     items:
       - const: txring0
       - const: txring1
@@ -79,6 +82,7 @@ properties:
       - const: rxring9
       - const: rxring10
       - const: rxring11
+      - const: parity
 
   iommus:
     minItems: 1
@@ -89,7 +93,8 @@ properties:
       all other rings which are only used for XDomain connections to other
       hosts.
 
-      T8142 uses one DART stream per ring: TX streams 0-11 and RX streams 16-27.
+      T8142 and T6050 use one DART stream per ring: TX streams 0-11 and RX
+      streams 16-27.
       T6030, T6031 and T8122 also use 24 entries. These are most likely one DART
       stream for each of the 12 transmit and 12 receive rings.
 
@@ -124,7 +129,9 @@ allOf:
       properties:
         compatible:
           contains:
-            const: apple,t8142-usb4-nhi
+            enum:
+              - apple,t6050-usb4-nhi
+              - apple,t8142-usb4-nhi
     then:
       properties:
         reg:
@@ -147,6 +154,7 @@ allOf:
               - apple,t8122-usb4-nhi
               - apple,t8132-usb4-nhi
               - apple,t8142-usb4-nhi
+              - apple,t6050-usb4-nhi
     then:
       properties:
         iommus:
@@ -170,4 +178,17 @@ allOf:
           iommus:
             maxItems: 1
 
+  - if:
+      properties:
+        compatible:
+          not:
+            contains:
+              const: apple,t6050-usb4-nhi
+    then:
+      properties:
+        interrupts:
+          maxItems: 24
+        interrupt-names:
+          maxItems: 24
+
 additionalProperties: false
-- 
2.56.0

