From 36f957c2aad2a7437daaa5a9bec3c679c3c9a5c8 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Wed, 4 Nov 2026 18:08:06 -0500
Subject: [PATCH 08/16] dt-bindings: iommu: apple,dart: Describe the setup of a
 DART nothing initialises

A T8110 DART that no boot loader sets up, such as a USB4 router's or
its PCIe-C tunnel's, needs the device tree to describe what the boot
loader otherwise does: its tunables, its bypass streams, every error
reported and the context cache flushed.

Add apple,full-error-reporting and apple,ctc-flush, and extend
apple,bypass-sids beyond the PCIe-C tunnel DARTs.

Developed with Claude Code.

Signed-off-by: Erik Bourget <erik@ebourget.net>
---
 .../devicetree/bindings/iommu/apple,dart.yaml | 20 +++++++++++++++++--
 1 file changed, 18 insertions(+), 2 deletions(-)

diff --git a/Documentation/devicetree/bindings/iommu/apple,dart.yaml b/Documentation/devicetree/bindings/iommu/apple,dart.yaml
index 7dac23e6a73c..f9bf52ca785b 100644
--- a/Documentation/devicetree/bindings/iommu/apple,dart.yaml
+++ b/Documentation/devicetree/bindings/iommu/apple,dart.yaml
@@ -147,9 +147,25 @@ properties:
     items:
       maximum: 255
     description:
-      Reserved streams of a USB4 PCIe tunnel DART that its PCIe-C port issues
+      Streams set to bypass after every reset of the DART, outside any domain.
+      On a USB4 PCIe tunnel DART, the reserved streams its PCIe-C port issues
       its own writes on, such as the interrupt controller writes its MSIs
-      turn into. They are set to bypass after every reset of the DART.
+      turn into. On a T8110 DART that nothing initialises before Linux, such
+      as a USB4 router's, the streams its co-processor uses without
+      translation.
+
+  apple,full-error-reporting:
+    type: boolean
+    description:
+      Unmask every error and enable the error interrupt for every stream,
+      with the registers of the DART's revision, and leave the DART unlocked
+      on error. For a T8110 DART that nothing initialises before Linux.
+
+  apple,ctc-flush:
+    type: boolean
+    description:
+      Flush the DART's context cache after a stream flush, where the DART
+      has one. For a T8110 DART that nothing initialises before Linux.
 
   apple,remap-streams:
     $ref: /schemas/types.yaml#/definitions/uint32-matrix
