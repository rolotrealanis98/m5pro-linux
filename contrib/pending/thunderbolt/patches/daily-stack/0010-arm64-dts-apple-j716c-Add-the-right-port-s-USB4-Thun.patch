+/*
+ * ATC2's USB4/Thunderbolt router (ADT /arm-io/acio2, acio-cpu2 and dart-acio2), powered per
+ * connection: the PHY enters CIO mode, then the router's domains come on (ATC2_CIO, _PCIE, _USB,
+ * _AUSS), the CIO reset (reconfig request) clocks the CPU wrapper, the CPU runs from the image the
+ * boot loader left in its SRAM, and once its firmware is ready the DART and the NHI are populated.
+ * Nothing here is touched at boot. The router is named acio@: the boot loader disables a cio@ node
+ * unless its first register is the third register of the matching /arm-io/acioN, which on T6050
+ * is not the router's rc block. The board gives the tunables and the host DROM until the boot
+ * loader fills them.
+ */
+&pmgr0 {
+	ps_atc2_cio: power-controller@2e8 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x2e8 4>;
+		label = "atc2_cio";
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		power-domains = <&ps_atc2_common>;
+	};
+
+	ps_atc2_cio_pcie: power-controller@3f8 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x3f8 4>;
+		label = "atc2_cio_pcie";
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		power-domains = <&ps_atc2_cio>;
+	};
+
+	ps_atc2_cio_usb: power-controller@400 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x400 4>;
+		label = "atc2_cio_usb";
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		power-domains = <&ps_atc2_cio>;
+	};
+
+	ps_atc2_cio_auss: power-controller@408 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x408 4>;
+		label = "atc2_cio_auss";
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		power-domains = <&ps_atc2_cio>, <&ps_auss>;
+	};
+};
+
+/* LSTX: /arm-io/acio2 gpio-lstx, AOP GPIO pin 81 (0x51), function 1 for the router */
+&pinctrl_aop {
+	acio2_lstx_pins: acio2-lstx-pins {
+		pinmux = <0x10051>;	/* APPLE_PINMUX(81, 1) */
+	};
+};
+
+&die0 {
+	/* /arm-io/acio-cpu2 reg[0]: the router CPU's mailbox, inside its wrapper */
+	acio2_mbox: mailbox@381108000 {
+		compatible = "apple,t6050-asc-mailbox", "apple,asc-mailbox-v4";
+		reg = <0x3 0x81108000 0x0 0x4000>;
+		interrupts = <AIC_IRQ 0 857 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 0 858 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 0 859 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 0 860 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "send-empty", "send-not-empty",
+				  "recv-empty", "recv-not-empty";
+		#mbox-cells = <0>;
+	};
+
+	/*
+	 * /arm-io/acio2: rc (reg[1]), the RTKit data segment in its SRAM, the PCIe adapter,
+	 * acio-cpu2 reg[1] (the CPU wrapper) and the PCIe router AP firmware block.
+	 */
+	acio2: acio@381ac0000 {
+		compatible = "apple,t6050-usb4-acio";
+		reg = <0x3 0x81ac0000 0x0 0xc000>,
+		      <0x3 0x81080000 0x0 0x26000>,
+		      <0x3 0x81e44000 0x0 0x4000>,
+		      <0x3 0x81100000 0x0 0x4000>,
+		      <0x3 0x81c80000 0x0 0x4000>;
+		reg-names = "rc", "sram", "pcie-adapter", "cpu", "router-ap-fw";
+		mboxes = <&acio2_mbox>;
+		resets = <&cio_reconfig0 2>;
+		power-domains = <&ps_atc2_cio>, <&ps_atc2_cio_pcie>,
+				<&ps_atc2_cio_usb>, <&ps_atc2_cio_auss>;
+		thunderbolt-switch;
+		pinctrl-0 = <&acio2_lstx_pins>;
+		pinctrl-names = "lstx";
+		lstx-gpios = <&pinctrl_aop 81 GPIO_ACTIVE_HIGH>;
+
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0x0 0x3 0x81000000 0x1000000>;
+		nonposted-mmio;
+
+		/*
+		 * /arm-io/dart-acio2, populated with the NHI once the router runs, so that it is
+		 * first read with the router up. Nothing initialises it before Linux: its tunables
+		 * (dart-tunables-instance-0), stream 15 (bypass-15) in bypass, every error
+		 * reported and the context cache flushed. vm-base 0x100_0000_0000.
+		 */
+		acio2_dart: iommu@a80000 {
+			compatible = "apple,t6050-dart", "apple,t8110-dart";
+			reg = <0xa80000 0xc000>;
+			interrupts = <AIC_IRQ 0 1670 IRQ_TYPE_LEVEL_HIGH>;
+			power-domains = <&ps_atc2_cio>;
+			#iommu-cells = <1>;
+			apple,dma-range = <0x100 0x4000 0x0 0xffff0000>;
+			apple,bypass-sids = <15>;
+			apple,full-error-reporting;
+			apple,ctc-flush;
+		};
+
+		/* Interrupts 0x66b.. are the TX rings and 0x677.. the RX rings */
+		acio2_nhi: nhi@f00000 {
+			compatible = "apple,t6050-usb4-nhi";
+			reg = <0xf00000 0x100000>;
+			reg-names = "nhi";
+			interrupts = <AIC_IRQ 0 1643 IRQ_TYPE_LEVEL_HIGH>,
+					     <AIC_IRQ 0 1644 IRQ_TYPE_LEVEL_HIGH>,
+					     <AIC_IRQ 0 1645 IRQ_TYPE_LEVEL_HIGH>,
+					     <AIC_IRQ 0 1646 IRQ_TYPE_LEVEL_HIGH>,
+					     <AIC_IRQ 0 1647 IRQ_TYPE_LEVEL_HIGH>,
+					     <AIC_IRQ 0 1648 IRQ_TYPE_LEVEL_HIGH>,
+					     <AIC_IRQ 0 1649 IRQ_TYPE_LEVEL_HIGH>,
+					     <AIC_IRQ 0 1650 IRQ_TYPE_LEVEL_HIGH>,
+					     <AIC_IRQ 0 1651 IRQ_TYPE_LEVEL_HIGH>,
+					     <AIC_IRQ 0 1652 IRQ_TYPE_LEVEL_HIGH>,
+					     <AIC_IRQ 0 1653 IRQ_TYPE_LEVEL_HIGH>,
+					     <AIC_IRQ 0 1654 IRQ_TYPE_LEVEL_HIGH>,
+					     <AIC_IRQ 0 1655 IRQ_TYPE_LEVEL_HIGH>,
+					     <AIC_IRQ 0 1656 IRQ_TYPE_LEVEL_HIGH>,
+					     <AIC_IRQ 0 1657 IRQ_TYPE_LEVEL_HIGH>,
+					     <AIC_IRQ 0 1658 IRQ_TYPE_LEVEL_HIGH>,
+					     <AIC_IRQ 0 1659 IRQ_TYPE_LEVEL_HIGH>,
+					     <AIC_IRQ 0 1660 IRQ_TYPE_LEVEL_HIGH>,
+					     <AIC_IRQ 0 1661 IRQ_TYPE_LEVEL_HIGH>,
+					     <AIC_IRQ 0 1662 IRQ_TYPE_LEVEL_HIGH>,
+					     <AIC_IRQ 0 1663 IRQ_TYPE_LEVEL_HIGH>,
+					     <AIC_IRQ 0 1664 IRQ_TYPE_LEVEL_HIGH>,
+					     <AIC_IRQ 0 1665 IRQ_TYPE_LEVEL_HIGH>,
+					     <AIC_IRQ 0 1666 IRQ_TYPE_LEVEL_HIGH>,
+					     <AIC_IRQ 0 1672 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "txring0", "txring1", "txring2", "txring3", "txring4", "txring5",
+						  "txring6", "txring7", "txring8", "txring9", "txring10", "txring11",
+						  "rxring0", "rxring1", "rxring2", "rxring3", "rxring4", "rxring5",
+						  "rxring6", "rxring7", "rxring8", "rxring9", "rxring10", "rxring11",
+						  "parity";
+			iommus = <&acio2_dart 0>,
+				 <&acio2_dart 1>,
+				 <&acio2_dart 2>,
+				 <&acio2_dart 3>,
+				 <&acio2_dart 4>,
+				 <&acio2_dart 5>,
+				 <&acio2_dart 6>,
+				 <&acio2_dart 7>,
+				 <&acio2_dart 8>,
