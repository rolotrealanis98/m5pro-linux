 enum atc_operation { ATC_MASK, ATC_TUNABLE, ATC_DELAY, ATC_POLL, ATC_POWER, ATC_FIRMWARE };
 struct atc_op {
@@ -68,9 +70,9 @@ struct atc_domain {
 	struct device *dev;
