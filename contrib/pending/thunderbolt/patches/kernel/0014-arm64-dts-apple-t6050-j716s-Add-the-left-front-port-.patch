From 3b533af1efdc5001cafa3d0d09f41a1619d12bbb Mon Sep 17 00:00:00 2001
From: Rolando Trevino <rolotrealanis@gmail.com>
Date: Sat, 7 Nov 2026 13:50:46 -0500
Subject: [PATCH 14/15] arm64: dts: apple: t6050-j716s: Add the left-front
 port's USB4/Thunderbolt router

hpm1, the left-front port's PD controller, names acio1 as its router in
the ADT. Enable ATC1's router and link it to the connector's USB4 port,
as the right port does, expose its LSTX pin (AOP GPIO 79) and give the
boot loader the usb4-1-* aliases for its tables.

The left-back port (ATC0) also has a router in the ADT. It is the debug
port and is not described here.

Signed-off-by: Rolando Trevino <rolotrealanis@gmail.com>
Assisted-by: LLM Claude
---
 arch/arm64/boot/dts/apple/t6050-j716s.dts | 45 +++++++++++++++++++++--
 1 file changed, 41 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t6050-j716s.dts b/arch/arm64/boot/dts/apple/t6050-j716s.dts
index 8f7e09396904..a1e9eb9660db 100644
--- a/arch/arm64/boot/dts/apple/t6050-j716s.dts
+++ b/arch/arm64/boot/dts/apple/t6050-j716s.dts
@@ -347,22 +347,26 @@ aliases {
 		usb4-2-pcie-adapter = &acio2;
 		usb4-2-nhi = &acio2_nhi;
 		usb4-2-pcie = &apciec2;
+		usb4-1-acio = &acio1;
+		usb4-1-pcie-adapter = &acio1;
+		usb4-1-nhi = &acio1_nhi;
+		usb4-1-pcie = &apciec1;
 	};
 };
 
-/* ATC2_CIO_AUSS's other parent; kept as the boot loader leaves it */
+/* ATC1_ and ATC2_CIO_AUSS's other parent; kept as the boot loader leaves it */
 &ps_auss {
 	status = "okay";
 };
 
-/* The CIO reconfig request, port 2 (clock gate CIO2_RECONFIG_V) */
+/* The CIO reconfig requests, ports 1 and 2 (clock gates CIO1_ and CIO2_RECONFIG_V) */
 &cio_reconfig0 {
 	status = "okay";
 };
 
-/* Only the router's LSTX pin (81) of the AOP GPIO controller is exposed. */
+/* Only the routers' LSTX pins (79 for ATC1, 81 for ATC2) of the AOP GPIO controller are exposed. */
 &pinctrl_aop {
-	gpio-reserved-ranges = <0 81>, <82 3>;
+	gpio-reserved-ranges = <0 79>, <80 1>, <82 3>;
 	status = "okay";
 };
 
@@ -523,3 +527,36 @@ tp-accel {
  *   2 afe-reset      (0x10000, 0x11c0000)
  */
 /delete-node/ &smc_pcio;
+
+/*
+ * The left-front port's USB4/Thunderbolt router (ATC1), as the right port's:
+ * acio1 and its tunnel in t6050-max.dtsi follow this board's ADT (acio1,
+ * acio-cpu1, dart-acio1, apciec1, dart-apciec1), and hpm1's acio-parent is
+ * acio1. The boot loader fills the same tables through the usb4-1-* aliases.
+ */
+&typec1 {
+	ports {
+		port@3 {
+			reg = <3>;
+			typec1_usb4: endpoint {
+				remote-endpoint = <&acio1_tbt>;
+			};
+		};
+	};
+};
+
+&acio1 {
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@1 {
+			reg = <1>;
+			acio1_tbt: endpoint {
+				remote-endpoint = <&typec1_usb4>;
+			};
+		};
+	};
+};
-- 
