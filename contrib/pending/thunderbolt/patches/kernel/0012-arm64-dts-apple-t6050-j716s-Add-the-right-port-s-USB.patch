From 0285762a01250cb9c9cd049dcf5477fde2cf2cdb Mon Sep 17 00:00:00 2001
From: Rolando Trevino <rolotrealanis@gmail.com>
Date: Sat, 7 Nov 2026 13:49:14 -0500
Subject: [PATCH 12/15] arm64: dts: apple: t6050-j716s: Add the right port's
 USB4/Thunderbolt router

The J716s ADT has the same right-hand router as the J716c: acio2 (port
number 3, "right"), acio-cpu2, dart-acio2, the PCIe tunnel apciec2 and
dart-apciec2, the power states ATC2_CIO, _CIO_PCIE, _CIO_USB, _CIO_AUSS
and ATC2_PCIE, the reconfig request CIO2_RECONFIG_V and the LSTX line on
AOP GPIO 81. Registers, interrupts, power states and the MSI slice match
the nodes t6050-max.dtsi carries, and hpm2's acio-parent is acio2.

Wire it up as the J716c does: the AUSS parent domain, the CIO reconfig
request, the AOP pin controller with only pin 81 exposed, and the USB4
endpoint between hpm2's connector and the router.

The router, NHI, DART, tunnel and PHY CIO tunables and the host DROM are
left to the boot loader, which copies them from the ADT through the
usb4-2-* aliases (the DROM with the router UUID it generates). The
router and the NHI refuse to probe without them, and the PD controller
then carries on without the router once the driver core stops waiting
for it, so the port keeps its USB and power delivery as before.

Signed-off-by: Rolando Trevino <rolotrealanis@gmail.com>
Assisted-by: LLM Claude
---
 arch/arm64/boot/dts/apple/t6050-j716s.dts | 65 +++++++++++++++++++++++
 1 file changed, 65 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t6050-j716s.dts b/arch/arm64/boot/dts/apple/t6050-j716s.dts
index 8411980cc50e..8f7e09396904 100644
--- a/arch/arm64/boot/dts/apple/t6050-j716s.dts
+++ b/arch/arm64/boot/dts/apple/t6050-j716s.dts
@@ -326,6 +326,71 @@ &usb_drd2_dart_1 {
 	status = "okay";
 };
 
+/*
+ * The right port's USB4/Thunderbolt router (ATC2): acio2, its DART and NHI and
+ * the PCIe tunnel (pcie-tunnel-2) are in t6050-max.dtsi and match this board's
+ * ADT (acio2, acio-cpu2, dart-acio2, apciec2, dart-apciec2, pmgr ATC2_CIO*,
+ * ATC2_PCIE, CIO2_RECONFIG_V, LSTX on AOP GPIO 81). hpm2's acio-parent is acio2.
+ *
+ * The boot loader fills, from the ADT and through the aliases below: the
+ * router's apple,tunable-rc, -pcie-adapter and -router-ap-fw, the NHI's
+ * apple,tunable-nhi and apple,thunderbolt-drom (with the router UUID it
+ * generates), both DARTs' apple,tunable, the tunnel's apple,tunable-debug,
+ * -rc, -fabric and its port's apple,tunable, and the PHY's CIO tunables. The
+ * router and the NHI refuse to probe without their tables, which leaves the
+ * port's USB and power delivery as they are without the router.
+ */
+/ {
+	aliases {
+		atcphy2 = &atc2_phy;
+		usb4-2-acio = &acio2;
+		usb4-2-pcie-adapter = &acio2;
+		usb4-2-nhi = &acio2_nhi;
+		usb4-2-pcie = &apciec2;
+	};
+};
+
+/* ATC2_CIO_AUSS's other parent; kept as the boot loader leaves it */
+&ps_auss {
+	status = "okay";
+};
+
+/* The CIO reconfig request, port 2 (clock gate CIO2_RECONFIG_V) */
+&cio_reconfig0 {
+	status = "okay";
+};
+
+/* Only the router's LSTX pin (81) of the AOP GPIO controller is exposed. */
+&pinctrl_aop {
+	gpio-reserved-ranges = <0 81>, <82 3>;
+	status = "okay";
+};
+
+&typec2 {
+	ports {
+		port@3 {
+			reg = <3>;
+			typec2_usb4: endpoint {
+				remote-endpoint = <&acio2_tbt>;
+			};
+		};
+	};
+};
+
+&acio2 {
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@1 {
+			reg = <1>;
+			acio2_tbt: endpoint {
+				remote-endpoint = <&typec2_usb4>;
+			};
+		};
+	};
+};
+
 /* Audio is not brought up: six sn012776 on i2c1/i2c3 and a cs42l84 on i2c2 */
 &i2c1 {
 	status = "disabled";
-- 
