# USB4/Thunderbolt for the J716s daily build, merged after the daily fragments:
#   scripts/kconfig/merge_config.sh -m .config j716s-usb4.config && make olddefconfig
# Same lines as patches/kernel/0015 adds to arch/arm64/configs/j716s.config.
CONFIG_USB4=y
CONFIG_USB4_APPLE_SOC=y
CONFIG_RESET_APPLE_CIO=y
CONFIG_APPLE_DART=y
CONFIG_PCIE_APPLE=y
CONFIG_HOTPLUG_PCI_PCIE=y
CONFIG_USB_XHCI_PCI=y
CONFIG_BLK_DEV_NVME=y
CONFIG_IGC=y
CONFIG_R8169=y
CONFIG_TIGON3=y
CONFIG_ATLANTIC=y
