hwmon: (macsmc) keep a fan whose optional keys are missing

macsmc_hwmon_create_fan() returned an error, dropping the whole fan, when
any of apple,fan-minimum/-maximum/-target/-mode named a key the SMC does
not have. The T6050 (M5 Pro) SMC spells the mode key F0md instead of
F0Md, so with the shared hwmon-fan*.dtsi both fans disappeared. Treat the
optional keys as optional: warn, drop that attribute, and only allow
manual control when mode, target, minimum and maximum keys all exist.

Co-Authored-By: Claude <noreply@anthropic.com>

diff --git a/drivers/hwmon/macsmc-hwmon.c b/drivers/hwmon/macsmc-hwmon.c
index 1500ec2cc..58d3dba5d 100644
--- a/drivers/hwmon/macsmc-hwmon.c
+++ b/drivers/hwmon/macsmc-hwmon.c
@@ -524,37 +524,43 @@ static int macsmc_hwmon_create_fan(struct device *dev, struct apple_smc *smc,
 		fan->attrs |= HWMON_F_LABEL;
 	}
 
-	/* The following keys are not required to simply monitor fan speed */
+	/*
+	 * The following keys are not required to simply monitor fan speed.
+	 * A key the firmware lacks (the T6050 SMC spells the mode key F0md,
+	 * not F0Md) drops only that attribute, not the whole fan.
+	 */
 	if (!of_property_read_string(fan_node, "apple,fan-minimum", &min)) {
-		ret = macsmc_hwmon_parse_key(dev, smc, &fan->min, min);
-		if (ret)
-			return ret;
-
-		fan->attrs |= HWMON_F_MIN;
+		if (macsmc_hwmon_parse_key(dev, smc, &fan->min, min))
+			dev_warn(dev, "Fan %s: no minimum key %s\n", now, min);
+		else
+			fan->attrs |= HWMON_F_MIN;
 	}
 
 	if (!of_property_read_string(fan_node, "apple,fan-maximum", &max)) {
-		ret = macsmc_hwmon_parse_key(dev, smc, &fan->max, max);
-		if (ret)
-			return ret;
-
-		fan->attrs |= HWMON_F_MAX;
+		if (macsmc_hwmon_parse_key(dev, smc, &fan->max, max))
+			dev_warn(dev, "Fan %s: no maximum key %s\n", now, max);
+		else
+			fan->attrs |= HWMON_F_MAX;
 	}
 
 	if (!of_property_read_string(fan_node, "apple,fan-target", &set)) {
-		ret = macsmc_hwmon_parse_key(dev, smc, &fan->set, set);
-		if (ret)
-			return ret;
-
-		fan->attrs |= HWMON_F_TARGET;
+		if (macsmc_hwmon_parse_key(dev, smc, &fan->set, set))
+			dev_warn(dev, "Fan %s: no target key %s\n", now, set);
+		else
+			fan->attrs |= HWMON_F_TARGET;
 	}
 
 	if (!of_property_read_string(fan_node, "apple,fan-mode", &mode)) {
-		ret = macsmc_hwmon_parse_key(dev, smc, &fan->mode, mode);
-		if (ret)
-			return ret;
+		if (macsmc_hwmon_parse_key(dev, smc, &fan->mode, mode))
+			dev_warn(dev, "Fan %s: no mode key %s, manual control disabled\n",
+				 now, mode);
 	}
 
+	/* Manual control needs the minimum, maximum and target keys too */
+	if ((fan->attrs & (HWMON_F_MIN | HWMON_F_MAX | HWMON_F_TARGET)) !=
+	    (HWMON_F_MIN | HWMON_F_MAX | HWMON_F_TARGET))
+		fan->mode.macsmc_key = 0;
+
 	/* Initialise fan control mode to automatic */
 	fan->manual = false;
 
