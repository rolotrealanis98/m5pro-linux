+/*
+ * EDR on a panel, as macOS drives it (see dcp-edr.h).  With applied
+ * headroom H (x1000 below), a swap asks for brightness SDR white x H,
+ * display EDR scale 1 / H and, while the frame uses EDR, headroom used H;
+ * the firmware shows a PQ surface at (PQ nits / 100) x the scale x the
+ * panel level, so PQ 100 lands at SDR white and highlights reach the panel
+ * peak.  H rises in steps linear in stops, one per swap, about 1 s when
+ * EDR starts, with a brightness limit of 1.3 x the brightness in the middle
+ * of the ramp.  H never exceeds the panel's potential headroom from the
+ * ADT, as on macOS.  When EDR ends, headroom used drops to 1.0 and H
+ * returns to 1.0.  Unchanged values are left out: the firmware keeps them.
+ *
+ * @nits is the level a swap carries itself (@carries: a brightness change
+ * or power on), else @standing, the current one, stands.  A swap that turns
+ * the panel off keeps its zero.  After a power off the ramp starts again
+ * from 1.0: asking for the peak at once does not take after a power on, on
+ * macOS either.  Returns false when the swap carries no EDR values.
+ */
+static bool dcp_edr_plan(struct apple_dcp *dcp, bool carries, u32 nits,
+			 u32 standing, struct dcp_edr_plan *plan)
+{
+	u32 peak = READ_ONCE(dcp->panel.peak_nits);
+	u32 sdr = carries ? nits : standing;
+	u32 cur = dcp->edr_hm ?: DCP_EDR_UNITY, target = DCP_EDR_UNITY, next;
+	u32 prev_sdr = dcp->edr_sdr;
+	bool restart = dcp->edr_restart;
+
+	dcp->edr_restart = false;
+	if (!dcp->output_edr && !dcp->edr_hm)
+		return false;	/* no EDR, and none to wind down */
+	if (!sdr)
+		return false;
+	if (dcp->output_edr)
+		target = dcp_edr_target(peak, sdr, dcp->panel.edr_ceiling);
+	if (restart && dcp->output_edr) {
+		cur = DCP_EDR_UNITY;
+		prev_sdr = sdr;
+	}
+	dcp->edr_sdr = sdr;
+	if (cur == target && !carries && !restart && dcp->edr_sent == dcp->output_edr)
+		return false;
+
+	/*
+	 * Up in steps; down at once.  macOS ramps down too, but its compositor
+	 * keeps presenting until the ramp ends.  Here a still desktop may send
+	 * no further swap, and a ramp stuck partway leaves SDR content dimmed
+	 * by the scale (headroom used is already 1.0).
+	 */
+	next = dcp_edr_next(cur, target, prev_sdr, sdr);
+
+	*plan = (struct dcp_edr_plan) {
+		.nits = (u64)sdr * next / DCP_EDR_UNITY,
+		.hm = next,
+		.limit = next != target && next != cur,
+	};
+	if (dcp->output_edr) {
+		plan->headroom = true;
+		dcp->edr_sent = true;
+	} else if (dcp->edr_sent) {
+		plan->headroom = true;
+		plan->headroom_unity = true;
+		dcp->edr_sent = false;
+	}
+	/* Back at 1.0 without EDR: leave the firmware's values alone again. */
+	dcp->edr_hm = (!dcp->output_edr && next == 1000) ? 0 : next;
+	return true;
+}
