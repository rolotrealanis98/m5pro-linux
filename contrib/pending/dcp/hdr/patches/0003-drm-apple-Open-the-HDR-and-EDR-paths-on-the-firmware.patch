index 462f3076bee2..fe679962c5fa 100644
--- a/drivers/gpu/drm/apple/dcp-edr.h
+++ b/drivers/gpu/drm/apple/dcp-edr.h
@@ -4,6 +4,8 @@
 #ifndef __APPLE_DCP_EDR_H__
 #define __APPLE_DCP_EDR_H__
 
+#include <linux/bitops.h>
+#include <linux/bits.h>
 #include <linux/limits.h>
 #include <linux/math64.h>
 #include <linux/minmax.h>
@@ -63,4 +65,74 @@ static inline u32 dcp_edr_next(u32 cur, u32 target, u32 prev_sdr, u32 sdr)
 		     target);
 }
 
+/* The binary64 nearest @num / @den, for small positive integers. */
+static inline u64 dcp_binary64_ratio(u64 num, u64 den)
+{
+	u64 mantissa = 0;
+	int exponent = 0;
+
+	while (num >= 2 * den) {
+		den <<= 1;
+		exponent++;
+	}
+	while (num < den) {
+		num <<= 1;
+		exponent--;
+	}
+	/* den <= num < 2 den: 53 quotient bits, then round to nearest */
+	for (unsigned int i = 0; i < 53; i++) {
+		mantissa <<= 1;
+		if (num >= den) {
+			mantissa |= 1;
+			num -= den;
+		}
+		num <<= 1;
+	}
+	if (num >= den && ++mantissa == 1ULL << 53) {
+		mantissa >>= 1;
+		exponent++;
+	}
+	return (u64)(exponent + 1023) << 52 | (mantissa & GENMASK_ULL(51, 0));
+}
+
+/* The binary64 of @nits (exact: every u32 is representable); 0 for 0. */
+static inline u64 dcp_binary64_nits(u32 nits)
+{
+	unsigned int exponent;
+
+	if (!nits)
+		return 0;
+	exponent = fls(nits) - 1;
+	return (u64)(exponent + 1023) << 52 |
+	       (((u64)nits << (52 - exponent)) & GENMASK_ULL(51, 0));
+}
+
+/* The u32 a binary64 holds, when it is a whole number in range; else 0. */
+static inline u32 dcp_binary64_to_u32(u64 bits)
+{
+	int exponent = (int)((bits >> 52) & 0x7ff) - 1023;
+	u64 mantissa = (bits & GENMASK_ULL(51, 0)) | 1ULL << 52;
+
+	if (bits >> 63 || exponent < 0 || exponent > 31)
+		return 0;
+	if (mantissa & GENMASK_ULL(51 - exponent, 0))
+		return 0;
+	return mantissa >> (52 - exponent);
+}
+
+/*
+ * What one swap carries for EDR (see dcp_edr_plan() in iomfb_template.c):
+ * the brightness, flagged by bl_update; the display scale 1000 / @hm,
+ * flagged by bl_flags[2]; the headroom @hm / 1000 (or 1 when EDR ends),
+ * flagged by bl_flags[4]; and the limit 1.3 x the brightness in the middle
+ * of a ramp, flagged by bl_flags[1].
+ */
+struct dcp_edr_plan {
+	u32 nits;		/* the brightness to ask for */
+	u32 hm;			/* applied headroom x1000 */
+	bool headroom;		/* carry the headroom used */
+	bool headroom_unity;	/* ... as 1 (EDR ending) */
+	bool limit;		/* carry the brightness limit */
+};
+
 #endif /* __APPLE_DCP_EDR_H__ */
