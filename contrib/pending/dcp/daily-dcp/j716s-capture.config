# J716s daily-dcp capture kernel: the same configuration as the daily-dcp kernel except that
# the GPU driver (aurora) is a module. The DCP (DRM_APPLE=y) then probes alone in the initcall
# window, the root mounts and journald flushes before the GPU probe, and aurora is loaded from
# the root (by udev, or by hand with modprobe when modprobe.blacklist=aurora is on the command
# line), so a failure in the GPU probe lands in the persistent journal.
CONFIG_DRM_ASAHI=m
