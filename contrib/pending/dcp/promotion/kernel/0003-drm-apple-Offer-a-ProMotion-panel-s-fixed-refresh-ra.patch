 /*
  * Publish a TimingElements catalog. Replaced arrays stay allocated, as
  * readers may still hold a snapshot. A failed parse keeps an admitted
@@ -1994,8 +1999,13 @@ int dcp_modes_replace(struct apple_dcp *dcp, struct dcp_parse_ctx *ctx,
 	} else {
 		/* An internal ProMotion panel starts at 120 Hz. */
 		if (!h17p_external &&
-		    dcp->fixed_connector_type == DRM_MODE_CONNECTOR_eDP)
+		    dcp->fixed_connector_type == DRM_MODE_CONNECTOR_eDP) {
 			dcp_promotion_default(modes, nr_modes);
+			/* The desktop 26.x mode set has no fixed-rate path. */
