@@ -1312,6 +1312,122 @@ void dcp_promotion_default(struct dcp_display_mode *modes, unsigned int count)
 	best->mode.type |= DRM_MODE_TYPE_PREFERRED;
 }
 
+/*
+ * The fixed refresh rates macOS offers on a ProMotion panel besides
+ * ProMotion itself and 120 Hz (System Settings, Displays), and 100 Hz.
+ * NTSC rates are the nominal rate times 1000/1001.
+ */
+static const struct {
+	u8 hz;
+	bool ntsc;
+} dcp_promotion_rates[] = {
+	{ 100, false }, { 60, false }, { 60, true }, { 50, false },
+	{ 48, false }, { 48, true },
+};
+
+static bool dcp_catalog_has_rate(const struct dcp_display_mode *modes,
+				 unsigned int count,
+				 const struct drm_display_mode *size, u32 rate)
+{
+	unsigned int i;
+
+	for (i = 0; i < count; i++) {
+		u32 r = dcp_mode_refresh(&modes[i].mode);
+
+		if (modes[i].mode.hdisplay == size->hdisplay &&
+		    modes[i].mode.vdisplay == size->vdisplay &&
+		    abs_diff(r, rate) <= rate / 2000)
+			return true;
+	}
+	return false;
+}
+
+/*
+ * Offer the fixed refresh rates of an internal ProMotion panel as modes of
+ * its preferred 120 Hz timing. The panel has one timing with an
+ * adaptive-sync range; macOS runs every fixed rate on that timing, so a
+ * fixed-rate mode keeps its timing ID, pixel clock and horizontal timing,
+ * and only stretches its vertical front porch so that DRM reports its
+ * rate. The mode set holds the rate through adaptive sync (fixed_rate).
+ *
+ * Rates outside the timing's adaptive-sync range (24 Hz up for a timing
+ * whose range fields are zero), and rates the firmware already lists a
+ * timing of the same size for, are not offered. Only an internal panel's
+ * timing at 120 Hz needs presentation timestamps (needs_timestamps). Takes
+ * @modes and returns the catalog, @modes itself when nothing is added or
+ * the larger array cannot be allocated.
+ */
+struct dcp_display_mode *dcp_promotion_fixed_modes(struct dcp_display_mode *modes,
+						   unsigned int *count)
+{
+	const struct dcp_display_mode *base = NULL;
+	struct dcp_display_mode *out;
+	unsigned int i, n = *count, added = 0;
+	u32 low, high;
+
+	for (i = 0; i < n; i++)
+		if (modes[i].mode.type & DRM_MODE_TYPE_PREFERRED)
+			base = &modes[i];
+	if (!base || !base->needs_timestamps || base->fixed_rate ||
+	    base->automatic_rgb8_quirk ||
+	    !dcp_refresh_is_promotion(dcp_mode_refresh(&base->mode)))
+		return modes;
+	/*
+	 * A 120 Hz panel timing whose range fields are both zero (the T6050
+	 * panel's) parses as fixed outside desktop firmware; the panel still
+	 * runs the ProMotion range, 24 Hz up to the timing's rate.
+	 */
+	low = base->vrr ? base->min_vrr : 24U << 16;
+	high = base->vrr ? base->max_vrr : dcp_mode_refresh(&base->mode);
+
+	out = krealloc_array(modes, n + ARRAY_SIZE(dcp_promotion_rates),
+			     sizeof(*modes), GFP_KERNEL);
+	if (!out)
+		return modes;
+	/* krealloc may have moved the catalog. */
+	for (i = 0; i < n; i++)
+		if (out[i].mode.type & DRM_MODE_TYPE_PREFERRED)
+			base = &out[i];
+
+	for (i = 0; i < ARRAY_SIZE(dcp_promotion_rates); i++) {
+		u32 rate = dcp_promotion_rates[i].hz << 16;
+		struct dcp_display_mode *m = &out[n + added];
+		u64 line, vtotal;
+		u16 extra;
+
+		if (dcp_promotion_rates[i].ntsc)
+			rate = DIV_ROUND_CLOSEST((u64)rate * 1000, 1001);
+		if (rate < low || rate >= high ||
+		    dcp_catalog_has_rate(out, n + added, &base->mode, rate))
+			continue;
+		/* The divisor exceeds 32 bits: no DIV_ROUND_CLOSEST_ULL. */
+		line = (u64)base->mode.htotal * rate;
+		vtotal = div64_u64((((u64)base->mode.clock * 1000) << 16) + line / 2,
+				   line);
+		if (vtotal <= base->mode.vtotal || vtotal > U16_MAX)
+			continue;
+		extra = vtotal - base->mode.vtotal;
+
+		*m = *base;
+		m->mode.type = DRM_MODE_TYPE_DRIVER;
+		m->mode.vsync_start += extra;
+		m->mode.vsync_end += extra;
+		m->mode.vtotal = vtotal;
+		drm_mode_set_name(&m->mode);
+		m->vrr = false;
+		m->min_vrr = rate;
+		m->max_vrr = rate;
+		m->fixed_rate = rate;
+		m->needs_timestamps = true;
+		m->preferred = false;
+		m->firmware_preferred = false;
+		m->metadata_timing_valid = false;
+		added++;
+	}
+	*count = n + added;
+	return out;
+}
+
 /* Entries of the array at the cursor, which is not consumed. */
