index 8715d4d38531..3cf570047db0 100644
--- a/drivers/gpu/drm/apple/parser.c
+++ b/drivers/gpu/drm/apple/parser.c
@@ -1298,7 +1298,7 @@ void dcp_promotion_default(struct dcp_display_mode *modes, unsigned int count)
 	for (i = 0; i < count; i++) {
 		struct dcp_display_mode *m = &modes[i];
 
-		if (m->automatic_rgb8_quirk ||
