diff --git a/drivers/gpu/drm/apple/parser-test.c b/drivers/gpu/drm/apple/parser-test.c
index cf8a251fd886..7be913dfda6a 100644
--- a/drivers/gpu/drm/apple/parser-test.c
+++ b/drivers/gpu/drm/apple/parser-test.c
@@ -546,6 +546,101 @@ static void parser_promotion_default(struct kunit *test)
 	kfree(modes);
 }
 
+/* The fixed refresh rates of a ProMotion timing, as modes of that timing. */
+static void parser_promotion_fixed_modes(struct kunit *test)
+{
+	static const u32 rates[] = {
+		100U << 16, 60U << 16, 3928232, 50U << 16, 48U << 16, 3142585,
+	};
+	struct parser_record record = valid_record(7, 10);
+	struct dcp_display_mode *modes;
+	struct parser_blob *blob;
+	unsigned int count, i;
+
+	/* No range: the internal ProMotion convention, 24 to 120 Hz. */
+	record.rate = 120 << 16;
+	blob = make_blob(test, &record, 1);
+	KUNIT_ASSERT_NOT_NULL(test, blob);
+	modes = parse_blob(blob, &count, 0, true);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, modes);
+	KUNIT_ASSERT_EQ(test, count, 1U);
+	modes = dcp_promotion_fixed_modes(modes, &count);
+	KUNIT_ASSERT_EQ(test, count, 1U + ARRAY_SIZE(rates));
+	KUNIT_EXPECT_TRUE(test, modes[0].mode.type & DRM_MODE_TYPE_PREFERRED);
+	KUNIT_EXPECT_TRUE(test, modes[0].vrr);
+	KUNIT_EXPECT_EQ(test, modes[0].fixed_rate, 0U);
+	for (i = 0; i < ARRAY_SIZE(rates); i++) {
+		const struct dcp_display_mode *m = &modes[1 + i];
+
+		KUNIT_EXPECT_EQ(test, m->fixed_rate, rates[i]);
+		KUNIT_EXPECT_LE(test, abs_diff(dcp_mode_refresh(&m->mode), rates[i]),
+				rates[i] / 2000);
+		KUNIT_EXPECT_FALSE(test, m->vrr);
+		KUNIT_EXPECT_TRUE(test, m->needs_timestamps);
+		KUNIT_EXPECT_FALSE(test, m->mode.type & DRM_MODE_TYPE_PREFERRED);
+		KUNIT_EXPECT_EQ(test, m->timing_mode_id, 7U);
+		KUNIT_EXPECT_EQ(test, m->color_mode_id, modes[0].color_mode_id);
+		KUNIT_EXPECT_EQ(test, m->mode.clock, modes[0].mode.clock);
+		KUNIT_EXPECT_EQ(test, m->mode.htotal, modes[0].mode.htotal);
+		KUNIT_EXPECT_EQ(test, m->mode.vdisplay, modes[0].mode.vdisplay);
+		KUNIT_EXPECT_GT(test, m->mode.vtotal, modes[0].mode.vtotal);
+		/* Only the front porch grows. */
+		KUNIT_EXPECT_EQ(test, m->mode.vtotal - m->mode.vsync_end,
+				modes[0].mode.vtotal - modes[0].mode.vsync_end);
+		KUNIT_EXPECT_EQ(test, m->mode.vsync_end - m->mode.vsync_start,
+				modes[0].mode.vsync_end - modes[0].mode.vsync_start);
+		KUNIT_EXPECT_FALSE(test, drm_mode_match(&m->mode, &modes[0].mode,
+							DRM_MODE_MATCH_TIMINGS));
+	}
+	kfree(modes);
+
+	/* A reported range keeps every offered rate inside it. */
+	record.vrr = true;
+	blob = make_blob(test, &record, 1);
+	KUNIT_ASSERT_NOT_NULL(test, blob);
+	modes = parse_blob(blob, &count, 0, true);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, modes);
+	KUNIT_ASSERT_EQ(test, count, 1U);
+	KUNIT_EXPECT_EQ(test, modes[0].min_vrr, 48U << 16);
+	modes = dcp_promotion_fixed_modes(modes, &count);
+	KUNIT_EXPECT_EQ(test, count, ARRAY_SIZE(rates));
+	for (i = 1; i < count; i++)
+		KUNIT_EXPECT_GE(test, modes[i].fixed_rate, 48U << 16);
+	kfree(modes);
+
+	/* A fixed 120 Hz timing (both range fields zero) runs 24 Hz up too. */
+	record.vrr_zero = true;
+	blob = make_blob(test, &record, 1);
+	KUNIT_ASSERT_NOT_NULL(test, blob);
+	modes = parse_blob(blob, &count, 0, true);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, modes);
+	KUNIT_ASSERT_EQ(test, count, 1U);
+	KUNIT_EXPECT_FALSE(test, modes[0].vrr);
+	KUNIT_EXPECT_TRUE(test, modes[0].needs_timestamps);
+	modes = dcp_promotion_fixed_modes(modes, &count);
+	KUNIT_EXPECT_EQ(test, count, 1U + ARRAY_SIZE(rates));
+	kfree(modes);
+
+	/* Nothing for an external display's 120 Hz timing. */
+	blob = make_blob(test, &record, 1);
+	KUNIT_ASSERT_NOT_NULL(test, blob);
+	modes = parse_blob(blob, &count, 0, false);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, modes);
+	modes = dcp_promotion_fixed_modes(modes, &count);
+	KUNIT_EXPECT_EQ(test, count, 1U);
+	kfree(modes);
+
+	/* Nor for a 60 Hz panel. */
+	record = valid_record(7, 10);
+	blob = make_blob(test, &record, 1);
+	KUNIT_ASSERT_NOT_NULL(test, blob);
+	modes = parse_blob(blob, &count, 0, true);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, modes);
+	modes = dcp_promotion_fixed_modes(modes, &count);
+	KUNIT_EXPECT_EQ(test, count, 1U);
+	kfree(modes);
+}
