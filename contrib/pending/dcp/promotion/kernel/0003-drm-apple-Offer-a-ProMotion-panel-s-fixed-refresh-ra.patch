 #endif
 		.value = {
-			min_vrr, /* minRR, 16.16 fixed-point Hz */
-			0,       /* mediaTargetRate */
-			0,       /* fractional rate */
+			min_vrr,    /* minRR, 16.16 fixed-point Hz */
+			media_rate, /* mediaTargetRate */
+			!!(media_rate & 0xffff), /* fractional rate */
 		},
 #if DCP_FW_VER >= DCP_FW_VERSION(13, 2, 0)
 		.count = 3,
@@ -3849,12 +3857,14 @@ int DCP_FW_NAME(iomfb_modeset)(struct apple_dcp *dcp,
 		complete_set_digital_out_mode(dcp, NULL, cookie);
 	} else
 #endif
-	if (mode->vrr &&
-		   dcp->hw.iomfb_method_profile !=
-		   DCP_IOMFB_METHODS_H17P_EXTERNAL)
+	if ((mode->vrr || mode->fixed_rate) &&
+	    dcp->hw.iomfb_method_profile !=
