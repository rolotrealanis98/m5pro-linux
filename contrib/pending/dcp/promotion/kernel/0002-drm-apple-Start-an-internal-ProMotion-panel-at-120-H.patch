From 9ccc42a52b5b427a4bcd3daa87e35ecf8f3682c3 Mon Sep 17 00:00:00 2001
From: Rolando Trevino <rolotrealanis@gmail.com>
Date: Sat, 7 Nov 2026 15:36:37 -0500
Subject: [PATCH 2/3] drm/apple: Start an internal ProMotion panel at 120 Hz

An internal panel's preferred mode is the timing its firmware ranks
first (IsPreferred, then Score). Every ProMotion panel seen so far
reports a single 120 Hz timing, so that is the mode a compositor picks.
Should a panel's firmware also list a slower timing of the native size
and rank it first, the desktop would come up at that rate instead of at
120 Hz, which is where macOS starts these panels.

Make the 120 Hz timing of the preferred mode's size the preferred mode
of an internal panel's catalog when the firmware ranked a slower one
first. A catalog without such a timing, or whose preferred mode already
runs at 120 Hz, keeps the firmware's ranking.

Assisted-by: LLM Claude
Signed-off-by: Rolando Trevino <rolotrealanis@gmail.com>
---
 drivers/gpu/drm/apple/iomfb.c       |  4 +++
 drivers/gpu/drm/apple/parser-test.c | 47 +++++++++++++++++++++++++++++
 drivers/gpu/drm/apple/parser.c      | 47 +++++++++++++++++++++++++++++
 drivers/gpu/drm/apple/parser.h      |  2 ++
 4 files changed, 100 insertions(+)

diff --git a/drivers/gpu/drm/apple/iomfb.c b/drivers/gpu/drm/apple/iomfb.c
index 5a660cb495dc..f69b00a206ed 100644
--- a/drivers/gpu/drm/apple/iomfb.c
+++ b/drivers/gpu/drm/apple/iomfb.c
@@ -1992,6 +1992,10 @@ int dcp_modes_replace(struct apple_dcp *dcp, struct dcp_parse_ctx *ctx,
 		kfree(modes);
 		return -EINVAL;
 	} else {
+		/* An internal ProMotion panel starts at 120 Hz. */
+		if (!h17p_external &&
+		    dcp->fixed_connector_type == DRM_MODE_CONNECTOR_eDP)
+			dcp_promotion_default(modes, nr_modes);
 		for (i = 0; i < nr_modes; i++)
 			if (modes[i].automatic_rgb8_quirk) {
 				modes[i].unsafe_rgb8_ticket = rate_ticket;
diff --git a/drivers/gpu/drm/apple/parser-test.c b/drivers/gpu/drm/apple/parser-test.c
index 5737b201093a..cf8a251fd886 100644
--- a/drivers/gpu/drm/apple/parser-test.c
+++ b/drivers/gpu/drm/apple/parser-test.c
@@ -500,6 +500,52 @@ static void parser_vrr_empty_range(struct kunit *test)
 	}
 }
 
+/* A ProMotion panel starts at 120 Hz whichever timing its firmware ranks first. */
+static void parser_promotion_default(struct kunit *test)
+{
+	struct parser_record records[] = {
+		valid_record(7, 100), valid_record(8, 50), valid_record(9, 200),
+	};
+	struct dcp_display_mode *modes;
+	struct parser_blob *blob;
+	unsigned int count;
+
+	records[1].rate = 120 << 16;
+	records[2].active = 720;
+	records[2].total = 750;
+	records[2].rate = 120 << 16;
+	blob = make_blob(test, records, 2);
+	KUNIT_ASSERT_NOT_NULL(test, blob);
+	modes = parse_blob(blob, &count, 0, true);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, modes);
+	KUNIT_ASSERT_EQ(test, count, 2U);
+	KUNIT_EXPECT_EQ(test, dcp_mode_refresh(&modes[0].mode), 60U << 16);
+	KUNIT_EXPECT_EQ(test, dcp_mode_refresh(&modes[1].mode), 120U << 16);
+	KUNIT_EXPECT_TRUE(test, modes[0].mode.type & DRM_MODE_TYPE_PREFERRED);
+	dcp_promotion_default(modes, count);
+	KUNIT_EXPECT_FALSE(test, modes[0].mode.type & DRM_MODE_TYPE_PREFERRED);
+	KUNIT_EXPECT_TRUE(test, modes[1].mode.type & DRM_MODE_TYPE_PREFERRED);
+	/* Already at 120 Hz: nothing moves. */
+	dcp_promotion_default(modes, count);
+	KUNIT_EXPECT_TRUE(test, modes[1].mode.type & DRM_MODE_TYPE_PREFERRED);
+	kfree(modes);
+
+	/* A 120 Hz timing of another size is not the panel's. */
+	records[1] = records[2];
+	blob = make_blob(test, records, 2);
+	KUNIT_ASSERT_NOT_NULL(test, blob);
+	modes = parse_blob(blob, &count, 0, true);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, modes);
+	KUNIT_ASSERT_EQ(test, count, 2U);
+	KUNIT_EXPECT_TRUE(test, modes[1].mode.type & DRM_MODE_TYPE_PREFERRED);
+	modes[1].mode.type &= ~DRM_MODE_TYPE_PREFERRED;
+	modes[0].mode.type |= DRM_MODE_TYPE_PREFERRED;
+	dcp_promotion_default(modes, count);
+	KUNIT_EXPECT_TRUE(test, modes[0].mode.type & DRM_MODE_TYPE_PREFERRED);
+	KUNIT_EXPECT_FALSE(test, modes[1].mode.type & DRM_MODE_TYPE_PREFERRED);
+	kfree(modes);
+}
+
 static void parser_replacement(struct kunit *test)
 {
 	struct parser_record record = valid_record(7, 10);
@@ -1820,6 +1866,7 @@ static struct kunit_case parser_cases[] = {
 	KUNIT_CASE(parser_bad_score),
 	KUNIT_CASE(parser_notch_vrr),
 	KUNIT_CASE(parser_vrr_empty_range),
+	KUNIT_CASE(parser_promotion_default),
 	KUNIT_CASE(parser_replacement),
 	KUNIT_CASE(parser_held_keeps_edid),
 	KUNIT_CASE(parser_attachment_admission),
diff --git a/drivers/gpu/drm/apple/parser.c b/drivers/gpu/drm/apple/parser.c
index ca95e4f71eea..8715d4d38531 100644
--- a/drivers/gpu/drm/apple/parser.c
+++ b/drivers/gpu/drm/apple/parser.c
@@ -6,6 +6,7 @@
 #include <linux/err.h>
 #include <linux/limits.h>
 #include <linux/math.h>
+#include <linux/math64.h>
 #include <linux/string.h>
 #include <linux/slab.h>
 
@@ -1265,6 +1266,52 @@ struct dcp_display_mode *enumerate_modes(struct dcp_parse_ctx *handle,
 	return modes;
 }
 
+/* The refresh rate of @mode in 16.16 Hz, from its clock and totals. */
+u32 dcp_mode_refresh(const struct drm_display_mode *mode)
+{
+	u64 pixels = (u64)mode->htotal * mode->vtotal;
+
+	if (mode->clock <= 0 || !pixels)
+		return 0;
+	return min_t(u64, U32_MAX,
+		     div64_u64((((u64)mode->clock * 1000) << 16) + pixels / 2, pixels));
+}
+
+/*
+ * A ProMotion panel starts at its 120 Hz timing, as macOS starts it, also
+ * when its firmware ranks a slower timing of the same size first: the
+ * 120 Hz timing of that size with the highest score becomes the preferred
+ * mode. A catalog without one, or whose preferred mode already runs at
+ * 120 Hz, is left as the firmware ranked it.
+ */
+void dcp_promotion_default(struct dcp_display_mode *modes, unsigned int count)
+{
+	struct dcp_display_mode *preferred = NULL, *best = NULL;
+	unsigned int i;
+
+	for (i = 0; i < count; i++)
+		if (modes[i].mode.type & DRM_MODE_TYPE_PREFERRED)
+			preferred = &modes[i];
+	if (!preferred ||
+	    dcp_refresh_is_promotion(dcp_mode_refresh(&preferred->mode)))
+		return;
+	for (i = 0; i < count; i++) {
+		struct dcp_display_mode *m = &modes[i];
+
+		if (m->automatic_rgb8_quirk ||
+		    m->mode.hdisplay != preferred->mode.hdisplay ||
+		    m->mode.vdisplay != preferred->mode.vdisplay ||
+		    !dcp_refresh_is_promotion(dcp_mode_refresh(&m->mode)))
+			continue;
+		if (!best || m->score > best->score)
+			best = m;
+	}
+	if (!best)
+		return;
+	preferred->mode.type &= ~DRM_MODE_TYPE_PREFERRED;
+	best->mode.type |= DRM_MODE_TYPE_PREFERRED;
+}
+
 /* Entries of the array at the cursor, which is not consumed. */
 int parse_array_count(const struct dcp_parse_ctx *handle, u32 *count)
 {
diff --git a/drivers/gpu/drm/apple/parser.h b/drivers/gpu/drm/apple/parser.h
index 45aaa1739ea9..a0112b2f587f 100644
--- a/drivers/gpu/drm/apple/parser.h
+++ b/drivers/gpu/drm/apple/parser.h
@@ -193,6 +193,8 @@ struct dcp_display_mode *enumerate_modes(struct dcp_parse_ctx *handle,
 					 int height_mm, unsigned notch_height,
 					 bool internal, bool external_sdr);
 int parse_display_metadata(struct dcp_parse_ctx *handle, struct dcp_display_metadata *out);
+u32 dcp_mode_refresh(const struct drm_display_mode *mode);
+void dcp_promotion_default(struct dcp_display_mode *modes, unsigned int count);
 /* Caller holds modes_lock while checking connector ownership. */
 bool dcp_modes_for_connector(struct apple_dcp *dcp,
 			     struct apple_connector *connector);
