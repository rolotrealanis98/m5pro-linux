diff --git a/drivers/gpu/drm/apple/iomfb-boolean-properties-v27.inc b/drivers/gpu/drm/apple/iomfb-boolean-properties-v27.inc
new file mode 100644
index 000000000000..b7b617b37994
--- /dev/null
+++ b/drivers/gpu/drm/apple/iomfb-boolean-properties-v27.inc
@@ -0,0 +1,51 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Copyright 2026 Aurora Silicon */
+
+struct dcp_boolean_property_v27 {
+	struct list_head node;
+	char name[64];
+	bool value;
+};
+
+static bool trampoline_set_boolean_property_v27(struct apple_dcp *dcp, int tag,
+						void *out, void *in)
+{
+	const u8 *request = in;
+	struct dcp_boolean_property_v27 *property;
+	char name[64];
+
+	trace_iomfb_callback(dcp, tag, __func__);
+
+	memcpy(name, request, sizeof(name));
+	name[sizeof(name) - 1] = '\0';
+	put_unaligned_le32(0, out);
+
+	list_for_each_entry(property, &dcp->iomfb_boolean_properties, node)
+		if (!strcmp(property->name, name))
+			goto update;
+	if (dcp->iomfb_boolean_property_count >= 64)
+		return true;
+	property = kzalloc(sizeof(*property), GFP_KERNEL);
+	if (!property)
+		return true;
+	memcpy(property->name, name, sizeof(name));
+	dcp->iomfb_boolean_property_count++;
+	list_add_tail(&property->node, &dcp->iomfb_boolean_properties);
+update:
+	property->value = request[64] & 1;
+	put_unaligned_le32(1, out);
+	return true;
+}
+
+void iomfb_firmware_state_cleanup_v27(void *data)
+{
+	struct apple_dcp *dcp = data;
+	struct dcp_boolean_property_v27 *property, *next;
+
+	external_counts_cleanup_v27(dcp);
+	list_for_each_entry_safe(property, next, &dcp->iomfb_boolean_properties, node) {
+		list_del(&property->node);
+		kfree(property);
+		dcp->iomfb_boolean_property_count--;
+	}
+}
diff --git a/drivers/gpu/drm/apple/iomfb-dfb.h b/drivers/gpu/drm/apple/iomfb-dfb.h
new file mode 100644
index 000000000000..30e84ab8366c
--- /dev/null
+++ b/drivers/gpu/drm/apple/iomfb-dfb.h
@@ -0,0 +1,105 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Copyright 2026 Aurora Silicon */
+
+#ifndef __APPLE_IOMFB_DFB_H__
+#define __APPLE_IOMFB_DFB_H__
+
+#include <linux/align.h>
+#include <linux/errno.h>
+#include <linux/log2.h>
+#include <linux/kernel.h>
+#include <linux/types.h>
+
+static inline u64 apple_dcp_dfb_round_size(u64 size)
+{
+	unsigned int bits = fls64(size);
+	u64 unit, half, tail;
+
+	if (bits <= 24)
+		return size;
+	unit = 1ULL << (bits - 24);
+	half = unit >> 1;
+	tail = size & (unit - 1);
+	size &= ~(unit - 1);
+	if (tail > half || (tail == half && (size & unit)))
+		size += unit;
+	return size;
+}
+
+static inline u64 apple_dcp_dfb_plane_size(u32 width, u32 height, u32 bpe,
+					 u32 compression)
+{
+	u64 stride, data, cols, rows, tw = 16, th = 16;
+	unsigned int order;
+
+	if (!compression) {
+		stride = ALIGN((u64)width * bpe, 128);
+		return ALIGN(apple_dcp_dfb_round_size(stride * height), 0x4000);
+	}
+	if (compression == 2 && bpe > 4) {
+		th = 8;
+		if (bpe == 16)
+			tw = 8;
+	}
+	cols = DIV_ROUND_UP(width, tw);
+	rows = DIV_ROUND_UP(height, th);
+	if (compression == 3) {
+		stride = tw * th * cols * bpe;
+		data = ALIGN(rows * stride, 128);
+		return data + 8 * roundup_pow_of_two(cols) * roundup_pow_of_two(rows);
+	}
+	order = ilog2(0x4000 / bpe);
+	stride = ALIGN((u64)width * bpe, (u64)bpe << (order / 2));
+	data = ALIGN(ALIGN((u64)height, 1ULL << ((order + 1) / 2)) * stride, 128);
+	return data + ALIGN(2 * roundup_pow_of_two(cols) * roundup_pow_of_two(rows), 128);
+}
+
+static inline int apple_dcp_dfb_allocation(u32 width, u32 height, u32 format,
+					 u32 compression, u64 region_size,
+					 u32 *surface_format, u32 *allocation)
+{
+	u32 bpe;
+	u64 size;
+	bool alpha_plane = false;
+
+	if (!width || !height || width > 16384 || height > 16384 || !region_size)
+		return -EINVAL;
+	if (compression != 0 && compression != 2 && compression != 3)
+		return -EOPNOTSUPP;
+	switch (format) {
+	case 0x62336138:
+		if (compression == 2) {
+			format = 0x77343061;
+			bpe = 8;
+		} else {
+			bpe = 4;
+			alpha_plane = true;
+		}
+		break;
+	case 0x77343061:
+		bpe = 8;
+		break;
+	case 0x42475241:
+	case 0x77333072:
+	case 0x6c313072:
+		bpe = 4;
+		break;
+	default:
+		return -EOPNOTSUPP;
+	}
+	size = apple_dcp_dfb_plane_size(width, height, bpe, compression);
+	if (alpha_plane)
+		size += apple_dcp_dfb_plane_size(width, height, 1, compression);
+	if (size > U32_MAX)
+		return -EOVERFLOW;
+	if (compression)
+		size = ALIGN(apple_dcp_dfb_round_size(size), 0x4000);
+	if (size > region_size)
+		return -ENOSPC;
+	if (!size || size > U32_MAX)
+		return -EOVERFLOW;
+	*surface_format = format;
+	*allocation = size;
+	return 0;
+}
+#endif
diff --git a/drivers/gpu/drm/apple/iomfb-display-identity-v27.inc b/drivers/gpu/drm/apple/iomfb-display-identity-v27.inc
new file mode 100644
index 000000000000..1b3710c1c762
--- /dev/null
+++ b/drivers/gpu/drm/apple/iomfb-display-identity-v27.inc
@@ -0,0 +1,84 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Copyright 2026 Aurora Silicon */
+
+struct dcp_display_product_request_v27 {
+	u8 vendor[10];
+	__le32 vendor_id;
+	__le32 vendor_length;
+	__le32 product_id;
+	u8 vendor_id_null, product_id_null;
+} __packed;
+
+struct dcp_display_product_reply_v27 {
+	u8 vendor[10];
+	__le32 vendor_id;
+	__le32 product_id;
+	u8 success, padding;
+} __packed;
+
+static_assert(sizeof(struct dcp_display_product_request_v27) == 24);
+static_assert(sizeof(struct dcp_display_product_reply_v27) == 20);
+static_assert(offsetof(struct dcp_display_product_reply_v27, product_id) == 14);
+
+struct dcp_display_identity_callback_v27 {
+	void *output;
+	enum dcp_context_id context;
+};
+
+static void display_identity_done_v27(struct apple_dcp *dcp, void *out, void *cookie)
+{
+	const struct dcp_display_product_reply_v27 *reply = out;
+	struct dcp_display_identity_callback_v27 *cb = cookie;
+	bool vendor_matches = reply && (!reply->vendor[0] ||
+			      (!memcmp(reply->vendor, "APP", 3) && !reply->vendor[3]));
+	bool display_x1 = reply && (reply->success & 1) && vendor_matches &&
+			 (le32_to_cpu(reply->product_id) >> 1) == 0x5721;
+
+	put_unaligned_le32(display_x1, cb->output);
+	dcp_ack(dcp, cb->context);
+	kfree(cb);
+}
+
+static bool trampoline_display_identity_v27(struct apple_dcp *dcp, int tag,
+					   void *out, void *in)
+{
+	static const struct dcp_method_entry method = {
+		.name = "display_product_id", .tag = {'A', '3', '7', '5'},
+	};
+	static const enum dcp_context_id contexts[] = {
+		DCP_CONTEXT_CB, DCP_CONTEXT_ASYNC, DCP_CONTEXT_OOBCB, DCP_CONTEXT_OOBASYNC,
+	};
+	struct dcp_channel *channels[] = {
+		&dcp->ch_cb, &dcp->ch_async, &dcp->ch_oobcb, &dcp->ch_oobasync,
+	};
+	struct dcp_display_product_request_v27 request = {
+		.vendor_length = cpu_to_le32(10),
+	};
+	struct dcp_display_identity_callback_v27 *cb;
+	int context = -1;
+
+	trace_iomfb_callback(dcp, tag, __func__);
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(channels); i++) {
+		struct dcp_channel *ch = channels[i];
+
+		if (ch->depth && ch->output[ch->depth - 1] == out) {
+			context = contexts[i];
+			break;
+		}
+	}
+	if (WARN_ON(context < 0))
+		return true;
+	cb = kzalloc(sizeof(*cb), GFP_KERNEL);
+	if (!cb)
+		return true;
+	cb->output = out;
+	cb->context = context;
+	if (dcp_push_nested(dcp, context, &method, sizeof(request),
+			    sizeof(struct dcp_display_product_reply_v27), &request,
+			    display_identity_done_v27, cb)) {
+		kfree(cb);
+		return true;
+	}
+	return false;
+}
diff --git a/drivers/gpu/drm/apple/iomfb-external-counts-v27.inc b/drivers/gpu/drm/apple/iomfb-external-counts-v27.inc
new file mode 100644
index 000000000000..ab5602821d3c
--- /dev/null
+++ b/drivers/gpu/drm/apple/iomfb-external-counts-v27.inc
@@ -0,0 +1,90 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Copyright 2026 Aurora Silicon */
+
+static DEFINE_SPINLOCK(external_counts_lock_v27);
+static u32 external_pipe_count_v27;
+static u32 external_apple_display_count_v27;
+static u32 external_suppression_count_v27;
+
+static bool trampoline_update_external_counts_v27(struct apple_dcp *dcp, int tag,
+						  void *out, void *in)
+{
+	const u8 *request = in;
+	bool plug = request[0] & 1;
+	u32 apple_display = request[1] & 1;
+	u32 pipes = get_unaligned_le32(request + 2);
+	unsigned long flags;
+
+	trace_iomfb_callback(dcp, tag, __func__);
+
+	if (dcp->connector_type == DRM_MODE_CONNECTOR_eDP)
+		return true;
+	spin_lock_irqsave(&external_counts_lock_v27, flags);
+	if ((plug && (pipes > U32_MAX - external_pipe_count_v27 ||
+		     apple_display > U32_MAX - external_apple_display_count_v27)) ||
+	    (!plug && (pipes > dcp->external_pipes_v27 ||
+		      apple_display > dcp->external_displays_v27))) {
+		spin_unlock_irqrestore(&external_counts_lock_v27, flags);
+		dev_warn_ratelimited(dcp->dev, "invalid external display count update\n");
+		return true;
+	}
+	dcp->external_pipes_v27 += plug ? pipes : -pipes;
+	dcp->external_displays_v27 += plug ? apple_display : -apple_display;
+	external_pipe_count_v27 += plug ? pipes : -pipes;
+	external_apple_display_count_v27 += plug ? apple_display : -apple_display;
+	spin_unlock_irqrestore(&external_counts_lock_v27, flags);
+	return true;
+}
+
+static bool trampoline_get_external_counts_v27(struct apple_dcp *dcp, int tag,
+					       void *out, void *in)
+{
+	const u8 *request = in;
+	unsigned long flags;
+	u32 counts[3];
+
+	trace_iomfb_callback(dcp, tag, __func__);
+	spin_lock_irqsave(&external_counts_lock_v27, flags);
+	counts[0] = external_pipe_count_v27;
+	counts[1] = external_apple_display_count_v27;
+	counts[2] = external_suppression_count_v27;
+	spin_unlock_irqrestore(&external_counts_lock_v27, flags);
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(counts); i++)
+		if (!(request[12 + i] & 1))
+			put_unaligned_le32(counts[i], (u8 *)out + 4 * i);
+	return true;
+}
+
+static bool trampoline_apply_suppression_v27(struct apple_dcp *dcp, int tag,
+					    void *out, void *in)
+{
+	const u8 *request = in;
+	unsigned long flags;
+
+	trace_iomfb_callback(dcp, tag, __func__);
+	spin_lock_irqsave(&external_counts_lock_v27, flags);
+	if (((request[0] & 1) && external_suppression_count_v27 == U32_MAX) ||
+	    (!(request[0] & 1) && !dcp->external_suppression_v27)) {
+		spin_unlock_irqrestore(&external_counts_lock_v27, flags);
+		return true;
+	}
+	dcp->external_suppression_v27 += (request[0] & 1) ? 1U : -1U;
+	external_suppression_count_v27 += (request[0] & 1) ? 1U : -1U;
+	spin_unlock_irqrestore(&external_counts_lock_v27, flags);
+	return true;
+}
+
+static void external_counts_cleanup_v27(struct apple_dcp *dcp)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&external_counts_lock_v27, flags);
+	external_pipe_count_v27 -= dcp->external_pipes_v27;
+	external_apple_display_count_v27 -= dcp->external_displays_v27;
+	external_suppression_count_v27 -= dcp->external_suppression_v27;
+	dcp->external_pipes_v27 = 0;
+	dcp->external_displays_v27 = 0;
+	dcp->external_suppression_v27 = 0;
+	spin_unlock_irqrestore(&external_counts_lock_v27, flags);
+}
diff --git a/drivers/gpu/drm/apple/iomfb-peer-runtime-v27.inc b/drivers/gpu/drm/apple/iomfb-peer-runtime-v27.inc
new file mode 100644
index 000000000000..c2a681328c10
--- /dev/null
+++ b/drivers/gpu/drm/apple/iomfb-peer-runtime-v27.inc
@@ -0,0 +1,125 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#include "iomfb-peer-v27.h"
+
+static void dcp_peer_swap_error(struct apple_dcp *owner, const char *where, u32 status)
+{
+	lockdep_assert_held(&owner->iomfb.lock);
+	dev_err(owner->dev, "paired swap %s failed: %#x\n", where, status);
+	dcp_peer_swap_failed_v27(owner);
+	/* One engine may already have accepted this frame. A failed peer ACK
+	 * is not a DMA-retirement witness for either scanout. The clean queue
+	 * retains its active transaction and next-scanout references on crash. */
+	WRITE_ONCE(owner->crashed, true);
+	dcp_swap_watchdog_complete(owner);
+	dcp_present_failed(owner);
+	schedule_work(&owner->vblank_wq);
+}
+
+static void dcp_peer_submit_error_on_owner(struct apple_dcp *owner, void *data, void *cookie)
+{
+	u32 *status = data;
+	dcp_peer_swap_error(owner, "peer submit", *status);
+}
+
+static void dcp_peer_submitted(struct apple_dcp *dcp, void *data, void *cookie)
+{
+	struct apple_dcp *owner = cookie;
+	struct dcp_swap_submit_resp_v27 *resp = data;
+	u32 status = resp ? resp->ret : ~0U;
+	u32 id;
+
+	if (owner != dcp) {
+		if (status && iomfb_queue_callback(owner, dcp_peer_submit_error_on_owner,
+						&status, sizeof(status), NULL)) {
+			WRITE_ONCE(owner->crashed, true);
+			schedule_work(&owner->vblank_wq);
+		}
+		return;
+	}
+	lockdep_assert_held(&owner->iomfb.lock);
+	if (READ_ONCE(owner->peer_frames.failed))
+		return;
+	id = owner->swap.h17p.swap.swap_id;
+	if (status) {
+		dcp_peer_swap_error(owner, "primary submit", status);
+		return;
+	}
+	if (dcp_present_submit(owner, id, true)) {
+		dcp_peer_swap_error(owner, "submit state", -EPROTO);
+		return;
+	}
+	/* Per-endpoint receive ordering handles the primary ACK before its
+	 * completion. The paired watermark still requires both completions. */
+	owner->swap_start = ktime_get();
+	owner->swap_submit_timestamp = arch_timer_read_counter();
+	dcp_swap_watchdog_arm(owner);
+}
+
+static void dcp_peer_started_on_owner(struct apple_dcp *owner, void *data, void *cookie)
+{
+	struct dcp_swap_start_resp_h17p *resp = data;
+	struct apple_dcp *peer = dcp_peer_scanout_v27(owner);
+	u32 id = owner->swap.h17p.swap.swap_id;
+
+	lockdep_assert_held(&owner->iomfb.lock);
+	if (IS_ERR_OR_NULL(peer) || peer != cookie || resp->ret || resp->swap_id != id) {
+		dcp_peer_swap_error(owner, "start/ID", resp->ret ?: -EPROTO);
+		return;
+	}
+	/* Keep the logical atomic input intact. Both split wire records are
+	 * primary-owned; dcp_push copies the peer's record into its own queue. */
+	iomfb_serialize_present_h17p(&owner->present_h17p, &owner->swap.h17p);
+	if (!iomfb_apply_backlight_h17p(owner, &owner->swap.h17p, &owner->present_h17p)) {
+		dcp_peer_swap_error(owner, "surface preparation", -EINVAL);
+		return;
+	}
+	iomfb_serialize_present_v27(&owner->present_v27, &owner->swap.h17p);
+	owner->present_v27.swap.brightness_update = owner->present_h17p.swap[0x354] & 1;
+	owner->present_v27.swap.brightness_nits = get_unaligned_le64(owner->present_h17p.swap + 0x35e);
+	dcp_peer_split_swap_v27(&owner->present_v27, &owner->peer_present_v27,
+				owner->peer_tiling.width);
+	if (dcp_present_retires(owner))
+		dcp_arm_retained_framebuffers(owner, id);
+	dcp_peer_swap_armed_v27(owner, id);
+	trace_iomfb_swap_submit(owner, id);
+	trace_iomfb_swap_submit(peer, id);
+	dcp_push(owner, false, &dcp_methods[dcpep_swap_submit], sizeof(owner->present_v27),
+		 sizeof(struct dcp_swap_submit_resp_v27), &owner->present_v27,
+		 dcp_peer_submitted, owner);
+	if (READ_ONCE(owner->crashed))
+		return;
+	dcp_push(peer, false, &dcp_methods[dcpep_swap_submit], sizeof(owner->peer_present_v27),
+		 sizeof(struct dcp_swap_submit_resp_v27), &owner->peer_present_v27,
+		 dcp_peer_submitted, owner);
+	if (READ_ONCE(peer->crashed))
+		dcp_peer_swap_error(owner, "peer publication", -EIO);
+}
+
+static void dcp_peer_started(struct apple_dcp *peer, void *data, void *cookie)
+{
+	struct apple_dcp *owner = cookie;
+	struct dcp_swap_start_resp_h17p failed = { .ret = ~0U };
+
+	if (iomfb_queue_callback(owner, dcp_peer_started_on_owner,
+				 data ?: &failed, sizeof(failed), peer)) {
+		WRITE_ONCE(owner->crashed, true);
+		schedule_work(&owner->vblank_wq);
+	}
+}
+
+static bool dcp_peer_start_second(struct apple_dcp *owner,
+				 struct dcp_swap_start_resp_h17p *resp)
+{
+	struct dcp_swap_start_req_h17p req = {};
+	struct apple_dcp *peer = dcp_peer_scanout_v27(owner);
+
+	if (!peer)
+		return false;
+	if (IS_ERR(peer) || resp->ret) {
+		dcp_peer_swap_error(owner, "primary start", resp->ret ?: -EIO);
+		return true;
+	}
+	owner->swap.h17p.swap.swap_id = resp->swap_id;
+	dcp_swap_start(peer, false, &req, dcp_peer_started, owner);
+	return true;
+}
diff --git a/drivers/gpu/drm/apple/iomfb-peer-v27.h b/drivers/gpu/drm/apple/iomfb-peer-v27.h
new file mode 100644
index 000000000000..ea3b586e037c
--- /dev/null
+++ b/drivers/gpu/drm/apple/iomfb-peer-v27.h
@@ -0,0 +1,129 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef APPLE_IOMFB_PEER_V27_H
+#define APPLE_IOMFB_PEER_V27_H
+
+#include <linux/types.h>
+#include <linux/build_bug.h>
+#include <linux/unaligned.h>
+#include <linux/math64.h>
+#include "iomfb_plane.h"
+#include "iomfb_v27.h"
+
+/* A364 and A365 share the video-data prefix, but not the final
+ * flags: A364 has a requires-merge boolean before three pointer-null flags;
+ * A365 has only two pointer-null flags and padding.
+ */
+struct dcp_peer_video_data_v27 {
+	u8 timing[0x50];
+	u8 color[0x20];
+} __packed;
+
+struct dcp_peer_get_video_req_v27 {
+	struct dcp_peer_video_data_v27 video;
+	__le32 timing_id, color_id;
+	u8 requires_merge, timing_null, color_null, requires_merge_null;
+} __packed;
+
+struct dcp_peer_get_video_resp_v27 {
+	struct dcp_peer_video_data_v27 video;
+	u8 requires_merge, success, padding[2];
+} __packed;
+
+struct dcp_peer_insert_video_req_v27 {
+	struct dcp_peer_video_data_v27 video;
+	__le32 timing_id, color_id;
+	u8 timing_null, color_null, padding[2];
+} __packed;
+
+struct dcp_peer_insert_video_resp_v27 {
+	struct dcp_peer_video_data_v27 video;
+	u8 success, padding[3];
+} __packed;
+
+static_assert(sizeof(struct dcp_peer_get_video_req_v27) == 0x7c);
+static_assert(sizeof(struct dcp_peer_get_video_resp_v27) == 0x74);
+static_assert(sizeof(struct dcp_peer_insert_video_req_v27) == 0x7c);
+static_assert(sizeof(struct dcp_peer_insert_video_resp_v27) == 0x74);
+
+/* The digital-out mode setter.
+ * Keep vertical timings, color data and all unmodified fields intact.
+ * The signed horizontal offset uses division toward zero.
+ */
+static inline void dcp_peer_split_timing_v27(struct dcp_peer_video_data_v27 *v)
+{
+	static const u8 half_fields[] = { 4, 8, 12, 16, 20, 28, 68 };
+
+	for (unsigned int i = 0; i < sizeof(half_fields); i++) {
+		u8 *field = v->timing + half_fields[i];
+
+		put_unaligned_le32(get_unaligned_le32(field) >> 1, field);
+	}
+	put_unaligned_le32((s32)get_unaligned_le32(v->timing + 24) / 2,
+			   v->timing + 24);
+}
+
+/* VFTG splits a surface at the half-panel boundary.
+ * Source and destination use pixels here, as in the existing IOMFB plane
+ * path. Use rational arithmetic in the kernel rather than floating point;
+ * round a shared source boundary once so neither half loses/duplicates it.
+ * DRM has already clipped negative/offscreen destination coordinates.
+ */
+static inline bool dcp_peer_clip_surface_v27(const struct dcp_rect *src,
+	const struct dcp_rect *dst, u32 tile_x, u32 tile_width,
+	struct dcp_rect *tile_src, struct dcp_rect *tile_dst)
+{
+	u64 left = max_t(u64, dst->x, tile_x);
+	u64 right = min_t(u64, (u64)dst->x + dst->w,
+			  (u64)tile_x + tile_width);
+	u64 first, last;
+
+	memset(tile_src, 0, sizeof(*tile_src));
+	memset(tile_dst, 0, sizeof(*tile_dst));
+	if (!src->w || !src->h || !dst->w || !dst->h || left >= right)
+		return false;
+	first = div_u64((left - dst->x) * src->w + dst->w / 2, dst->w);
+	last = div_u64((right - dst->x) * src->w + dst->w / 2, dst->w);
+	if (first >= last || (u64)src->x + last > U32_MAX)
+		return false;
+	*tile_src = *src;
+	tile_src->x += first;
+	tile_src->w = last - first;
+	*tile_dst = *dst;
+	tile_dst->x = left - tile_x;
+	tile_dst->w = right - left;
+	return true;
+}
+
+
+/* Clone descriptors only: both DCPs use the same display DMA domain/IOVA. */
+static inline void dcp_peer_split_swap_v27(struct dcp_swap_submit_req_v27 *left,
+					  struct dcp_swap_submit_req_v27 *right,
+					  u32 tile_width)
+{
+	*right = *left;
+	for (unsigned int i = 0; i < ARRAY_SIZE(left->surf_null); i++) {
+		struct dcp_rect src = left->swap.src_rect[i];
+		struct dcp_rect dst = left->swap.dst_rect[i];
+		bool present = !left->surf_null[i];
+		struct dcp_swap_submit_req_v27 *halves[] = {left, right};
+
+		for (unsigned int side = 0; side < 2; side++) {
+			struct dcp_swap_submit_req_v27 *req = halves[side];
+			struct dcp_rect clipped_src, clipped_dst;
+
+			if (present && dcp_peer_clip_surface_v27(&src, &dst,
+				side * tile_width, tile_width, &clipped_src, &clipped_dst)) {
+				req->swap.src_rect[i] = clipped_src;
+				req->swap.dst_rect[i] = clipped_dst;
+			} else {
+				req->surf_null[i] = true;
+				req->surf_iova[i] = 0;
+				req->swap.surf_ids[i] = 0;
+				memset(&req->swap.src_rect[i], 0, sizeof(req->swap.src_rect[i]));
+				memset(&req->swap.dst_rect[i], 0, sizeof(req->swap.dst_rect[i]));
+			}
+		}
+	}
+}
+
+#endif
