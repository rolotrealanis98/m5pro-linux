diff --git a/drivers/gpu/drm/apple/dcp-peer-frames-v27.h b/drivers/gpu/drm/apple/dcp-peer-frames-v27.h
new file mode 100644
index 000000000000..abb7798a1764
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-peer-frames-v27.h
@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef APPLE_DCP_PEER_FRAMES_V27_H
+#define APPLE_DCP_PEER_FRAMES_V27_H
+
+#include <linux/types.h>
+
+/* Protected by dcp_peer_lock. Sequence comparisons cover less than 2^31
+ * outstanding swaps, as in the existing single-pipe retirement path.
+ */
+struct dcp_peer_frames_v27 {
+	u32 first, submitted, engine[2], retired;
+	bool active, armed, failed, have[2], have_retired;
+};
+
+static inline void dcp_peer_frame_submit_v27(struct dcp_peer_frames_v27 *s, u32 id)
+{
+	if (!s->armed) {
+		s->first = id;
+		s->armed = true;
+	}
+	s->submitted = id;
+}
+
+static inline bool dcp_peer_frame_complete_v27(struct dcp_peer_frames_v27 *s,
+					      unsigned int engine, u32 id,
+					      u32 *watermark)
+{
+	u32 done;
+
+	if (!s->active || s->failed || !s->armed || engine > 1 ||
+	    (s32)(id - s->first) < 0 || (s32)(s->submitted - id) < 0 ||
+	    (s->have[engine] && (s32)(id - s->engine[engine]) <= 0))
+		return false;
+	s->engine[engine] = id;
+	s->have[engine] = true;
+	if (!s->have[0] || !s->have[1])
+		return false;
+	done = (s32)(s->engine[0] - s->engine[1]) < 0 ? s->engine[0] : s->engine[1];
+	if (s->have_retired && (s32)(done - s->retired) <= 0)
+		return false;
+	s->retired = *watermark = done;
+	s->have_retired = true;
+	return true;
+}
+#endif
diff --git a/drivers/gpu/drm/apple/dcp-peer-modeset-probe-v27.inc b/drivers/gpu/drm/apple/dcp-peer-modeset-probe-v27.inc
new file mode 100644
index 000000000000..a5aa449b446d
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-peer-modeset-probe-v27.inc
@@ -0,0 +1,227 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* Paired modeset bring-up, opt-in only. Scanout is a separate step. */
+/* The power-state step starts one asynchronous AP request per engine.
+ * Submit both before waiting: either firmware may rendezvous with its peer.
+ */
+static int dcp_peer_probe_power(struct apple_dcp *dcp, struct apple_dcp *peer,
+                                bool on)
+{
+	struct dcp_peer_video_wait *wait;
+	struct dcp_method_entry method = { .name = "peer_power_test",
+		.tag = {'A', '4', '8', '4'} };
+	u8 power[16] = {}, response[8];
+	int ret;
+
+	wait = kzalloc(sizeof(*wait), GFP_KERNEL);
+	if (!wait)
+		return -ENOMEM;
+	kref_init(&wait->refs);
+	init_completion(&wait->done);
+	wait->size = sizeof(response);
+	put_unaligned_le64(on, power);
+	kref_get(&wait->refs);
+	dcp_push(dcp, false, &method, sizeof(power), sizeof(response), power,
+		 dcp_peer_video_done, wait);
+	ret = dcp_peer_video_call(peer, "A484", power, sizeof(power),
+				  response, sizeof(response));
+	if (!ret && get_unaligned_le32(response + 4))
+		ret = -EIO;
+	if (!wait_for_completion_timeout(&wait->done, msecs_to_jiffies(2000)))
+		ret = ret ?: -ETIMEDOUT;
+	else if (!ret && get_unaligned_le32(wait->reply + 4))
+		ret = -EIO;
+	kref_put(&wait->refs, dcp_peer_video_free);
+	dev_info(dcp->dev, "peer power %u result=%d\n", on, ret);
+	return ret;
+}
+
+static int dcp_peer_probe_quiesce(struct apple_dcp *dcp, struct apple_dcp *peer)
+{
+	__le32 manage = 0;
+	int ret;
+
+	/* Setting the digital-out mode: pair API power0, 100ms,
+	 * then manage_elements(false), A362, on each engine before A365.
+	 * Only discard AP state after both engines have acknowledged power0.
+	 */
+	{
+		guard(mutex)(&dcp_peer_lock);
+		dcp->peer_tiling.modeset_complete = peer->peer_tiling.modeset_complete = false;
+	}
+	ret = dcp_peer_probe_power(dcp, peer, false);
+	if (ret)
+		return ret;
+	msleep(100);
+	ret = dcp_peer_video_call(dcp, "A362", &manage, sizeof(manage), NULL, 0);
+	if (ret)
+		return ret;
+	ret = dcp_peer_video_call(peer, "A362", &manage, sizeof(manage), NULL, 0);
+	if (ret)
+		return ret;
+	{
+		guard(mutex)(&dcp_peer_lock);
+		dcp->peer_frames = (struct dcp_peer_frames_v27){};
+		dcp->peer_tiling.member = peer->peer_tiling.member = false;
+		dcp->peer_tiling.vftg = peer->peer_tiling.vftg = false;
+		dcp->peer_tiling.modeset_complete = peer->peer_tiling.modeset_complete = false;
+		dcp->peer_tiling.phase = peer->peer_tiling.phase = 0;
+		dcp->peer_tiling.modeset_state = peer->peer_tiling.modeset_state = 0;
+		dcp->peer_tiling.ready = peer->peer_tiling.ready = false;
+	}
+	return 0;
+}
+
+static int dcp_peer_probe_prepare_vftg(struct apple_dcp *dcp, struct apple_dcp *peer,
+				      const struct dcp_peer_insert_video_req_v27 *video)
+{
+	guard(mutex)(&dcp_peer_lock);
+	if (dcp->peer_reserved != peer || peer->peer_owner != dcp)
+		return -ENODEV;
+	/* These are set BEFORE A366/A365, but membership is marked only after
+	 * both merge-mode insertions have accepted the derived video data.
+	 */
+	dcp->peer_tiling.vftg = peer->peer_tiling.vftg = true;
+	dcp->peer_tiling.modeset_complete = peer->peer_tiling.modeset_complete = false;
+	dcp->peer_tiling.primary = true;
+	peer->peer_tiling.primary = false;
+	dcp->peer_tiling.width = peer->peer_tiling.width =
+		get_unaligned_le32(video->video.timing + 8);
+	dcp->peer_tiling.height = peer->peer_tiling.height =
+		get_unaligned_le32(video->video.timing + 0x28);
+	dcp->peer_tiling.x = dcp->peer_tiling.y = peer->peer_tiling.y = 0;
+	peer->peer_tiling.x = dcp->peer_tiling.width;
+	return 0;
+}
+
+static int dcp_peer_probe_copy_dsc(struct apple_dcp *primary, struct apple_dcp *peer)
+{
+	u8 caps_req[36] = {}, caps[32], bpp_req[4] = {}, bpp[8];
+	u8 hints_req[12] = {}, hints[12];
+	u32 required;
+	int ret;
+
+	ret = dcp_peer_video_call_stream(primary, true, "A369", NULL, 0, &required, 4);
+	if (ret || !(required & 1))
+		return ret;
+	ret = dcp_peer_video_call_stream(primary, true, "A367", caps_req, 36, caps, 32);
+	if (ret)
+		return ret;
+	memcpy(caps_req, caps, 32);
+	ret = dcp_peer_video_call(peer, "A368", caps_req, 36, caps, 32);
+	if (ret)
+		return ret;
+	ret = dcp_peer_video_call_stream(primary, true, "A370", bpp_req, 4, bpp, 8);
+	if (ret || get_unaligned_le32(bpp + 2))
+		return ret ?: -EIO;
+	memcpy(bpp_req, bpp, 2);
+	ret = dcp_peer_video_call(peer, "A371", bpp_req, 4, bpp, 8);
+	if (ret || get_unaligned_le32(bpp + 2))
+		return ret ?: -EIO;
+	ret = dcp_peer_video_call_stream(primary, true, "A372", hints_req, 12, hints, 12);
+	if (ret || get_unaligned_le32(hints + 8))
+		return ret ?: -EIO;
+	memcpy(hints_req, hints, 8);
+	ret = dcp_peer_video_call(peer, "A373", hints_req, 12, hints, 12);
+	if (ret || get_unaligned_le32(hints + 8))
+		return ret ?: -EIO;
+	dev_info(primary->dev, "peer DSC copied: bpp=%u hints=%*ph\n",
+		 get_unaligned_le16(bpp), 8, hints);
+	return 0;
+}
+
+static int dcp_peer_probe_modeset(struct apple_dcp *dcp, struct apple_dcp *peer,
+				 const struct dcp_peer_insert_video_req_v27 *video,
+				 bool firmware_requires_merge)
+{
+	struct dcp_peer_video_wait *wait;
+	struct dcp_method_entry method = { .name = "peer_modeset_test",
+		.tag = {'A', '4', '1', '3'} };
+	__le32 mode[2] = {video->color_id, video->timing_id};
+	u32 primary_id, peer_id, phase, status;
+	unsigned long deadline;
+	int ret;
+
+	{
+		guard(mutex)(&dcp_peer_lock);
+		if (dcp->peer_reserved != peer || peer->peer_owner != dcp ||
+		    !dcp->peer_tiling.display_id_valid || !peer->peer_tiling.display_id_valid)
+			return -ENODEV;
+		dcp->peer_tiling.member = peer->peer_tiling.member = true;
+		/* The original A364 result is preserved even when the host
+		 * allocation requires a pair for a lower-bandwidth timing.
+		 */
+		dcp->peer_tiling.mode_flag = peer->peer_tiling.mode_flag =
+			!firmware_requires_merge;
+	}
+	ret = dcp_peer_probe_power(dcp, peer, true);
+	if (ret)
+		return ret;
+	/* Wait 100ms after both API-power transitions, before swap IDs. */
+	msleep(100);
+	ret = dcp_peer_video_call(dcp, "A360", NULL, 0, &primary_id, 4);
+	if (ret)
+		return ret;
+	ret = dcp_peer_video_call(peer, "A360", NULL, 0, &peer_id, 4);
+	if (ret)
+		return ret;
+	if (primary_id != peer_id) {
+		status = max(primary_id, peer_id);
+		ret = dcp_peer_video_call(primary_id < peer_id ? dcp : peer,
+					  "A361", &status, 4, NULL, 0);
+		if (ret)
+			return ret;
+	}
+	phase = 1;
+	dcp_peer_tiling_state_v27(dcp, true, 1, 10, &phase);
+	dcp_peer_tiling_state_v27(peer, true, 1, 10, &phase);
+	wait = kzalloc(sizeof(*wait), GFP_KERNEL);
+	if (!wait)
+		return -ENOMEM;
+	init_completion(&wait->done);
+	kref_init(&wait->refs);
+	kref_get(&wait->refs);
+	wait->size = 4;
+	dcp_push(dcp, false, &method, sizeof(mode), 4, mode,
+		 dcp_peer_video_done, wait);
+	/* The primary negotiates the link, signals phase2, and then waits for
+	 * its peer. Waiting for its final ACK first would deadlock the pair.
+	 */
+	deadline = jiffies + msecs_to_jiffies(8500);
+	for (;;) {
+		phase = 0;
+		if (!dcp_peer_tiling_state_v27(dcp, false, 1, 10, &phase)) {
+			ret = -ENODEV;
+			goto put;
+		}
+		if (phase >= 2)
+			break;
+		if (completion_done(&wait->done) || time_after_eq(jiffies, deadline)) {
+			ret = completion_done(&wait->done) ? -EIO : -ETIMEDOUT;
+			dev_err(dcp->dev, "peer primary ended before phase2: phase=%u result=%#x\n",
+				phase, get_unaligned_le32(wait->reply));
+			goto put;
+		}
+		msleep(2);
+	}
+	dev_info(dcp->dev, "peer primary reached modeset phase%u\n", phase);
+	ret = dcp_peer_probe_copy_dsc(dcp, peer);
+	if (ret)
+		goto put;
+	ret = dcp_peer_video_call(peer, "A413", mode, sizeof(mode), &status, 4);
+	if (ret || status) {
+		ret = ret ?: -EIO;
+		goto put;
+	}
+	if (!wait_for_completion_timeout(&wait->done, msecs_to_jiffies(8500)))
+		ret = -ETIMEDOUT;
+	else if (get_unaligned_le32(wait->reply))
+		ret = -EIO;
+put:
+	kref_put(&wait->refs, dcp_peer_video_free);
+	if (!ret) {
+		guard(mutex)(&dcp_peer_lock);
+		dcp->peer_tiling.modeset_complete = peer->peer_tiling.modeset_complete = true;
+	}
+	dev_info(dcp->dev, "peer paired modeset result=%d (scanout not submitted)\n", ret);
+	return ret;
+}
diff --git a/drivers/gpu/drm/apple/dcp-peer-probe-v27.inc b/drivers/gpu/drm/apple/dcp-peer-probe-v27.inc
new file mode 100644
index 000000000000..33def11c752e
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-peer-probe-v27.inc
@@ -0,0 +1,98 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* Explicit, opt-in firmware bring-up command. This is not the final hotplug
+ * lifecycle: use only the dedicated, otherwise unrouted peer reservation.
+ */
+struct dcp_peer_probe_wait {
+	struct kref refs;
+	struct completion done;
+};
+
+static void dcp_peer_probe_free(struct kref *ref)
+{
+	kfree(container_of(ref, struct dcp_peer_probe_wait, refs));
+}
+
+static void dcp_peer_probe_done(struct apple_dcp *dcp, void *out, void *cookie)
+{
+	struct dcp_peer_probe_wait *wait = cookie;
+
+	complete(&wait->done);
+	kref_put(&wait->refs, dcp_peer_probe_free);
+}
+
+static ssize_t peer_setup_test_store(struct device *dev,
+				    struct device_attribute *attr,
+				    const char *buf, size_t count)
+{
+	static const struct dcp_method_entry method = {
+		.name = "setup_peer_dcp", .tag = {'A', '3', '6', '6'},
+	};
+	struct apple_dcp *dcp = dev_get_drvdata(dev);
+	struct dcp_peer_probe_wait *wait;
+	__le32 enabled = cpu_to_le32(1);
+	bool value;
+	long ret;
+
+	if (kstrtobool(buf, &value) || !value)
+		return -EINVAL;
+	if (!peer_allocation_probe || !dcp)
+		return -EOPNOTSUPP;
+	wait = kzalloc(sizeof(*wait), GFP_KERNEL);
+	if (!wait)
+		return -ENOMEM;
+	init_completion(&wait->done);
+	kref_init(&wait->refs);
+	{
+		guard(mutex)(&dcp_peer_lock);
+		if (!dcp->peer_owner || dcp->peer_owner->peer_reserved != dcp ||
+		    dcp->peer_unbinding || dcp->crashed || !dcp->active ||
+		    dcp->fw_compat != DCP_FIRMWARE_V_27_0 ||
+		    dcp->fixed_phy || dcp->nr_typec_routes ||
+		    (dcp->connector && dcp->connector->connected) ||
+		    dcp->ch_cmd.depth || dcp->ch_cb.depth || dcp->ch_async.depth ||
+		    dcp->ch_oobcmd.depth || dcp->ch_oobcb.depth ||
+		    dcp->ch_oobasync.depth) {
+			kref_put(&wait->refs, dcp_peer_probe_free);
+			return -EBUSY;
+		}
+		kref_get(&wait->refs);
+		/* Peer-DCP setup (one bool argument): four input
+		 * bytes (boolean followed by zero padding), no output.
+		 */
+		dcp_push(dcp, false, &method, sizeof(enabled), 0, &enabled,
+			 dcp_peer_probe_done, wait);
+	}
+	ret = wait_for_completion_timeout(&wait->done, msecs_to_jiffies(2000));
+	kref_put(&wait->refs, dcp_peer_probe_free);
+	dev_info(dev, "peer A366 setup test %s\n", ret ? "acknowledged" : "timed out");
+	return ret ? count : -ETIMEDOUT;
+}
+static DEVICE_ATTR_WO(peer_setup_test);
+
+#include "dcp-peer-video-probe-v27.inc"
+#include "dcp-peer-swap-probe-v27.inc"
+#include "dcp-peer-runtime-v27.inc"
+
+static struct attribute *dcp_peer_probe_attrs[] = {
+	&dev_attr_peer_setup_test.attr,
+	&dev_attr_peer_video_test.attr,
+	&dev_attr_peer_link_test.attr,
+	&dev_attr_peer_swap_test.attr,
+	&dev_attr_peer_stop_test.attr,
+	NULL,
+};
+
+static umode_t dcp_peer_probe_visible(struct kobject *kobj,
+				    struct attribute *attr, int n)
+{
+	return peer_allocation_probe ? attr->mode : 0;
+}
+
+static const struct attribute_group dcp_peer_probe_group = {
+	.attrs = dcp_peer_probe_attrs,
+	.is_visible = dcp_peer_probe_visible,
+};
+static const struct attribute_group *dcp_peer_probe_groups[] = {
+	&dcp_peer_probe_group,
+	NULL,
+};
diff --git a/drivers/gpu/drm/apple/dcp-peer-runtime-v27.inc b/drivers/gpu/drm/apple/dcp-peer-runtime-v27.inc
new file mode 100644
index 000000000000..b1f99d6ddd65
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-peer-runtime-v27.inc
@@ -0,0 +1,161 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* Kept opt-in while paired DRM lifecycle is being validated on T6050. */
+static bool peer_scanout;
+module_param(peer_scanout, bool, 0444);
+MODULE_PARM_DESC(peer_scanout, "Enable firmware27 paired DRM scanout bring-up");
+
+static bool dcp_peer_transport_idle(struct apple_dcp *dcp)
+{
+	return dcp->active && !dcp->crashed && !dcp->peer_unbinding &&
+	       !dcp->ch_cmd.depth && !dcp->ch_cb.depth && !dcp->ch_async.depth &&
+	       !dcp->ch_oobcmd.depth && !dcp->ch_oobcb.depth && !dcp->ch_oobasync.depth;
+}
+
+int dcp_peer_modeset_v27(struct apple_dcp *dcp, u32 timing, u32 color, bool vrr)
+{
+	struct apple_dcp *peer;
+	int ret = -EOPNOTSUPP;
+
+	if (!peer_scanout || !peer_allocation_probe ||
+	    dcp->fw_compat != DCP_FIRMWARE_V_27_0)
+		return ret;
+	if (timing > U32_MAX - 10000 || color > U32_MAX - 10000)
+		return -EINVAL;
+	if (!device_trylock(dcp->dev))
+		return -EBUSY;
+	{
+		guard(mutex)(&dcp_peer_lock);
+		peer = dcp->peer_reserved;
+		if (!peer)
+			goto unlock;
+		if (peer->peer_owner != dcp || !dcp_peer_transport_idle(dcp) ||
+		    !dcp_peer_transport_idle(peer) || peer->fixed_phy ||
+		    peer->nr_typec_routes || !peer->crtc ||
+		    !peer->crtc->base.state || peer->crtc->base.state->active ||
+		    !device_trylock(peer->dev)) {
+			ret = -EBUSY;
+			goto unlock;
+		}
+	}
+	/* Do not silently select an untiled mode when paired VRR was requested.
+	 * The internal and single-pipe external adaptive-sync paths are unchanged.
+	 */
+	if (vrr) {
+		struct dcp_peer_get_video_req_v27 req = {
+			.timing_id = cpu_to_le32(timing), .color_id = cpu_to_le32(color),
+		};
+		struct dcp_peer_get_video_resp_v27 resp;
+
+		ret = dcp_peer_video_call(dcp, "A364", &req, sizeof(req), &resp, sizeof(resp));
+		if (ret || !(resp.success & 1) || (resp.requires_merge & 1)) {
+			ret = ret ?: -EINVAL;
+			goto peer_unlock;
+		}
+	}
+	ret = dcp_peer_install_video_v27(dcp, peer, timing, color, 4);
+	if (!ret) {
+		guard(mutex)(&dcp_peer_lock);
+		dcp->peer_frames = (struct dcp_peer_frames_v27){ .active = true };
+		dev_info(dcp->dev, "paired DRM mode ready: timing=%u color=%u\n", timing, color);
+	}
+peer_unlock:
+	device_unlock(peer->dev);
+unlock:
+	device_unlock(dcp->dev);
+	return ret;
+}
+
+/* Return1 after a paired stop,0 for a normal CRTC, or an error. */
+int dcp_peer_stop_v27(struct apple_dcp *dcp)
+{
+	struct apple_dcp *peer;
+	int ret = 0;
+
+	if (!peer_scanout || !READ_ONCE(dcp->peer_frames.active))
+		return 0;
+	if (!device_trylock(dcp->dev))
+		return -EBUSY;
+	{
+		guard(mutex)(&dcp_peer_lock);
+		peer = dcp->peer_reserved;
+		if (!peer || peer->peer_owner != dcp || !dcp_peer_transport_idle(dcp) ||
+		    !dcp_peer_transport_idle(peer) || !device_trylock(peer->dev)) {
+			ret = -EBUSY;
+			goto unlock;
+		}
+	}
+	ret = dcp_peer_probe_quiesce(dcp, peer);
+	device_unlock(peer->dev);
+	if (!ret)
+		ret = 1;
+unlock:
+	device_unlock(dcp->dev);
+	return ret;
+}
+
+struct apple_dcp *dcp_peer_scanout_v27(struct apple_dcp *dcp)
+{
+	struct apple_dcp *peer;
+
+	if (!peer_scanout || !READ_ONCE(dcp->peer_frames.active))
+		return NULL;
+	guard(mutex)(&dcp_peer_lock);
+	if (!dcp->peer_frames.active)
+		return NULL;
+	peer = dcp->peer_reserved;
+	if (!peer || peer->peer_owner != dcp || dcp->peer_frames.failed ||
+	    !dcp->peer_tiling.modeset_complete || !peer->peer_tiling.modeset_complete ||
+	    dcp->crashed || peer->crashed || dcp->peer_unbinding || peer->peer_unbinding)
+		return ERR_PTR(-EIO);
+	return peer;
+}
+
+void dcp_peer_swap_armed_v27(struct apple_dcp *dcp, u32 id)
+{
+	guard(mutex)(&dcp_peer_lock);
+	dcp_peer_frame_submit_v27(&dcp->peer_frames, id);
+}
+
+void dcp_peer_swap_failed_v27(struct apple_dcp *dcp)
+{
+	guard(mutex)(&dcp_peer_lock);
+	dcp->peer_frames.failed = true;
+	dcp_mode_invalidate(&dcp->mode_state);
+}
+
+bool dcp_peer_swap_complete_v27(struct apple_dcp *dcp, u32 id, ktime_t now,
+		void (*report)(struct apple_dcp *, u32, ktime_t))
+{
+	struct apple_dcp *owner;
+	u32 watermark;
+
+	/* Independent CRTCs must not serialize through the pair's mutex. */
+	if (!peer_scanout || (!READ_ONCE(dcp->peer_frames.active) &&
+			     !READ_ONCE(dcp->peer_owner)))
+		return false;
+	guard(mutex)(&dcp_peer_lock);
+	owner = dcp->peer_owner ?: dcp;
+	if (!peer_scanout || !owner->peer_frames.active)
+		return false;
+	if (dcp_peer_frame_complete_v27(&owner->peer_frames, dcp != owner, id, &watermark))
+		/* Queue the combined watermark to the primary IOMFB owner. */
+		report(owner, watermark, now);
+	return true;
+}
+
+int dcp_peer_color_v27(struct apple_dcp *dcp, struct iomfb_set_matrix_req *matrix)
+{
+	struct apple_dcp *peer = dcp_peer_scanout_v27(dcp);
+	u32 status, identity = 0x10000;
+	int ret;
+
+	if (!peer)
+		return 0;
+	if (IS_ERR(peer))
+		return PTR_ERR(peer);
+	ret = dcp_peer_video_call(peer, "A423", matrix, sizeof(*matrix), &status, 4);
+	if (ret || status)
+		return ret ?: -EIO;
+	ret = dcp_peer_video_call(peer, "A428", &identity, sizeof(identity), &status, 4);
+	return ret ?: (status ? -EIO : 0);
+}
diff --git a/drivers/gpu/drm/apple/dcp-peer-swap-probe-v27.inc b/drivers/gpu/drm/apple/dcp-peer-swap-probe-v27.inc
new file mode 100644
index 000000000000..f6c8ced4317e
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-peer-swap-probe-v27.inc
@@ -0,0 +1,243 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* Explicit background-only paired swap diagnostic. No framebuffer DMA or
+ * DRM events are owned here. Both DRM CRTCs must remain inactive.
+ */
+struct dcp_peer_background {
+	struct iomfb_transaction transaction;
+	struct dcp_peer_video_wait *wait;
+	struct dcp_swap_submit_req_v27 wire;
+	bool sent;
+};
+
+static void dcp_peer_background_done(struct apple_dcp *dcp, void *out, void *cookie)
+{
+	struct dcp_peer_background *background = cookie;
+	struct dcp_swap_submit_resp_v27 failed = { .ret = ~0U };
+	struct dcp_swap_submit_resp_v27 *response = out ?: &failed;
+
+	if (!dcp_present_submit_h17p(&dcp->present_state_h17p,
+				     background->wire.swap.swap_id, !response->ret))
+		WRITE_ONCE(dcp->crashed, true);
+	dcp_peer_video_done(dcp, response, background->wait);
+}
+
+static void dcp_peer_background_start(struct apple_dcp *dcp,
+				      struct iomfb_transaction *transaction)
+{
+	struct dcp_peer_background *background =
+		container_of(transaction, struct dcp_peer_background, transaction);
+	struct dcp_method_entry method = { .name = "peer_background_test",
+		.tag = {'A', '4', '0', '8'} };
+	struct dcp_swap_submit_resp_v27 failed = { .ret = ~0U };
+
+	background->sent = true;
+	if (!dcp_present_begin_h17p(&dcp->present_state_h17p,
+				    background->wire.swap.swap_id)) {
+		dcp_peer_video_done(dcp, &failed, background->wait);
+		return;
+	}
+	dcp_push(dcp, false, &method, sizeof(background->wire), sizeof(failed),
+		 &background->wire, dcp_peer_background_done, background);
+}
+
+static void dcp_peer_background_release(struct iomfb_transaction *transaction)
+{
+	struct dcp_peer_background *background =
+		container_of(transaction, struct dcp_peer_background, transaction);
+
+	if (!background->sent)
+		kref_put(&background->wait->refs, dcp_peer_video_free);
+	kfree(background);
+}
+
+static int dcp_peer_queue_background(struct apple_dcp *dcp,
+				     struct dcp_swap_submit_req_v27 *wire,
+				     struct dcp_peer_video_wait *wait)
+{
+	struct dcp_peer_background *background;
+	int ret;
+
+	background = kzalloc_obj(*background);
+	if (!background)
+		return -ENOMEM;
+	background->wire = *wire;
+	background->wait = wait;
+	kref_get(&wait->refs);
+	background->transaction.start = dcp_peer_background_start;
+	background->transaction.release = dcp_peer_background_release;
+	ret = iomfb_queue(dcp, &background->transaction);
+	if (ret)
+		dcp_peer_background_release(&background->transaction);
+	return ret;
+}
+
+static int dcp_peer_probe_background(struct apple_dcp *dcp, struct apple_dcp *peer)
+{
+	struct dcp_swap_start_req_h17p start = {};
+	struct dcp_swap_start_resp_h17p a, b;
+	struct dcp_swap_submit_req_v27 *submit;
+	struct dcp_swap_submit_resp_v27 response;
+	struct dcp_peer_video_wait *wait, *peer_wait;
+	unsigned long deadline;
+	int ret;
+
+	submit = kzalloc(sizeof(*submit), GFP_KERNEL);
+	wait = kzalloc(sizeof(*wait), GFP_KERNEL);
+	peer_wait = kzalloc(sizeof(*peer_wait), GFP_KERNEL);
+	if (!submit || !wait || !peer_wait) {
+		kfree(submit);
+		kfree(wait);
+		kfree(peer_wait);
+		return -ENOMEM;
+	}
+	kref_init(&wait->refs);
+	init_completion(&wait->done);
+	wait->size = sizeof(response);
+	kref_init(&peer_wait->refs);
+	init_completion(&peer_wait->done);
+	peer_wait->size = sizeof(response);
+	ret = dcp_peer_video_call(dcp, "A406", &start, sizeof(start), &a, sizeof(a));
+	if (ret || a.ret) {
+		ret = ret ?: -EIO;
+		goto out;
+	}
+	ret = dcp_peer_video_call(peer, "A406", &start, sizeof(start), &b, sizeof(b));
+	if (ret || b.ret || a.swap_id != b.swap_id) {
+		dev_err(dcp->dev, "peer swap-start mismatch/error: %u/%u result=%d\n",
+			a.swap_id, ret ? 0 : b.swap_id, ret);
+		ret = ret ?: -EIO;
+		goto out;
+	}
+	submit->swap.swap_id = a.swap_id;
+	submit->swap.swap_enabled = submit->swap.swap_completed = IOMFB_SET_BACKGROUND | 7;
+	submit->swap.bg_color = 0xffff0000;
+	memset(submit->surf_null, 1, sizeof(submit->surf_null));
+	submit->unknown_pointer_null = submit->unknown_output_null = true;
+	ret = dcp_peer_queue_background(dcp, submit, wait);
+	if (ret)
+		goto out;
+	/* Queue both engines before waiting, with each present tracked by its
+	 * own IOMFB transaction and completion state. */
+	submit->swap.bg_color = 0xff0000ff;
+	ret = dcp_peer_queue_background(peer, submit, peer_wait);
+	if (ret)
+		goto out;
+	if (!wait_for_completion_timeout(&peer_wait->done, msecs_to_jiffies(2000))) {
+		ret = -ETIMEDOUT;
+		goto out;
+	}
+	memcpy(&response, peer_wait->reply, sizeof(response));
+	if (response.ret) {
+		ret = -EIO;
+		goto out;
+	}
+	if (!wait_for_completion_timeout(&wait->done, msecs_to_jiffies(2000))) {
+		ret = -ETIMEDOUT;
+		goto out;
+	}
+	memcpy(&response, wait->reply, sizeof(response));
+	if (response.ret) {
+		ret = -EIO;
+		goto out;
+	}
+	deadline = jiffies + msecs_to_jiffies(2000);
+	while (!READ_ONCE(dcp->have_swap_complete) || !READ_ONCE(peer->have_swap_complete) ||
+	       READ_ONCE(dcp->last_swap_id) != a.swap_id ||
+	       READ_ONCE(peer->last_swap_id) != a.swap_id) {
+		if (time_after_eq(jiffies, deadline)) {
+			ret = -ETIMEDOUT;
+			goto out;
+		}
+		msleep(2);
+	}
+	dev_info(dcp->dev, "peer background swap %u completed on both engines (optical unverified)\n",
+		 a.swap_id);
+out:
+	dev_info(dcp->dev, "peer background test result=%d\n", ret);
+	kref_put(&wait->refs, dcp_peer_video_free);
+	kref_put(&peer_wait->refs, dcp_peer_video_free);
+	kfree(submit);
+	return ret;
+}
+
+static ssize_t peer_swap_test_store(struct device *dev,
+				   struct device_attribute *attr,
+				   const char *buf, size_t count)
+{
+	struct apple_dcp *dcp, *peer;
+	struct device *peer_dev = NULL;
+	bool enabled;
+	int ret;
+
+	if (kstrtobool(buf, &enabled) || !enabled)
+		return -EINVAL;
+	if (!peer_allocation_probe || !device_trylock(dev))
+		return -EBUSY;
+	dcp = dev_get_drvdata(dev);
+	{
+		guard(mutex)(&dcp_peer_lock);
+		peer = dcp ? dcp->peer_reserved : NULL;
+		if (!peer || peer->peer_owner != dcp || !dcp_peer_video_idle(dcp) ||
+		    !dcp_peer_video_idle(peer) || READ_ONCE(dcp->peer_frames.active) || !dcp->peer_tiling.member ||
+		    !peer->peer_tiling.member || !dcp->peer_tiling.modeset_complete ||
+		    !peer->peer_tiling.modeset_complete || !dcp->crtc || !peer->crtc ||
+		    !dcp->crtc->base.state || !peer->crtc->base.state ||
+		    dcp->crtc->base.state->active || peer->crtc->base.state->active ||
+		    dcp->fw_compat != DCP_FIRMWARE_V_27_0 ||
+		    peer->fw_compat != DCP_FIRMWARE_V_27_0 ||
+		    !device_trylock(peer->dev)) {
+			ret = -EBUSY;
+			goto out;
+		}
+		peer_dev = peer->dev;
+	}
+	ret = dcp_peer_probe_background(dcp, peer);
+out:
+	if (peer_dev)
+		device_unlock(peer_dev);
+	device_unlock(dev);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_WO(peer_swap_test);
+
+/* End a diagnostic pair using the firmware's power/element sequence. Keep the
+ * reservation on failure: a failed ACK is not evidence that DMA has stopped.
+ */
+static ssize_t peer_stop_test_store(struct device *dev,
+				   struct device_attribute *attr,
+				   const char *buf, size_t count)
+{
+	struct apple_dcp *dcp, *peer;
+	struct device *peer_dev = NULL;
+	bool enabled;
+	int ret;
+
+	if (kstrtobool(buf, &enabled) || !enabled)
+		return -EINVAL;
+	if (!peer_allocation_probe || !device_trylock(dev))
+		return -EBUSY;
+	dcp = dev_get_drvdata(dev);
+	{
+		guard(mutex)(&dcp_peer_lock);
+		peer = dcp ? dcp->peer_reserved : NULL;
+		if (!peer || peer->peer_owner != dcp || !dcp_peer_video_idle(dcp) ||
+		    !dcp_peer_video_idle(peer) || !dcp->crtc || !peer->crtc ||
+		    !dcp->crtc->base.state || !peer->crtc->base.state ||
+		    dcp->crtc->base.state->active || peer->crtc->base.state->active ||
+		    dcp->fw_compat != DCP_FIRMWARE_V_27_0 ||
+		    peer->fw_compat != DCP_FIRMWARE_V_27_0 ||
+		    !device_trylock(peer->dev)) {
+			ret = -EBUSY;
+			goto out;
+		}
+		peer_dev = peer->dev;
+	}
+	ret = dcp_peer_probe_quiesce(dcp, peer);
+	dev_info(dev, "peer stop test result=%d\n", ret);
+out:
+	if (peer_dev)
+		device_unlock(peer_dev);
+	device_unlock(dev);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_WO(peer_stop_test);
diff --git a/drivers/gpu/drm/apple/dcp-peer-v27.h b/drivers/gpu/drm/apple/dcp-peer-v27.h
new file mode 100644
index 000000000000..cea2a4f13e43
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-peer-v27.h
@@ -0,0 +1,125 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef APPLE_DCP_PEER_V27_H
+#define APPLE_DCP_PEER_V27_H
+
+#include <linux/types.h>
+#include <linux/kernel.h>
+#include <linux/unaligned.h>
+
+#include "dcp-peer-v26_6.h"
+
+struct dcp_dptx_caps {
+	u32 width, total_rate, active_rate;
+};
+
+/* Per-engine state used by D114/D115 in a VFTG pair. This is not
+ * display-wall emulation: membership is set only while a split mode is active.
+ */
+/* The record is struct dcp_peer_tiling, shared with the desktop 26.6 pair. */
+
+static inline bool dcp_peer_tiling_get_v27(
+	const struct dcp_peer_tiling *own,
+	const struct dcp_peer_tiling *related, u32 event, u32 param, u32 *value)
+{
+	const struct dcp_peer_tiling *target = own;
+
+	/* The getter redirects event 2 only for an active pair. */
+	if (event == 2 && own->member) {
+		if (!related)
+			return false;
+		target = related;
+	}
+	switch (param) {
+	case 1: *value = target->member; return true;
+	case 2:
+		if (event == 1 || target->member)
+			*value = target->phase;
+		return true;
+	case 3: return true; /* The non-wall case preserves the input. */
+	case 4:
+		if (event != 1 && !target->member)
+			return true;
+		if (!target->display_id_valid)
+			return false;
+		*value = target->display_id;
+		return true;
+	case 5: case 12: *value = target->x; return true;
+	case 6:
+		if (event == 1 || target->member)
+			*value = target->ready;
+		return true;
+	case 8: *value = own->vftg; return true;
+	case 9: *value = own->primary; return true;
+	case 10:
+		if (event == 1 || target->member)
+			*value = target->modeset_state;
+		return true;
+	case 11: *value = 0; return true; /* This pair is not a display wall. */
+	case 13: *value = target->y; return true;
+	case 14: *value = target->mode_flag; return true;
+	default: return false;
+	}
+}
+
+static inline bool dcp_peer_tiling_set_v27(struct dcp_peer_tiling *own,
+	struct dcp_peer_tiling *related, u32 event, u32 param, u32 value)
+{
+	/* Unlike the getter, the setter always redirects event 2. */
+	struct dcp_peer_tiling *target = event == 2 ? related : own;
+
+	if (!target)
+		return false;
+	switch (param) {
+	case 2: target->phase = value; return true;
+	case 6: target->ready = !!value; return true;
+	case 10: target->modeset_state = value; return true;
+	default: return false;
+	}
+}
+
+/* AV display hints and display allocation records. */
+struct dcp_display_hints_v27 {
+	u8 hints[0x6c];
+	u8 padding[4];
+	__le32 primary_id, peer_id;
+	u8 extra_pipes, flags;
+	u8 allocation_reserved[22];
+	__le32 status;
+	u8 tail[12];
+} __packed;
+
+static_assert(sizeof(struct dcp_display_hints_v27) == 160);
+static_assert(offsetof(struct dcp_display_hints_v27, primary_id) == 0x70);
+static_assert(offsetof(struct dcp_display_hints_v27, status) == 0x90);
+
+/* Extra pipe count, as the T602X display crossbar computes it.
+ * Caps come from the live DPTX service, never from a forced clock limit.
+ */
+static inline u32 dcp_peer_extra_pipes(const u8 *hints,
+				     const struct dcp_dptx_caps *caps)
+{
+	u32 width = get_unaligned_le32(hints + 0x38);
+	u32 total = get_unaligned_le32(hints + 0x40);
+	u32 active = get_unaligned_le32(hints + 0x44);
+	u32 extra;
+
+	if (!(hints[0] & 1) || !width || !total || !active ||
+	    !caps->width || !caps->total_rate || !caps->active_rate)
+		return 0;
+	extra = (width - 1) / caps->width;
+	extra = max(extra, (total - 1) / caps->total_rate);
+	return max(extra, (active - 1) / caps->active_rate);
+}
+
+/* Peer validity rule of the T8132 display crossbar, inherited by T6050.
+ * Endpoint zero is the internal display; a peer must be on the same die.
+ */
+static inline bool dcp_peer_index_allowed(u32 primary, u32 peer)
+{
+	static const u8 masks[] = { 0, 0x1c, 0x18, 0x10, 0 };
+
+	return primary < ARRAY_SIZE(masks) && peer < ARRAY_SIZE(masks) &&
+	       (masks[primary] & BIT(peer));
+}
+
+#endif
diff --git a/drivers/gpu/drm/apple/dcp-peer-v27.inc b/drivers/gpu/drm/apple/dcp-peer-v27.inc
new file mode 100644
index 000000000000..9bae0594b584
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-peer-v27.inc
@@ -0,0 +1,154 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+
+/* Bring-up gate until the framebuffer merge lifecycle is implemented. This
+ * only reserves an otherwise unrouted DCP; it never replaces a physical route.
+ */
+static bool peer_allocation_probe;
+module_param(peer_allocation_probe, bool, 0444);
+MODULE_PARM_DESC(peer_allocation_probe, "Test firmware27 logical peer allocation (merge bring-up)");
+
+bool dcp_peer_tiling_state_v27(struct apple_dcp *dcp, bool write,
+			      u32 event, u32 param, u32 *value)
+{
+	struct apple_dcp *peer;
+
+	guard(mutex)(&dcp_peer_lock);
+	if (!peer_allocation_probe || dcp->peer_unbinding || dcp->crashed)
+		return false;
+	peer = dcp->peer_reserved ?: dcp->peer_owner;
+	if (!peer || peer->peer_unbinding || peer->crashed)
+		return false;
+	/* A resource reservation is not a framebuffer pair. Before the
+	 * split-mode preparation, keep the established untiled callback path;
+	 * zero-initialized fields are not yet valid tiling-manager state.
+	 */
+	if (!dcp->peer_tiling.vftg || !peer->peer_tiling.vftg)
+		return false;
+	if (write)
+		return dcp_peer_tiling_set_v27(&dcp->peer_tiling,
+					      &peer->peer_tiling, event, param, *value);
+	return dcp_peer_tiling_get_v27(&dcp->peer_tiling, &peer->peer_tiling,
+				     event, param, value);
+}
+
+void dcp_peer_display_ids_v27(struct apple_dcp *dcp, u32 own, u32 related)
+{
+	struct apple_dcp *peer;
+
+	guard(mutex)(&dcp_peer_lock);
+	peer = dcp->peer_reserved ?: dcp->peer_owner;
+	if (!peer || own == related || dcp->peer_unbinding || peer->peer_unbinding)
+		return;
+	/* D575 carries external display IDs, not crossbar endpoint indices. */
+	dcp->peer_tiling.display_id = own;
+	dcp->peer_tiling.display_id_valid = true;
+	peer->peer_tiling.display_id = related;
+	peer->peer_tiling.display_id_valid = true;
+}
+
+static void dcp_peer_release_locked(struct apple_dcp *dcp)
+{
+	if (dcp->peer_reserved) {
+		/* A link-allocation release is not a DMA-stop acknowledgement.
+		 * Keep a prepared pair owned until the AP has powered both down.
+		 * Firmware may still need the tiling rendezvous state to stop.
+		 */
+		if (dcp->peer_tiling.vftg || dcp->peer_tiling.member ||
+		    dcp->peer_reserved->peer_tiling.vftg ||
+		    dcp->peer_reserved->peer_tiling.member) {
+			dcp->peer_tiling.modeset_complete = false;
+			dcp->peer_reserved->peer_tiling.modeset_complete = false;
+			return;
+		}
+		memset(&dcp->peer_tiling, 0, sizeof(dcp->peer_tiling));
+		memset(&dcp->peer_reserved->peer_tiling, 0,
+		       sizeof(dcp->peer_reserved->peer_tiling));
+		dcp->peer_reserved->peer_owner = NULL;
+		dcp->peer_reserved = NULL;
+	}
+}
+
+int dcp_peer_hints_v27(struct apple_dcp *dcp, struct dptx_port *port,
+		      const void *data, size_t size, void *reply, size_t reply_size)
+{
+	struct dcp_display_hints_v27 *r = reply;
+	struct apple_dcp *peer = NULL;
+	struct drm_crtc *crtc;
+	u32 extra;
+
+	if (size != sizeof(*r) || reply_size != sizeof(*r))
+		return -EINVAL;
+	memcpy(reply, data, sizeof(*r));
+	/* The first word is hint flags, not a return code. The completion
+	 * status has a field of its own, leaving the request hints unchanged.
+	 */
+	r->status = 0;
+	if (!peer_allocation_probe)
+		return 0;
+	if (!of_device_is_compatible(dcp->dev->of_node, "apple,t6050-dcpext") ||
+	    port->unit || !dcp->crtc)
+		return 0;
+
+	extra = dcp_peer_extra_pipes(r->hints, &port->caps);
+	memset(&r->primary_id, 0, 32);
+	guard(mutex)(&dcp_peer_lock);
+	if (dcp->peer_unbinding || dcp->crashed)
+		return -ENODEV;
+	if (!extra || !(r->hints[0] & 1)) {
+		dcp_peer_release_locked(dcp);
+		memset(&r->primary_id, 0, 32);
+		return 0;
+	}
+	/* This candidate implements a non-tiled, two-pipe reservation. Tiled
+	 * panels and more than one peer require the full display allocator.
+	 */
+	if (extra != 1 || (r->hints[0] & 2) || dcp->peer_owner)
+		return 0;
+	peer = dcp->peer_reserved;
+	if (!peer) {
+		drm_for_each_crtc(crtc, dcp->crtc->base.dev) {
+			struct apple_dcp *p = platform_get_drvdata(to_apple_crtc(crtc)->dcp);
+
+			/* A dedicated, unrouted peer cannot race Type-C's allocator
+			 * or a fixed connector's HPD handler in this bring-up step.
+			 */
+			if (!p || !p->active || p->crashed || p->peer_unbinding ||
+			    p->peer_owner || p->peer_reserved || p->fixed_phy ||
+			    p->nr_typec_routes || p->active_typec_route ||
+			    (p->connector && p->connector->connected) ||
+			    !dcp_peer_index_allowed(dcp->index, p->index) ||
+			    p->dptx_die != dcp->dptx_die ||
+			    !p->crtc || p->crtc->base.dev != dcp->crtc->base.dev ||
+			    p->fw_compat != DCP_FIRMWARE_V_27_0 ||
+			    !p->dptxport[0].enabled ||
+			    p->dptxport[0].caps.width < port->caps.width ||
+			    p->dptxport[0].caps.total_rate < port->caps.total_rate ||
+			    p->dptxport[0].caps.active_rate < port->caps.active_rate ||
+			    p->dptxport[0].connected || p->dptxport[1].connected ||
+			    !of_device_is_compatible(p->dev->of_node, "apple,t6050-dcpext"))
+				continue;
+			if (!peer || p->index < peer->index)
+				peer = p;
+		}
+		if (!peer) {
+			dev_info(dcp->dev, "no eligible idle peer for %u extra pipe\n", extra);
+			return 0;
+		}
+		dcp->peer_reserved = peer;
+		peer->peer_owner = dcp;
+		dev_info(dcp->dev, "reserved peer DCP%u for %ux%u, total %u active %u\n",
+			 peer->index, get_unaligned_le32(r->hints + 0x38),
+			 get_unaligned_le32(r->hints + 0x3c),
+			 get_unaligned_le32(r->hints + 0x40),
+			 get_unaligned_le32(r->hints + 0x44));
+	}
+	/* The display allocation update writes primary/peer endpoint IDs.
+	 * The extra pipe count supplies byte8. This is full dual-pipe, so the
+	 * T6050 limited-dual-pipe flag (byte9 bit1) remains clear.
+	 */
+	r->primary_id = cpu_to_le32(dcp->index);
+	r->peer_id = cpu_to_le32(peer->index);
+	r->extra_pipes = extra;
+	r->flags &= ~3;
+	return 0;
+}
diff --git a/drivers/gpu/drm/apple/dcp-peer-video-probe-v27.inc b/drivers/gpu/drm/apple/dcp-peer-video-probe-v27.inc
new file mode 100644
index 000000000000..24c985a91195
--- /dev/null
+++ b/drivers/gpu/drm/apple/dcp-peer-video-probe-v27.inc
@@ -0,0 +1,250 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* Opt-in A364/A365 bring-up. Installs derived modes without selecting them;
+ * paired power, modeset and swap ownership must be implemented separately.
+ */
+#include "iomfb-peer-v27.h"
+
+struct dcp_peer_video_wait {
+	struct kref refs;
+	struct completion done;
+	size_t size;
+	u8 reply[sizeof(struct dcp_peer_get_video_resp_v27)];
+};
+
+static void dcp_peer_video_free(struct kref *ref)
+{
+	kfree(container_of(ref, struct dcp_peer_video_wait, refs));
+}
+
+static void dcp_peer_video_done(struct apple_dcp *dcp, void *out, void *cookie)
+{
+	struct dcp_peer_video_wait *wait = cookie;
+
+	if (wait->size)
+		memcpy(wait->reply, out, wait->size);
+	complete(&wait->done);
+	kref_put(&wait->refs, dcp_peer_video_free);
+}
+
+static int dcp_peer_video_call_stream(struct apple_dcp *dcp, bool independent,
+			       const char *tag,
+			       void *in, size_t in_size, void *out, size_t out_size)
+{
+	struct dcp_method_entry method = { .name = "peer_video_test" };
+	struct dcp_peer_video_wait *wait;
+	int ret = 0;
+
+	if (out_size > sizeof(wait->reply))
+		return -EINVAL;
+	/* An unrelated AP thread gets its own firmware stream. A369/A367/etc.
+	 * must not be mistaken for nested callbacks of the pending A413.
+	 * Stream1 (the driver's OOB context) is independent of stream0.
+	 */
+	if (independent && (dcp->ch_oobcmd.depth || dcp->ch_oobcb.depth))
+		return -EBUSY;
+	wait = kzalloc(sizeof(*wait), GFP_KERNEL);
+	if (!wait)
+		return -ENOMEM;
+	memcpy(method.tag, tag, sizeof(method.tag));
+	wait->size = out_size;
+	init_completion(&wait->done);
+	kref_init(&wait->refs);
+	kref_get(&wait->refs);
+	dcp_push(dcp, independent, &method, in_size, out_size, in,
+		 dcp_peer_video_done, wait);
+	if (!wait_for_completion_timeout(&wait->done,
+		msecs_to_jiffies(!memcmp(tag, "A413", 4) ? 8500 : 2000)))
+		ret = -ETIMEDOUT;
+	else if (out_size)
+		memcpy(out, wait->reply, out_size);
+	/* A late ACK owns only the heap cookie, never a caller's stack. */
+	kref_put(&wait->refs, dcp_peer_video_free);
+	return ret;
+}
+
+static int dcp_peer_video_call(struct apple_dcp *dcp, const char *tag,
+			       void *in, size_t in_size, void *out, size_t out_size)
+{
+	return dcp_peer_video_call_stream(dcp, false, tag, in, in_size, out, out_size);
+}
+
+#include "dcp-peer-modeset-probe-v27.inc"
+
+static bool dcp_peer_video_idle(struct apple_dcp *dcp)
+{
+	return dcp->active && !dcp->crashed && !dcp->peer_unbinding &&
+	       !READ_ONCE(dcp->mode_state.changing) && !dcp->ch_cmd.depth && !dcp->ch_cb.depth &&
+	       !dcp->ch_async.depth && !dcp->ch_oobcmd.depth &&
+	       !dcp->ch_oobcb.depth && !dcp->ch_oobasync.depth;
+}
+
+/* Shared by the explicit diagnostic and normal DRM mode selection.
+ * Install4 chooses a pair only when firmware's A364 requires one.
+ */
+static int dcp_peer_install_video_v27(struct apple_dcp *dcp, struct apple_dcp *peer,
+                                     u32 timing, u32 color, u32 install)
+{
+	struct device *dev = dcp->dev;
+	struct dcp_peer_get_video_req_v27 req = {};
+	struct dcp_peer_get_video_resp_v27 resp;
+	struct dcp_peer_insert_video_req_v27 insert = {};
+	struct dcp_peer_insert_video_resp_v27 inserted;
+	__le32 enabled = cpu_to_le32(1);
+	int ret;
+
+	req.timing_id = cpu_to_le32(timing);
+	req.color_id = cpu_to_le32(color);
+	ret = dcp_peer_video_call(dcp, "A364", &req, sizeof(req), &resp, sizeof(resp));
+	if (ret)
+		return ret;
+	dev_info(dev, "peer video timing=%u color=%u success=%u merge=%u timing=%*ph color=%*ph\n",
+		 timing, color, resp.success, resp.requires_merge,
+		 64, resp.video.timing, 32, resp.video.color);
+	dev_info(dev, "peer timing tail=%*ph\n", 16, resp.video.timing + 64);
+	if (!(resp.success & 1)) {
+		ret = -ENOENT;
+		return ret;
+	}
+	if (!install)
+		return ret;
+	/* Mode3 explicitly tests a reserved pair using an existing lower-rate
+	 * timing. It does not advertise a mode, raise a limit, or add scanout.
+	 * Keep this diagnostic independent of production mode selection.
+	 */
+	if (!(resp.requires_merge & 1) && install != 3) {
+		if (install == 4 && (dcp->peer_tiling.vftg || peer->peer_tiling.vftg)) {
+			u8 power[16] = {1}, response[8];
+
+			ret = dcp_peer_probe_quiesce(dcp, peer);
+			if (ret)
+				return ret;
+			/* A mode-only DRM commit does not call CRTC poweron again. */
+			ret = dcp_peer_video_call(dcp, "A484", power, sizeof(power),
+						  response, sizeof(response));
+			if (ret || get_unaligned_le32(response + 4))
+				return ret ?: -EIO;
+		}
+		return -EOPNOTSUPP;
+	}
+	ret = dcp_peer_probe_quiesce(dcp, peer);
+	if (ret)
+		return ret;
+	insert.video = resp.video;
+	dcp_peer_split_timing_v27(&insert.video);
+	insert.timing_id = cpu_to_le32(timing + 10000);
+	insert.color_id = cpu_to_le32(color + 10000);
+	ret = dcp_peer_probe_prepare_vftg(dcp, peer, &insert);
+	if (ret)
+		return ret;
+	ret = dcp_peer_video_call(peer, "A366", &enabled, sizeof(enabled), NULL, 0);
+	if (ret)
+		return ret;
+	ret = dcp_peer_video_call(dcp, "A365", &insert, sizeof(insert),
+				  &inserted, sizeof(inserted));
+	if (!ret && !(inserted.success & 1))
+		ret = -EIO;
+	if (ret)
+		return ret;
+	/* The first call's in/out timing and color go to the peer. */
+	insert.video = inserted.video;
+	ret = dcp_peer_video_call(peer, "A365", &insert, sizeof(insert),
+				  &inserted, sizeof(inserted));
+	if (!ret && !(inserted.success & 1))
+		ret = -EIO;
+	dev_info(dev, "peer derived mode timing=%u color=%u width=%u height=%u clock=%u result=%d (not selected)\n",
+		 timing + 10000, color + 10000,
+		 get_unaligned_le32(insert.video.timing + 8),
+		 get_unaligned_le32(insert.video.timing + 0x28),
+		 get_unaligned_le32(insert.video.timing + 0x44), ret);
+	if (!ret && install >= 2)
+		ret = dcp_peer_probe_modeset(dcp, peer, &insert,
+					     resp.requires_merge & 1);
+	return ret;
+}
+
+static ssize_t peer_video_test_store(struct device *dev,
+				    struct device_attribute *attr,
+				    const char *buf, size_t count)
+{
+	struct apple_dcp *dcp, *peer;
+	struct device *peer_dev = NULL;
+	u32 timing, color, install;
+	char extra;
+	int ret;
+
+	if (sscanf(buf, "%u %u %u %c", &timing, &color, &install, &extra) != 3 ||
+	    install > 3 || timing > U32_MAX - 10000 || color > U32_MAX - 10000)
+		return -EINVAL;
+	if (!peer_allocation_probe)
+		return -EOPNOTSUPP;
+	/* Trylocks avoid the sysfs-removal/device-lock inversion. Hold both
+	 * devices across RPC waits so neither devm-backed DCP can be unbound.
+	 */
+	if (!device_trylock(dev))
+		return -EBUSY;
+	dcp = dev_get_drvdata(dev);
+	{
+		guard(mutex)(&dcp_peer_lock);
+		peer = dcp ? dcp->peer_reserved : NULL;
+		if (!peer || peer->peer_owner != dcp || !dcp_peer_video_idle(dcp) ||
+		    !dcp_peer_video_idle(peer) || !dcp->crtc || !peer->crtc ||
+		    !dcp->crtc->base.state || !peer->crtc->base.state ||
+		    (install && (dcp->crtc->base.state->active ||
+				 peer->crtc->base.state->active)) || peer->fixed_phy ||
+		    peer->nr_typec_routes || peer->peer_tiling.member ||
+		    dcp->peer_tiling.member ||
+		    dcp->fw_compat != DCP_FIRMWARE_V_27_0 ||
+		    peer->fw_compat != DCP_FIRMWARE_V_27_0 ||
+		    (peer->connector && peer->connector->connected)) {
+			ret = -EBUSY;
+			goto unlock;
+		}
+		if (!device_trylock(peer->dev)) {
+			ret = -EBUSY;
+			goto unlock;
+		}
+		peer_dev = peer->dev;
+	}
+	ret = dcp_peer_install_video_v27(dcp, peer, timing, color, install);
+unlock:
+	if (peer_dev)
+		device_unlock(peer_dev);
+	device_unlock(dev);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_WO(peer_video_test);
+
+static ssize_t peer_link_test_store(struct device *dev,
+				   struct device_attribute *attr,
+				   const char *buf, size_t count)
+{
+	struct apple_dcp *dcp;
+	bool enabled;
+	int ret;
+
+	if (kstrtobool(buf, &enabled))
+		return -EINVAL;
+	if (!peer_allocation_probe || !device_trylock(dev))
+		return -EBUSY;
+	dcp = dev_get_drvdata(dev);
+	if (!dcp || !dcp->active || dcp->crashed || !dcp->fixed_phy ||
+	    dcp->nr_typec_routes || dcp->connector_type != DRM_MODE_CONNECTOR_HDMIA) {
+		ret = -EOPNOTSUPP;
+		goto unlock;
+	}
+	{
+		guard(mutex)(&dcp_peer_lock);
+		if (dcp->peer_tiling.vftg || dcp->peer_tiling.member) {
+			ret = -EBUSY;
+			goto unlock;
+		}
+	}
+	/* Use the existing disconnect/connect lifecycle, serialized with HPD.
+	 * This diagnostic models link re-enumeration, not a physical cable pull.
+	 */
+	ret = dcp_typec_test_link(to_platform_device(dev), enabled);
+unlock:
+	device_unlock(dev);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_WO(peer_link_test);
