# Merge on top of the R3-R config (make defconfig asahi.config + boot-path =y, tools/README.md).
# No modules load on this boot path, so everything the DCP path needs is built in.
# DRM_APPLE depends on BACKLIGHT_CLASS_DEVICE, which R3-R has =m: that caps DRM_APPLE at =m.
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_APPLE=y
# DP/HDMI audio pulls SND into the built-in set; not needed for the internal panel.
# CONFIG_DRM_APPLE_AUDIO is not set
# Keep simpledrm as the fallback the driver hands over from (or never takes over from).
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
# Already =y in R3-R; listed because DRM_APPLE needs them built in.
CONFIG_APPLE_DART=y
CONFIG_APPLE_RTKIT=y
CONFIG_APPLE_MAILBOX=y
CONFIG_MULTIPLEXER=y
CONFIG_TYPEC=y
# Selected by DRM_APPLE (inert without a PMP report node in the DT): APPLE_PMP_REPORT, OF_DYNAMIC,
# DRM_APPLE_FABRIC_CORE, DRM_KMS_HELPER, DRM_GEM_DMA_HELPER, DRM_GEM_SHMEM_HELPER, VMAP_PFN.
# For the dev_dbg lines of apple-dart and drm/apple (dyndbg= on the command line):
CONFIG_DYNAMIC_DEBUG=y
