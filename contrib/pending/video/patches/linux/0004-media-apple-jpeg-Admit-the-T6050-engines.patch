From 00438947500d18f64bd712e9759add060ebce2ba Mon Sep 17 00:00:00 2001
From: Rolando Trevino <rolotrealanis@gmail.com>
Date: Sat, 7 Nov 2026 13:51:58 -0500
Subject: [PATCH 04/11] media: apple: jpeg: Admit the T6050 engines

The J716s ADT gives both JPEG engines hw-type 0x111010: T8140's engine
generation (0x11xxxx) at another revision. Accept it under the existing
stepping mask with T8140's programming, and cover it in the KUnit
identity test.

The revision comes from the ADT and has not been read from HWREV yet;
identification still refuses an engine that reads back anything else.

Signed-off-by: Rolando Trevino <rolotrealanis@gmail.com>
Assisted-by: LLM Claude
---
 drivers/media/platform/apple/jpeg/apple-jpeg-drv.c  |  1 +
 drivers/media/platform/apple/jpeg/apple-jpeg-hw.h   | 11 +++++++++++
 drivers/media/platform/apple/jpeg/apple-jpeg-test.c |  3 +++
 3 files changed, 15 insertions(+)

diff --git a/drivers/media/platform/apple/jpeg/apple-jpeg-drv.c b/drivers/media/platform/apple/jpeg/apple-jpeg-drv.c
index f86baca02e4a..0565382bebb2 100644
--- a/drivers/media/platform/apple/jpeg/apple-jpeg-drv.c
+++ b/drivers/media/platform/apple/jpeg/apple-jpeg-drv.c
@@ -851,6 +851,7 @@ static void aj_remove(struct platform_device *pdev)
 
 static const struct of_device_id aj_of_match[] = {
 	{ .compatible = "apple,t6041-jpeg", .data = &apple_jpeg_t6041 },
+	{ .compatible = "apple,t6050-jpeg", .data = &apple_jpeg_t6050 },
 	{ .compatible = "apple,t8140-jpeg", .data = &apple_jpeg_t8140 },
 	{ }
 };
diff --git a/drivers/media/platform/apple/jpeg/apple-jpeg-hw.h b/drivers/media/platform/apple/jpeg/apple-jpeg-hw.h
index 7e15ef5f72c2..888b6ea631b5 100644
--- a/drivers/media/platform/apple/jpeg/apple-jpeg-hw.h
+++ b/drivers/media/platform/apple/jpeg/apple-jpeg-hw.h
@@ -92,6 +92,8 @@
 #define AJ_HWREV_MASK			0xffff0fff
 /* ADT hw-type 0x101008; its stepping nibble is masked off like T8140's. */
 #define AJ_HWREV_T6041			0x100008
+/* ADT hw-type 0x111010, under the same mask. */
+#define AJ_HWREV_T6050			0x110010
 #define AJ_HWREV_T8140			0x110000
 
 struct apple_jpeg_variant {
@@ -108,6 +110,15 @@ static const struct apple_jpeg_variant apple_jpeg_t6041 = {
 	.hwrev = AJ_HWREV_T6041,
 };
 
+/*
+ * T6050 is T8140's engine generation (0x11xxxx) and is driven like it; its
+ * revision is taken from the ADT's hw-type.
+ */
+static const struct apple_jpeg_variant apple_jpeg_t6050 = {
+	.hwrev_mask = AJ_HWREV_MASK,
+	.hwrev = AJ_HWREV_T6050,
+};
+
 static const struct apple_jpeg_variant apple_jpeg_t8140 = {
 	.hwrev_mask = AJ_HWREV_MASK,
 	.hwrev = AJ_HWREV_T8140,
diff --git a/drivers/media/platform/apple/jpeg/apple-jpeg-test.c b/drivers/media/platform/apple/jpeg/apple-jpeg-test.c
index c5fc7c865de6..1a0095a5d8d1 100644
--- a/drivers/media/platform/apple/jpeg/apple-jpeg-test.c
+++ b/drivers/media/platform/apple/jpeg/apple-jpeg-test.c
@@ -19,6 +19,9 @@ static void apple_jpeg_hwrev_test(struct kunit *test)
 	KUNIT_EXPECT_TRUE(test, apple_jpeg_hwrev_supported(&apple_jpeg_t6041, 0x10f008));
 	KUNIT_EXPECT_FALSE(test, apple_jpeg_hwrev_supported(&apple_jpeg_t6041, 0x101009));
 	KUNIT_EXPECT_FALSE(test, apple_jpeg_hwrev_supported(&apple_jpeg_t8140, 0x101008));
+	KUNIT_EXPECT_TRUE(test, apple_jpeg_hwrev_supported(&apple_jpeg_t6050, 0x111010));
+	KUNIT_EXPECT_FALSE(test, apple_jpeg_hwrev_supported(&apple_jpeg_t6050, 0x110000));
+	KUNIT_EXPECT_FALSE(test, apple_jpeg_hwrev_supported(&apple_jpeg_t8140, 0x111010));
 	KUNIT_EXPECT_FALSE(test, apple_jpeg_hwrev_supported(NULL, 0x110000));
 }
 
