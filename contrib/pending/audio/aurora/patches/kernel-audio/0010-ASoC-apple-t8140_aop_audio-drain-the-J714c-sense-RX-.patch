+        let param = ptr::from_ref(self).cast_mut().cast::<core::ffi::c_void>();
+        self.sense_arm_base.store(self.sense_ring_pos.load(core::sync::atomic::Ordering::Relaxed), core::sync::atomic::Ordering::Relaxed);
