# SPDX-License-Identifier: GPL-2.0-only
# Start speakersafetyd when the J716 speaker sense PCM appears.
# Install: /usr/lib/udev/rules.d/96-speakersafetyd-j716.rules
# (upstream 95-speakersafetyd.rules already sets ACP_IGNORE for AppleJ*,
# but has no AppleJ716 line). No DRIVERS== here: udev requires every
# parent key of a rule to match one and the same parent, and the card id
# and the macaudio driver live on different parents (found 2026-11-07).
SUBSYSTEM=="sound", KERNEL=="pcmC*D2c", ATTRS{id}=="AppleJ716", TAG+="systemd", ENV{SYSTEMD_WANTS}="speakersafetyd.service"
