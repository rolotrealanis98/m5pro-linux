# J716s audio on aurora-j716s + patches/kernel-audio. Merge into wt-aurora's .config, then olddefconfig.
# No modules are built for the M5 payloads: everything audio must be =y.
#
# Rust: the AOP (aop.rs) and the AOP audio driver (aop_audio.rs, aop_t8140.rs) are Rust.
# Needs `make LLVM=1 rustavailable` to pass first (rustc >= 1.85 with rust-src, bindgen >= 0.71.1, libclang).
CONFIG_RUST=y
# Rust turns this on by default on ARCH_APPLE; keep the change to audio only.
# CONFIG_APPLE_PMP is not set
CONFIG_PM=y
CONFIG_INPUT=y
# The AOP: co-processor, setup port, RTKit and mailbox (RUST_APPLE_RTKIT/MAILBOX are selected).
CONFIG_APPLE_AOP=y
# AOP audio: the T6050 variant of the T8140 backend (CPU DAIs for jack and speakers, the mic card).
CONFIG_SND_SOC_APPLE_AOP_AUDIO=y
# DMA: the base-ns and LEAP-S ADMACs.
CONFIG_DMADEVICES=y
CONFIG_APPLE_ADMAC=y
# The audio GPIOs (amp SDZ 107 / IRQ 106, jack reset 139 / IRQ 134) and the three I2C buses.
CONFIG_PINCTRL_APPLE_GPIO=y
CONFIG_I2C_APPLE=y
# The six amps share SDZ GPIO 107: without the proxy every consumer defers.
CONFIG_GPIO_SHARED=y
CONFIG_GPIO_SHARED_PROXY=y
# ALSA/ASoC core and the machine driver with its codecs.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_PROC_FS=y
CONFIG_SND_DMAENGINE_PCM=y
CONFIG_SND_SOC_APPLE_MACAUDIO=y
CONFIG_SND_SOC_TAS2764=y
CONFIG_SND_SOC_CS42L84=y
# macaudio selects these; listed so they are not left at m.
CONFIG_SND_SOC_APPLE_MCA=y
CONFIG_SND_SOC_TAS2770=y
CONFIG_SND_SOC_CS42L83=y
CONFIG_SND_SOC_MAX98357A=y
CONFIG_SND_SIMPLE_CARD_UTILS=y
CONFIG_COMMON_CLK_APPLE_NCO=y
# Debug aids (optional): /dev/i2c-* for i2c-tools reads of the amps, dynamic debug for the AOP and macaudio.
CONFIG_I2C_CHARDEV=y
CONFIG_DYNAMIC_DEBUG=y
