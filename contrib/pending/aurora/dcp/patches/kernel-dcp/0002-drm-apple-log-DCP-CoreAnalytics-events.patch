From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Diljit Singh <hey@djdev.me>
Date: Mon, 19 Oct 2026 07:10:51 -0400
Subject: [PATCH 02/12] drm/apple: log DCP CoreAnalytics events

Both DCP firmware crashes seen on T6050 were announced by a
CoreAnalyticsSendEvent callback (D113), whose payload was acknowledged
unread. Log each event's name, and the payload of the first 16 per DCP.

Signed-off-by: Diljit Singh <hey@djdev.me>
[ J775D: backport onto integration/aurora: adapted to the callback table and device struct as carried, without their per-entry comments and crash counter; original 7e64758f0097 ]
Signed-off-by: Jeff Queisser <funkzy@users.noreply.github.com>

(cherry picked from commit eb027c6e6118e822b9135629a69fb36f7f447edd)
---
 drivers/gpu/drm/apple/dcp-internal.h |  2 ++
 drivers/gpu/drm/apple/iomfb_v27.c    | 30 +++++++++++++++++++++++++++-
 2 files changed, 31 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/apple/dcp-internal.h b/drivers/gpu/drm/apple/dcp-internal.h
index cf7aa61ef34e..b156e500f0a4 100644
--- a/drivers/gpu/drm/apple/dcp-internal.h
+++ b/drivers/gpu/drm/apple/dcp-internal.h
@@ -510,6 +510,8 @@ struct apple_dcp {
 
 	/* DCP has crashed */
 	bool crashed;
+	/* CoreAnalytics events dumped in full (dcpep_cb_core_analytics_v27). */
+	u32 analytics_dumps;
 
 	DECLARE_BITMAP(iomfb_surfaces, DCP_MAX_PLANES);
 
diff --git a/drivers/gpu/drm/apple/iomfb_v27.c b/drivers/gpu/drm/apple/iomfb_v27.c
index 0ec2ce360005..13caf82875be 100644
--- a/drivers/gpu/drm/apple/iomfb_v27.c
+++ b/drivers/gpu/drm/apple/iomfb_v27.c
@@ -345,6 +345,34 @@ static bool trampoline_set_tiling_state_v27(struct apple_dcp *dcp, int tag,
 #include "iomfb-external-counts-v27.inc"
 #include "iomfb-boolean-properties-v27.inc"
 
+#define DCP_ANALYTICS_EVENT_SIZE 0x1044
+#define DCP_ANALYTICS_FULL_DUMPS 16
+
+/*
+ * D113 CoreAnalyticsSendEvent. The firmware reports an analytics event, its
+ * name first ("com.apple.iomfb...."); both DCP firmware crashes seen on T6050
+ * were announced by one. Log the name, and the payload of the first few.
+ */
+static bool dcpep_cb_core_analytics_v27(struct apple_dcp *dcp, int tag,
+					void *out, void *in)
+{
+	const u8 *event = in;
+	unsigned int len = DCP_ANALYTICS_EVENT_SIZE;
+	char name[128];
+
+	strscpy(name, event, sizeof(name));
+	dev_info_ratelimited(dcp->dev, "CoreAnalytics event %s\n", name);
+	if (dcp->analytics_dumps < DCP_ANALYTICS_FULL_DUMPS) {
+		dcp->analytics_dumps++;
+		while (len && !event[len - 1])
+			len--;
+		print_hex_dump(KERN_INFO, "dcp analytics: ", DUMP_PREFIX_OFFSET,
+			       32, 1, event, len, true);
+	}
+	*(__le32 *)out = 0;
+	return true;
+}
+
 static const iomfb_cb_handler cb_handlers[IOMFB_MAX_CB] = {
 	[0] = dcpep_cb_d000_h17p,
 	[1] = trampoline_true,
@@ -362,7 +390,7 @@ static const iomfb_cb_handler cb_handlers[IOMFB_MAX_CB] = {
 	[110] = trampoline_true,
 	[111] = trampoline_create_backlight_service,
 	[112] = trampoline_true,
-	[113] = trampoline_zero,
+	[113] = dcpep_cb_core_analytics_v27,
 	[116] = trampoline_nop,
 	[117] = trampoline_zero,
 	[118] = trampoline_zero,
-- 
2.56.0

