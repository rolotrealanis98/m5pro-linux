From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jeff Queisser <funkzy@users.noreply.github.com>
Date: Thu, 5 Nov 2026 09:19:13 -0800
Subject: [PATCH 07/12] drm/apple: Fix garbled display output with firmware 27

On the M5 Ultra Mac Studio (J775D), with display firmware 27, the screen
showed a stable but garbled image of thin vertical stripes: the firmware
read each surface's element size as 1 byte where XRGB8888 is 4. The
picture is now correct.

The DCP reads a surface's pix_size and each plane's tile_size as bytes
per element. Linear planes sent 1 (block width times height) and the DFB
sent 1, where XRGB8888 is 4 and the DFB's own format says 4 or 8.
has_compr_info is a presence flag, set only when compression_info
describes a compressed (Interchange) plane, and was 1 for linear
surfaces too.

On firmware 27 (DCP_FIRMWARE_V_27_0), send bytes per element, the
element's width and height in pixels, and has_compr_info only for
Interchange planes. The DFB's format and bytes per element now come
from one helper, apple_dcp_dfb_format(), which its allocation also
uses. Earlier firmware keeps the values it has run with: before
widening this, check a linear XRGB8888 and an NV12 swap on 12.x to
26.x firmware.

Signed-off-by: Jeff Queisser <funkzy@users.noreply.github.com>

(cherry picked from commit 59cb5ce253f7f3bdd92ba3aba966a87b03c31431)
---
 drivers/gpu/drm/apple/dcp-internal.h   | 15 ++++++++
 drivers/gpu/drm/apple/iomfb-dfb.h      | 49 +++++++++++++++++---------
 drivers/gpu/drm/apple/iomfb_template.c |  7 ++--
 drivers/gpu/drm/apple/plane.c          | 31 +++++++++++++---
 4 files changed, 80 insertions(+), 22 deletions(-)

diff --git a/drivers/gpu/drm/apple/dcp-internal.h b/drivers/gpu/drm/apple/dcp-internal.h
index b156e500f0a4..aaef876df231 100644
--- a/drivers/gpu/drm/apple/dcp-internal.h
+++ b/drivers/gpu/drm/apple/dcp-internal.h
@@ -1068,6 +1068,21 @@ static inline bool dcp_ext_dptx_607(const struct apple_dcp *dcp)
 	       dcp->hw.fw_14_7_endpoints;
 }
 
+/*
+ * Whether this DCP reads a surface's element geometry as the surface record
+ * defines it: bytes per element (pix_size, a linear plane's tile_size), the
+ * element's width and height in pixels, and compression information only for
+ * a compressed plane. Only firmware 27 (DCP_FIRMWARE_V_27_0, which only
+ * T6050's DCP hw data selects) is tested with it. Earlier firmware keeps the
+ * fixed 1/1/1 and has_compr_info 1 it has run on: before widening this,
+ * check a linear XRGB8888 and an NV12 swap, and the default framebuffer, on
+ * 12.x-26.x firmware.
+ */
+static inline bool dcp_surface_element_geometry(const struct apple_dcp *dcp)
+{
+	return dcp->fw_compat == DCP_FIRMWARE_V_27_0;
+}
+
 #define DCP_AUDIO_MAX_CHANS 15
 
 void dcp_trace_panel_property(struct apple_dcp *dcp, int tag, const char *key,
diff --git a/drivers/gpu/drm/apple/iomfb-dfb.h b/drivers/gpu/drm/apple/iomfb-dfb.h
index 30e84ab8366c..8175cb2d3c92 100644
--- a/drivers/gpu/drm/apple/iomfb-dfb.h
+++ b/drivers/gpu/drm/apple/iomfb-dfb.h
@@ -54,39 +54,56 @@ static inline u64 apple_dcp_dfb_plane_size(u32 width, u32 height, u32 bpe,
 	return data + ALIGN(2 * roundup_pow_of_two(cols) * roundup_pow_of_two(rows), 128);
 }
 
-static inline int apple_dcp_dfb_allocation(u32 width, u32 height, u32 format,
-					 u32 compression, u64 region_size,
-					 u32 *surface_format, u32 *allocation)
+/*
+ * The DFB's surface format and bytes per element (the surface record's pix_size)
+ * for the firmware's format and compression; *alpha_plane for a separate alpha plane.
+ */
+static inline int apple_dcp_dfb_format(u32 format, u32 compression,
+				       u32 *surface_format, u32 *bpe,
+				       bool *alpha_plane)
 {
-	u32 bpe;
-	u64 size;
-	bool alpha_plane = false;
-
-	if (!width || !height || width > 16384 || height > 16384 || !region_size)
-		return -EINVAL;
-	if (compression != 0 && compression != 2 && compression != 3)
-		return -EOPNOTSUPP;
+	*alpha_plane = false;
 	switch (format) {
 	case 0x62336138:
 		if (compression == 2) {
 			format = 0x77343061;
-			bpe = 8;
+			*bpe = 8;
 		} else {
-			bpe = 4;
-			alpha_plane = true;
+			*bpe = 4;
+			*alpha_plane = true;
 		}
 		break;
 	case 0x77343061:
-		bpe = 8;
+		*bpe = 8;
 		break;
 	case 0x42475241:
 	case 0x77333072:
 	case 0x6c313072:
-		bpe = 4;
+		*bpe = 4;
 		break;
 	default:
 		return -EOPNOTSUPP;
 	}
+	*surface_format = format;
+	return 0;
+}
+
+static inline int apple_dcp_dfb_allocation(u32 width, u32 height, u32 format,
+					 u32 compression, u64 region_size,
+					 u32 *surface_format, u32 *allocation)
+{
+	u32 bpe;
+	u64 size;
+	bool alpha_plane;
+	int ret;
+
+	if (!width || !height || width > 16384 || height > 16384 || !region_size)
+		return -EINVAL;
+	if (compression != 0 && compression != 2 && compression != 3)
+		return -EOPNOTSUPP;
+	ret = apple_dcp_dfb_format(format, compression, &format, &bpe, &alpha_plane);
+	if (ret)
+		return ret;
 	size = apple_dcp_dfb_plane_size(width, height, bpe, compression);
 	if (alpha_plane)
 		size += apple_dcp_dfb_plane_size(width, height, 1, compression);
diff --git a/drivers/gpu/drm/apple/iomfb_template.c b/drivers/gpu/drm/apple/iomfb_template.c
index 891ad15d2364..165d864ff330 100644
--- a/drivers/gpu/drm/apple/iomfb_template.c
+++ b/drivers/gpu/drm/apple/iomfb_template.c
@@ -827,7 +827,8 @@ static bool iomfbep_cb_create_dfb_surface(struct apple_dcp *dcp, int tag,
 	{
 		struct dcp_dfb_dimensions_h17p dim;
 		struct dcp_surface *surface = (void *)req->surface;
-		u32 format, allocation;
+		u32 format, allocation, bpe;
+		bool alpha_plane;
 		int ret = -EINVAL;
 
 		memcpy(&dim, in, sizeof(dim));
@@ -844,9 +845,11 @@ static bool iomfbep_cb_create_dfb_surface(struct apple_dcp *dcp, int tag,
 			return true;
 		}
 
+		apple_dcp_dfb_format(dcp->dfb_format, dcp->dfb_compression,
+				     &format, &bpe, &alpha_plane);
 		surface->is_premultiplied = 1;
 		surface->format = format;
-		surface->pix_size = 1;
+		surface->pix_size = dcp_surface_element_geometry(dcp) ? bpe : 1;
 		surface->pel_w = 1;
 		surface->pel_h = 1;
 		surface->buf_size = allocation;
diff --git a/drivers/gpu/drm/apple/plane.c b/drivers/gpu/drm/apple/plane.c
index a8c37e29ed65..bf25e66a9322 100644
--- a/drivers/gpu/drm/apple/plane.c
+++ b/drivers/gpu/drm/apple/plane.c
@@ -145,8 +145,16 @@ static int apple_get_ix_layout(u32 width, u32 height,
 	return 0;
 }
 
+static bool apple_plane_element_geometry(struct drm_crtc *crtc)
+{
+	struct apple_dcp *dcp = platform_get_drvdata(to_apple_crtc(crtc)->dcp);
+
+	return dcp_surface_element_geometry(dcp);
+}
+
 /* Use exactly the same geometry for admission and surface construction. */
 static int apple_plane_get_fb_layout(struct drm_framebuffer *fb,
+				     bool element_geometry,
 				     struct apple_plane_layout *planes,
 				     u32 *buf_size)
 {
@@ -195,7 +203,9 @@ static int apple_plane_get_fb_layout(struct drm_framebuffer *fb,
 				return -EINVAL;
 			p->image.tile_w = drm_format_info_block_width(fmt, i);
 			p->image.tile_h = drm_format_info_block_height(fmt, i);
-			p->tile_size = p->image.tile_w * p->image.tile_h;
+			/* tile_size is bytes per element, not pixels. */
+			p->tile_size = element_geometry ? fmt->char_per_block[i] :
+				       p->image.tile_w * p->image.tile_h;
 			p->stride = fb->pitches[i];
 			break;
 		default:
@@ -251,7 +261,9 @@ static int apple_plane_atomic_check(struct drm_plane *plane,
 	if (ret < 0)
 		return ret;
 
-	ret = apple_plane_get_fb_layout(new_plane_state->fb, layouts, &buf_size);
+	ret = apple_plane_get_fb_layout(new_plane_state->fb,
+					apple_plane_element_geometry(new_plane_state->crtc),
+					layouts, &buf_size);
 	if (ret)
 		return ret;
 
@@ -417,8 +429,9 @@ static void apple_plane_atomic_update(struct drm_plane *plane,
 
 	struct drm_framebuffer *fb = base->fb;
 	const struct drm_format_info *fmt = fb->format;
+	bool element_geometry = apple_plane_element_geometry(base->crtc);
 
-	if (WARN_ON_ONCE(apple_plane_get_fb_layout(fb, layouts, &buf_size))) {
+	if (WARN_ON_ONCE(apple_plane_get_fb_layout(fb, element_geometry, layouts, &buf_size))) {
 		memset(&new_state->surf, 0, sizeof(new_state->surf));
 		return;
 	}
@@ -450,7 +463,7 @@ static void apple_plane_atomic_update(struct drm_plane *plane,
 		.surface_id = plane->base.id,
 		.buf_size = buf_size,
 
-		/* Only used for compressed or multiplanar surfaces */
+		/* Only used for compressed or multiplanar surfaces before firmware 27 */
 		.pix_size = 1,
 		.pel_w = 1,
 		.pel_h = 1,
@@ -459,6 +472,16 @@ static void apple_plane_atomic_update(struct drm_plane *plane,
 		.has_compr_info = 1,
 	};
 
+	if (element_geometry) {
+		/* Bytes per element, and the element's width and height in pixels */
+		new_state->surf.pix_size = fmt->char_per_block[0];
+		new_state->surf.pel_w = drm_format_info_block_width(fmt, 0);
+		new_state->surf.pel_h = drm_format_info_block_height(fmt, 0);
+		/* Present only when compression_info describes a compressed plane */
+		new_state->surf.has_compr_info =
+			fb->modifier == DRM_FORMAT_MOD_APPLE_INTERCHANGE;
+	}
+
 	/* Populate plane information for planar formats */
 	struct dcp_surface *surf = &new_state->surf;
 	for (int i = 0; fb->format->num_planes && i < fb->format->num_planes; i++) {
-- 
2.56.0

