From 3e7019dfb7cfa45f7960ccf1c45d5f590365e0c2 Mon Sep 17 00:00:00 2001
From: Rolando Trevino <rolotrealanis@gmail.com>
Date: Sat, 7 Nov 2026 07:05:38 -0500
Subject: [PATCH] pcie: t6050: start ANS for the N1 training's storage checks
 (chosen.m5pro,n1=3|4)

On the J716s A/B boot chain the chainloading stage-1 reads boot.bin from
the ESP and then stops ANS (nvme_shutdown(): RTKit sleep, CPU stop, PMGR
reset). The stage-2 m1n1 therefore finds ANS stopped, and the storage
reference of the port-0 training refuses before any write ("STOP: ANS is
not running (before)": /arm-io/ans reg[0] + 0x44, CPU control RUN bit 4,
reads 0). Linux's nvme-apple restarts the stopped firmware itself.

With chosen.m5pro,n1=3 (=4 with the SMC reset release of =2), stage-2
starts ANS with nvme_init(), reads NVMe block 1 (the GPT header), runs
the =1/=2 training with storage live as designed, then requires the same
storage registers and the same block read again, and stops ANS with
nvme_shutdown(), so Linux gets ANS in the state stage-1 hands over today.
If ANS stays running or storage is in doubt after the training, it
resets the SoC through the watchdog after 15 s instead of booting a
kernel that could not mount its root: iBoot counts the failed boot and
the A/B stage-1 boots its fallback slot.

rtkit_boot()'s HELLO and endpoint-map wait becomes settable; the
training sets 10 s around nvme_init(), as Linux waits for this ANS
(it can take about 3 s to answer after a stop).

=1 and =2 are unchanged.

Signed-off-by: Rolando Trevino <rolotrealanis@gmail.com>
---
 src/kboot_n1.c   | 16 ++++++----
 src/pcie_t6050.c | 80 +++++++++++++++++++++++++++++++++++++++++++++++-
 src/pcie_t6050.h |  3 ++
 src/rtkit.c      | 12 ++++++--
 src/rtkit.h      |  2 ++
 5 files changed, 104 insertions(+), 9 deletions(-)

diff --git a/src/kboot_n1.c b/src/kboot_n1.c
index cfeeb12c..52b94730 100644
--- a/src/kboot_n1.c
+++ b/src/kboot_n1.c
@@ -20,8 +20,10 @@
  *    not up takes an SError.
  * The MAC addresses travel through the wifi0/bluetooth0 aliases (dt_set_mac_addresses()).
  * With chosen.m5pro,n1=1 in the payload variables, apcie0 port 0 is first trained from cold
- * (pcie_t6050.c); =2 also releases the N1's reset through the SMC before the training. Without
- * the variable nothing here trains a link, and a port that is not up stays disabled.
+ * (pcie_t6050.c); =2 also releases the N1's reset through the SMC before the training. =3 and =4
+ * are =1 and =2 with ANS started for the storage checks and stopped again after, for a stage-1 that
+ * leaves ANS stopped. Without the variable nothing here trains a link, and a port that is not up
+ * stays disabled.
  */
 
 #include "kboot_n1.h"
@@ -224,10 +226,12 @@ int kboot_setup_n1(void *dt)
         return -1;
 
     const char *train = kboot_get_chosen("m5pro,n1");
-    if (train && (!strcmp(train, "1") || !strcmp(train, "2"))) {
-        printf("n1: chosen.m5pro,n1=%s: training apcie0 port 0%s\n", train,
-               train[0] == '2' ? " after the SMC reset release" : "");
-        if (pcie_t6050_n1_train(train[0] == '2'))
+    int mode = train && train[0] >= '1' && train[0] <= '4' && !train[1] ? train[0] - '0' : 0;
+    if (mode) {
+        bool smc = mode == 2 || mode == 4;
+        printf("n1: chosen.m5pro,n1=%s: training apcie0 port 0%s%s\n", train,
+               mode >= 3 ? " with ANS started" : "", smc ? " after the SMC reset release" : "");
+        if (mode >= 3 ? pcie_t6050_n1_train_ans(smc) : pcie_t6050_n1_train(smc))
             printf("n1: port 0 training stopped; booting without the N1\n");
         host = fdt_node_offset_by_compatible(dt, -1, "apple,t6050-pcie");
         if (host < 0)
diff --git a/src/pcie_t6050.c b/src/pcie_t6050.c
index b256ef6f..8d0ed957 100644
--- a/src/pcie_t6050.c
+++ b/src/pcie_t6050.c
@@ -18,15 +18,27 @@
  *
  * Only run when the payload sets chosen.m5pro,n1=1 (or =2 with the SMC release): unmeasured on
  * J716s.
+ *
+ * =3 (=4 with the SMC release) is for a boot chain whose chainloading stage-1 reads the ESP and
+ * then stops ANS (nvme_shutdown(): RTKit sleep, CPU stop, PMGR reset), so this stage finds it
+ * stopped and the check above refuses. pcie_t6050_n1_train_ans() starts ANS with nvme_init() and
+ * reads a block, trains as =1/=2 with storage live, then requires the same register state and the
+ * same block, and stops ANS with nvme_shutdown(): Linux gets ANS as stage-1 leaves it today. If
+ * storage is in doubt after the training, Linux could not mount its root, so this resets the SoC
+ * through the watchdog instead: iBoot counts the failed boot, the A/B stage-1 boots its fallback.
  */
 
 #include "pcie_t6050.h"
 #include "adt.h"
+#include "malloc.h"
+#include "nvme.h"
 #include "pmgr.h"
+#include "rtkit.h"
 #include "smc.h"
 #include "string.h"
 #include "tunables.h"
 #include "utils.h"
+#include "wdt.h"
 
 #define T6050_GP_PORTS 4
 
@@ -299,6 +311,7 @@ static const char *const storage_ps[] = {"APCIE_ST0", "APCIE_ST1",     "FAB6_SOC
                                          "ANS",       "APCIE_SYS_ST0", "APCIE_SYS_ST1"};
 static u64 storage_addr[ST_COUNT];
 static u32 storage_ref[ST_COUNT];
+static bool storage_have_ref;
 #define NVME_BOOT_STATUS_OK 0xde71ce55
 
 static int storage_find(void)
@@ -336,8 +349,10 @@ static int storage_check(const char *tag, bool reference)
 
     for (int i = 0; i < ST_COUNT; i++)
         cur[i] = read32(storage_addr[i]);
-    if (reference)
+    if (reference) {
         memcpy(storage_ref, cur, sizeof(cur));
+        storage_have_ref = true;
+    }
     for (int i = 0; i < ST_COUNT && !reference; i++) {
         if (cur[i] == storage_ref[i])
             continue;
@@ -647,3 +662,66 @@ int pcie_t6050_n1_train(bool smc_release)
     state = 0;
     return 0;
 }
+
+#define ANS_RUNNING() (read32(storage_addr[ST_ANS_CTRL]) & BIT(4))
+
+/* Storage is in doubt and Linux could not mount its root: reset, so the A/B stage-1 falls back */
+static void __attribute__((noreturn)) storage_lost(const char *why)
+{
+    printf("%sstorage lost (%s): watchdog reset in 15 s, stage-1 then boots its fallback\n",
+           stop_prefix, why);
+    mdelay(15000);
+    wdt_reboot();
+    while (true)
+        ;
+}
+
+int pcie_t6050_n1_train_ans(bool smc_release)
+{
+    const u32 nsid = 1, lba = 1; /* the GPT header of the 4 KiB-block namespace */
+
+    TRY(storage_find());
+    if (ANS_RUNNING()) {
+        printf("pcie-t6050: ANS already running: training as =1/=2\n");
+        return pcie_t6050_n1_train(smc_release);
+    }
+
+    printf("pcie-t6050: ANS stopped (0x%x): starting it\n", read32(storage_addr[ST_ANS_CTRL]));
+    rtkit_set_boot_timeout(10 * USEC_PER_SEC); /* ANS can take ~3 s to answer after a stop */
+    bool up = nvme_init();
+    rtkit_set_boot_timeout(0);
+    if (!up) {
+        if (ANS_RUNNING())
+            storage_lost("nvme_init failed, ANS left running");
+        FAIL("nvme_init failed, ANS stopped as before: not training\n");
+    }
+
+    u8 *blk = memalign(SZ_16K, 2 * SZ_4K);
+    if (!blk || !nvme_read(nsid, lba, blk)) {
+        free(blk);
+        nvme_shutdown();
+        if (ANS_RUNNING())
+            storage_lost("ANS still running after nvme_shutdown");
+        FAIL("NVMe read before the training failed: not training\n");
+    }
+    printf("pcie-t6050: NVMe block %u read (%s)\n", lba,
+           memcmp(blk, "EFI PART", 8) ? "no GPT signature" : "GPT header");
+
+    int ret = pcie_t6050_n1_train(smc_release);
+
+    /* Whatever the outcome: the same storage registers, the same block, read through ANS */
+    if (storage_have_ref && storage_check("after training", false))
+        storage_lost("registers");
+    if (!nvme_read(nsid, lba, blk + SZ_4K))
+        storage_lost("read failed");
+    if (memcmp(blk, blk + SZ_4K, SZ_4K))
+        storage_lost("block differs");
+    free(blk);
+    printf("pcie-t6050: storage after training: NVMe read identical\n");
+
+    nvme_shutdown();
+    if (ANS_RUNNING())
+        storage_lost("ANS still running after nvme_shutdown");
+    printf("pcie-t6050: ANS stopped again for Linux\n");
+    return ret;
+}
diff --git a/src/pcie_t6050.h b/src/pcie_t6050.h
index fc1a95e1..6c15d8e8 100644
--- a/src/pcie_t6050.h
+++ b/src/pcie_t6050.h
@@ -8,4 +8,7 @@
 /* Train T6050 apcie0 port 0 (the N1) from cold; 0 once its link is up, -1 after a stop */
 int pcie_t6050_n1_train(bool smc_release);
 
+/* The same with ANS started for the storage checks and stopped again after (chosen.m5pro,n1=3|4) */
+int pcie_t6050_n1_train_ans(bool smc_release);
+
 #endif
diff --git a/src/rtkit.c b/src/rtkit.c
index aca64d6a..29295733 100644
--- a/src/rtkit.c
+++ b/src/rtkit.c
@@ -493,6 +493,14 @@ bool rtkit_start_ep(rtkit_dev_t *rtk, u8 ep)
     return true;
 }
 
+/* rtkit_boot()'s wait for HELLO and for each endpoint-map message */
+static u64 rtkit_boot_timeout = USEC_PER_SEC;
+
+void rtkit_set_boot_timeout(u64 us)
+{
+    rtkit_boot_timeout = us ? us : USEC_PER_SEC;
+}
+
 bool rtkit_boot(rtkit_dev_t *rtk)
 {
     struct asc_message msg;
@@ -508,7 +516,7 @@ bool rtkit_boot(rtkit_dev_t *rtk)
         return false;
     }
 
-    if (!asc_recv_timeout(rtk->asc, &msg, USEC_PER_SEC)) {
+    if (!asc_recv_timeout(rtk->asc, &msg, rtkit_boot_timeout)) {
         rtkit_printf("did not receive HELLO\n");
         return false;
     }
@@ -555,7 +563,7 @@ bool rtkit_boot(rtkit_dev_t *rtk)
     bool has_oslog = false;
     bool got_epmap = false;
     while (!got_epmap) {
-        if (!asc_recv_timeout(rtk->asc, &msg, USEC_PER_SEC)) {
+        if (!asc_recv_timeout(rtk->asc, &msg, rtkit_boot_timeout)) {
             rtkit_printf("couldn't receive message while waiting for endpoint map\n");
             return false;
         }
diff --git a/src/rtkit.h b/src/rtkit.h
index 9b561fa8..caa05cfa 100644
--- a/src/rtkit.h
+++ b/src/rtkit.h
@@ -30,6 +30,8 @@ void rtkit_free(rtkit_dev_t *rtk);
 
 bool rtkit_start_ep(rtkit_dev_t *rtk, u8 ep);
 bool rtkit_boot(rtkit_dev_t *rtk);
+/* rtkit_boot()'s HELLO and endpoint-map wait in microseconds; 0 restores the 1 s default */
+void rtkit_set_boot_timeout(u64 us);
 
 bool rtkit_can_recv(rtkit_dev_t *rtk);
 
-- 
