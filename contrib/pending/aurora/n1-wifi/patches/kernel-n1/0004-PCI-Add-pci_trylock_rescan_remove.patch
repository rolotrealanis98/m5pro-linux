From 3af164adce50c555f8a9b20e9c1f949a9dfa859d Mon Sep 17 00:00:00 2001
From: Dj <hey@djdev.me>
Date: Mon, 26 Oct 2026 02:34:16 -0400
Subject: [PATCH 04/16] PCI: Add pci_trylock_rescan_remove()

A driver's work item that rescans or resets part of a bus takes the
rescan/remove lock. When the device is being removed, the remover holds
that lock while it cancels the work, so a worker that blocks on the lock
deadlocks against its own cancellation.

Add pci_trylock_rescan_remove(), which takes the rescan/remove lock only
if it is free. A worker that cannot get it returns and retries later,
and the remover's cancellation completes.

Signed-off-by: Dj <hey@djdev.me>
Signed-off-by: Erik Bourget <erik@ebourget.net>
(cherry picked from commit 92841e50ceef76b6e2c2a32cb81d352f4c14f24f)
---
 drivers/pci/probe.c | 7 +++++++
 include/linux/pci.h | 1 +
 2 files changed, 8 insertions(+)

diff --git a/drivers/pci/probe.c b/drivers/pci/probe.c
index 27008e2ea5af..d625dd5e778a 100644
--- a/drivers/pci/probe.c
+++ b/drivers/pci/probe.c
@@ -3517,6 +3517,13 @@ void pci_lock_rescan_remove(void)
 }
 EXPORT_SYMBOL_GPL(pci_lock_rescan_remove);
 
+/* Work cancelled by removal must not wait on the remover's own lock. */
+bool pci_trylock_rescan_remove(void)
+{
+	return mutex_trylock(&pci_rescan_remove_lock);
+}
+EXPORT_SYMBOL_GPL(pci_trylock_rescan_remove);
+
 void pci_unlock_rescan_remove(void)
 {
 	mutex_unlock(&pci_rescan_remove_lock);
diff --git a/include/linux/pci.h b/include/linux/pci.h
index 5cec6d838b3f..c0d76d93a78f 100644
--- a/include/linux/pci.h
+++ b/include/linux/pci.h
@@ -1559,6 +1559,7 @@ void set_pcie_hotplug_bridge(struct pci_dev *pdev);
 /* Functions for PCI Hotplug drivers to use */
 unsigned int pci_rescan_bus(struct pci_bus *bus);
 void pci_lock_rescan_remove(void);
+bool pci_trylock_rescan_remove(void);
 void pci_unlock_rescan_remove(void);
 
 /* Vital Product Data routines */
