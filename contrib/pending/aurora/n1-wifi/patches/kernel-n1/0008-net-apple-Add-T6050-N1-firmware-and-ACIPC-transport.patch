-		return ret;
-	bt->bar = pcim_iomap_table(pdev)[0];
-	if (readl(bt->bar + 0x18) != 2 || readl(bt->bar) != 0)
-		return dev_err_probe(&pdev->dev, -EBUSY,
-				     "Beta requires running firmware and unowned IPC (exec=%u ipc=%u)\n",
-				     readl(bt->bar + 0x18), readl(bt->bar));
