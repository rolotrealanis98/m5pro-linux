-	update(phy, 0, 0, BIT(31));
-	update(port, 0x80, 0, 1);
-	for (i = 0; i < 2000; i++) {
-		pci_read_config_dword(bridge, 0x728, &value);
-		if ((value & 0x3f) == 0x11)
-			break;
-		usleep_range(1000, 1200);
-	}
-	if (i == 2000)
-		goto timed_out;
-	msleep(100);
-	pci_restore_state(bridge);
-	/* Bus numbers/windows now restored; endpoint config may be read again. */
-	pci_read_config_dword(pdev, PCI_VENDOR_ID, &identity);
-	if (identity != 0x1901106b && identity != 0x1900106b) {
-		ret = -ENODEV;
-		goto out;
-	}
-	pci_restore_state(pdev);
-	if (pm) {
-		pci_write_config_word(pdev, pm + PCI_PM_CTRL, 0);
-		msleep(10);
-	}
-	dev_info(&pdev->dev, "port transition complete: endpoint=%#x LTSSM=%#x\n",
-		 identity, value & 0x3f);
-	ret = 0;
-	goto out;
-timed_out:
-	ret = -ETIMEDOUT;
-out:
-	if (saved) {
-		if (board->keep_port_tables)
-			for (i = 0; i < ARRAY_SIZE(rid2sid); i++) {
-				writel(rid2sid[i], port + 0x3000 + 4 * i);
-				valid += !!(rid2sid[i] & BIT(31));
-			}
-		for (i = 0; i < ARRAY_SIZE(msimap); i++)
-			writel(msimap[i], port + 0x3800 + 4 * i);
-		writel(msiaddr, port + 0x16c);
-		writel(msicfg, port + 0x124);
-		dev_info(&pdev->dev, "restored %u RID2SID entries and the MSI setup %#x/%#x (ret %d)\n",
-			 valid, msicfg, msiaddr, ret);
-	}
-	if (pad)
-		iounmap(pad);
-	if (phy)
-		iounmap(phy);
-	if (port)
-		iounmap(port);
-	return ret;
-}
