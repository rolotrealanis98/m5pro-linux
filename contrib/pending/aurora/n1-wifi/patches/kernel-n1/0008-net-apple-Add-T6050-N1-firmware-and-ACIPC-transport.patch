-static int cen_hci_flush(struct hci_dev *hdev)
-{
-	struct cen_bt *bt = hci_get_drvdata(hdev);
-
-	skb_queue_purge(&bt->txq);
-	skb_queue_purge(&bt->acl_txq);
-	skb_queue_purge(&bt->le_txq);
-	return 0;
-}
