-{
-	struct centauri_wifi *wifi = READ_ONCE(c->wifi);
-
-	if (wifi && READ_ONCE(wifi->connected) && !READ_ONCE(wifi->stopping))
-		mod_delayed_work(system_wq, &wifi->link_work, 0);
