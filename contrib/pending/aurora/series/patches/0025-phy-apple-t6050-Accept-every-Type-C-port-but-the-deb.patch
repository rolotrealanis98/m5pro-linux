From 0f9fd9812fafad08c3bc78251061a826b2736af2 Mon Sep 17 00:00:00 2001
From: Jeff Queisser <funkzy@users.noreply.github.com>
Date: Tue, 3 Nov 2026 01:50:54 -0800
Subject: [PATCH 25/58] phy: apple: t6050: Accept every Type-C port but the
 debug port

The combo PHY refused any apple,port-index other than 1 or 2, the two ports a
guest description produced. Nothing else in the driver reads the index: the
firmware buffer, banks and sequences are port-agnostic. Validate it against
the board's port set instead: 1 to 5, with 0 (the port that carries the boot
loader's debug link) still excluded, here and in the binding.

Signed-off-by: Jeff Queisser <funkzy@users.noreply.github.com>
Signed-off-by: Erik Bourget <erik@ebourget.net>
---
 Documentation/devicetree/bindings/phy/apple,t6050-dp-phy.yaml | 4 ++--
 drivers/phy/apple/atc-t6050-dp.c                              | 3 ++-
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/Documentation/devicetree/bindings/phy/apple,t6050-dp-phy.yaml b/Documentation/devicetree/bindings/phy/apple,t6050-dp-phy.yaml
index fdc2e6046170..8cbfe94b62ec 100644
--- a/Documentation/devicetree/bindings/phy/apple,t6050-dp-phy.yaml
+++ b/Documentation/devicetree/bindings/phy/apple,t6050-dp-phy.yaml
@@ -38,8 +38,8 @@ properties:
 
   apple,port-index:
     $ref: /schemas/types.yaml#/definitions/uint32
-    enum: [1, 2]
-    description: Native Type-C port; the debug/proxy port is excluded
+    enum: [1, 2, 3, 4, 5]
+    description: Type-C port; the debug port (0) is excluded
 
   apple,guest-port-reserved:
     type: boolean
diff --git a/drivers/phy/apple/atc-t6050-dp.c b/drivers/phy/apple/atc-t6050-dp.c
index 447915391948..01c666bb9e7d 100644
--- a/drivers/phy/apple/atc-t6050-dp.c
+++ b/drivers/phy/apple/atc-t6050-dp.c
@@ -623,8 +623,9 @@ static int t6050_dp_probe(struct platform_device *pdev)
 	dp->combo = of_device_is_compatible(dev->of_node, "apple,t6050-combo-phy");
 	if (dp->combo) {
 		u32 port;
+		/* Every Type-C port but 0, the debug port that carries the boot link. */
 		if (of_property_read_u32(dev->of_node, "apple,port-index", &port) ||
-		    (port != 1 && port != 2) ||
+		    port < 1 || port > 5 ||
 		    !of_property_present(dev->of_node, "apple,guest-port-reserved") ||
 		    !of_property_present(dev->of_node, "mode-switch"))
 			return -EINVAL;
