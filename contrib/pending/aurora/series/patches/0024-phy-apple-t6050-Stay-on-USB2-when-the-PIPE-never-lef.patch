From 1b0edc86c5f756746270b881d85c6ecdb4c437a0 Mon Sep 17 00:00:00 2001
From: Jeff Queisser <funkzy@users.noreply.github.com>
Date: Wed, 4 Nov 2026 11:59:40 -0800
Subject: [PATCH 24/58] phy: apple: t6050: Stay on USB2 when the PIPE never
 left the dummy

A USB3 PIPE switch can fail before the mux moves, with the PIPE still on
its dummy producer. The PHY then faulted and lost USB2 with it.

Leave the port on USB2 in that case, as four DisplayPort lanes do.

Signed-off-by: Jeff Queisser <funkzy@users.noreply.github.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Erik Bourget <erik@ebourget.net>
---
 drivers/phy/apple/atc-t6050-combo.h | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/drivers/phy/apple/atc-t6050-combo.h b/drivers/phy/apple/atc-t6050-combo.h
index 6a9d97d233dc..d4aa80de61ac 100644
--- a/drivers/phy/apple/atc-t6050-combo.h
+++ b/drivers/phy/apple/atc-t6050-combo.h
@@ -277,6 +277,11 @@ static int combo_usb3_mode(struct phy *phy, enum phy_mode mode, int submode)
 		return (readl(dp->banks[44] + 0xc) & 0x73) == 0x10 ? 0 : -EIO;
 	apple_tunable_apply(dp->banks[44], dp->pipe_default);
 	ret = apple_t6050_usb3_pipe_switch(&dp->usb_io);
+	if (ret >= -6 && ret < 0 && (readl(dp->banks[44] + 0xc) & 0x73) == 0x42) {
+		/* The PIPE never left its dummy producer: the port stays USB2, as with four DP lanes. */
+		dev_warn(dp->dev, "USB3 PIPE switch failed (%d), the port runs USB2 only\n", ret);
+		return 0;
+	}
 	if (ret)
 		combo_pipe_fault(dp, "USB3 PIPE switch", ret);
 	else
