+++ b/Documentation/devicetree/bindings/usb/apple,dwc3.yaml
@@ -24,6 +24,23 @@ allOf:
     then:
       required:
         - power-domains
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: apple,t6050-dwc3
+    then:
