+          minItems: 3
+        reg-names:
+          minItems: 3
+    else:
+      properties:
+        reg:
+          maxItems: 3
+        reg-names:
+          maxItems: 3
 
 $defs:
   apple,tunable:
@@ -37,7 +54,7 @@ $defs:
         - description: Bits to be set after applying the mask
     description: >
       Controller table from the device's Apple device tree, applied after
-      every core reset (T6040).
+      every core reset (T6040, T6050).
 
 properties:
   compatible:
@@ -49,6 +66,7 @@ properties:
               - apple,t6030-dwc3
               - apple,t6031-dwc3
               - apple,t6040-dwc3
+              - apple,t6050-dwc3
               - apple,t8112-dwc3
               - apple,t8122-dwc3
               - apple,t8140-dwc3
@@ -62,7 +80,9 @@ properties:
     items:
       - description: Core DWC3 region
       - description: Apple-specific DWC3 region
-      - description: Controller configuration block (T6040)
+      - description: Controller configuration block (T6040, T6050)
+      - description: Bulk fabric block (T6050)
+      - description: AUSBC debug block (T6050)
 
   reg-names:
     minItems: 2
@@ -70,6 +90,8 @@ properties:
       - const: dwc3-core
       - const: dwc3-apple
       - const: drd-cfg
+      - const: drd-bulk
+      - const: drd-ausbc
 
   interrupts:
     maxItems: 1
@@ -103,6 +125,20 @@ properties:
     $ref: "#/$defs/apple,tunable"
     description: Tunables applied to the link registers of the Apple region.
 
+  apple,tunable-cio:
+    $ref: "#/$defs/apple,tunable"
+    description:
+      Tunables applied to the CIO registers of the Apple region, from offset
+      0x20 of that region, after the driver's fixed CIO values.
+
+  apple,tunable-bulk:
+    $ref: "#/$defs/apple,tunable"
