From 30f1d215e709569fd37bed2a890f8cb55069c8f5 Mon Sep 17 00:00:00 2001
From: rolotrealanis98 <122947376+rolotrealanis98@users.noreply.github.com>
Date: Fri, 6 Nov 2026 18:48:35 -0500
Subject: [PATCH 48/58] power: supply: macsmc-power: initialise work items
 before the notifier

Probe initialises critical_work twice: once before devm_work_autocancel()
(which initialises it itself) and again, together with dbg_log_work,
after blocking_notifier_chain_register(). An SMC critical-battery event
arriving between the two would have its queued work re-initialised under
the workqueue, corrupting it. Initialise both before the notifier is
registered and drop the later INIT_WORK()/INIT_DELAYED_WORK().

Port of m5pro-linux integration patch 0004 to the Aurora driver.

Assisted-by: LLM
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/power/supply/macsmc-power.c | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/drivers/power/supply/macsmc-power.c b/drivers/power/supply/macsmc-power.c
index 1bc23703654a..26580a8eb63a 100644
--- a/drivers/power/supply/macsmc-power.c
+++ b/drivers/power/supply/macsmc-power.c
@@ -990,11 +990,18 @@ static int macsmc_power_probe(struct platform_device *pdev)
 		return ret;
 	dev_set_drvdata(dev, power);
 
-	INIT_WORK(&power->critical_work, macsmc_power_critical_work);
+	/* devm_work_autocancel() initialises critical_work */
 	ret = devm_work_autocancel(dev, &power->critical_work, macsmc_power_critical_work);
 	if (ret)
 		return ret;
 
+	/*
+	 * Must be ready before the notifier is registered below: an SMC event
+	 * can arrive as soon as it is, and re-initialising a work item that
+	 * is already queued corrupts the workqueue.
+	 */
+	INIT_DELAYED_WORK(&power->dbg_log_work, macsmc_dbg_work);
+
 	/*
 	 * Check for battery presence.
 	 * B0AV is a fundamental key.
@@ -1189,9 +1196,6 @@ static int macsmc_power_probe(struct platform_device *pdev)
 	power->nb.notifier_call = macsmc_power_event;
 	blocking_notifier_chain_register(&smc->event_handlers, &power->nb);
 
-	INIT_WORK(&power->critical_work, macsmc_power_critical_work);
-	INIT_DELAYED_WORK(&power->dbg_log_work, macsmc_dbg_work);
-
 	g_power = power;
 
 	if (log_power)
