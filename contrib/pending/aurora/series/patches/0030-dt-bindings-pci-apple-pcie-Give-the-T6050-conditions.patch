From 4cba8e071f909af71dbd69def78d4ba3ec100234 Mon Sep 17 00:00:00 2001
From: Jeff Queisser <funkzy@users.noreply.github.com>
Date: Mon, 2 Nov 2026 20:50:35 -0800
Subject: [PATCH 30/58] dt-bindings: pci: apple,pcie: Give the T6050 conditions
 a then branch

The two non-T6050 defaults added for the T6050 hosts (the fixed reg-names
list with at most 10 regions, and reset-gpios on every root port) were
written as an if with only an else. dtschema's meta-schema requires a
then wherever there is an if, so dt_binding_check reports "'then' is a
dependency of 'if'" for both. State the same conditions as "not T6050,
then".

No change in what the binding accepts.

Signed-off-by: Jeff Queisser <funkzy@users.noreply.github.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Erik Bourget <erik@ebourget.net>
(cherry picked from commit 11481f95c508b518ce462fec1c9e44f18c62cd16)
---
 .../devicetree/bindings/pci/apple,pcie.yaml        | 14 ++++++++------
 1 file changed, 8 insertions(+), 6 deletions(-)

diff --git a/Documentation/devicetree/bindings/pci/apple,pcie.yaml b/Documentation/devicetree/bindings/pci/apple,pcie.yaml
index d06713e1cb9d..c40714144e01 100644
--- a/Documentation/devicetree/bindings/pci/apple,pcie.yaml
+++ b/Documentation/devicetree/bindings/pci/apple,pcie.yaml
@@ -415,9 +415,10 @@ allOf:
               if:
                 properties:
                   compatible:
-                    contains:
-                      const: apple,t6050-pcie
-              else:
+                    not:
+                      contains:
+                        const: apple,t6050-pcie
+              then:
                 properties:
                   reg:
                     maxItems: 10
@@ -437,9 +438,10 @@ allOf:
         - if:
             properties:
               compatible:
-                contains:
-                  const: apple,t6050-pcie
-          else:
+                not:
+                  contains:
+                    const: apple,t6050-pcie
+          then:
             patternProperties:
               "^pci@":
                 required:
