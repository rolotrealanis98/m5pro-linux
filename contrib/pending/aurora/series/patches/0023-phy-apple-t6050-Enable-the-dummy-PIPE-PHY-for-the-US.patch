From 519492d56b32fe2df58717453395ed920d00a5b7 Mon Sep 17 00:00:00 2001
From: Jeff Queisser <funkzy@users.noreply.github.com>
Date: Wed, 4 Nov 2026 11:59:40 -0800
Subject: [PATCH 23/58] phy: apple: t6050: Enable the dummy PIPE PHY for the
 USB3 lock

The PIPE lock that starts the USB3 handoff is acknowledged only while
the combo PHY's dummy PIPE PHY is enabled (pipehandler
NONSELECTED_OVERRIDE bit 15), as on the earlier ATC PHYs (T8122,
T8140), and the bit resets to clear with the controller's domain.
Without it the lock timed out, the PHY faulted and rear port 2 had no
USB at all.

Enable it before the controller leaves reset. Each PIPE-switch step
returns its own code, and every fault of the PHY is logged with its
reason (the pipehandler registers for PIPE faults); dwc3-apple logs a
fatal USB3 PHY failure.

Signed-off-by: Jeff Queisser <funkzy@users.noreply.github.com>
Signed-off-by: Erik Bourget <erik@ebourget.net>
---
 drivers/phy/apple/atc-t6050-combo.h           | 37 ++++++++++++++++---
 .../apple/usb-t6050/apple_t6050_usb3_pipe.h   | 19 +++++++---
 drivers/usb/dwc3/dwc3-apple.c                 |  4 +-
 3 files changed, 48 insertions(+), 12 deletions(-)

diff --git a/drivers/phy/apple/atc-t6050-combo.h b/drivers/phy/apple/atc-t6050-combo.h
index 3c3454ceb64d..6a9d97d233dc 100644
--- a/drivers/phy/apple/atc-t6050-combo.h
+++ b/drivers/phy/apple/atc-t6050-combo.h
@@ -79,6 +79,17 @@ static int combo_quiesce(void *ctx)
 	return ret;
 }
 
+/* The pipehandler bank is the controller's: read it only while the controller holds its domain. */
+static void combo_pipe_fault(struct t6050_dp *dp, const char *what, int ret)
+{
+	dev_err(dp->dev, "%s failed (%d): pipe 00=%08x 04=%08x 0c=%08x 10=%08x 14=%08x 1c=%08x 20=%08x\n",
+		what, ret, readl(dp->banks[44]), readl(dp->banks[44] + 0x4),
+		readl(dp->banks[44] + 0xc), readl(dp->banks[44] + 0x10),
+		readl(dp->banks[44] + 0x14), readl(dp->banks[44] + 0x1c),
+		readl(dp->banks[44] + 0x20));
+	dp->faulted = true;
+}
+
 static int combo_stop(struct t6050_dp *dp)
 {
 	int ret;
@@ -101,6 +112,7 @@ static int combo_stop(struct t6050_dp *dp)
 	if (!ret)
 		ret = atc_domain_set(&dp->domain[0], false);
 	if (ret) {
+		dev_err(dp->dev, "stop failed (%d)\n", ret);
 		dp->faulted = true;
 		return ret < 0 ? ret : -EIO;
 	}
@@ -142,6 +154,7 @@ static int combo_start(struct t6050_dp *dp, enum combo_mode mode)
 	}
 	if (ret) {
 		/* A partial shared transition has no cold-start ownership proof. */
+		dev_err(dp->dev, "start of mode %d failed (%d)\n", mode, ret);
 		dp->faulted = true;
 		return ret < 0 ? ret : -EIO;
 	}
@@ -217,10 +230,12 @@ static int combo_usb2_mode(struct phy *phy, enum phy_mode mode, int submode)
 	if (dp->usb2_active)
 		return 0;
 	ret = APPLE_T6050_USB_RUN(&dp->usb_platform, apple_t6050_usb2_host);
-	if (ret)
+	if (ret) {
+		dev_err(dp->dev, "USB2 host start failed (%d)\n", ret);
 		dp->faulted = true;
-	else
+	} else {
 		dp->usb2_active = true;
+	}
 	return ret;
 }
 
@@ -233,8 +248,10 @@ static int combo_usb2_reset(struct phy *phy)
 	if (dp->faulted || !dp->usb2_active)
 		return -ENOLINK;
 	ret = apple_t6050_usb2_port_reset(&dp->usb_io, dp, combo_sleep);
-	if (ret)
+	if (ret) {
+		dev_err(dp->dev, "USB2 port reset failed (%d)\n", ret);
 		dp->faulted = true;
+	}
 	return ret ? -EIO : 0;
 }
 
@@ -261,7 +278,7 @@ static int combo_usb3_mode(struct phy *phy, enum phy_mode mode, int submode)
 	apple_tunable_apply(dp->banks[44], dp->pipe_default);
 	ret = apple_t6050_usb3_pipe_switch(&dp->usb_io);
 	if (ret)
-		dp->faulted = true;
+		combo_pipe_fault(dp, "USB3 PIPE switch", ret);
 	else
 		dp->pipe_active = true;
 	return ret ? -EIO : 0;
@@ -287,8 +304,10 @@ static int combo_usb3_poweroff(struct phy *phy)
 		if (!ret)
 			dp->usb2_active = false;
 	}
-	if (ret)
+	if (ret) {
+		dev_err(dp->dev, "USB3 power-off failed (%d)\n", ret);
 		dp->faulted = true;
+	}
 	return ret ? -EIO : 0;
 }
 static const struct phy_ops combo_usb2_ops = {
@@ -312,7 +331,7 @@ static int combo_reset_assert(struct reset_controller_dev *reset, unsigned long
 	apple_t6050_usb_mask(&dp->usb_io, 44, 0x1c, 0x10, 0x10);
 	ret = apple_t6050_usb3_pipe_cold_dummy(&dp->usb_io);
 	if (ret)
-		dp->faulted = true;
+		combo_pipe_fault(dp, "dummy PIPE park", ret);
 	else
 		dp->controller_active = false;
 	return ret ? -EIO : 0;
@@ -326,6 +345,12 @@ static int combo_reset_deassert(struct reset_controller_dev *reset, unsigned lon
 		return -EINVAL;
 	if (dp->faulted || !dp->usb2_active)
 		return -ENOLINK;
+	/*
+	 * The PIPE lock that starts the USB3 handoff is acknowledged only while the dummy PHY
+	 * behind the mux is enabled (NONSELECTED_OVERRIDE bit 15), as on the earlier ATC PHYs.
+	 * The bit resets to clear with the controller's domain, so set it for every session.
+	 */
+	apple_t6050_usb_mask(&dp->usb_io, 44, 0x20, BIT(15), BIT(15));
 	apple_t6050_usb_mask(&dp->usb_io, 44, 0x1c, 0x10, 0);
 	apple_t6050_usb_mask(&dp->usb_io, 44, 0x1c, 1, 1);
 	dp->controller_active = true;
diff --git a/drivers/phy/apple/usb-t6050/apple_t6050_usb3_pipe.h b/drivers/phy/apple/usb-t6050/apple_t6050_usb3_pipe.h
index 953a42dbc7aa..f70f6f109038 100644
--- a/drivers/phy/apple/usb-t6050/apple_t6050_usb3_pipe.h
+++ b/drivers/phy/apple/usb-t6050/apple_t6050_usb3_pipe.h
@@ -36,6 +36,11 @@ apple_t6050_usb3_pipe_cold_dummy(const struct apple_t6050_usb_io *io)
     return (io->read(io->context, 44, 0x0c) & 0x73) == 0x42 ? 0 : -1;
 }
 
+/*
+ * Returns 0, or the failing step: -2 the PIPE was not parked on a known producer, -3 the lock was
+ * not acknowledged, -4..-6 the BIST, -7 the mux did not read back USB3, -8 the BIST did not stop,
+ * -9 the lock release was not acknowledged. Up to -6 the mux is untouched.
+ */
 static inline int
 apple_t6050_usb3_pipe_switch(const struct apple_t6050_usb_io *io)
 {
@@ -48,22 +53,26 @@ apple_t6050_usb3_pipe_switch(const struct apple_t6050_usb_io *io)
     mux = io->read(io->context, 44, 0x0c) & 0x73;
     /* Never reroute an active USB4 producer or guess an unknown state. */
     if (!(aon & 1) || (mux != 0x42 && mux != 0x10))
-        return -1;
+        return -2;
 
     /* Native T8142 xHCI USB3 mode switch, native27 T6050-compatible path. */
     apple_t6050_usb_mask(io, 44, 0x04, 0x0e, 0);
     apple_t6050_usb_mask(io, 44, 0x00, 1, 1);
     apple_t6050_usb_mask(io, 44, 0x10, 1, 1);
     locked = 1;
+    result = -3;
     if (io->poll(io->context, 44, 0x14, 1, 1, 6000))
         goto out;
 
     bist = 1;
+    result = -4;
     if (apple_t6050_usb_bist_on(io))
         goto out;
     apple_t6050_usb_mask(io, 44, 0x20, 0x100f, 3);
+    result = -5;
     if (io->poll(io->context, 44, 0x20, 0xf, 3, 1000))
         goto out;
+    result = -6;
     if (apple_t6050_usb_bist_off(io))
         goto out;
     bist = 0;
@@ -73,16 +82,16 @@ apple_t6050_usb3_pipe_switch(const struct apple_t6050_usb_io *io)
     io->delay(io->context, 5);
     apple_t6050_usb_mask(io, 44, 0x0c, 0x73, 0);
     apple_t6050_usb_mask(io, 44, 0x0c, 0x73, 0x10);
-    result = (io->read(io->context, 44, 0x0c) & 0x73) == 0x10 ? 0 : -1;
+    result = (io->read(io->context, 44, 0x0c) & 0x73) == 0x10 ? 0 : -7;
 
 out:
     if (bist && apple_t6050_usb_bist_off(io))
-        result = -1;
+        result = -8;
     apple_t6050_usb_mask(io, 44, 0x00, 5, 0);
     if (locked) {
         apple_t6050_usb_mask(io, 44, 0x10, 1, 0);
-        if (io->poll(io->context, 44, 0x14, 1, 0, 6000))
-            result = -1;
+        if (io->poll(io->context, 44, 0x14, 1, 0, 6000) && !result)
+            result = -9;
     }
     return result;
 }
diff --git a/drivers/usb/dwc3/dwc3-apple.c b/drivers/usb/dwc3/dwc3-apple.c
index f9201545ec87..8bf5811b9547 100644
--- a/drivers/usb/dwc3/dwc3-apple.c
+++ b/drivers/usb/dwc3/dwc3-apple.c
@@ -670,8 +670,10 @@ static int dwc3_apple_set_role(struct dwc3_apple *appledwc, enum dwc3_apple_stat
 		 * success, and its errors leave the PIPE without a known producer.
 		 */
 		if (of_device_is_compatible(appledwc->dev->of_node, "apple,t8132-dwc3") ||
-		    of_device_is_compatible(appledwc->dev->of_node, "apple,t6050-dwc3"))
+		    of_device_is_compatible(appledwc->dev->of_node, "apple,t6050-dwc3")) {
+			dev_err(appledwc->dev, "USB3 PHY setup failed, err=%d\n", ret);
 			return ret;
+		}
 		dev_warn(appledwc->dev, "USB3 PHY setup failed, USB2 only, err=%d\n", ret);
 	} else if (host && appledwc->usb3_phy &&
 		   of_device_is_compatible(appledwc->dev->of_node, "apple,t8132-dwc3")) {
