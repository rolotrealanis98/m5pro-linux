@@ -632,7 +638,12 @@ static int command(struct centauri_wifi *wifi, u32 id, const void *payload,
 
 		if (wifi->reply_valid && wifi->reply_sequence == sequence &&
 		    (wifi->reply_command & ~BIT(30)) == id) {
