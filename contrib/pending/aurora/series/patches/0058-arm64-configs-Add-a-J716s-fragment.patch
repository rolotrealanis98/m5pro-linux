From b9cea5ab1b7d418fdea75ee45c27b44eb23f3082 Mon Sep 17 00:00:00 2001
From: Rolando Trevino <rolotrealanis@gmail.com>
Date: Fri, 6 Nov 2026 20:58:53 -0500
Subject: [PATCH] arm64: configs: Add a J716s fragment

The J716s boots with no modules on its root file system, so every
driver on its boot path has to be built in. Add the fragment it is built
with on top of defconfig and asahi.config:

  make ARCH=arm64 LLVM=1 defconfig asahi.config j716s.config

Besides the storage, SMC, HID, Type-C, Wi-Fi and Bluetooth drivers it
turns Rust off (nothing on this machine's path needs it yet), keeps the
MTP haptic driver off so that HID_MAGICMOUSE, which drives the trackpad,
can be built in, and enables Landlock (pacman's download sandbox),
nftables, zram with zstd and /dev/mem for the userspace it runs.

Assisted-by: LLM
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Rolando Trevino <rolotrealanis@gmail.com>
---
 arch/arm64/configs/j716s.config | 74 +++++++++++++++++++++++++++++++++
 1 file changed, 74 insertions(+)
 create mode 100644 arch/arm64/configs/j716s.config

diff --git a/arch/arm64/configs/j716s.config b/arch/arm64/configs/j716s.config
new file mode 100644
index 000000000000..caa69196ae0d
--- /dev/null
+++ b/arch/arm64/configs/j716s.config
@@ -0,0 +1,74 @@
+# MacBook Pro (16-inch, M5 Pro, 2026), J716s: the drivers on its boot path
+# built in (the root file system carries no modules), on top of defconfig
+# and asahi.config:
+#   make ARCH=arm64 LLVM=1 defconfig asahi.config j716s.config
+
+# No Rust: nothing on the T6050 boot path needs it yet
+CONFIG_RUST=n
+CONFIG_DRM_APPLE=n
+
+# Storage: ANS NVMe behind SART, RTKit
+CONFIG_NVME_APPLE=y
+CONFIG_APPLE_SART=y
+CONFIG_APPLE_RTKIT_HELPER=y
+
+# SMC and its consumers
+CONFIG_GPIO_MACSMC=y
+CONFIG_INPUT_MACSMC_INPUT=y
+CONFIG_POWER_RESET_MACSMC=y
+CONFIG_SENSORS_MACSMC_HWMON=y
+CONFIG_MACSMC_POWER=y
+
+# CPU frequency
+CONFIG_ARM_APPLE_SOC_CPUFREQ=y
+
+# Pins (PCIe port 0's PERST#)
+CONFIG_PINCTRL_APPLE_GPIO=y
+
+# Keyboard and trackpad: DockChannel HID. HID_MAGICMOUSE drives the
+# trackpad; the MTP haptic driver would force it to =m, so it stays off
+# (no click haptics).
+CONFIG_APPLE_DOCKCHANNEL=y
+CONFIG_HID_DOCKCHANNEL=y
+CONFIG_HID_APPLE=y
+CONFIG_HID_MAGICMOUSE=y
+CONFIG_HID_APPLE_MTP_HAPTIC=n
+CONFIG_HIDRAW=y
+
+# Keyboard backlight and the backlight class
+CONFIG_PWM_APPLE=y
+CONFIG_BACKLIGHT_CLASS_DEVICE=y
+
+# Type-C: combo PHY, dwc3, the SN201202x PD controller
+CONFIG_TYPEC=y
+CONFIG_TYPEC_TPS6598X=y
+CONFIG_TYPEC_SN201202X=y
+CONFIG_PHY_APPLE_ATC=y
+CONFIG_PHY_APPLE_T6040_USB2=y
+CONFIG_PHY_APPLE_T6050_DP=y
+CONFIG_USB_DWC3_APPLE=y
+CONFIG_USB_UAS=y
+
+# USB network adapters used for bring-up
+CONFIG_USB_USBNET=y
+CONFIG_USB_NET_CDCETHER=y
+CONFIG_USB_NET_CDC_NCM=y
+CONFIG_USB_NET_AX88179_178A=y
+CONFIG_USB_RTL8152=y
+
+# Wi-Fi and Bluetooth: the N1 (centauri) on PCIe port 0
+CONFIG_RFKILL=y
+CONFIG_CFG80211=y
+CONFIG_APPLE_CENTAURI=y
+CONFIG_APPLE_CENTAURI_WIFI=y
+CONFIG_BT=y
+CONFIG_BT_HCICENTAURI=y
+
+# Userspace: pacman's download sandbox, nftables, compressed swap, /dev/mem
+CONFIG_SECURITY_LANDLOCK=y
+CONFIG_NF_TABLES=y
+CONFIG_NFT_COMPAT=m
+CONFIG_ZRAM=y
+CONFIG_ZRAM_BACKEND_ZSTD=y
+CONFIG_ZRAM_DEF_COMP_ZSTD=y
+CONFIG_DEVMEM=y
-- 
