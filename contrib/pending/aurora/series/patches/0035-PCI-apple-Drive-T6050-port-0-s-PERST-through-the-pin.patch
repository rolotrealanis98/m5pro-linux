From 1410826d67dc9ed21d3da619525991592ccec577 Mon Sep 17 00:00:00 2001
From: Jeff Queisser <funkzy@users.noreply.github.com>
Date: Mon, 2 Nov 2026 23:53:26 -0800
Subject: [PATCH 35/58] PCI: apple: Drive T6050 port 0's PERST# through the pin
 controller

The adopted port 0 named its PERST# pad as a 4-byte reg of the host
(perst0, one word inside the pin controller's block) and wrote it raw.
With the pin controller in the device tree the two nodes claim the same
MMIO word, and whichever probes second fails: when pinctrl wins, the
host's port setup stops with -EBUSY and no port is adopted, so the
Ethernet and USB behind ports 2 and 3 are gone with it.

One owner for the pad: the pin controller. The port node carries
reset-gpios, as every other Apple host's port nodes do, and the host
takes the line as the bootloader left it (GPIOD_ASIS: probe never
touches a trained link's reset) and drives it only in the root-port
reset, as a GPIO output at the logical level the reset asks for. The
raw pad write set the same things (function bits cleared, mode output,
the data bit) plus the pad's input enable, which the pin controller
leaves as the bootloader set it. Probe asks for the line before any
port is set up, so a host whose pin controller is not up yet defers
instead of adopting nothing; an adopted port without reset-gpios has no
reset, as before (reset_root_port answers -EOPNOTSUPP). The perst<n>
reg, its binding entry and the raw pad write go; the binding allows
reset-gpios on an adopted port again.

Probe names the port whose line it cannot have, as the probe of the
other hosts' ports does: a line the pin controller reserves
(gpio-reserved-ranges) is refused with -EINVAL, which the host's probe
otherwise returned with no word of which port or property.

Signed-off-by: Jeff Queisser <funkzy@users.noreply.github.com>
Signed-off-by: Erik Bourget <erik@ebourget.net>
(cherry picked from commit a873be047e9a514f8a2e886f5272c570e0dd6516)
---
 .../devicetree/bindings/pci/apple,pcie.yaml   | 15 +++---
 drivers/pci/controller/pcie-apple.c           | 48 +++++++++++--------
 2 files changed, 38 insertions(+), 25 deletions(-)

diff --git a/Documentation/devicetree/bindings/pci/apple,pcie.yaml b/Documentation/devicetree/bindings/pci/apple,pcie.yaml
index 35360ddf2522..d6570e35974a 100644
--- a/Documentation/devicetree/bindings/pci/apple,pcie.yaml
+++ b/Documentation/devicetree/bindings/pci/apple,pcie.yaml
@@ -253,16 +253,15 @@ allOf:
       properties:
         reg:
           minItems: 5
-          maxItems: 18
+          maxItems: 14
         reg-names:
           description:
             config and rc, then port<n>, phy<n> and intr2axi<n> for each
-            bootloader-trained root port 00:<n>.0, and perst<n> (its PERST#
-            pad) for a port whose endpoint needs a root-port reset.
+            bootloader-trained root port 00:<n>.0.
           minItems: 5
-          maxItems: 18
+          maxItems: 14
           items:
-            pattern: "^(config|rc|(port|phy|intr2axi|perst)[0-3])$"
+            pattern: "^(config|rc|(port|phy|intr2axi)[0-3])$"
         interrupts:
           maxItems: 4
         interrupt-names:
@@ -278,7 +277,11 @@ allOf:
       patternProperties:
         "^pci@":
           properties:
-            reset-gpios: false
+            reset-gpios:
+              description:
+                The PERST# line of a port whose endpoint needs a root-port
+                reset after the bootloader trained the link. Left as the
+                bootloader set it until that reset.
             pwren-gpios: false
           required:
             - apple,link-trained-by-bootloader
diff --git a/drivers/pci/controller/pcie-apple.c b/drivers/pci/controller/pcie-apple.c
index 9b70458075f0..a3a6438888f7 100644
--- a/drivers/pci/controller/pcie-apple.c
+++ b/drivers/pci/controller/pcie-apple.c
@@ -472,7 +472,7 @@ struct apple_pcie_port {
 	void __iomem		*intr2axi;	/* adopt_link: this port's */
 	u8			adopted_bus;	/* adopt_link: the secondary bus */
 	unsigned long		adopted_slots;	/* adopt_link: RID2SID slots routed (slot == SID) */
-	void __iomem		*perst;		/* adopt_link: the PERST# pad, for a root-port reset */
+	struct gpio_desc	*perst;		/* adopt_link: its PERST# line, for a root-port reset */
 };
 
 static int apple_pcie_managed_admit(struct apple_pcie_port *port);
@@ -1772,12 +1772,18 @@ static int apple_pcie_adopt_link(struct apple_pcie_port *port)
 	port->intr2axi = devm_platform_ioremap_resource_byname(pdev, name);
 	if (IS_ERR(port->intr2axi))
 		return PTR_ERR(port->intr2axi);
-	/* Only a port whose endpoint needs a root-port reset names its PERST# pad */
-	snprintf(name, sizeof(name), "perst%d", port->idx);
-	if (platform_get_resource_byname(pdev, IORESOURCE_MEM, name)) {
-		port->perst = devm_platform_ioremap_resource_byname(pdev, name);
-		if (IS_ERR(port->perst))
+	/*
+	 * Only a port whose endpoint needs a root-port reset names its PERST# line
+	 * (reset-gpios, on the port node as on every other Apple host). The pin
+	 * controller owns the pad; the line is taken as the bootloader left it,
+	 * released, and driven only by the reset.
+	 */
+	port->perst = devm_fwnode_gpiod_get(pcie->dev, of_fwnode_handle(port->np), "reset",
+					    GPIOD_ASIS, "PERST#");
+	if (IS_ERR(port->perst)) {
+		if (PTR_ERR(port->perst) != -ENOENT)
 			return PTR_ERR(port->perst);
+		port->perst = NULL;
 	}
 
 	/* The currently qualified handoff is Gen3 x1, with no retrain in progress. */
@@ -1935,20 +1941,14 @@ static int apple_pcie_t6050_tune(struct apple_pcie_port *port, struct pci_dev *r
 	return 0;
 }
 
-/* PERST# through its pad: a GPIO output (function bits cleared) at the level asked for */
+/*
+ * PERST# through the pin controller: the pad as a GPIO output (its function bits
+ * cleared, mode output) at the line's logical level, which the DT's
+ * GPIO_ACTIVE_LOW turns into the pad level.
+ */
 static int apple_pcie_t6050_perst(struct apple_pcie_port *port, bool asserted)
 {
-	u32 old, value;
-
-	old = readl(port->perst);
-	if (old & BIT(21))
-		return -EIO;
-	value = (old & ~0x27f) | 0x202 | !asserted;
-	/* The input enable (bit 9) goes on after the rest */
-	writel((value & ~0x200) | (old & 0x200), port->perst);
-	if (!(old & 0x200))
-		writel(value, port->perst);
-	return (readl(port->perst) ^ value) & 0x27f ? -EIO : 0;
+	return gpiod_direction_output(port->perst, asserted);
 }
 
 /* Let the link go idle, hold the endpoint in reset and stop the port and its lane clocks */
@@ -3741,9 +3741,19 @@ static int apple_pcie_probe(struct platform_device *pdev)
 			if (of_property_read_u32(child, "reg", &reg) || reg & ~0xf800 ||
 			    (reg >> 11) > 3 ||
 			    !of_property_read_bool(child, "apple,link-trained-by-bootloader") ||
-			    of_property_present(child, "reset-gpios") ||
 			    of_property_present(child, "pwren-gpios"))
 				return -EINVAL;
+			/*
+			 * A port whose endpoint needs a root-port reset names its PERST#
+			 * line: probe waits for the line's controller before any port is
+			 * touched (a failed adoption would otherwise swallow the deferral).
+			 */
+			if (of_property_present(child, "reset-gpios")) {
+				ret = apple_pcie_probe_port(child);
+				if (ret)
+					return dev_err_probe(dev, ret, "Port %pOF probe fail\n",
+							     child);
+			}
 		}
 	} else if (!hw->tunneled) {
 		/* Check for probe dependencies for all ports first */
