diff --git a/Documentation/devicetree/bindings/phy/apple,t6050-dp-phy.yaml b/Documentation/devicetree/bindings/phy/apple,t6050-dp-phy.yaml
new file mode 100644
index 000000000000..52cb96f4a965
--- /dev/null
+++ b/Documentation/devicetree/bindings/phy/apple,t6050-dp-phy.yaml
@@ -0,0 +1,224 @@
+# SPDX-License-Identifier: GPL-2.0-only
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/phy/apple,t6050-dp-phy.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple T6050 DisplayPort and Type-C combo PHY
+
+maintainers:
+  - Dj <hey@djdev.me>
+
+description: |
+  Fixed four-lane DisplayPort PHY for HDMI bridges, or one shared owner of
+  Type-C USB2, USB3 and DisplayPort alternate mode. DisplayPort supports RBR
+  through HBR3 without spread-spectrum clocking. The combo provider serializes
+  controller shutdown, PIPE handoff, orientation and alternate-mode changes.
+  Register resources, power domains and board tunables come from the producer.
+
+properties:
+  compatible:
+    enum:
+      - apple,t6050-dp-phy
+      - apple,t6050-combo-phy
+
+  reg:
+    minItems: 6
+    maxItems: 11
+
+  reg-names:
+    minItems: 6
+    maxItems: 11
+
+  '#phy-cells':
+    enum: [0, 1]
+
+  '#reset-cells':
+    const: 1
+
+  apple,port-index:
+    enum: [1, 2]
+    description: Native Type-C port; the debug/proxy port is excluded
+
+  apple,guest-port-reserved:
+    type: boolean
+    description: The boot producer has excluded this port from host ownership
+
+  mode-switch: true
+  orientation-switch: true
+
+  mboxes:
+    maxItems: 1
+
+  port:
+    $ref: /schemas/graph.yaml#/properties/port
+
+  apple,tunable-aus40cmn-shm:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description: Offset, mask and value tuples for the common analog bank
+
+  apple,tunable-cio4pll:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description: Offset, mask and value tuples for the CIO PLL bank
+
+  apple,tunable-usb2-default:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description: Offset, mask and value tuples for the USB2 PHY bank
+
+  apple,tunable-usb2-host:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description: Offset, mask and value tuples for the USB2 host bank
+
+  apple,tunable-pipe-default:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description: Offset, mask and value tuples for the PIPE handler
+
+  power-domains:
+    minItems: 3
+    maxItems: 3
+
+  power-domain-names:
+    items:
+      - const: usb-aon
+      - const: common
+      - const: wrapper
+
+  apple,tunable-axi2af:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description: Offset, mask and value tuples within the named bank
+
+  apple,tunable-fabric:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description: Offset, mask and value tuples within the named bank
+
+  apple,tunable-common-cfg:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description: Offset, mask and value tuples within the named bank
+
+  apple,tunable-lioa:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description: Offset, mask and value tuples within the named bank
+
+  apple,tunable-lane0-rx-clock:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description: Offset, mask and value tuples within the named bank
+
+  apple,tunable-lane1-rx-clock:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description: Offset, mask and value tuples within the named bank
+
+  apple,tunable-lane0-rx-eq:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description: Offset, mask and value tuples within the named bank
+
+  apple,tunable-lane1-rx-eq:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description: Offset, mask and value tuples within the named bank
+
+  apple,tunable-auspll:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description: Offset, mask and value tuples within the named bank
+
+patternProperties:
+  '^apple,dp-training-table(-rbr|-hbr|-hbr2|-hbr3)?$':
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    minItems: 16
+    maxItems: 16
+    description: Drive presets indexed by voltage swing times four plus pre-emphasis
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - '#phy-cells'
+  - power-domains
+  - power-domain-names
+  - apple,tunable-axi2af
+  - apple,tunable-fabric
+  - apple,tunable-common-cfg
+  - apple,tunable-lioa
+  - apple,tunable-lane0-rx-clock
+  - apple,tunable-lane1-rx-clock
+  - apple,tunable-lane0-rx-eq
+  - apple,tunable-lane1-rx-eq
+  - apple,tunable-auspll
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          const: apple,t6050-combo-phy
+    then:
+      properties:
+        '#phy-cells':
+          const: 1
+        reg:
+          minItems: 11
+          maxItems: 11
+        reg-names:
+          items:
+            - const: core
+            - const: usb2phy
+            - const: usb2-digital
+            - const: reset
+            - const: fabric
+            - const: axi2af
+            - const: lioa
+            - const: common-cfg
+            - const: usb-control
+            - const: firmware-data
+            - const: pipehandler
+      required:
+        - '#reset-cells'
+        - apple,port-index
+        - apple,guest-port-reserved
+        - mode-switch
+        - orientation-switch
+        - mboxes
+        - apple,tunable-aus40cmn-shm
+        - apple,tunable-cio4pll
+        - apple,tunable-usb2-default
+        - apple,tunable-usb2-host
+        - apple,tunable-pipe-default
+    else:
+      properties:
+        '#phy-cells':
+          const: 0
+      if:
+        required:
+          - mode-switch
+      then:
+        properties:
+          reg:
+            minItems: 8
+            maxItems: 8
+          reg-names:
+            items:
+              - const: core
+              - const: reset
+              - const: fabric
+              - const: axi2af
+              - const: lioa
+              - const: common-cfg
+              - const: usb-control
+              - const: firmware-data
+        required:
+          - orientation-switch
+          - mboxes
+          - apple,tunable-aus40cmn-shm
+          - apple,tunable-cio4pll
+      else:
+        properties:
+          reg:
+            minItems: 6
+            maxItems: 6
+          reg-names:
+            items:
+              - const: core
+              - const: reset
+              - const: fabric
+              - const: axi2af
+              - const: lioa
+              - const: common-cfg
+
+additionalProperties: false
diff --git a/drivers/phy/apple/Kconfig b/drivers/phy/apple/Kconfig
index 5348987cf1dc..36ed85b7935f 100644
--- a/drivers/phy/apple/Kconfig
+++ b/drivers/phy/apple/Kconfig
@@ -62,3 +62,16 @@ config PHY_APPLE_DPTX
 	  such as the M2.
 	  This driver provides support for DisplayPort and is used on the
 	  Mac mini (M2 and M2 Pro, 2023).
+
+config PHY_APPLE_T6050_DP
+	tristate "Apple T6050 DisplayPort and Type-C combo PHY"
+	depends on ARCH_APPLE || COMPILE_TEST
+	depends on OF && PM && TYPEC
+	select GENERIC_PHY
+	select APPLE_TUNABLE
+	select APPLE_RTKIT
+	select RESET_CONTROLLER
+	help
+	  Fixed HDMI bridges and Type-C USB host/DisplayPort alternate mode.
+	  One owner coordinates the shared PHY, firmware, PIPE and USB2 state.
+	  Requires named register banks, power domains and firmware tunables.
diff --git a/drivers/phy/apple/Makefile b/drivers/phy/apple/Makefile
index e7156408e792..e0b94bb1dcaa 100644
--- a/drivers/phy/apple/Makefile
+++ b/drivers/phy/apple/Makefile
@@ -8,3 +8,5 @@ phy-apple-t6040-usb2-y			:= t6040-usb2.o
 
 obj-$(CONFIG_PHY_APPLE_DPTX)	+= phy-apple-dptx.o
 phy-apple-dptx-y		+= dptx.o
+
+obj-$(CONFIG_PHY_APPLE_T6050_DP) += atc-t6050-dp.o
diff --git a/drivers/phy/apple/atc-t6050-combo.h b/drivers/phy/apple/atc-t6050-combo.h
new file mode 100644
index 000000000000..1066748dc1af
--- /dev/null
+++ b/drivers/phy/apple/atc-t6050-combo.h
@@ -0,0 +1,394 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* One Type-C owner reuses the established DP and USB backend sequences.
+ * All calls below hold dp->lock; only PHY power_off authorizes PIPE teardown
+ * while the controller reset is deasserted. Lane changes require reset/off.
+ */
+static u32 combo_read(void *ctx, unsigned int bank, unsigned int offset)
+{
+	struct t6050_dp *dp = ctx;
+	return readl(dp->banks[bank] + offset);
+}
+static void combo_write(void *ctx, unsigned int bank, unsigned int offset, u32 value)
+{
+	struct t6050_dp *dp = ctx;
+	writel(value, dp->banks[bank] + offset);
+}
+static int combo_poll(void *ctx, unsigned int bank, unsigned int offset,
+		      unsigned int mask, unsigned int expected, unsigned int usec)
+{
+	struct t6050_dp *dp = ctx;
+	u32 value;
+	return readl_poll_timeout(dp->banks[bank] + offset, value,
+		(value & mask) == expected,
+		(bank == 44 || bank == 35 || usec <= 1000) ? 1 : 1000, usec);
+}
+static void combo_delay(void *ctx, unsigned int usec) { udelay(usec); }
+static void combo_pause(void *ctx, unsigned int nsec) { ndelay(nsec); }
+static void combo_sleep(void *ctx, unsigned int msec) { msleep(msec); }
+static int combo_wrapper(void *ctx, unsigned int active)
+{
+	struct t6050_dp *dp = ctx;
+	return atc_domain_set(&dp->domain[2], active);
+}
+static int combo_firmware(void *ctx, unsigned int active)
+{
+	return atc_firmware(ctx, active);
+}
+static int combo_tunable(void *ctx, unsigned int bank, const char *name)
+{
+	static const struct { u8 bank, index; const char *name; } common[] = {
+		{41, 0, "tunable_ATC0AXI2AF"}, {40, 1, "tunable_ATC_FABRIC"},
+		{43, 2, "tunable_ATC_COMMON_CFG"}, {42, 3, "tunable_ATC0AXI2AF_LIOA"},
+		{20, 4, "tunable_LN0_RX_CFG_TX_OF_RXCLK"}, {29, 5, "tunable_LN1_RX_CFG_TX_OF_RXCLK"},
+		{18, 6, "tunable_LN0_RX_EQ_DFLT"}, {27, 7, "tunable_LN1_RX_EQ_DFLT"},
+		{8, 8, "tunable_AUSPLL_CORE"}, {5, 9, "tunable_AUS40CMN_SHM"},
+		{10, 10, "tunable_CIO4PLL_CORE"},
+	};
+	struct t6050_dp *dp = ctx;
+
+	if (bank == 0 && !strcmp(name, "tunable_USB2PHY_DFLT")) {
+		apple_tunable_apply(dp->banks[0], dp->usb2_default);
+		return 0;
+	}
+	if (bank == 0 && !strcmp(name, "tunable_USB2PHY_HOST")) {
+		apple_tunable_apply(dp->banks[0], dp->usb2_host);
+		return 0;
+	}
+	for (unsigned int i = 0; i < ARRAY_SIZE(common); i++)
+		if (bank == common[i].bank && !strcmp(name, common[i].name)) {
+			apple_tunable_apply(dp->banks[bank], dp->tunables[common[i].index]);
+			return 0;
+		}
+	return -EINVAL;
+}
+
+static int combo_quiesce(void *ctx)
+{
+	struct t6050_dp *dp = ctx;
+	int ret = 0;
+
+	if (dp->usb_prepared) {
+		ret = APPLE_T6050_USB_RUN(&dp->usb_platform, apple_t6050_usb3_shutdown);
+		if (!ret)
+			dp->usb_prepared = false;
+	} else if (dp->enabled) {
+		/* Multifunction has a distinct native shutdown; never run the
+		 * USB-only analog sequence over live DisplayPort lane state. */
+		ret = atc_stop(dp);
+	}
+	return ret;
+}
+
+static int combo_stop(struct t6050_dp *dp)
+{
+	int ret;
+
+	lockdep_assert_held(&dp->lock);
+	if (dp->faulted)
+		return -EIO;
+	if (dp->controller_active || dp->pipe_active)
+		return -EBUSY;
+	ret = combo_quiesce(dp);
+	if (!ret && dp->usb2_active) {
+		ret = apple_t6050_usb2_stop(&dp->usb_platform);
+		if (!ret)
+			dp->usb2_active = false;
+	}
+	if (!ret)
+		ret = atc_domain_set(&dp->domain[1], false);
+	if (!ret)
+		ret = atc_domain_set(&dp->domain[0], false);
+	if (ret) {
+		dp->faulted = true;
+		return ret < 0 ? ret : -EIO;
+	}
+	dp->combo_mode = COMBO_SAFE;
+	return 0;
+}
+
+static int combo_start(struct t6050_dp *dp, enum combo_mode mode)
+{
+	int ret;
+
+	lockdep_assert_held(&dp->lock);
+	if (dp->faulted)
+		return -EIO;
+	if (dp->orientation == TYPEC_ORIENTATION_NONE)
+		return -ENOLINK;
+	ret = atc_domain_set(&dp->domain[0], true);
+	if (!ret)
+		ret = atc_domain_set(&dp->domain[1], true);
+	if (!ret)
+		ret = APPLE_T6050_USB_RUN(&dp->usb_platform, apple_t6050_usb2_host);
+	if (!ret)
+		dp->usb2_active = true;
+	if (!ret && mode == COMBO_USB) {
+		ret = dp->reverse ?
+			APPLE_T6050_USB_RUN(&dp->usb_platform, apple_t6050_usb3_init_reverse) :
+			APPLE_T6050_USB_RUN(&dp->usb_platform, apple_t6050_usb3_init_normal);
+		if (!ret)
+			dp->usb_prepared = true;
+	} else if (!ret) {
+		dp->multifunction = mode == COMBO_DP2;
+		ret = atc_start(dp);
+	}
+	if (ret) {
+		/* A partial shared transition has no cold-start ownership proof. */
+		dp->faulted = true;
+		return ret < 0 ? ret : -EIO;
+	}
+	dp->combo_mode = mode;
+	return 0;
+}
+
+static int combo_orientation(struct t6050_dp *dp, enum typec_orientation orientation)
+{
+	int ret;
+
+	guard(mutex)(&dp->lock);
+	if (dp->faulted)
+		return -EIO;
+	if (orientation != TYPEC_ORIENTATION_NONE && orientation != TYPEC_ORIENTATION_NORMAL &&
+	    orientation != TYPEC_ORIENTATION_REVERSE)
+		return -EINVAL;
+	if (dp->orientation == orientation)
+		return 0;
+	ret = combo_stop(dp);
+	if (!ret) {
+		dp->orientation = orientation;
+		dp->reverse = orientation == TYPEC_ORIENTATION_REVERSE;
+	}
+	return ret;
+}
+
+static int combo_mux(struct t6050_dp *dp, struct typec_mux_state *state)
+{
+	enum combo_mode mode;
+	int ret;
+
+	if (state->mode == TYPEC_STATE_SAFE)
+		mode = COMBO_SAFE;
+	else if (state->mode == TYPEC_STATE_USB && !state->alt)
+		mode = COMBO_USB;
+	else if (state->alt && state->alt->svid == USB_TYPEC_DP_SID) {
+		switch (state->mode) {
+		case TYPEC_DP_STATE_C:
+		case TYPEC_DP_STATE_E: mode = COMBO_DP4; break;
+		case TYPEC_DP_STATE_D: mode = COMBO_DP2; break;
+		default: return -EOPNOTSUPP;
+		}
+	} else {
+		return -EOPNOTSUPP;
+	}
+	guard(mutex)(&dp->lock);
+	if (dp->faulted)
+		return -EIO;
+	if (mode == dp->combo_mode &&
+	    (mode == COMBO_SAFE || dp->usb_prepared || dp->enabled))
+		return 0;
+	if (mode != COMBO_SAFE && dp->orientation == TYPEC_ORIENTATION_NONE)
+		return -ENOLINK;
+	ret = combo_stop(dp);
+	if (ret || mode == COMBO_SAFE)
+		return ret;
+	return combo_start(dp, mode);
+}
+
+static int combo_usb2_mode(struct phy *phy, enum phy_mode mode, int submode)
+{
+	struct t6050_dp *dp = phy_get_drvdata(phy);
+	int ret;
+
+	guard(mutex)(&dp->lock);
+	if (dp->faulted)
+		return -EIO;
+	if (mode != PHY_MODE_USB_HOST)
+		return -EOPNOTSUPP;
+	if (!dp->usb_prepared && !dp->enabled)
+		return -ENOLINK;
+	if (dp->usb2_active)
+		return 0;
+	ret = APPLE_T6050_USB_RUN(&dp->usb_platform, apple_t6050_usb2_host);
+	if (ret)
+		dp->faulted = true;
+	else
+		dp->usb2_active = true;
+	return ret;
+}
+
+static int combo_usb2_reset(struct phy *phy)
+{
+	struct t6050_dp *dp = phy_get_drvdata(phy);
+	int ret;
+
+	guard(mutex)(&dp->lock);
+	if (dp->faulted || !dp->usb2_active)
+		return -ENOLINK;
+	ret = apple_t6050_usb2_port_reset(&dp->usb_io, dp, combo_sleep);
+	if (ret)
+		dp->faulted = true;
+	return ret ? -EIO : 0;
+}
+
+static int combo_usb3_mode(struct phy *phy, enum phy_mode mode, int submode)
+{
+	struct t6050_dp *dp = phy_get_drvdata(phy);
+	int ret;
+
+	guard(mutex)(&dp->lock);
+	if (dp->faulted)
+		return -EIO;
+	if (mode != PHY_MODE_USB_HOST)
+		return -EOPNOTSUPP;
+	if (!dp->controller_active || !dp->usb2_active)
+		return -ENOLINK;
+	/* Four DP lanes leave DWC3 on its established dummy PIPE; USB2 still
+	 * uses its independent D+/D- PHY. Do not switch USB3 onto DP lanes. */
+	if (dp->combo_mode == COMBO_DP4 && dp->enabled)
+		return 0;
+	if (!dp->usb_prepared && !(dp->combo_mode == COMBO_DP2 && dp->enabled))
+		return -ENOLINK;
+	if (dp->pipe_active)
+		return (readl(dp->banks[44] + 0xc) & 0x73) == 0x10 ? 0 : -EIO;
+	apple_tunable_apply(dp->banks[44], dp->pipe_default);
+	ret = apple_t6050_usb3_pipe_switch(&dp->usb_io);
+	if (ret)
+		dp->faulted = true;
+	else
+		dp->pipe_active = true;
+	return ret ? -EIO : 0;
+}
+
+static int combo_usb3_poweroff(struct phy *phy)
+{
+	struct t6050_dp *dp = phy_get_drvdata(phy);
+	int ret = 0;
+
+	guard(mutex)(&dp->lock);
+	if (dp->faulted)
+		return -EIO;
+	/* DWC3 calls power_off only after host/gadget shutdown and SUSPHY.
+	 * PIPE must select its dummy producer before the controller is reset. */
+	if (dp->pipe_active) {
+		ret = apple_t6050_usb3_pipe_stop(&dp->usb_io, combo_quiesce, dp);
+		if (!ret)
+			dp->pipe_active = false;
+	}
+	if (!ret && dp->usb2_active) {
+		ret = apple_t6050_usb2_stop(&dp->usb_platform);
+		if (!ret)
+			dp->usb2_active = false;
+	}
+	if (ret)
+		dp->faulted = true;
+	return ret ? -EIO : 0;
+}
+static const struct phy_ops combo_usb2_ops = {
+	.set_mode = combo_usb2_mode, .reset = combo_usb2_reset, .owner = THIS_MODULE,
+};
+static const struct phy_ops combo_usb3_ops = {
+	.set_mode = combo_usb3_mode, .power_off = combo_usb3_poweroff, .owner = THIS_MODULE,
+};
+
+static int combo_reset_assert(struct reset_controller_dev *reset, unsigned long id)
+{
+	struct t6050_dp *dp = container_of(reset, struct t6050_dp, reset);
+	int ret;
+
+	guard(mutex)(&dp->lock);
+	if (id || dp->pipe_active)
+		return -EBUSY;
+	if (dp->faulted)
+		return -EIO;
+	apple_t6050_usb_mask(&dp->usb_io, 44, 0x1c, 1, 0);
+	apple_t6050_usb_mask(&dp->usb_io, 44, 0x1c, 0x10, 0x10);
+	ret = apple_t6050_usb3_pipe_cold_dummy(&dp->usb_io);
+	if (ret)
+		dp->faulted = true;
+	else
+		dp->controller_active = false;
+	return ret ? -EIO : 0;
+}
+static int combo_reset_deassert(struct reset_controller_dev *reset, unsigned long id)
+{
+	struct t6050_dp *dp = container_of(reset, struct t6050_dp, reset);
+
+	guard(mutex)(&dp->lock);
+	if (id)
+		return -EINVAL;
+	if (dp->faulted || !dp->usb2_active)
+		return -ENOLINK;
+	apple_t6050_usb_mask(&dp->usb_io, 44, 0x1c, 0x10, 0);
+	apple_t6050_usb_mask(&dp->usb_io, 44, 0x1c, 1, 1);
+	dp->controller_active = true;
+	return 0;
+}
+static const struct reset_control_ops combo_reset_ops = {
+	.assert = combo_reset_assert, .deassert = combo_reset_deassert,
+};
+
+static struct phy *combo_xlate(struct device *dev, const struct of_phandle_args *args)
+{
+	struct t6050_dp *dp = dev_get_drvdata(dev);
+	if (args->args_count != 1)
+		return ERR_PTR(-EINVAL);
+	switch (args->args[0]) {
+	case PHY_TYPE_USB2: return dp->combo_phy[0];
+	case PHY_TYPE_USB3: return dp->combo_phy[1];
+	case PHY_TYPE_DP: return dp->combo_phy[2];
+	default: return ERR_PTR(-EINVAL);
+	}
+}
+
+static int combo_setup(struct platform_device *pdev, struct t6050_dp *dp)
+{
+	static const struct { u8 bank; u32 minimum; const char *name; } extra[] = {
+		{0, 0x20, "usb2phy"}, {1, 0x24, "usb2-digital"}, {44, 0x48, "pipehandler"},
+	};
+	struct device *dev = dp->dev;
+	int ret;
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(extra); i++) {
+		struct resource *res = platform_get_resource_byname(pdev, IORESOURCE_MEM, extra[i].name);
+		if (!res || resource_size(res) < extra[i].minimum)
+			return -EINVAL;
+		dp->banks[extra[i].bank] = devm_ioremap_resource(dev, res);
+		if (IS_ERR(dp->banks[extra[i].bank]))
+			return PTR_ERR(dp->banks[extra[i].bank]);
+		dp->resources[extra[i].bank] = *res;
+	}
+	dp->usb2_default = devm_apple_tunable_parse(dev, dev->of_node,
+		"apple,tunable-usb2-default", &dp->resources[0]);
+	if (IS_ERR(dp->usb2_default))
+		return PTR_ERR(dp->usb2_default);
+	dp->usb2_host = devm_apple_tunable_parse(dev, dev->of_node,
+		"apple,tunable-usb2-host", &dp->resources[0]);
+	if (IS_ERR(dp->usb2_host))
+		return PTR_ERR(dp->usb2_host);
+	dp->pipe_default = devm_apple_tunable_parse(dev, dev->of_node,
+		"apple,tunable-pipe-default", &dp->resources[44]);
+	if (IS_ERR(dp->pipe_default))
+		return PTR_ERR(dp->pipe_default);
+	dp->usb_io = (struct apple_t6050_usb_io) {
+		.context = dp, .read = combo_read, .write = combo_write,
+		.poll = combo_poll, .delay = combo_delay,
+	};
+	dp->usb_platform = (struct apple_t6050_usb_platform) {
+		.context = dp, .io = &dp->usb_io, .wrapper_power = combo_wrapper,
+		.firmware = combo_firmware, .tunable = combo_tunable, .pause_ns = combo_pause,
+	};
+	dp->reset = (struct reset_controller_dev) {
+		.owner = THIS_MODULE, .ops = &combo_reset_ops, .dev = dev,
+		.of_node = dev->of_node, .nr_resets = 1,
+	};
+	ret = devm_reset_controller_register(dev, &dp->reset);
+	if (ret)
+		return ret;
+	for (unsigned int i = 0; i < 2; i++) {
+		dp->combo_phy[i] = devm_phy_create(dev, NULL, i ? &combo_usb3_ops : &combo_usb2_ops);
+		if (IS_ERR(dp->combo_phy[i]))
+			return PTR_ERR(dp->combo_phy[i]);
+		phy_set_drvdata(dp->combo_phy[i], dp);
+	}
+	return 0;
+}
diff --git a/drivers/phy/apple/atc-t6050-dp.c b/drivers/phy/apple/atc-t6050-dp.c
new file mode 100644
index 000000000000..cafee096a625
--- /dev/null
+++ b/drivers/phy/apple/atc-t6050-dp.c
@@ -0,0 +1,806 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* T6050 DisplayPort PHY for fixed bridges and Type-C DP alternate mode. */
+#include <linux/bitfield.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/phy/phy.h>
+#include <linux/platform_device.h>
+#include <linux/reset-controller.h>
+#include <dt-bindings/phy/phy.h>
+#include "usb-t6050/apple_t6050_usb_phy.h"
+#include "usb-t6050/apple_t6050_usb3_pipe.h"
+#include "usb-t6050/apple_t6050_usb2_reset.h"
+#include <linux/pm_domain.h>
+#include <linux/pm_runtime.h>
+#include <linux/soc/apple/tunable.h>
+#include <linux/soc/apple/rtkit.h>
+#include <linux/soc/apple/dp-tunnel.h>
+#include <linux/usb/typec.h>
+#include <linux/usb/typec_mux.h>
+#include <linux/usb/typec_dp.h>
+#include <linux/usb/typec_altmode.h>
+
+enum atc_operation { ATC_MASK, ATC_TUNABLE, ATC_DELAY, ATC_POLL, ATC_POWER, ATC_FIRMWARE };
+struct atc_op {
+	u8 op, bank;
+	u16 offset;
+	u32 mask, value, timeout;
+};
+struct atc_rate_op {
+	struct atc_op op;
+	u8 rates;
+	u32 values[4];
+};
+#include "atc-t6050-dp-data.h"
+#include "atc-t6050-typec-data.h"
+
+static const struct { u8 bank; u32 offset; } core_banks[] = {
+	{2, 0}, {3, 0x400}, {4, 0x800}, {5, 0xa00}, {6, 0x1000},
+	{7, 0x3000}, {8, 0x3200}, {9, 0x3800}, {10, 0x3a00},
+	{14, 0x7000}, {16, 0x9000}, {18, 0xb000}, {19, 0xc000},
+	{20, 0xd000}, {21, 0xe000}, {22, 0xf000}, {25, 0x19000},
+	{27, 0x1b000}, {28, 0x1c000}, {29, 0x1d000}, {30, 0x1e000},
+	{31, 0x1f000}, {33, 0x28000}, {34, 0x28400}, {35, 0x29000},
+};
+static const struct { u8 bank; const char *name; } extra_banks[] = {
+	{39, "reset"}, {40, "fabric"}, {41, "axi2af"},
+	{42, "lioa"}, {43, "common-cfg"},
+	{38, "usb-control"},
+};
+static const struct { u8 bank; const char *name; } tunable_names[] = {
+	{41, "apple,tunable-axi2af"}, {40, "apple,tunable-fabric"},
+	{43, "apple,tunable-common-cfg"}, {42, "apple,tunable-lioa"},
+	{20, "apple,tunable-lane0-rx-clock"}, {29, "apple,tunable-lane1-rx-clock"},
+	{18, "apple,tunable-lane0-rx-eq"}, {27, "apple,tunable-lane1-rx-eq"},
+	{8, "apple,tunable-auspll"},
+	{5, "apple,tunable-aus40cmn-shm"}, {10, "apple,tunable-cio4pll"},
+};
+static const unsigned int link_rates[] = {1620, 2700, 5400, 8100};
+static const char * const training_names[] = {
+	"apple,dp-training-table-rbr", "apple,dp-training-table-hbr",
+	"apple,dp-training-table-hbr2", "apple,dp-training-table-hbr3",
+};
+struct atc_domain {
+	struct device *dev;
+	bool active;
+};
+enum combo_mode { COMBO_SAFE, COMBO_USB, COMBO_DP4, COMBO_DP2 };
+struct t6050_dp {
+	bool combo, usb_prepared, usb2_active, pipe_active, controller_active;
+	enum combo_mode combo_mode;
+	enum typec_orientation orientation;
+	struct phy *combo_phy[3];
+	struct reset_controller_dev reset;
+	struct apple_t6050_usb_io usb_io;
+	struct apple_t6050_usb_platform usb_platform;
+	struct apple_tunable *usb2_default, *usb2_host, *pipe_default;
+	struct device *dev;
+	struct mutex lock;
+	void __iomem *banks[45];
+	struct resource resources[45];
+	struct apple_tunable *tunables[ARRAY_SIZE(tunable_names)];
+	struct atc_domain domain[3]; /* USB AON, common, wrapper: native order. */
+	u32 training[4][16];
+	u32 voltage[4], pre[4];
+	int rate;
+	bool enabled, faulted;
+	bool typec, reverse, multifunction;
+	struct apple_rtkit *rtkit;
+	void __iomem *fw_data;
+	bool fw_running;
+};
+
+static int atc_domain_set(struct atc_domain *pd, bool active)
+{
+	int ret;
+
+	if (pd->active == active)
+		return 0;
+	if (active) {
+		ret = pm_runtime_resume_and_get(pd->dev);
+		if (ret < 0)
+			return ret;
+	} else {
+		ret = pm_runtime_put_sync_suspend(pd->dev);
+		if (ret < 0) {
+			/* put decremented usage even when suspend failed. */
+			pm_runtime_get_noresume(pd->dev);
+			return ret;
+		}
+	}
+	pd->active = active;
+	return 0;
+}
+
+static void atc_domain_release(void *data)
+{
+	struct atc_domain *pd = data;
+
+	if (pd->active)
+		pm_runtime_put_sync_suspend(pd->dev);
+	dev_pm_domain_detach(pd->dev, true);
+}
+
+/* The bootloader preloads CIO80 firmware into local SRAM. The firmware's
+ * data segment is 0x10000000..0x10010000, not guest system RAM. */
+static int atc_fw_shmem_setup(void *cookie, struct apple_rtkit_shmem *bfr)
+{
+	struct t6050_dp *dp = cookie;
+
+	if (bfr->iova < 0x10000000 ||
+	    bfr->size > 0x10000 || bfr->iova - 0x10000000 > 0x10000 - bfr->size) {
+		dev_err(dp->dev, "unsupported PHY firmware buffer %llx size %zx\n",
+			(unsigned long long)bfr->iova, bfr->size);
+		return -EINVAL;
+	}
+	bfr->iomem = dp->fw_data + (bfr->iova - 0x10000000);
+	bfr->is_mapped = true;
+	return 0;
+}
+
+static void atc_fw_shmem_destroy(void *cookie, struct apple_rtkit_shmem *bfr)
+{
+	/* SRAM is owned by the PHY and mapped for the device lifetime. */
+}
+
+static void atc_fw_message(void *cookie, u8 endpoint, u64 message)
+{
+	struct t6050_dp *dp = cookie;
+
+	dev_dbg(dp->dev, "PHY firmware ep%x: %016llx\n", endpoint, message);
+}
+
+static void atc_fw_crashed(void *cookie, const void *log, size_t size)
+{
+	struct t6050_dp *dp = cookie;
+
+	WRITE_ONCE(dp->faulted, true);
+	dev_err(dp->dev, "PHY firmware crashed\n");
+}
+
+static const struct apple_rtkit_ops atc_fw_ops = {
+	.shmem_setup = atc_fw_shmem_setup,
+	.shmem_destroy = atc_fw_shmem_destroy,
+	.recv_message = atc_fw_message,
+	.crashed = atc_fw_crashed,
+};
+
+static int atc_firmware(struct t6050_dp *dp, bool start)
+{
+	int ret;
+
+	if (!dp->rtkit)
+		return -ENODEV;
+	if (dp->fw_running == start)
+		return 0;
+	if (start) {
+		/* Native coprocessor run, after its +0x40 firmware enable. */
+		writel(BIT(4), dp->banks[38] + 0x28);
+		ret = apple_rtkit_wake(dp->rtkit);
+		if (!ret)
+			ret = apple_rtkit_start_ep(dp->rtkit, 0x20);
+	} else {
+		/* CIO80PhyMBI::sendPowerDown, then the RTBuddy power transition. */
+		ret = apple_rtkit_send_message(dp->rtkit, 0x20, BIT_ULL(56), NULL, false);
+		if (!ret)
+			ret = apple_rtkit_shutdown(dp->rtkit);
+		if (!ret)
+			writel((u32)~BIT(4), dp->banks[38] + 0x28);
+	}
+	if (ret)
+		dev_err(dp->dev, "PHY firmware %s failed: %d\n", start ? "start" : "stop", ret);
+	else
+		dp->fw_running = start;
+	return ret;
+}
+
+static int atc_validate_step(struct t6050_dp *dp, const struct atc_op *s)
+{
+	if (s->op == ATC_DELAY)
+		return s->value <= 10000 ? 0 : -EINVAL;
+	if (s->op == ATC_POWER)
+		return s->value <= 1 ? 0 : -EINVAL;
+	if (s->op == ATC_FIRMWARE)
+		return dp->typec && s->value <= 1 ? 0 : -EINVAL;
+	if (s->bank >= ARRAY_SIZE(dp->banks) || !dp->banks[s->bank] ||
+	    s->offset % 4 || s->offset + 4 > resource_size(&dp->resources[s->bank]))
+		return -EINVAL;
+	if (s->op == ATC_TUNABLE)
+		return s->value < ARRAY_SIZE(tunable_names) &&
+		       tunable_names[s->value].bank == s->bank ? 0 : -EINVAL;
+	if (s->op == ATC_MASK || s->op == ATC_POLL)
+		return s->value & ~s->mask ? -EINVAL : 0;
+	return -EINVAL;
+}
+
+static int atc_step(struct t6050_dp *dp, const struct atc_op *s)
+{
+	void __iomem *reg;
+	u32 value;
+	int ret = atc_validate_step(dp, s);
+
+	if (ret)
+		return ret;
+	if (s->op == ATC_DELAY) {
+		udelay(s->value);
+		return 0;
+	}
+	if (s->op == ATC_FIRMWARE)
+		return atc_firmware(dp, s->value);
+	if (s->op == ATC_POWER)
+		return atc_domain_set(&dp->domain[2], s->value);
+	if (s->bank >= ARRAY_SIZE(dp->banks) || !dp->banks[s->bank] ||
+	    s->offset + 4 > resource_size(&dp->resources[s->bank]))
+		return -EINVAL;
+	reg = dp->banks[s->bank] + s->offset;
+	switch (s->op) {
+	case ATC_MASK:
+		value = readl(reg);
+		writel((value & ~s->mask) | s->value, reg);
+		return 0;
+	case ATC_TUNABLE:
+		if (s->value >= ARRAY_SIZE(dp->tunables))
+			return -EINVAL;
+		apple_tunable_apply(dp->banks[s->bank], dp->tunables[s->value]);
+		return 0;
+	case ATC_POLL:
+		ret = readl_poll_timeout(reg, value, (value & s->mask) == s->value,
+					s->timeout > 1000 ? 1000 : 1, s->timeout);
+		if (ret)
+			dev_err(dp->dev, "bank%u+%x timeout: %x & %x != %x\n",
+				s->bank, s->offset, value, s->mask, s->value);
+		return ret;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int atc_sequence(struct t6050_dp *dp, const struct atc_op *s, size_t count)
+{
+	for (size_t i = 0; i < count; i++) {
+		int ret = atc_step(dp, &s[i]);
+
+		if (ret) {
+			dp->faulted = true;
+			return ret;
+		}
+	}
+	return 0;
+}
+#define ATC_SEQUENCE(dp, seq) atc_sequence(dp, seq, ARRAY_SIZE(seq))
+
+static int atc_link_rate(struct t6050_dp *dp, int rate)
+{
+	const struct atc_rate_op *on = dp_link_on;
+	size_t nr_on = ARRAY_SIZE(dp_link_on);
+	int ret;
+
+	if (dp->multifunction) {
+		on = dp->reverse ? dp_group0_on : dp_group1_on;
+		nr_on = dp->reverse ? ARRAY_SIZE(dp_group0_on) : ARRAY_SIZE(dp_group1_on);
+	}
+	if (dp->rate == rate)
+		return 0;
+	if (dp->rate >= 0) {
+		if (dp->multifunction)
+			ret = dp->reverse ? ATC_SEQUENCE(dp, dp_group0_off) :
+					    ATC_SEQUENCE(dp, dp_group1_off);
+		else
+			ret = ATC_SEQUENCE(dp, dp_link_off);
+		if (ret)
+			return ret;
+		dp->rate = -1;
+	}
+	if (rate < 0)
+		return 0;
+	for (size_t i = 0; i < nr_on; i++) {
+		struct atc_op op = on[i].op;
+
+		if (!(on[i].rates & BIT(rate)))
+			continue;
+		op.value = on[i].values[rate];
+		ret = atc_step(dp, &op);
+		if (ret) {
+			dp->faulted = true;
+			return ret;
+		}
+	}
+	dp->rate = rate;
+	memset(dp->voltage, 0, sizeof(dp->voltage));
+	memset(dp->pre, 0, sizeof(dp->pre));
+	return 0;
+}
+
+static int atc_start(struct t6050_dp *dp)
+{
+	int ret;
+
+	if (dp->faulted)
+		return -EIO;
+	if (dp->enabled)
+		return 0;
+	ret = atc_domain_set(&dp->domain[0], true);
+	if (ret)
+		return ret;
+	ret = atc_domain_set(&dp->domain[1], true);
+	if (ret) {
+		atc_domain_set(&dp->domain[0], false);
+		return ret;
+	}
+	if (dp->multifunction)
+		ret = dp->reverse ? ATC_SEQUENCE(dp, mf_reverse_init) :
+				    ATC_SEQUENCE(dp, mf_normal_init);
+	else
+		ret = dp->reverse ? ATC_SEQUENCE(dp, dp_reverse_init) :
+				    ATC_SEQUENCE(dp, dp_init);
+	if (!ret)
+		ret = ATC_SEQUENCE(dp, aux_on);
+	if (ret)
+		return ret;
+	dp->enabled = true;
+	return 0;
+}
+
+static int atc_stop(struct t6050_dp *dp)
+{
+	int ret;
+
+	if (dp->faulted)
+		return -EIO;
+	if (!dp->enabled)
+		return 0;
+	ret = atc_link_rate(dp, -1);
+	if (!ret)
+		ret = ATC_SEQUENCE(dp, aux_off);
+	if (!ret)
+		ret = dp->multifunction ? ATC_SEQUENCE(dp, mf_poweroff) :
+					 ATC_SEQUENCE(dp, dp_poweroff);
+	if (ret)
+		return ret;
+	dp->enabled = false;
+	/* Combo owns domain shutdown after USB2 and PIPE have also quiesced. */
+	if (dp->combo)
+		return 0;
+	ret = atc_domain_set(&dp->domain[1], false);
+	if (!ret)
+		ret = atc_domain_set(&dp->domain[0], false);
+	return ret;
+}
+
+static void atc_mask(void __iomem *reg, u32 mask, u32 value)
+{
+	writel((readl(reg) & ~mask) | value, reg);
+}
+
+static void atc_drive(struct t6050_dp *dp, unsigned int lane, u32 preset)
+{
+	/* Native DP lane order is RX/TX in each orientation-selected group. */
+	unsigned int group = (lane < 2 ? 1 : 0) ^ dp->reverse;
+	bool tx = lane & 1;
+	void __iomem *base = dp->banks[(tx ? 21 : 20) + 9 * group];
+	u32 ctrl = ((preset >> 2) & 0xf) | ((preset & 3) << 14);
+	u32 eq = ((preset >> 5) & 0x7fffe) | 1;
+
+	if (tx)
+		atc_mask(base + 0x100, BIT(20), BIT(20));
+	atc_mask(base + (tx ? 0x58 : 0x68), 0xc00f, ctrl);
+	atc_mask(base + (tx ? 0x104 : 0xac), BIT(29), BIT(29));
+	atc_mask(base + (tx ? 0x100 : 0xa8), 0x7ffff, eq);
+}
+
+#include "atc-t6050-combo.h"
+
+static int t6050_dp_set_mode(struct phy *phy, enum phy_mode mode, int submode)
+{
+	struct t6050_dp *dp = phy_get_drvdata(phy);
+
+	guard(mutex)(&dp->lock);
+	if (mode == PHY_MODE_DP)
+		return dp->typec ? (dp->enabled ? 0 : -ENOLINK) : atc_start(dp);
+	if (mode == PHY_MODE_INVALID)
+		return dp->combo ? atc_link_rate(dp, -1) : atc_stop(dp);
+	return -EINVAL;
+}
+
+static int t6050_dp_validate(struct phy *phy, enum phy_mode mode, int submode,
+			    union phy_configure_opts *opts)
+{
+	struct t6050_dp *dp = phy_get_drvdata(phy);
+
+	guard(mutex)(&dp->lock);
+	if (mode != PHY_MODE_DP)
+		return -EINVAL;
+	memset(opts, 0, sizeof(*opts));
+	opts->dp.lanes = dp->multifunction ? 2 : 4;
+	opts->dp.link_rate = 8100;
+	opts->dp.ssc = 0;
+	return 0;
+}
+
+static int t6050_dp_configure(struct phy *phy, union phy_configure_opts *opts)
+{
+	struct t6050_dp *dp = phy_get_drvdata(phy);
+	struct phy_configure_opts_dp *cfg = &opts->dp;
+	int rate = -1, ret;
+
+	/* Validate the whole request before altering a running transmitter. */
+	if (cfg->set_rate && cfg->link_rate) {
+		for (unsigned int i = 0; i < ARRAY_SIZE(link_rates); i++)
+			if (cfg->link_rate == link_rates[i])
+				rate = i;
+		if (rate < 0 || cfg->ssc)
+			return -EINVAL;
+	}
+	if ((cfg->set_lanes || cfg->set_voltages) &&
+	    cfg->lanes != 0 && cfg->lanes != 1 && cfg->lanes != 2 && cfg->lanes != 4)
+		return -EINVAL;
+	if (cfg->set_voltages)
+		for (unsigned int i = 0; i < cfg->lanes; i++)
+			if (cfg->voltage[i] > 3 || cfg->pre[i] > 3 ||
+			    cfg->voltage[i] + cfg->pre[i] > 3)
+				return -EINVAL;
+	if (cfg->set_voltages && cfg->set_rate && rate < 0 && cfg->lanes)
+		return -EINVAL;
+	guard(mutex)(&dp->lock);
+	if (dp->faulted)
+		return -EIO;
+	if (!dp->enabled)
+		return -EPIPE;
+	if ((cfg->set_lanes || cfg->set_voltages) && dp->multifunction && cfg->lanes > 2)
+		return -EINVAL;
+	if (cfg->set_rate) {
+		ret = atc_link_rate(dp, rate);
+		if (ret)
+			return ret;
+	}
+	/* Native setActiveLaneCount is a no-op; DCP controls the active count. */
+	if (cfg->set_voltages) {
+		if (dp->rate < 0)
+			return -EPIPE;
+		for (unsigned int i = 0; i < cfg->lanes; i++) {
+			u32 preset = dp->training[dp->rate][4 * cfg->voltage[i] + cfg->pre[i]];
+
+			atc_drive(dp, i, preset);
+			dp->voltage[i] = cfg->voltage[i];
+			dp->pre[i] = cfg->pre[i];
+		}
+	}
+	return 0;
+}
+
+static const struct phy_ops t6050_dp_ops = {
+	.set_mode = t6050_dp_set_mode,
+	.validate = t6050_dp_validate,
+	.configure = t6050_dp_configure,
+	.owner = THIS_MODULE,
+};
+
+int apple_dp_phy_link_config(struct phy *phy, unsigned int *pclk, bool *uhbr)
+{
+	struct t6050_dp *dp;
+
+	if (!phy || phy->ops != &t6050_dp_ops)
+		return -EOPNOTSUPP;
+	dp = phy_get_drvdata(phy);
+	guard(mutex)(&dp->lock);
+	if (dp->faulted)
+		return -EIO;
+	if (!dp->enabled || dp->rate < 0)
+		return -ENOLINK;
+	/* Native direct DPPHY uses logical clock0, mapped to xbar PCLK1.
+	 * The other four logical clocks are separately managed tunnel clocks. */
+	*pclk = 1;
+	*uhbr = false;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(apple_dp_phy_link_config);
+
+/* The connector sets orientation before changing the alternate-mode mux. */
+static int t6050_set_orientation(struct t6050_dp *dp,
+				enum typec_orientation orientation)
+{
+	bool reverse = orientation == TYPEC_ORIENTATION_REVERSE;
+	int ret;
+
+	if (dp->combo)
+		return combo_orientation(dp, orientation);
+	guard(mutex)(&dp->lock);
+	if (orientation == TYPEC_ORIENTATION_NONE)
+		return atc_stop(dp);
+	if (dp->reverse == reverse)
+		return 0;
+	ret = atc_stop(dp);
+	if (!ret)
+		dp->reverse = reverse;
+	return ret;
+}
+
+static int t6050_set_typec_mode(struct t6050_dp *dp, struct typec_mux_state *state)
+{
+	bool multifunction;
+	int ret;
+
+	if (dp->combo)
+		return combo_mux(dp, state);
+	guard(mutex)(&dp->lock);
+	if (state->mode == TYPEC_STATE_SAFE)
+		return atc_stop(dp);
+	/* USB-only and USB4 require their controller's separate PHY interface. */
+	if (!state->alt || state->alt->svid != USB_TYPEC_DP_SID)
+		return -EOPNOTSUPP;
+	switch (state->mode) {
+	case TYPEC_DP_STATE_C:
+	case TYPEC_DP_STATE_E:
+		multifunction = false;
+		break;
+	case TYPEC_DP_STATE_D:
+		multifunction = true;
+		break;
+	default:
+		return -EOPNOTSUPP;
+	}
+	if (dp->enabled && dp->multifunction == multifunction)
+		return 0;
+	ret = atc_stop(dp);
+	if (ret)
+		return ret;
+	dp->multifunction = multifunction;
+	ret = atc_start(dp);
+	if (!ret)
+		dev_info(dp->dev, "Type-C DP: %u lanes, %s orientation\n",
+			 multifunction ? 2 : 4, dp->reverse ? "reverse" : "normal");
+	return ret;
+}
+
+static int t6050_typec_orientation(struct typec_switch_dev *sw,
+				 enum typec_orientation orientation)
+{
+	return t6050_set_orientation(typec_switch_get_drvdata(sw), orientation);
+}
+
+static int t6050_typec_mode(struct typec_mux_dev *mux, struct typec_mux_state *state)
+{
+	return t6050_set_typec_mode(typec_mux_get_drvdata(mux), state);
+}
+
+static void t6050_typec_switch_release(void *data)
+{
+	typec_switch_unregister(data);
+}
+
+static void t6050_typec_mux_release(void *data)
+{
+	typec_mux_unregister(data);
+}
+
+static int t6050_typec_register(struct t6050_dp *dp)
+{
+	struct typec_switch_desc sw_desc = {
+		.fwnode = dev_fwnode(dp->dev), .drvdata = dp,
+		.set = t6050_typec_orientation,
+	};
+	struct typec_mux_desc mux_desc = {
+		.fwnode = dev_fwnode(dp->dev), .drvdata = dp,
+		.set = t6050_typec_mode,
+	};
+	struct typec_switch_dev *sw;
+	struct typec_mux_dev *mux;
+	int ret;
+
+	sw = typec_switch_register(dp->dev, &sw_desc);
+	if (IS_ERR(sw))
+		return PTR_ERR(sw);
+	ret = devm_add_action_or_reset(dp->dev, t6050_typec_switch_release, sw);
+	if (ret)
+		return ret;
+	mux = typec_mux_register(dp->dev, &mux_desc);
+	if (IS_ERR(mux))
+		return PTR_ERR(mux);
+	return devm_add_action_or_reset(dp->dev, t6050_typec_mux_release, mux);
+}
+
+static int t6050_dp_probe(struct platform_device *pdev)
+{
+	static const char * const domains[] = {"usb-aon", "common", "wrapper"};
+	struct device *dev = &pdev->dev;
+	struct t6050_dp *dp;
+	struct phy_provider *provider;
+	struct phy *phy;
+	struct resource *core;
+	void __iomem *base;
+	int ret;
+
+	dp = devm_kzalloc(dev, sizeof(*dp), GFP_KERNEL);
+	if (!dp)
+		return -ENOMEM;
+	dp->dev = dev;
+	dp->combo = of_device_is_compatible(dev->of_node, "apple,t6050-combo-phy");
+	if (dp->combo) {
+		u32 port;
+		if (of_property_read_u32(dev->of_node, "apple,port-index", &port) ||
+		    (port != 1 && port != 2) ||
+		    !of_property_present(dev->of_node, "apple,guest-port-reserved") ||
+		    !of_property_present(dev->of_node, "mode-switch"))
+			return -EINVAL;
+	}
+	dp->typec = of_property_present(dev->of_node, "mode-switch");
+	dp->rate = -1;
+	mutex_init(&dp->lock);
+	platform_set_drvdata(pdev, dp);
+	core = platform_get_resource_byname(pdev, IORESOURCE_MEM, "core");
+	if (!core || resource_size(core) < (dp->combo ? 0x2c000 : 0x2c400))
+		return -EINVAL;
+	base = devm_ioremap_resource(dev, core);
+	if (IS_ERR(base))
+		return PTR_ERR(base);
+	for (unsigned int i = 0; i < ARRAY_SIZE(core_banks); i++) {
+		u8 bank = core_banks[i].bank;
+
+		dp->banks[bank] = base + core_banks[i].offset;
+		dp->resources[bank] = *core;
+		dp->resources[bank].start += core_banks[i].offset;
+		dp->resources[bank].end = core->end;
+	}
+	for (unsigned int i = 0; i < ARRAY_SIZE(extra_banks); i++) {
+		u8 bank = extra_banks[i].bank;
+		struct resource *res = platform_get_resource_byname(pdev, IORESOURCE_MEM,
+								   extra_banks[i].name);
+
+		if (bank == 38 && !dp->typec)
+			continue;
+		if (!res || resource_size(res) < 4)
+			return -EINVAL;
+		dp->banks[bank] = devm_ioremap_resource(dev, res);
+		if (IS_ERR(dp->banks[bank]))
+			return PTR_ERR(dp->banks[bank]);
+		dp->resources[bank] = *res;
+	}
+	/* Check every register step before any domain is enabled. */
+	{
+		static const struct { const struct atc_op *ops; size_t count; } sequences[] = {
+			{ dp_init, ARRAY_SIZE(dp_init) },
+			{ aux_on, ARRAY_SIZE(aux_on) },
+			{ aux_off, ARRAY_SIZE(aux_off) },
+			{ dp_link_off, ARRAY_SIZE(dp_link_off) },
+			{ dp_poweroff, ARRAY_SIZE(dp_poweroff) },
+		};
+
+		for (unsigned int i = 0; i < ARRAY_SIZE(sequences); i++)
+			for (size_t j = 0; j < sequences[i].count; j++) {
+				ret = atc_validate_step(dp, &sequences[i].ops[j]);
+				if (ret)
+					return ret;
+			}
+		for (unsigned int i = 0; i < ARRAY_SIZE(dp_link_on); i++)
+			for (unsigned int rate = 0; rate < ARRAY_SIZE(link_rates); rate++) {
+				struct atc_op op = dp_link_on[i].op;
+
+				if (!(dp_link_on[i].rates & BIT(rate)))
+					continue;
+				op.value = dp_link_on[i].values[rate];
+				ret = atc_validate_step(dp, &op);
+				if (ret)
+					return ret;
+			}
+	}
+	if (dp->typec) {
+		static const struct { const struct atc_op *ops; size_t count; } sequences[] = {
+			{ dp_reverse_init, ARRAY_SIZE(dp_reverse_init) },
+			{ mf_normal_init, ARRAY_SIZE(mf_normal_init) },
+			{ mf_reverse_init, ARRAY_SIZE(mf_reverse_init) },
+			{ mf_poweroff, ARRAY_SIZE(mf_poweroff) },
+			{ dp_group0_off, ARRAY_SIZE(dp_group0_off) },
+			{ dp_group1_off, ARRAY_SIZE(dp_group1_off) },
+		};
+		const struct atc_rate_op *rates[] = { dp_group0_on, dp_group1_on };
+		const size_t counts[] = { ARRAY_SIZE(dp_group0_on), ARRAY_SIZE(dp_group1_on) };
+
+		for (unsigned int i = 0; i < ARRAY_SIZE(sequences); i++)
+			for (size_t j = 0; j < sequences[i].count; j++) {
+				ret = atc_validate_step(dp, &sequences[i].ops[j]);
+				if (ret)
+					return ret;
+			}
+		for (unsigned int group = 0; group < ARRAY_SIZE(rates); group++)
+			for (size_t i = 0; i < counts[group]; i++)
+				for (unsigned int rate = 0; rate < ARRAY_SIZE(link_rates); rate++) {
+					struct atc_op op = rates[group][i].op;
+					if (!(rates[group][i].rates & BIT(rate)))
+						continue;
+					op.value = rates[group][i].values[rate];
+					ret = atc_validate_step(dp, &op);
+					if (ret)
+						return ret;
+				}
+	}
+	for (unsigned int i = 0; i < ARRAY_SIZE(tunable_names); i++) {
+		if (i >= 9 && !dp->typec)
+			continue;
+		dp->tunables[i] = devm_apple_tunable_parse(dev, dev->of_node,
+				 tunable_names[i].name, &dp->resources[tunable_names[i].bank]);
+		if (IS_ERR(dp->tunables[i]))
+			return dev_err_probe(dev, PTR_ERR(dp->tunables[i]),
+					     "missing or invalid %s\n", tunable_names[i].name);
+	}
+	for (unsigned int i = 0; i < ARRAY_SIZE(training_names); i++) {
+		const char *name = training_names[i];
+
+		if (!of_property_present(dev->of_node, name))
+			name = "apple,dp-training-table";
+		if (!of_property_present(dev->of_node, name)) {
+			memcpy(dp->training[i], dp_training_default, sizeof(dp_training_default));
+			continue;
+		}
+		if (of_property_count_u32_elems(dev->of_node, name) != 16)
+			return -EINVAL;
+		ret = of_property_read_u32_array(dev->of_node, name, dp->training[i], 16);
+		if (ret)
+			return ret;
+	}
+	/* Three named domains prevent automatic wrapper enable at probe time. */
+	if (of_count_phandle_with_args(dev->of_node, "power-domains", "#power-domain-cells") != 3)
+		return -EINVAL;
+	for (unsigned int i = 0; i < ARRAY_SIZE(domains); i++) {
+		dp->domain[i].dev = dev_pm_domain_attach_by_name(dev, domains[i]);
+		if (IS_ERR_OR_NULL(dp->domain[i].dev))
+			return dev_err_probe(dev, dp->domain[i].dev ? PTR_ERR(dp->domain[i].dev) : -ENODEV,
+					     "cannot attach %s domain\n", domains[i]);
+		ret = devm_add_action_or_reset(dev, atc_domain_release, &dp->domain[i]);
+		if (ret)
+			return ret;
+	}
+	if (dp->typec) {
+		dp->fw_data = devm_platform_ioremap_resource_byname(pdev, "firmware-data");
+		if (IS_ERR(dp->fw_data))
+			return PTR_ERR(dp->fw_data);
+		dp->rtkit = devm_apple_rtkit_init(dev, dp, NULL, 0, &atc_fw_ops);
+		if (IS_ERR(dp->rtkit))
+			return dev_err_probe(dev, PTR_ERR(dp->rtkit), "cannot initialize PHY firmware IPC\n");
+	}
+	if (dp->combo) {
+		ret = combo_setup(pdev, dp);
+		if (ret)
+			return ret;
+	}
+	phy = devm_phy_create(dev, NULL, &t6050_dp_ops);
+	if (IS_ERR(phy))
+		return PTR_ERR(phy);
+	phy_set_drvdata(phy, dp);
+	dp->combo_phy[2] = phy;
+	provider = devm_of_phy_provider_register(dev, dp->combo ? combo_xlate : of_phy_simple_xlate);
+	if (IS_ERR(provider))
+		return PTR_ERR(provider);
+	return dp->typec ? t6050_typec_register(dp) : 0;
+}
+
+static void t6050_dp_shutdown(struct platform_device *pdev)
+{
+	struct t6050_dp *dp = platform_get_drvdata(pdev);
+
+	guard(mutex)(&dp->lock);
+	if (dp->combo ? combo_stop(dp) : atc_stop(dp))
+		dev_warn(dp->dev, "PHY shutdown incomplete after an earlier error\n");
+}
+
+static const struct of_device_id t6050_dp_match[] = {
+	{ .compatible = "apple,t6050-dp-phy" },
+	{ .compatible = "apple,t6050-combo-phy" },
+	{},
+};
+MODULE_DEVICE_TABLE(of, t6050_dp_match);
+static struct platform_driver t6050_dp_driver = {
+	.probe = t6050_dp_probe,
+	.remove = t6050_dp_shutdown,
+	.shutdown = t6050_dp_shutdown,
+	.driver = {
+		.name = "apple-t6050-dp-phy",
+		.of_match_table = t6050_dp_match,
+	},
+};
+module_platform_driver(t6050_dp_driver);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Apple T6050 DisplayPort and Type-C USB combo PHY");
