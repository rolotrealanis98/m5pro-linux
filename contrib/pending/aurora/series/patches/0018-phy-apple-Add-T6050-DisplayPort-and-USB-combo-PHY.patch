+    { T6050_DELAY, 0, 0x0, 0x0, 0x1, 0, 0 },
+    { T6050_MASK, 39, 0x0, 0x4, 0x4, 0, 0 },
+    { T6050_DELAY, 0, 0x0, 0x0, 0x1, 0, 0 },
+    { T6050_MASK, 39, 0x0, 0x2, 0x0, 0, 0 },
+    { T6050_DELAY, 0, 0x0, 0x0, 0x1, 0, 0 },
+    { T6050_POLL, 39, 0x4, 0x2, 0x0, 1000, 0 },
+    { T6050_DELAY, 0, 0x0, 0x0, 0x1, 0, 0 },
+    { T6050_MASK, 39, 0x0, 0x1, 0x0, 0, 0 },
+    { T6050_DELAY, 0, 0x0, 0x0, 0x1, 0, 0 },
+    { T6050_POLL, 39, 0x4, 0x1, 0x0, 1000, 0 },
+    { T6050_DELAY, 0, 0x0, 0x0, 0x1, 0, 0 },
+    { T6050_MASK, 39, 0x8, 0x1, 0x0, 0, 0 },
+    { T6050_DELAY, 0, 0x0, 0x0, 0x1, 0, 0 },
+};
+
+static inline int
+apple_t6050_usb_phy_run(const struct apple_t6050_usb_platform *p,
+                      const struct apple_t6050_usb_step *steps, unsigned int count)
+{
+    if (!p || !p->io || !p->io->read || !p->io->write ||
+        !p->io->poll || !p->io->delay || !p->wrapper_power ||
+        !p->firmware || !p->tunable)
+        return -1;
+    for (unsigned int i = 0; i < count; i++) {
+        const struct apple_t6050_usb_step *s = &steps[i];
+        int ret = 0;
+        switch (s->op) {
+        case T6050_MASK:
+            apple_t6050_usb_mask(p->io, s->bank, s->offset, s->mask, s->value);
+            break;
+        case T6050_POLL:
+            ret = p->io->poll(p->io->context, s->bank, s->offset,
+                              s->mask, s->value, s->timeout);
+            break;
+        case T6050_DELAY: p->io->delay(p->io->context, s->value); break;
+        case T6050_POWER: ret = p->wrapper_power(p->context, s->value); break;
+        case T6050_FIRMWARE: ret = p->firmware(p->context, s->value); break;
+        case T6050_TUNABLE: ret = p->tunable(p->context, s->bank, s->name); break;
+        default: return -1;
+        }
+        if (ret)
+            return ret;
+    }
+    return 0;
+}
+#define APPLE_T6050_USB_RUN(p, steps) \
+    apple_t6050_usb_phy_run((p), (steps), sizeof(steps) / sizeof((steps)[0]))
+
+/* Native shutdown first asserts PORT_RESET only if it was not already set.
+ * The 5 ms wait belongs to that transition, not every redundant stop call.
+ * Preserve IOPause(500 ns), whose unit differs from IODelay(microseconds).
+ */
+static inline int apple_t6050_usb2_stop(const struct apple_t6050_usb_platform *p)
+{
+    if (!p || !p->io || !p->io->read || !p->io->write ||
+        !p->io->delay || !p->pause_ns)
+        return -1;
+    if (!(p->io->read(p->io->context, 0, 4) & 2)) {
+        apple_t6050_usb_mask(p->io, 0, 4, 2, 2);
+        p->io->delay(p->io->context, 5000);
+    }
+    apple_t6050_usb_mask(p->io, 0, 0, 7, 4);
+    apple_t6050_usb_mask(p->io, 0, 4, 8, 8);
+    apple_t6050_usb_mask(p->io, 0, 4, 1, 1);
+    apple_t6050_usb_mask(p->io, 0, 0x1c, 0x20000000, 0x20000000);
+    apple_t6050_usb_mask(p->io, 0, 0x1c, 0x40000000, 0x40000000);
+    p->pause_ns(p->context, 500);
+    return 0;
+}
+#endif
