From 6f13992337bc8731cec358576ae97913ab689b4d Mon Sep 17 00:00:00 2001
From: Dj <hey@djdev.me>
Date: Fri, 6 Nov 2026 18:48:49 -0500
Subject: [PATCH 4/4] power: supply: macsmc-power: read battery identity
 strings at their key size

Probe reads BMDN, BMSN and BMDT with the size of the destination buffer
instead of the size of the key. SMC read requests must describe the key,
not the buffer. Read each identity key's info first, refuse a key that
is empty, unreadable or too large for the buffer, read exactly its size
and terminate the string. Also check for the SMC parent before using it.

This is the drivers/power/supply/macsmc-power.c part of Aurora commit
54b12371013e ("mfd: macsmc: Support T6050 power and pcIO consumers",
branch j716c/t6050-platform), which applies unchanged; the gpio-macsmc,
macsmc MFD and binding parts are left out. A T6050 kernel without it
hung in macsmc-power probe (J716s, 2026-11-05, last line after "Apple
SMC power/lid events"); whether these reads were the cause is not
established.

Signed-off-by: Dj <hey@djdev.me>
Signed-off-by: Erik Bourget <erik@ebourget.net>
---
 drivers/power/supply/macsmc-power.c | 41 ++++++++++++++++++++++++-----
 1 file changed, 34 insertions(+), 7 deletions(-)

diff --git a/drivers/power/supply/macsmc-power.c b/drivers/power/supply/macsmc-power.c
index 26580a8eb63a..d98e5347af77 100644
--- a/drivers/power/supply/macsmc-power.c
+++ b/drivers/power/supply/macsmc-power.c
@@ -960,10 +960,34 @@ static int macsmc_power_event(struct notifier_block *nb, unsigned long event, vo
 	return NOTIFY_DONE;
 }
 
+static int macsmc_read_identity(struct apple_smc *smc, smc_key key,
+			       char *out, size_t capacity)
+{
+	struct apple_smc_key_info info;
+	int ret;
+
+	if (!capacity)
+		return -EINVAL;
+	out[0] = '\0';
+	ret = apple_smc_get_key_info(smc, key, &info);
+	if (ret < 0)
+		return ret;
+	if (!info.size || info.size >= capacity || !(info.flags & APPLE_SMC_READABLE))
+		return -EINVAL;
+	/* SMC read requests must describe this key, not the destination buffer. */
+	ret = apple_smc_read(smc, key, out, info.size);
+	if (ret != info.size) {
+		out[0] = '\0';
+		return ret < 0 ? ret : -EIO;
+	}
+	out[info.size] = '\0';
+	return 0;
+}
+
 static int macsmc_power_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
-	struct apple_smc *smc = dev_get_drvdata(pdev->dev.parent);
+	struct apple_smc *smc;
 	struct power_supply_config psy_cfg = {};
 	struct apple_smc_key_info info;
 	struct macsmc_power *power;
@@ -976,6 +1000,9 @@ static int macsmc_power_probe(struct platform_device *pdev)
 	enum power_supply_property *props;
 	size_t nprops;
 
+	if (!dev->parent)
+		return dev_err_probe(dev, -ENODEV, "Missing SMC parent\n");
+	smc = dev_get_drvdata(dev->parent);
 	if (!smc)
 		return -ENODEV;
 
@@ -1128,12 +1155,12 @@ static int macsmc_power_probe(struct platform_device *pdev)
 		power->batt_desc.num_properties = nprops;
 
 		/* Fetch identity strings */
-		apple_smc_read(smc, SMC_KEY(BMDN), power->model_name,
-			       sizeof(power->model_name) - 1);
-		apple_smc_read(smc, SMC_KEY(BMSN), power->serial_number,
-			       sizeof(power->serial_number) - 1);
-		apple_smc_read(smc, SMC_KEY(BMDT), power->mfg_date,
-			       sizeof(power->mfg_date) - 1);
+		macsmc_read_identity(smc, SMC_KEY(BMDN), power->model_name,
+				     sizeof(power->model_name));
+		macsmc_read_identity(smc, SMC_KEY(BMSN), power->serial_number,
+				     sizeof(power->serial_number));
+		macsmc_read_identity(smc, SMC_KEY(BMDT), power->mfg_date,
+				     sizeof(power->mfg_date));
 
 		apple_smc_read_u8(power->smc, SMC_KEY(BNCB), &power->num_cells);
 		power->nominal_voltage_mv = MACSMC_NOMINAL_CELL_VOLTAGE_MV * power->num_cells;
-- 
