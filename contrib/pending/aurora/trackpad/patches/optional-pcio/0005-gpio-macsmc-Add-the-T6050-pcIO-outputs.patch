From 7272a42a27e6570286acd2c0a0a0fd4b52f208e9 Mon Sep 17 00:00:00 2001
From: Dj <hey@djdev.me>
Date: Fri, 6 Nov 2026 18:50:37 -0500
Subject: [PATCH] gpio: macsmc: Add the T6050 pcIO outputs

The writable eight-byte pcIO SMC key drives board outputs through command
templates that the device tree lists in apple,output-commands; the driver
inserts the level in the low 16 bits. Register the outputs as their own
MFD cell, macsmc-pcio-gpio, where the device tree has an
apple,smc-pcio-gpio child.

This is the gpio-macsmc and binding part of Aurora commit 54b12371013e
("mfd: macsmc: Support T6050 power and pcIO consumers", branch
j716c/t6050-platform), unchanged, with only the pcIO cell of its MFD
part. The T6050 cell profile is left out: on this tree it would drop the
reboot, RTC and GPIO cells (Aurora restores reboot and RTC in
64f198a02f63). The cell gets its own name because this tree keeps the
macsmc-gpio cell, and two PLATFORM_DEVID_NONE devices named macsmc-gpio
cannot both register.

Signed-off-by: Dj <hey@djdev.me>
Signed-off-by: Erik Bourget <erik@ebourget.net>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/gpio/apple,smc-pcio-gpio.yaml    | 40 ++++++++++
 .../devicetree/bindings/mfd/apple,smc.yaml    |  4 +-
 drivers/gpio/gpio-macsmc.c                    | 73 ++++++++++++++++++-
 drivers/mfd/macsmc.c                          | 14 ++++
 4 files changed, 129 insertions(+), 2 deletions(-)
 create mode 100644 Documentation/devicetree/bindings/gpio/apple,smc-pcio-gpio.yaml

diff --git a/Documentation/devicetree/bindings/gpio/apple,smc-pcio-gpio.yaml b/Documentation/devicetree/bindings/gpio/apple,smc-pcio-gpio.yaml
new file mode 100644
index 000000000000..94d9672189fc
--- /dev/null
+++ b/Documentation/devicetree/bindings/gpio/apple,smc-pcio-gpio.yaml
@@ -0,0 +1,40 @@
+# SPDX-License-Identifier: GPL-2.0-only
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/gpio/apple,smc-pcio-gpio.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple SMC pcIO output GPIOs
+
+maintainers:
+  - Dj <hey@djdev.me>
+
+description: |
+  The writable eight-byte pcIO SMC key controls outputs through board
+  command templates. Each template has its low 16 bits clear; the driver
+  inserts a boolean output level and sends the little-endian command.
+  Input reads and mode changes are not supported by this interface.
+
+properties:
+  compatible:
+    const: apple,smc-pcio-gpio
+
+  gpio-controller: true
+
+  '#gpio-cells':
+    const: 2
+
+  apple,output-commands:
+    $ref: /schemas/types.yaml#/definitions/uint64-array
+    minItems: 1
+    maxItems: 64
+    uniqueItems: true
+    description: Unique command templates with low 16 bits clear, in GPIO order
+
+required:
+  - compatible
+  - gpio-controller
+  - '#gpio-cells'
+  - apple,output-commands
+
+additionalProperties: false
diff --git a/Documentation/devicetree/bindings/mfd/apple,smc.yaml b/Documentation/devicetree/bindings/mfd/apple,smc.yaml
index 8641aaeb432e..417d0f35e6cb 100644
--- a/Documentation/devicetree/bindings/mfd/apple,smc.yaml
+++ b/Documentation/devicetree/bindings/mfd/apple,smc.yaml
@@ -51,7 +51,9 @@ properties:
     maxItems: 1
 
   gpio:
-    $ref: /schemas/gpio/apple,smc-gpio.yaml
+    oneOf:
+      - $ref: /schemas/gpio/apple,smc-gpio.yaml
+      - $ref: /schemas/gpio/apple,smc-pcio-gpio.yaml
 
   gpio-low:
     $ref: /schemas/gpio/apple,smc-gpio.yaml
diff --git a/drivers/gpio/gpio-macsmc.c b/drivers/gpio/gpio-macsmc.c
index b9500afad3ce..1e099ede17cf 100644
--- a/drivers/gpio/gpio-macsmc.c
+++ b/drivers/gpio/gpio-macsmc.c
@@ -1,4 +1,4 @@
-// SPDX-License-Identifier: GPL-2.0-only OR MIT
+// SPDX-License-Identifier: (GPL-2.0-only OR MIT) AND GPL-2.0-only
 /*
  * Apple SMC GPIO driver
  * Copyright The Asahi Linux Contributors
@@ -15,6 +15,7 @@
 #include <linux/mfd/macsmc.h>
 #include <linux/mutex.h>
 #include <linux/of.h>
+#include <linux/unaligned.h>
 
 #define MAX_GPIO 64
 
@@ -101,6 +102,7 @@ struct macsmc_gpio {
 	struct apple_smc *smc;
 	struct gpio_chip gc;
 
+	u64 *output_commands;
 	int first_index;
 	smc_key base_key;
 
@@ -342,6 +344,72 @@ static int macsmc_gpio_init_valid_mask(struct gpio_chip *gc,
 	return 0;
 }
 
+/* Each DT template identifies one output; its low 16 bits carry the value. */
+static int macsmc_pcio_set(struct gpio_chip *gc, unsigned int offset, int value)
+{
+	struct macsmc_gpio *smcgp = gpiochip_get_data(gc);
+	u8 command[8];
+	int ret;
+
+	put_unaligned_le64(smcgp->output_commands[offset] | !!value, command);
+	ret = apple_smc_write(smcgp->smc, SMC_KEY(pcIO), command, sizeof(command));
+	/* SMC writes return status, not a byte count. */
+	return ret < 0 ? ret : 0;
+}
+
+static int macsmc_pcio_get(struct gpio_chip *gc, unsigned int offset)
+{
+	/* The native output command has no established input/readback operation. */
+	return -EOPNOTSUPP;
+}
+
+static int macsmc_pcio_get_direction(struct gpio_chip *gc, unsigned int offset)
+{
+	return GPIO_LINE_DIRECTION_OUT;
+}
+
+static int macsmc_pcio_probe(struct macsmc_gpio *smcgp)
+{
+	struct device *dev = smcgp->dev;
+	struct apple_smc_key_info info;
+	int count, ret;
+
+	ret = apple_smc_get_key_info(smcgp->smc, SMC_KEY(pcIO), &info);
+	if (ret < 0)
+		return ret;
+	if (info.size != 8 || !(info.flags & APPLE_SMC_WRITABLE))
+		return dev_err_probe(dev, -EINVAL, "pcIO is not an eight-byte output key\n");
+	count = of_property_count_u64_elems(dev->of_node, "apple,output-commands");
+	if (count <= 0 || count > MAX_GPIO)
+		return -EINVAL;
+	smcgp->output_commands = devm_kcalloc(dev, count, sizeof(u64), GFP_KERNEL);
+	if (!smcgp->output_commands)
+		return -ENOMEM;
+	ret = of_property_read_u64_array(dev->of_node, "apple,output-commands",
+					smcgp->output_commands, count);
+	if (ret)
+		return ret;
+	for (int i = 0; i < count; i++) {
+		if (smcgp->output_commands[i] & 0xffff)
+			return -EINVAL;
+		for (int j = 0; j < i; j++)
+			if (smcgp->output_commands[i] == smcgp->output_commands[j])
+				return -EINVAL;
+	}
+
+	smcgp->gc.label = "macsmc-pcio-output";
+	smcgp->gc.owner = THIS_MODULE;
+	smcgp->gc.get = macsmc_pcio_get;
+	smcgp->gc.set = macsmc_pcio_set;
+	smcgp->gc.direction_output = macsmc_pcio_set;
+	smcgp->gc.get_direction = macsmc_pcio_get_direction;
+	smcgp->gc.can_sleep = true;
+	smcgp->gc.ngpio = count;
+	smcgp->gc.base = -1;
+	smcgp->gc.parent = dev;
+	return devm_gpiochip_add_data(dev, &smcgp->gc, smcgp);
+}
+
 struct macsmc_gpio_of_match_data {
 	smc_key base_key;
 };
@@ -360,6 +428,8 @@ static int macsmc_gpio_probe(struct platform_device *pdev)
 
 	smcgp->dev = &pdev->dev;
 	smcgp->smc = smc;
+	if (device_is_compatible(&pdev->dev, "apple,smc-pcio-gpio"))
+		return macsmc_pcio_probe(smcgp);
 	smcgp->base_key = data ? data->base_key : _SMC_KEY("gP\0\0");
 	smcgp->j700_pcio = of_machine_is_compatible("apple,j700") &&
 				device_is_compatible(&pdev->dev, "apple,smc-gpio");
@@ -405,6 +475,7 @@ static const struct macsmc_gpio_of_match_data macsmc_gpio_low_data = {
 };
 
 static const struct of_device_id macsmc_gpio_of_table[] = {
+	{ .compatible = "apple,smc-pcio-gpio" },
 	{
 		.compatible = "apple,smc-gpio",
 		.data = &macsmc_gpio_up_data,
diff --git a/drivers/mfd/macsmc.c b/drivers/mfd/macsmc.c
index 546e5cdbb72a..2e7780717c26 100644
--- a/drivers/mfd/macsmc.c
+++ b/drivers/mfd/macsmc.c
@@ -59,6 +59,10 @@ static const struct mfd_cell apple_smc_devs[] = {
 	MFD_CELL_OF("macsmc-rtc", NULL, NULL, 0, 0, "apple,smc-rtc"),
 };
 
+/* The pcIO outputs, where the board describes them (T6050). */
+static const struct mfd_cell apple_smc_pcio_dev =
+	MFD_CELL_OF("macsmc-pcio-gpio", NULL, NULL, 0, 0, "apple,smc-pcio-gpio");
+
 /* The second GPIO bank ('gp' keys) only exists on some SMCs. */
 static const struct mfd_cell apple_smc_low_gpio_dev =
 	MFD_CELL_OF("macsmc-low-gpio", NULL, NULL, 0, 0, "apple,smc-low-gpio");
@@ -565,6 +569,16 @@ static int apple_smc_probe(struct platform_device *pdev)
 	if (ret)
 		return dev_err_probe(smc->dev, ret, "Failed to register sub-devices");
 
+	np = of_get_compatible_child(dev->of_node, "apple,smc-pcio-gpio");
+	if (np) {
+		of_node_put(np);
+		ret = devm_mfd_add_devices(smc->dev, PLATFORM_DEVID_NONE,
+					   &apple_smc_pcio_dev, 1, NULL, 0, NULL);
+		if (ret)
+			return dev_err_probe(smc->dev, ret,
+					     "Failed to register the pcIO outputs");
+	}
+
 	/*
 	 * Register the second GPIO bank only where the device tree describes
 	 * it: the MFD core would otherwise create an unbound device and warn
-- 
2.56.0

