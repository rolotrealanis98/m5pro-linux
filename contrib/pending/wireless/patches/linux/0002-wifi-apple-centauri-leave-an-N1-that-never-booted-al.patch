From ff289b9ce8ec7b090c0b17265bb5f48988d531ab Mon Sep 17 00:00:00 2001
From: ed <edimoldovan@gmail.com>
Date: Fri, 6 Nov 2026 13:47:59 +0100
Subject: [PATCH 2/2] wifi: apple: centauri: leave an N1 that never booted
 alone at remove and shutdown

On the J714c, a restart with the N1 adopted but without its firmware file hung the SoC
inside the driver's shutdown (initcall_debug on the panel: the last device line before
the CPU stall is apple_centauri 0000:01:00.0: shutdown): centauri_stop_dma's config-space
accesses to the endpoint never complete. An N1 whose ROM boot never started has no DMA
and no bus mastering to stop, so remove and shutdown return before touching it.

Taken from edimoldovan/linux-aurora t6050-j714c commit 3a1bae4f8550.

Signed-off-by: Rolando Trevino <rolotrealanis@gmail.com>
---
 drivers/net/wireless/apple/centauri/centauri_pci.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/drivers/net/wireless/apple/centauri/centauri_pci.c b/drivers/net/wireless/apple/centauri/centauri_pci.c
index 42e768c351ac..b1984fa8eb3a 100644
--- a/drivers/net/wireless/apple/centauri/centauri_pci.c
+++ b/drivers/net/wireless/apple/centauri/centauri_pci.c
@@ -383,6 +383,17 @@ static void centauri_remove(struct pci_dev *pdev)
 	WRITE_ONCE(c->removing, true);
 	cancel_delayed_work_sync(&c->boot_work);
 	mutex_lock(&c->boot_lock);
+	/*
+	 * Nothing to stop on an N1 whose ROM boot never started (no firmware file, no
+	 * DMA, bus mastering never enabled): on the J714c the config-space accesses of
+	 * centauri_stop_dma hang the SoC at a restart in that state.
+	 */
+	if (!c->boot_attempted) {
+		dev_info(&pdev->dev, "N1 never booted: leaving it untouched\n");
+		c->boot_phase = CEN_BOOT_STOPPED;
+		mutex_unlock(&c->boot_lock);
+		return;
+	}
 	centauri_wifi_unregister(c);
 	centauri_free_boot(c);
 	c->boot_phase = CEN_BOOT_STOPPED;
-- 
