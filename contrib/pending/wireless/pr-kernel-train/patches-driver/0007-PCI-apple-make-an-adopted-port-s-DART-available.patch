From 02f083465e8ad5386bd69a34fdd263099c7d2949 Mon Sep 17 00:00:00 2001
From: ed <edimoldovan@gmail.com>
Date: Sat, 7 Nov 2026 09:50:13 +0100
Subject: [PATCH 7/9] PCI: apple: make an adopted port's DART available

Once a port is adopted, trained by the bootloader or by Linux, the root
complex is up: make the port's DART available.

Link: https://github.com/edimoldovan/linux-aurora/commit/3291060c462a
Signed-off-by: Rolando Trevino <rolotrealanis@gmail.com>
---
 drivers/pci/controller/pcie-apple.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/drivers/pci/controller/pcie-apple.c b/drivers/pci/controller/pcie-apple.c
index 0214ceb8c1e5..eeda81dade0a 100644
--- a/drivers/pci/controller/pcie-apple.c
+++ b/drivers/pci/controller/pcie-apple.c
@@ -2253,6 +2253,18 @@ static int apple_pcie_t6050_shared_phy_on(struct apple_pcie *pcie)
 	return 0;
 }
 
+/* The port's DART answers once the root complex is up (apple,manual-availability) */
+static void apple_pcie_dart_available(struct apple_pcie_port *port)
+{
+	struct of_phandle_args iommu = {};
+
+	if (of_map_iommu_id(port->pcie->dev->of_node, port->adopted_bus << 8, &iommu) ||
+	    !iommu.np)
+		return;
+	apple_dart_make_available(iommu.np);
+	of_node_put(iommu.np);
+}
+
 static int apple_pcie_t6050_cold_train(struct apple_pcie_port *port)
 {
 	struct apple_pcie *pcie = port->pcie;
@@ -2641,6 +2653,7 @@ static int apple_pcie_setup_port(struct apple_pcie *pcie,
 		}
 		if (ret)
 			goto err_teardown;
+		apple_pcie_dart_available(port);
 	} else {
 		if (pcie->hw->retain_clocks)
 			rmw_set(PORT_APPCLK_EN, port->base + PORT_APPCLK);
-- 
