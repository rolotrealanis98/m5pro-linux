# OPTIONAL: embed the firmware for the dongles actually owned into Image.gz,
# so the =y drivers find it at first enumeration (before the root fs).
# Merge after omarchy-wireless-dongles.config. Stage the uncompressed files
# from linux-firmware (and wireless-regdb) under EXTRA_FIRMWARE_DIR first:
# scripts/stage-wireless-fw.sh in the deliverable does that. The build fails
# loudly if a listed file is missing.
#
# Default set: MT7921AU Wi-Fi + its BT, RTL8761BU BT dongle, regulatory db.
# Keep it to the hardware you have; every file grows the kernel image.
CONFIG_EXTRA_FIRMWARE="regulatory.db regulatory.db.p7s mediatek/WIFI_MT7961_patch_mcu_1_2_hdr.bin mediatek/WIFI_RAM_CODE_MT7961_1.bin mediatek/BT_RAM_CODE_MT7961_1_2_hdr.bin rtl_bt/rtl8761bu_fw.bin"
CONFIG_EXTRA_FIRMWARE_DIR="/Users/rolo/Work/agents/wireless/fw-staging"
