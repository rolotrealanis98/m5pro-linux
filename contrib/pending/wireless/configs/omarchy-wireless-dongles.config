# omarchy-m5 / m5pro-linux: USB Wi-Fi + USB Bluetooth dongles on the J716s.
#
# Merge AFTER omarchy-storage-net.config, omarchy-smc.config and the pending
# omarchy-usb-host.config (contrib/pending/usb). Without the USB host DTB
# (t6050-j716s-usbhost.dtb) nothing here can enumerate: every Type-C port is
# a gadget today.
#
# Everything is =y: the kernel ships as Image.gz without modules_install, so
# =m drivers never reach the Arch root.
#
# Firmware: built-in drivers probe as soon as the dongle enumerates (~6 s),
# before the root fs is mounted (~13.5 s). Their firmware must then come
# from the initramfs (/lib/firmware inside it) or from the kernel image
# (CONFIG_EXTRA_FIRMWARE, see omarchy-wireless-embed-fw.config). Firmware
# on the root alone only helps after an unbind/bind, and hot-replug is not
# reliable on the USB2-only host PHY yet (eUSB2 repeater re-sync).

# --- 802.11 core -----------------------------------------------------------
# cfg80211 depends on RFKILL || !RFKILL: RFKILL=m would cap it at m.
CONFIG_RFKILL=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=y
CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS=y
CONFIG_CFG80211_DEFAULT_PS=y
CONFIG_MAC80211=y
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_MAC80211_LEDS=y
CONFIG_WLAN=y

# --- MediaTek (first choice) ------------------------------------------------
# MT7921AU/MT7921AUN: Wi-Fi 6/6E, USB id 0e8d:7961 (+ Netgear/TP-Link ids)
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7921U=y
# MT7925U: Wi-Fi 7 (Netgear A8500/A9000); USB2 host caps it anyway
CONFIG_MT7925U=y
# Wi-Fi 5 / Wi-Fi 4 MediaTek USB parts (mt7612u, mt7610u, mt7601u)
CONFIG_MT76x2U=y
CONFIG_MT76x0U=y
CONFIG_MT7601U=y

# --- Realtek ----------------------------------------------------------------
CONFIG_WLAN_VENDOR_REALTEK=y
# rtw89 USB (Wi-Fi 6/6E/7): RTL8832BU/8852BU, RTL8832CU/8852CU, 8851BU, 8922AU
CONFIG_RTW89=y
CONFIG_RTW89_8851BU=y
CONFIG_RTW89_8852AU=y
CONFIG_RTW89_8852BU=y
CONFIG_RTW89_8852CU=y
CONFIG_RTW89_8922AU=y
# rtw88 USB (Wi-Fi 5): RTL8811CU/8821CU, 8812BU/8822BU, 8822CU, 8812AU, 8821AU, 8814AU
CONFIG_RTW88=y
CONFIG_RTW88_8821CU=y
CONFIG_RTW88_8822BU=y
CONFIG_RTW88_8822CU=y
CONFIG_RTW88_8812AU=y
CONFIG_RTW88_8821AU=y
CONFIG_RTW88_8814AU=y
# rtl8xxxu: older RTL8188/8192/8723 USB parts
CONFIG_RTL8XXXU=y

# --- Atheros: the open-firmware safe fallback (AR9271 / AR7010) -------------
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K_HTC=y

# --- Firmware loader --------------------------------------------------------
# ALARM's linux-firmware installs uncompressed files, but x86 Arch and
# hand-copied trees use .zst/.xz; accept both.
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_FW_LOADER_COMPRESS_XZ=y

# --- Crypto that iwd checks for at startup (src/main.c) --------------------
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_MD4=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_DES=y
CONFIG_KEYS=y
CONFIG_KEY_DH_OPERATIONS=y
# EAP-TLS / 802.1X certificates
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_ASYMMETRIC_PUBLIC_KEY_SUBTYPE=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_PKCS7_MESSAGE_PARSER=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y

# --- Bluetooth (btusb) ------------------------------------------------------
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIBTUSB_BCM=y
# CONFIG_BT_HCIBTUSB_AUTOSUSPEND is not set
CONFIG_BT_MTK=y
CONFIG_BT_RTL=y
CONFIG_BT_BCM=y
CONFIG_BT_INTEL=y
# BLE keyboards/mice (HoG) go through uhid in bluetoothd
CONFIG_UHID=y
CONFIG_INPUT_UINPUT=y
