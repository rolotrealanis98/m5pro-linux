#!/bin/sh
# Copy the SEP key store files to the ESP (m5sep/) when they differ, so the initramfs unseal always sees the copy the driver wrote last.
# Why: apple_sep rewrites /var/lib/aurora-sep-keybag.bin on every boot (mtime), and an initramfs copy frozen at build time can go stale.
# Runs after touchid-up and whenever the files change (m5pro-sep-keystore-sync.path). Atomic per file (tmp + rename on the FAT ESP).
# The files are secret state (keybag holds the bag secret): the ESP copy has the same exposure as the copy inside the payload.
set -u
SRC=/var/lib; DST=/boot/m5sep
mountpoint -q /boot || mount /boot 2>/dev/null || exit 0
mkdir -p "$DST" || exit 0
n=0
for f in aurora-sep-keybag.bin aurora-sep-refkey.bin aurora-sep-refkey-v2.bin; do
    [ -s "$SRC/$f" ] || continue
    cmp -s "$SRC/$f" "$DST/$f" && continue
    cp "$SRC/$f" "$DST/.$f.tmp" && sync "$DST/.$f.tmp" && mv -f "$DST/.$f.tmp" "$DST/$f" && { echo "m5pro-sep-keystore-sync: updated $f ($(sha256sum < "$SRC/$f" | cut -c1-12))"; n=$((n+1)); }
done
[ $n -gt 0 ] && sync
exit 0
