From ffbfc3f44d6ce6a7f37af31a3f75cc252e534b56 Mon Sep 17 00:00:00 2001
From: Rolando Trevino <rolotrealanis@gmail.com>
Date: Sat, 7 Nov 2026 13:50:20 -0500
Subject: [PATCH 4/9] dt-bindings: npu: apple,ane: Add T6050

The T6050 (M5 Pro, Max and Ultra) ANE reports the T8140's firmware
generation (H17, HWX subtype 9) with board type 0x220, and has the
T6041's seven register windows (engine, PMGR and five auxiliary
windows), two interrupts, one system power domain, preloaded firmware
and an exclave-assigned coprocessor. Its firmware DATA segment starts
at 0x100000bc000 and its ADT lists five DAPF records, one more than the
T6041 and T8140.

Describe it, allow a fifth DAPF range and the T6050 DATA address only
for it, and keep the T6041 and T8140 at four ranges and their DATA
address.

Also write the last power-domains rule as if/then: an else without a
then fails the dtschema meta-schema.

Assisted-by: LLM Claude
Signed-off-by: Rolando Trevino <rolotrealanis@gmail.com>
---
 .../devicetree/bindings/npu/apple,ane.yaml    | 126 +++++++++++++++---
 1 file changed, 108 insertions(+), 18 deletions(-)

diff --git a/Documentation/devicetree/bindings/npu/apple,ane.yaml b/Documentation/devicetree/bindings/npu/apple,ane.yaml
index 6e50f9f11b23..f001ab632704 100644
--- a/Documentation/devicetree/bindings/npu/apple,ane.yaml
+++ b/Documentation/devicetree/bindings/npu/apple,ane.yaml
@@ -18,8 +18,11 @@ description:
   coprocessor is exclave-assigned and cannot be used directly without a
   Linux ownership provider. T6041 has one interrupt and preloaded firmware;
   its CPU, MPM and task domains depend on the ANE system domain, and its
-  base domain depends on the task domain. Interrupt roles on T6041 and
-  T8140 are not yet established.
+  base domain depends on the task domain. T6050 runs the T8140's firmware
+  generation with the T6041's seven register windows, two interrupts, one
+  system power domain, preloaded firmware and an exclave-assigned
+  coprocessor. Interrupt roles on T6041, T6050 and T8140 are not yet
+  established.
 
 properties:
   compatible:
@@ -31,6 +34,7 @@ properties:
           - apple,t6021-ane
           - apple,t6022-ane
           - apple,t6041-ane
+          - apple,t6050-ane
           - apple,t8112-ane
           - apple,t8140-ane
       - items:
@@ -94,9 +98,9 @@ properties:
     description:
       The power states the engine needs, five on T8103, six on T6000 with
       ANE level control (including PMP report SRAM), eight on
-      T602x, seven on T8112 and one system domain on T8140. T6041 may add
-      a sixth, "perf", a performance floor (such as the SoC rail floor)
-      that the driver holds only while requests are in flight.
+      T602x, seven on T8112 and one system domain on T8140 and T6050.
+      T6041 may add a sixth, "perf", a performance floor (such as the SoC
+      rail floor) that the driver holds only while requests are in flight.
     minItems: 1
     maxItems: 8
 
@@ -117,7 +121,7 @@ properties:
     maxItems: 2
     description:
       On T602x, the IOVA-only reservation of the firmware entry alias.
-      On T6041 and T8140, bootloader-provided physical TEXT and DATA preload
+      On T6041, T6050 and T8140, bootloader-provided physical TEXT and DATA preload
       reservations in that order. Each reservation must have no-map, must
       not be reusable, and must remain reserved until reboot. Physical
       addresses vary per boot and must not be hard-coded in a board DTS.
@@ -131,24 +135,25 @@ properties:
     $ref: /schemas/types.yaml#/definitions/uint64-array
     items:
       - const: 0x10000000000
-      - const: 0x100000c0000
+      - enum: [0x100000bc000, 0x100000c0000]
     description:
       Device addresses of the preloaded TEXT and DATA segments. Their sizes
-      are 0xc0000 and 0x2ac000 bytes respectively. The bootloader supplies
+      are 0xc0000 and 0x2ac000 bytes respectively, and 0xbc000 and 0x2b0000
+      on T6050, where DATA starts at 0x100000bc000. The bootloader supplies
       the physical reservations. The device addresses are fixed by the
       firmware layout and may be described statically.
 
   apple,dapf-ranges:
     $ref: /schemas/types.yaml#/definitions/uint64-matrix
     minItems: 4
-    maxItems: 4
+    maxItems: 5
     items:
       items:
         - description: Physical start address, inclusive
         - description: Physical end address, inclusive
     description:
-      Four DART address protection filter (DAPF) ranges, in hardware record
-      order. Each pair contains inclusive 64-bit physical bounds, not a
+      Four (five on T6050) DART address protection filter (DAPF) ranges, in
+      hardware record order. Each pair contains inclusive 64-bit physical bounds, not a
       base and length. The same records apply to all three ANE DARTs.
       Firmware accesses these registers through identity mappings of the
       containing 16 KiB pages in its private domain. These are MMIO ranges,
@@ -167,7 +172,7 @@ properties:
 
   apple,ane-type:
     $ref: /schemas/types.yaml#/definitions/uint32
-    enum: [0x110, 0x200]
+    enum: [0x110, 0x200, 0x220]
     description: Firmware generation identifier supplied by the bootloader
 
   apple,firmware-preloaded:
@@ -222,6 +227,10 @@ allOf:
           maxItems: 1
         apple,ane-type:
           const: 0x200
+        apple,firmware-iovas:
+          items:
+            - const: 0x10000000000
+            - const: 0x100000c0000
   - if:
       properties:
         compatible:
@@ -236,6 +245,39 @@ allOf:
             - const: engine
             - const: pmgr
             - const: pwgate
+        apple,dapf-ranges:
+          maxItems: 4
+      required:
+        - apple,dapf-ranges
+  - if:
+      properties:
+        compatible:
+          const: apple,t6050-ane
+    then:
+      properties:
+        interrupts:
+          minItems: 2
+        reg:
+          minItems: 7
+        reg-names:
+          items:
+            - const: engine
+            - const: pmgr
+            - const: aux-0
+            - const: aux-1
+            - const: aux-2
+            - const: aux-3
+            - const: aux-4
+        power-domains:
+          maxItems: 1
+        apple,ane-type:
+          const: 0x220
+        apple,dapf-ranges:
+          minItems: 5
+        apple,firmware-iovas:
+          items:
+            - const: 0x10000000000
+            - const: 0x100000bc000
       required:
         - apple,dapf-ranges
   - if:
@@ -254,6 +296,7 @@ allOf:
         compatible:
           enum:
             - apple,t6041-ane
+            - apple,t6050-ane
             - apple,t8140-ane
       required:
         - memory-region
@@ -300,6 +343,12 @@ allOf:
             - const: perf
         apple,ane-type:
           const: 0x110
+        apple,dapf-ranges:
+          maxItems: 4
+        apple,firmware-iovas:
+          items:
+            - const: 0x10000000000
+            - const: 0x100000c0000
       required:
         - apple,ane-type
         - apple,firmware-preloaded
@@ -311,6 +360,7 @@ allOf:
             enum:
               - apple,t8140-ane
               - apple,t6041-ane
+              - apple,t6050-ane
     then:
       properties:
         interrupt-names: false
@@ -406,12 +456,14 @@ allOf:
   - if:
       properties:
         compatible:
-          contains:
-            enum:
-              - apple,t8140-ane
-              - apple,t6041-ane
-              - apple,t6001-ane
-    else:
+          not:
+            contains:
+              enum:
+                - apple,t8140-ane
+                - apple,t6041-ane
+                - apple,t6050-ane
+                - apple,t6001-ane
+    then:
       properties:
         power-domains:
           minItems: 5
@@ -548,3 +600,41 @@ examples:
             status = "disabled";
         };
     };
+
+  - |
+    #include <dt-bindings/interrupt-controller/apple-aic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        ane@508000000 {
+            compatible = "apple,t6050-ane";
+            reg = <0x5 0x08000000 0x0 0x2000000>,
+                  <0x2 0x80900000 0x0 0x18000>,
+                  <0x2 0x80920000 0x0 0x4000>,
+                  <0x2 0x84240000 0x0 0x40000>,
+                  <0x2 0x12000000 0x0 0xff4000>,
+                  <0x5 0x84000000 0x0 0x2000000>,
+                  <0x2 0x88374000 0x0 0x4000>;
+            reg-names = "engine", "pmgr", "aux-0", "aux-1", "aux-2",
+                        "aux-3", "aux-4";
+            interrupt-parent = <&aic>;
+            interrupts = <AIC_IRQ 0 954 IRQ_TYPE_LEVEL_HIGH>,
+                         <AIC_IRQ 0 967 IRQ_TYPE_LEVEL_HIGH>;
+            iommus = <&ane_dart0 0>, <&ane_dart1 0>, <&ane_dart2 0>;
+            power-domains = <&ps_ane_sys>;
+            apple,ane-type = <0x220>;
+            apple,firmware-preloaded;
+            apple,dapf-ranges = /bits/ 64 <0x2809003a8 0x2809003ab>,
+                                /bits/ 64 <0x2809003c0 0x2809003d3>,
+                                /bits/ 64 <0x581668000 0x581668003>,
+                                /bits/ 64 <0x2302668000 0x2302668003>,
+                                /bits/ 64 <0x6302668000 0x6302668003>;
+            memory-region = <&ane_fw_text>, <&ane_fw_data>;
+            memory-region-names = "firmware-text", "firmware-data";
+            apple,firmware-iovas = /bits/ 64 <0x10000000000 0x100000bc000>;
+            status = "disabled";
+        };
+    };
-- 
