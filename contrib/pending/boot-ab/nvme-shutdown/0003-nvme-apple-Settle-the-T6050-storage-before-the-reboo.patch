From e3459a30e6b8b1fd7cd386c1209b819201789f50 Mon Sep 17 00:00:00 2001
From: Rolando Trevino <rolotrealanis@gmail.com>
Date: Sat, 7 Nov 2026 21:17:50 -0500
Subject: [PATCH 3/3] nvme: apple: Settle the T6050 storage before the reboot
 notifiers

The final shutdown (previous patch) now waits for the controller, but it
runs from device_shutdown(), after macsmc-reboot's reboot notifier told the
SMC a restart is coming and cleared boot_stage. A hang or reset during that
wait would then look like a clean shutdown to iBoot.

On T6050, register a reboot notifier with a priority above macsmc-reboot's
(100 against 0) that syncs the filesystems (ksys_sync_helper(), a no-op
without PM_SLEEP) and sends a Flush to every namespace, then logs how long
that took. The notifier does not send SHN, so nothing that is written
between it and the final shutdown fails. It takes itself off the chain at
the start of remove(), as it lives in struct apple_nvme.

The controller has no idle indication to wait on: the wait that matters
is SHN completion, which stays in the final shutdown. This patch only
moves the work that does not depend on the controller shutting down in
front of the boot_stage write, and can be dropped without affecting the
previous two.

Signed-off-by: Rolando Trevino <rolotrealanis@gmail.com>
Assisted-by: LLM Claude
---
 drivers/nvme/host/apple.c | 40 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 40 insertions(+)

diff --git a/drivers/nvme/host/apple.c b/drivers/nvme/host/apple.c
index 67933005cfb9..3e76091d6e05 100644
--- a/drivers/nvme/host/apple.c
+++ b/drivers/nvme/host/apple.c
@@ -39,7 +39,9 @@
 #include <linux/pm_domain.h>
 #include <linux/soc/apple/rtkit.h>
 #include <linux/soc/apple/sart.h>
+#include <linux/reboot.h>
 #include <linux/reset.h>
+#include <linux/suspend.h>
 #include <linux/time64.h>
 
 #include "nvme.h"
@@ -241,6 +243,8 @@ struct apple_nvme {
 	bool recover_to_live;
 	bool suspended;
 	bool final_shutdown;
+	struct notifier_block reboot_nb;
+	bool reboot_nb_registered;
 	unsigned long recovery_flags;
 
 	void __iomem *mmio_coproc;
@@ -1408,6 +1412,32 @@ static void apple_nvme_final_shn(struct apple_nvme *anv)
 	anv->ctrl.shutdown_timeout = saved;
 }
 
+/*
+ * Reboot notifiers run by priority, highest first. macsmc-reboot's (priority
+ * 0) tells the SMC a restart is coming and clears boot_stage; run before it so
+ * that a hang or a reset while the storage settles is still a boot that did
+ * not end cleanly.
+ */
+#define APPLE_NVME_REBOOT_NB_PRIO	100
+
+static int apple_nvme_reboot_notify(struct notifier_block *nb,
+				    unsigned long action, void *data)
+{
+	struct apple_nvme *anv = container_of(nb, struct apple_nvme, reboot_nb);
+	ktime_t start = ktime_get();
+	int failed;
+
+	if (READ_ONCE(anv->removing) || READ_ONCE(anv->final_shutdown))
+		return NOTIFY_DONE;
+
+	ksys_sync_helper();
+	failed = apple_nvme_flush_all(anv);
+	dev_info(anv->dev, "storage settled before reboot in %lld ms (%d flush failures)\n",
+		 ktime_ms_delta(ktime_get(), start), failed);
+
+	return NOTIFY_DONE;
+}
+
 static int apple_nvme_disable_locked(struct apple_nvme *anv, bool shutdown)
 {
 	enum nvme_ctrl_state state;
@@ -2624,6 +2654,13 @@ static int apple_nvme_probe(struct platform_device *pdev)
 	nvme_reset_ctrl(&anv->ctrl);
 	async_schedule(apple_nvme_async_probe, anv);
 
+	if (anv->hw->shutdown_min_timeout) {
+		anv->reboot_nb.notifier_call = apple_nvme_reboot_notify;
+		anv->reboot_nb.priority = APPLE_NVME_REBOOT_NB_PRIO;
+		if (!register_reboot_notifier(&anv->reboot_nb))
+			anv->reboot_nb_registered = true;
+	}
+
 	return 0;
 
 out_uninit_ctrl:
@@ -2638,6 +2675,9 @@ static void apple_nvme_remove(struct platform_device *pdev)
 {
 	struct apple_nvme *anv = platform_get_drvdata(pdev);
 
+	/* The notifier lives in anv: take it off the chain before anything is freed. */
+	if (anv->reboot_nb_registered)
+		unregister_reboot_notifier(&anv->reboot_nb);
 	WRITE_ONCE(anv->removing, true);
 	apple_nvme_set_reset_ready(anv, false);
 	nvme_change_ctrl_state(&anv->ctrl, NVME_CTRL_DELETING);
-- 
