# m5-debug.config - visibility and hang->reset fragment for the J716s bring-up kernel.
# Planning prototype 2026-11-05, UNTESTED. merge_config.sh on top of the integration .config.
#
# netconsole on the CDC-EEM gadget link (targets created from the debug initramfs via configfs)
CONFIG_NETCONSOLE=y
CONFIG_NETCONSOLE_DYNAMIC=y
CONFIG_NETCONSOLE_EXTENDED_LOG=y
CONFIG_PRINTK_CALLER=y
#
# pstore/ramoops in iBoot's panic region (/pram, outside Linux RAM); m1n1 kboot adds the
# reserved-memory ramoops node (FRICTION.md P5). PSTORE_RAM was =m and the root loads no
# modules, so it never ran.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
#
# Turn hangs into panics, and panics into resets (the reset is what lets stage-1 fall back).
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR_PREFER_BUDDY=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=10
CONFIG_RCU_CPU_STALL_TIMEOUT=21
#
# Watchdog: stage-1 (chainload.wdt=) leaves the SoC watchdog armed; apple_wdt sees RESET_EN and
# the core feeds it until userspace (systemd RuntimeWatchdogSec=) opens /dev/watchdog0.
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
# CONFIG_WATCHDOG_NOWAYOUT is not set
#
# Probe-hang bisect build only (not the daily kernel): macsmc-power as a module, loaded by the
# debug initramfs after netconsole is up (m5.insmod=macsmc_power). Everything else stays =y.
# CONFIG_MACSMC_POWER=m
