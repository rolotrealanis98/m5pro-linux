+arg() { \$BB sed -n "s/.*\\b\$1=\\([^ ]*\\).*/\\1/p" /proc/cmdline; }
+CH=/proc/device-tree/chosen
+SLOT=\$(\$BB cat \$CH/m5pro,boot-slot 2>/dev/null | \$BB tr -d '\\0')
