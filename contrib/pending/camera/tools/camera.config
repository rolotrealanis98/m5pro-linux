# J716s camera bring-up on top of defconfig + asahi.config + j716s.config (series tree):
# media core built in, the ISP as a module (blacklist it in modprobe.d; load it by hand).
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_VIDEO_APPLE_ISP=m
