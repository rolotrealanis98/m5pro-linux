From 72d82d0c4b2f0f698effb2478c435f9947aace7f Mon Sep 17 00:00:00 2001
From: Rolando Trevino <rolotrealanis@gmail.com>
Date: Wed, 4 Nov 2026 18:10:14 -0500
Subject: [PATCH 1/5] phy: apple: add a USB2-only Type-C port PHY driver for
 T6050

The full Apple Type-C PHY driver (phy-apple-atc) does not support T6050
(M5 Pro/Max) yet. For USB 2.0 the dwc3 controllers only need the USB2
half of it, which m1n1 already brings up for its own gadget with the same
register sequence on every SoC.

Add phy-apple-usb2: .init runs m1n1's usb_phy_bringup() sequence on
the usb2phy block (ADT atc-phyN reg[0]), adding the host-mode bits in
USB2PHY_SIG that phy-apple-atc sets on M1..M4, before dwc3's core soft
reset (dwc3 calls phy_init() before it, phy_power_on() after); .exit is
phy-apple-atc's USB2 power-off; set_mode flips the host bits. The PIPE
mux is left on the dummy PHY, so USB3, USB4 and DisplayPort stay off.

Plain dwc3 calls phy_set_mode() only after its core init, while Asahi's
dwc3-apple notes the USB2 PHY mode must be set before dwc3 resets it, so
the PHY also takes its initial mode from "apple,default-mode".

Signed-off-by: Rolando Trevino <rolotrealanis@gmail.com>

---
 drivers/phy/apple/Kconfig  |  12 ++
 drivers/phy/apple/Makefile |   3 +
 drivers/phy/apple/usb2.c   | 286 +++++++++++++++++++++++++++++++++++++
 3 files changed, 301 insertions(+)
 create mode 100644 drivers/phy/apple/usb2.c

diff --git a/drivers/phy/apple/Kconfig b/drivers/phy/apple/Kconfig
index 8409b67f6..fadbae011 100644
--- a/drivers/phy/apple/Kconfig
+++ b/drivers/phy/apple/Kconfig
@@ -21,3 +21,15 @@ config PHY_APPLE_DPTX
 	  such as the M2.
 	  This driver provides support for DisplayPort and is used on the
 	  Mac mini (M2 and M2 Pro, 2023).
+
+config PHY_APPLE_USB2
+	tristate "Apple Type-C port USB2-only PHY"
+	depends on ARCH_APPLE || COMPILE_TEST
+	select GENERIC_PHY
+	help
+	  Enable this for USB 2.0 host or device mode on the Type-C ports of
+	  Apple SoCs whose full Type-C PHY (PHY_APPLE_ATC) is not supported
+	  yet, such as the M5 Pro (T6050). Only the USB2 PHY is driven; USB3,
+	  USB4 and DisplayPort stay unavailable.
+
+	  If M is selected the module will be called 'phy-apple-usb2'.
diff --git a/drivers/phy/apple/Makefile b/drivers/phy/apple/Makefile
index b9e7bf3e4..2613dd42c 100644
--- a/drivers/phy/apple/Makefile
+++ b/drivers/phy/apple/Makefile
@@ -5,3 +5,6 @@ phy-apple-atc-y			:= atc.o
 
 obj-$(CONFIG_PHY_APPLE_DPTX)	+= phy-apple-dptx.o
 phy-apple-dptx-y		+= dptx.o
+
+obj-$(CONFIG_PHY_APPLE_USB2)	+= phy-apple-usb2.o
+phy-apple-usb2-y		+= usb2.o
diff --git a/drivers/phy/apple/usb2.c b/drivers/phy/apple/usb2.c
new file mode 100644
index 000000000..6cd58bb3b
--- /dev/null
+++ b/drivers/phy/apple/usb2.c
@@ -0,0 +1,286 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * Apple Type-C port USB2 PHY, USB 2.0 only.
+ *
+ * The USB2 half of the Apple Type-C PHY ("atc-phy" in the ADT, whose reg[0]
+ * is this block) without any of the USB3/USB4/DisplayPort machinery that
+ * phy-apple-atc drives. It exists for SoCs where the full ATC PHY is not
+ * supported yet (T6050, M5 Pro), so that a dwc3 controller can run in host
+ * mode over the USB 2.0 pairs while its PIPE interface stays on the dummy
+ * PHY that the bootloader (m1n1 usb_phy_bringup()) selected.
+ *
+ * Bring-up (.init) is the exact register sequence m1n1 uses on T6050 (which
+ * is known to work there for device mode), plus the host-mode bits that
+ * phy-apple-atc sets in USB2PHY_SIG on M1..M4. VBUS detection stays forced
+ * valid in both modes, like m1n1 and phy-apple-atc do: VBUS itself is owned
+ * by the USB-PD controller, not by this PHY.
+ *
+ * Copyright The Asahi Linux Contributors
+ */
+
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/phy/phy.h>
+#include <linux/platform_device.h>
+#include <linux/string.h>
+
+#define USB2PHY_USBCTL			0x00
+#define USB2PHY_USBCTL_USB_MODE		0x7
+#define USB2PHY_USBCTL_RUN		2
+#define USB2PHY_USBCTL_ISOLATION	4
+
+#define USB2PHY_CTL			0x04
+#define USB2PHY_CTL_RESET		BIT(0)
+#define USB2PHY_CTL_PORT_RESET		BIT(1)
+#define USB2PHY_CTL_APB_RESET_N		BIT(2)
+#define USB2PHY_CTL_SIDDQ		BIT(3)
+
+#define USB2PHY_SIG			0x08
+#define USB2PHY_SIG_VBUSDET_FORCE_VAL	BIT(0)
+#define USB2PHY_SIG_VBUSDET_FORCE_EN	BIT(1)
+#define USB2PHY_SIG_VBUSVLDEXT_FORCE_VAL BIT(2)
+#define USB2PHY_SIG_VBUSVLDEXT_FORCE_EN	BIT(3)
+#define USB2PHY_SIG_HOST		(7 << 12)
+/* Full USB2PHY_SIG value m1n1 writes on every SoC, T6050 included */
+#define USB2PHY_SIG_M1N1		0x01c1000f
+
+#define USB2PHY_MISCTUNE		0x1c
+#define USB2PHY_MISCTUNE_APBCLK_GATE_OFF BIT(29)
+#define USB2PHY_MISCTUNE_REFCLK_GATE_OFF BIT(30)
+/* MISCTUNE value m1n1 writes (clock gates off, tuning as left by iBoot) */
+#define USB2PHY_MISCTUNE_M1N1		0x008c0813
+
+struct apple_usb2phy {
+	struct device *dev;
+	void __iomem *regs;
+	struct phy *phy;
+	struct mutex lock;
+	bool host;
+	bool powered;
+};
+
+static void apple_usb2phy_hw_on(struct apple_usb2phy *p)
+{
+	u32 sig = USB2PHY_SIG_M1N1 & ~USB2PHY_SIG_HOST;
+
+	if (p->host)
+		sig |= USB2PHY_SIG_HOST;
+
+	/* m1n1 src/usb.c usb_phy_bringup(), verbatim apart from the HOST bits */
+	writel(sig, p->regs + USB2PHY_SIG);
+	writel(USB2PHY_CTL_RESET | USB2PHY_CTL_PORT_RESET, p->regs + USB2PHY_CTL);
+	udelay(10);
+	writel(readl(p->regs + USB2PHY_CTL) & ~USB2PHY_CTL_RESET, p->regs + USB2PHY_CTL);
+	udelay(10);
+	writel(readl(p->regs + USB2PHY_CTL) & ~USB2PHY_CTL_PORT_RESET, p->regs + USB2PHY_CTL);
+	udelay(10);
+	writel(USB2PHY_MISCTUNE_M1N1, p->regs + USB2PHY_MISCTUNE);
+	writel(USB2PHY_USBCTL_RUN, p->regs + USB2PHY_USBCTL);
+	udelay(10);
+}
+
+static void apple_usb2phy_hw_off(struct apple_usb2phy *p)
+{
+	u32 v;
+
+	/* phy-apple-atc atcphy_usb2_power_off() */
+	v = readl(p->regs + USB2PHY_USBCTL);
+	v &= ~USB2PHY_USBCTL_USB_MODE;
+	v |= USB2PHY_USBCTL_ISOLATION;
+	writel(v, p->regs + USB2PHY_USBCTL);
+	udelay(10);
+	writel(readl(p->regs + USB2PHY_CTL) | USB2PHY_CTL_SIDDQ, p->regs + USB2PHY_CTL);
+	udelay(10);
+	writel(readl(p->regs + USB2PHY_CTL) | USB2PHY_CTL_PORT_RESET, p->regs + USB2PHY_CTL);
+	udelay(10);
+	writel(readl(p->regs + USB2PHY_CTL) | USB2PHY_CTL_RESET, p->regs + USB2PHY_CTL);
+	udelay(10);
+	writel(readl(p->regs + USB2PHY_CTL) & ~USB2PHY_CTL_APB_RESET_N, p->regs + USB2PHY_CTL);
+	udelay(10);
+	writel(readl(p->regs + USB2PHY_MISCTUNE) | USB2PHY_MISCTUNE_APBCLK_GATE_OFF |
+	       USB2PHY_MISCTUNE_REFCLK_GATE_OFF, p->regs + USB2PHY_MISCTUNE);
+}
+
+/*
+ * The full reset sequence runs in .init, not .power_on: dwc3 calls
+ * phy_init() before its core soft reset and phy_power_on() after it, and
+ * the PHY must be up (in the right mode) before dwc3 resets (the order
+ * phy-apple-atc + dwc3-apple use on M1..M4).
+ *
+ * It runs even if the bootloader left the PHY running: the eUSB2 repeater
+ * between PHY and connector is reset out of band by the USB-PD controller on
+ * every CC (dis)connect, and only a PHY reset re-synchronises the two (see
+ * dwc3-apple.c). Unbinding and rebinding dwc3 therefore re-syncs the port.
+ */
+static int apple_usb2phy_init(struct phy *phy)
+{
+	struct apple_usb2phy *p = phy_get_drvdata(phy);
+
+	guard(mutex)(&p->lock);
+
+	apple_usb2phy_hw_on(p);
+	p->powered = true;
+	dev_dbg(p->dev, "on, %s mode, SIG=%#x\n", p->host ? "host" : "device",
+		readl(p->regs + USB2PHY_SIG));
+	return 0;
+}
+
+static int apple_usb2phy_exit(struct phy *phy)
+{
+	struct apple_usb2phy *p = phy_get_drvdata(phy);
+
+	guard(mutex)(&p->lock);
+
+	apple_usb2phy_hw_off(p);
+	p->powered = false;
+	return 0;
+}
+
+static int apple_usb2phy_power_on(struct phy *phy)
+{
+	struct apple_usb2phy *p = phy_get_drvdata(phy);
+
+	guard(mutex)(&p->lock);
+
+	/* Normally a no-op: .init already brought the PHY up. */
+	if (!p->powered) {
+		apple_usb2phy_hw_on(p);
+		p->powered = true;
+	}
+	return 0;
+}
+
+static int apple_usb2phy_power_off(struct phy *phy)
+{
+	/*
+	 * Keep the PHY running until .exit: after a power-off only the full
+	 * reset sequence brings it back, and dwc3 also calls power_off on
+	 * paths (suspend) where it does not call init again.
+	 */
+	return 0;
+}
+
+static int apple_usb2phy_set_mode(struct phy *phy, enum phy_mode mode, int submode)
+{
+	struct apple_usb2phy *p = phy_get_drvdata(phy);
+	bool host;
+
+	switch (mode) {
+	case PHY_MODE_USB_HOST:
+	case PHY_MODE_USB_HOST_LS:
+	case PHY_MODE_USB_HOST_FS:
+	case PHY_MODE_USB_HOST_HS:
+		host = true;
+		break;
+	case PHY_MODE_USB_DEVICE:
+	case PHY_MODE_USB_DEVICE_LS:
+	case PHY_MODE_USB_DEVICE_FS:
+	case PHY_MODE_USB_DEVICE_HS:
+		host = false;
+		break;
+	case PHY_MODE_USB_OTG:
+		return 0;
+	default:
+		return -EINVAL;
+	}
+
+	guard(mutex)(&p->lock);
+
+	if (host == p->host)
+		return 0;
+	p->host = host;
+
+	/*
+	 * phy-apple-atc flips only the SIG bits here, with the PHY running and
+	 * the dwc3 core held in reset. Plain dwc3 calls set_mode after its core
+	 * init, so mirror the bit flip but keep everything else as it is; the
+	 * initial mode should come from "apple,default-mode" so that the PHY is
+	 * already in the right mode when dwc3 first resets it.
+	 */
+	if (p->powered) {
+		u32 sig = readl(p->regs + USB2PHY_SIG);
+
+		if (host)
+			sig |= USB2PHY_SIG_HOST;
+		else
+			sig &= ~USB2PHY_SIG_HOST;
+		writel(sig, p->regs + USB2PHY_SIG);
+	}
+	dev_info(p->dev, "switched to %s mode\n", host ? "host" : "device");
+	return 0;
+}
+
+static const struct phy_ops apple_usb2phy_ops = {
+	.owner = THIS_MODULE,
+	.init = apple_usb2phy_init,
+	.exit = apple_usb2phy_exit,
+	.power_on = apple_usb2phy_power_on,
+	.power_off = apple_usb2phy_power_off,
+	.set_mode = apple_usb2phy_set_mode,
+};
+
+static int apple_usb2phy_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct phy_provider *provider;
+	struct apple_usb2phy *p;
+	const char *mode;
+
+	p = devm_kzalloc(dev, sizeof(*p), GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+
+	p->dev = dev;
+	mutex_init(&p->lock);
+
+	p->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(p->regs))
+		return PTR_ERR(p->regs);
+
+	/* The bootloader leaves the PHY in device mode (m1n1's USB gadget). */
+	p->host = false;
+	if (!of_property_read_string(dev->of_node, "apple,default-mode", &mode)) {
+		if (!strcmp(mode, "host"))
+			p->host = true;
+		else if (strcmp(mode, "device"))
+			return dev_err_probe(dev, -EINVAL, "bad apple,default-mode \"%s\"\n",
+					     mode);
+	}
+
+	p->phy = devm_phy_create(dev, NULL, &apple_usb2phy_ops);
+	if (IS_ERR(p->phy))
+		return PTR_ERR(p->phy);
+	phy_set_drvdata(p->phy, p);
+
+	provider = devm_of_phy_provider_register(dev, of_phy_simple_xlate);
+	if (IS_ERR(provider))
+		return PTR_ERR(provider);
+
+	dev_info(dev, "USB2 PHY, default %s mode, USBCTL=%#x CTL=%#x SIG=%#x\n",
+		 p->host ? "host" : "device", readl(p->regs + USB2PHY_USBCTL),
+		 readl(p->regs + USB2PHY_CTL), readl(p->regs + USB2PHY_SIG));
+	return 0;
+}
+
+static const struct of_device_id apple_usb2phy_of_match[] = {
+	{ .compatible = "apple,t6050-usb2phy" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, apple_usb2phy_of_match);
+
+static struct platform_driver apple_usb2phy_driver = {
+	.probe = apple_usb2phy_probe,
+	.driver = {
+		.name = "phy-apple-usb2",
+		.of_match_table = apple_usb2phy_of_match,
+	},
+};
+module_platform_driver(apple_usb2phy_driver);
+
+MODULE_DESCRIPTION("Apple Type-C port USB2-only PHY");
+MODULE_LICENSE("Dual MIT/GPL");
-- 
2.56.0

