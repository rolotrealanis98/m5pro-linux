+			opp-microvolt = <760000>;
+			clock-latency-ns = <8000>;
+		};
+		opp03 {
+			opp-hz = /bits/ 64 <1620000000>;
+			opp-level = <3>;
+			opp-microvolt = <785000>;
+			clock-latency-ns = <8000>;
+		};
+		opp04 {
+			opp-hz = /bits/ 64 <1980000000>;
+			opp-level = <4>;
+			opp-microvolt = <820000>;
+			clock-latency-ns = <8000>;
+		};
+		opp05 {
+			opp-hz = /bits/ 64 <2292000000>;
+			opp-level = <5>;
+			opp-microvolt = <855000>;
+			clock-latency-ns = <8000>;
+		};
+		opp06 {
+			opp-hz = /bits/ 64 <2580000000>;
+			opp-level = <6>;
+			opp-microvolt = <885000>;
+			clock-latency-ns = <8000>;
+		};
+		opp07 {
+			opp-hz = /bits/ 64 <2880000000>;
+			opp-level = <7>;
+			opp-microvolt = <920000>;
+			clock-latency-ns = <8000>;
+		};
+		opp08 {
+			opp-hz = /bits/ 64 <3180000000>;
+			opp-level = <8>;
+			opp-microvolt = <950000>;
+			clock-latency-ns = <8000>;
+		};
+		opp09 {
+			opp-hz = /bits/ 64 <3432000000>;
+			opp-level = <9>;
+			opp-microvolt = <980000>;
+			clock-latency-ns = <8000>;
+		};
+		opp10 {
+			opp-hz = /bits/ 64 <3648000000>;
+			opp-level = <10>;
+			opp-microvolt = <1010000>;
+			clock-latency-ns = <8000>;
+		};
+		opp11 {
+			opp-hz = /bits/ 64 <3828000000>;
+			opp-level = <11>;
+			opp-microvolt = <1030000>;
+			clock-latency-ns = <8000>;
+		};
+		opp12 {
+			opp-hz = /bits/ 64 <3984000000>;
+			opp-level = <12>;
+			opp-microvolt = <1050000>;
