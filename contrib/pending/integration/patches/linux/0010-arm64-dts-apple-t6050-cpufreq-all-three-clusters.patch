From 7efa8920e7695fdadd4310c51ba54b34eef056b2 Mon Sep 17 00:00:00 2001
From: rolotrealanis98 <122947376+rolotrealanis98@users.noreply.github.com>
Date: Wed, 4 Nov 2026 18:00:07 -0500
Subject: [PATCH] (kernel-tree copy of the dt/ part) cpufreq dt: all three T6050 clusters, generated from the
 J716s ADT

gen-cpufreq-dt.py now emits the P cluster (cluster 2, apple,everest)
as well as the two M clusters, and t6050-cpufreq.dtsi is regenerated
from build/adt-runtime-j716s.bin.

- M clusters (voltage-states22/23): unchanged p-states 2-15, which is
  byte-for-byte what the J714s ADT gave (the old generator run on the
  J716s ADT reproduces the old file exactly). The refused top entry,
  p-state 16 (4380 MHz), is now listed with turbo-mode, so it is used
  only after "echo 1 > /sys/devices/system/cpu/cpufreq/boost".
- P cluster (voltage-states5, 20 entries, 1308-4608 MHz): p-states
  2-21, assuming the M clusters' "p-state N = entry N-2" mapping, which
  is not measured on this cluster yet. Entries above 4308 MHz (p-states
  18-21) are turbo-mode. performance-controller@212e20000 follows the
  ADT pmgr reg list, which maps the same 0x12e8-byte DVFS window at
  0x21Xe20000 for all three clusters.
- compatible is now "apple,t6050-cluster-cpufreq",
  "apple,t8112-cluster-cpufreq", the form the binding accepts for T6020;
  the driver matched the t8112 entry before and still does.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---

diff --git a/arch/arm64/boot/dts/apple/t6050-cpufreq.dtsi b/dt/t6050-cpufreq.dtsi
index 869c3ec..47f9a2a 100644
--- a/arch/arm64/boot/dts/apple/t6050-cpufreq.dtsi
+++ b/arch/arm64/boot/dts/apple/t6050-cpufreq.dtsi
@@ -1,8 +1,9 @@
 // SPDX-License-Identifier: GPL-2.0+ OR MIT
 /*
  * T6050 CPU cluster DVFS (apple-soc-cpufreq).
- * GENERATED from the runtime ADT (build/adt-runtime-j714s.bin) by
+ * GENERATED from the runtime ADT (adt-runtime-j716s.bin) by
  * gen-cpufreq-dt.py; see there for the measured p-state/frequency mapping.
+ * M clusters: measured. P cluster: p-state mapping assumed, not yet measured.
  */
 
 / {
@@ -93,6 +94,13 @@
 			opp-microvolt = <1070000>;
 			clock-latency-ns = <8000>;
 		};
+		opp16 {
+			opp-hz = /bits/ 64 <4380000000>;
+			opp-level = <16>;
+			opp-microvolt = <1070000>;
+			clock-latency-ns = <8000>;
+			turbo-mode;
+		};
 	};
 
 	m1_opp: opp-table-m1 {
@@ -182,25 +190,165 @@
 			opp-microvolt = <1070000>;
 			clock-latency-ns = <8000>;
 		};
+		opp16 {
+			opp-hz = /bits/ 64 <4380000000>;
+			opp-level = <16>;
+			opp-microvolt = <1070000>;
+			clock-latency-ns = <8000>;
+			turbo-mode;
+		};
+	};
+
