+&cpu_p0 {
+	operating-points-v2 = <&p_opp>;
+	performance-domains = <&cpufreq_p>;
+};
+
+&cpu_p1 {
+	operating-points-v2 = <&p_opp>;
+	performance-domains = <&cpufreq_p>;
+};
+
+&cpu_p2 {
