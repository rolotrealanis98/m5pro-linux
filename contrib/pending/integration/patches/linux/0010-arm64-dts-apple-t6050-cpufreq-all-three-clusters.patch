+		};
+		opp14 {
+			opp-hz = /bits/ 64 <4188000000>;
+			opp-level = <14>;
+			opp-microvolt = <1075000>;
+			clock-latency-ns = <8000>;
+		};
+		opp15 {
+			opp-hz = /bits/ 64 <4236000000>;
+			opp-level = <15>;
+			opp-microvolt = <1075000>;
+			clock-latency-ns = <8000>;
+		};
+		opp16 {
+			opp-hz = /bits/ 64 <4284000000>;
+			opp-level = <16>;
+			opp-microvolt = <1075000>;
+			clock-latency-ns = <8000>;
+		};
+		opp17 {
+			opp-hz = /bits/ 64 <4308000000>;
+			opp-level = <17>;
+			opp-microvolt = <1075000>;
+			clock-latency-ns = <8000>;
+		};
+		opp18 {
+			opp-hz = /bits/ 64 <4332000000>;
+			opp-level = <18>;
+			opp-microvolt = <1075000>;
+			clock-latency-ns = <8000>;
+			turbo-mode;
+		};
+		opp19 {
+			opp-hz = /bits/ 64 <4428000000>;
+			opp-level = <19>;
+			opp-microvolt = <1075000>;
+			clock-latency-ns = <8000>;
+			turbo-mode;
+		};
+		opp20 {
+			opp-hz = /bits/ 64 <4512000000>;
+			opp-level = <20>;
+			opp-microvolt = <1120000>;
+			clock-latency-ns = <8000>;
+			turbo-mode;
+		};
+		opp21 {
+			opp-hz = /bits/ 64 <4608000000>;
+			opp-level = <21>;
+			opp-microvolt = <1120000>;
+			clock-latency-ns = <8000>;
+			turbo-mode;
+		};
 	};
 
 };
 
 &soc {
 	cpufreq_m0: performance-controller@210e20000 {
-		compatible = "apple,t6050-cluster-cpufreq", "apple,t8112-cluster-cpufreq",
-			     "apple,cluster-cpufreq";
+		compatible = "apple,t6050-cluster-cpufreq", "apple,t8112-cluster-cpufreq";
 		reg = <0x2 0x10e20000 0x0 0x1000>;
 		#performance-domain-cells = <0>;
 	};
 
 	cpufreq_m1: performance-controller@211e20000 {
-		compatible = "apple,t6050-cluster-cpufreq", "apple,t8112-cluster-cpufreq",
-			     "apple,cluster-cpufreq";
+		compatible = "apple,t6050-cluster-cpufreq", "apple,t8112-cluster-cpufreq";
 		reg = <0x2 0x11e20000 0x0 0x1000>;
 		#performance-domain-cells = <0>;
 	};
 
+	cpufreq_p: performance-controller@212e20000 {
+		compatible = "apple,t6050-cluster-cpufreq", "apple,t8112-cluster-cpufreq";
+		reg = <0x2 0x12e20000 0x0 0x1000>;
+		#performance-domain-cells = <0>;
+	};
+
 };
 
 &cpu_m0_0 {
@@ -262,3 +410,33 @@
 	operating-points-v2 = <&m1_opp>;
 	performance-domains = <&cpufreq_m1>;
 };
