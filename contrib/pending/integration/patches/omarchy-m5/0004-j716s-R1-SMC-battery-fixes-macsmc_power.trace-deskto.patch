diff --git a/configs/omarchy-desktop.config b/configs/omarchy-desktop.config
new file mode 100644
index 0000000..180c36c
--- /dev/null
+++ b/configs/omarchy-desktop.config
@@ -0,0 +1,97 @@
+# omarchy-desktop.config: what an Omarchy desktop session needs on the
+# J716s (M5 Pro) beyond the bring-up kernel. Merge after the board and
+# omarchy-usb-host fragments. The root has no modules, so everything is =y.
+
+# zram swap: zram-generator otherwise waits 90 s for /dev/zram0 at boot.
+CONFIG_SWAP=y
+CONFIG_BLK_DEV=y
+CONFIG_ZSMALLOC=y
+CONFIG_ZRAM=y
+CONFIG_ZRAM_BACKEND_ZSTD=y
+CONFIG_ZRAM_DEF_COMP_ZSTD=y
+
+# ufw (Omarchy enables it) through Arch's iptables-nft: nf_tables with the
+# xtables compat layer, conntrack, and the matches/targets ufw's rule files use
+# (conntrack/state, limit, recent, multiport, comment, addrtype, hl, pkttype,
+# rt/ipv6header for the IPv6 rules, LOG, REJECT). The legacy x_tables
+# (IP_NF_FILTER etc., IP_NF_IPTABLES_LEGACY) are not needed with iptables-nft.
+CONFIG_NETFILTER=y
+CONFIG_NETFILTER_ADVANCED=y
+CONFIG_NETFILTER_INGRESS=y
+CONFIG_NETFILTER_NETLINK=y
+CONFIG_NF_CONNTRACK=y
+CONFIG_NF_CONNTRACK_MARK=y
+CONFIG_NF_CONNTRACK_FTP=y
+CONFIG_NF_CT_NETLINK=y
+CONFIG_NF_NAT=y
+CONFIG_NF_NAT_FTP=y
+CONFIG_NF_NAT_MASQUERADE=y
+CONFIG_NF_TABLES=y
+CONFIG_NF_TABLES_INET=y
+CONFIG_NF_TABLES_IPV4=y
+CONFIG_NF_TABLES_IPV6=y
+CONFIG_NFT_CT=y
+CONFIG_NFT_LOG=y
+CONFIG_NFT_LIMIT=y
+CONFIG_NFT_MASQ=y
+CONFIG_NFT_NAT=y
+CONFIG_NFT_REJECT=y
+CONFIG_NFT_REJECT_INET=y
+CONFIG_NFT_COMPAT=y
+CONFIG_NFT_FIB_INET=y
+CONFIG_NFT_FIB_IPV4=y
+CONFIG_NFT_FIB_IPV6=y
+CONFIG_NETFILTER_XTABLES=y
+CONFIG_NETFILTER_XT_MARK=y
+CONFIG_NETFILTER_XT_CONNMARK=y
+CONFIG_NETFILTER_XT_TARGET_LOG=y
+CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
+CONFIG_NETFILTER_XT_NAT=y
+CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
+CONFIG_NETFILTER_XT_MATCH_COMMENT=y
+CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
+CONFIG_NETFILTER_XT_MATCH_HL=y
+CONFIG_NETFILTER_XT_MATCH_LIMIT=y
+CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
+CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
+CONFIG_NETFILTER_XT_MATCH_RECENT=y
+CONFIG_NETFILTER_XT_MATCH_STATE=y
+CONFIG_NF_LOG_SYSLOG=y
+CONFIG_NF_REJECT_IPV4=y
+CONFIG_NF_REJECT_IPV6=y
+CONFIG_IP_NF_IPTABLES=y
+CONFIG_IP_NF_TARGET_REJECT=y
+CONFIG_IP6_NF_IPTABLES=y
+CONFIG_IP6_NF_TARGET_REJECT=y
+CONFIG_IP6_NF_MATCH_IPV6HEADER=y
+CONFIG_IP6_NF_MATCH_RT=y
+
+# Keyboard backlight: fpwm0 + pwm-leds (PWM_APPLE was =m).
+CONFIG_PWM=y
+CONFIG_PWM_APPLE=y
+CONFIG_NEW_LEDS=y
+CONFIG_LEDS_CLASS=y
+CONFIG_LEDS_PWM=y
+
+# cpufreq: schedutil by default (validated on J714c with the same OPPs).
+CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
+CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
+
+# s2idle staging: /sys/power/pm_test and sleep debug messages. Hibernation
+# needs the secondaries offlined (spin-table CPUs cannot be) and a resume path
+# the boot chain does not have.
+CONFIG_SUSPEND=y
+CONFIG_PM_SLEEP=y
+CONFIG_PM_DEBUG=y
+CONFIG_PM_ADVANCED_DEBUG=y
+CONFIG_PM_SLEEP_DEBUG=y
+# CONFIG_HIBERNATION is not set
+
+# Hang visibility, report-only (no panic): a CPU spinning with interrupts on
+# or off, or a stuck task, prints a warning on the panel (the buddy hard-lockup
+# detector is the only one available: no perf NMI on Apple). A whole-SoC
+# freeze still prints nothing.
+CONFIG_SOFTLOCKUP_DETECTOR=y
+CONFIG_HARDLOCKUP_DETECTOR=y
+CONFIG_DETECT_HUNG_TASK=y
+CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120
diff --git a/dt/t6050-j716s.dts b/dt/t6050-j716s.dts
index 3156aa7..97219ea 100644
--- a/dt/t6050-j716s.dts
+++ b/dt/t6050-j716s.dts
@@ -10,6 +10,7 @@
 /dts-v1/;
 
 #include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/leds/common.h>
 #include "t6050.dtsi"
 #include "t6050-jxxx.dtsi"
 
@@ -22,6 +23,31 @@
 		 * from /arm-io/dockchannel-mtp/mtp-transport/keyboard kblang-calibration */
 		keyboard = &keyboard;
 	};
+
+	/*
+	 * Keyboard backlight. ADT /arm-io/pwm0/kbd-backlight: channel 0,
+	 * default-hz 25000 -> period 40000 ns, as on every Asahi MacBook. The
+	 * SMC has no keyboard-light key here; the PWM is the whole path.
+	 * ps_fpwm0 is clock-gated at handover, so the keyboard stays dark until
+	 * userspace sets a brightness (leds-pwm falls back to "off" when it
+	 * reads back period 0).
+	 */
+	led-controller {
+		compatible = "pwm-leds";
+
+		led-0 {
+			pwms = <&fpwm0 0 40000>;
+			label = "kbd_backlight";
+			function = LED_FUNCTION_KBD_BACKLIGHT;
+			color = <LED_COLOR_ID_WHITE>;
+			max-brightness = <255>;
+			default-state = "keep";
+		};
+	};
+};
+
+&fpwm0 {
+	status = "okay";
 };
 
 /*
