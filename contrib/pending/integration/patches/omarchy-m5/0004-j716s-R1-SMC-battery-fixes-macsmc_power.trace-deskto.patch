             CONFIG_USB_DWC3 CONFIG_USB_CONFIGFS CONFIG_USB_CONFIGFS_NCM
             CONFIG_USB_CONFIGFS_ACM
             CONFIG_PHY_APPLE_USB2 CONFIG_USB_XHCI_PLATFORM CONFIG_USB_RTL8152
-            CONFIG_USB_NET_AX88179_178A CONFIG_USB_NET_CDCETHER"
+            CONFIG_USB_NET_AX88179_178A CONFIG_USB_NET_CDCETHER
