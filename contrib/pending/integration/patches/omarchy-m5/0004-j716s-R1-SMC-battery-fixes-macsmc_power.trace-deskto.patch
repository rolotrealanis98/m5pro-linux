diff --git a/dt/t6050.dtsi b/dt/t6050.dtsi
index 22ef313..f460879 100644
--- a/dt/t6050.dtsi
+++ b/dt/t6050.dtsi
@@ -300,6 +300,20 @@
 			interrupts = <AIC_IRQ 721 IRQ_TYPE_LEVEL_HIGH>;
 		};
 
+		/*
+		 * ADT /arm-io/pwm0: compatible "fpwm,s5l8920x", reg 0x505040000
