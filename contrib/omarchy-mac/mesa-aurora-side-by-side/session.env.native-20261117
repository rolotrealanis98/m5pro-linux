# Mesa environment for the GPU desktop session on the M5 Pro (aurora DRM driver), 2026-11-17:
# GL and GLES on the NATIVE Gallium asahi driver, Vulkan on Borealis, both from aurora-wip db928e79933d
# in /opt/mesa-aurora-20261117 (gpu-mesa-aurora-1.md: glmark2 subset 3411 native vs 1835 zink, no faults).
# Read by /usr/local/bin/hypr-gpu-session at login. Back to the previous zink setup:
#   cp /etc/mesa-aurora/session.env.zink-20261117 /etc/mesa-aurora/session.env   (then log out and in)
LD_LIBRARY_PATH=/opt/mesa-aurora-20261117/lib
__EGL_VENDOR_LIBRARY_FILENAMES=/opt/mesa-aurora-20261117/share/glvnd/egl_vendor.d/50_aurora.json
__GLX_VENDOR_LIBRARY_NAME=aurora
LIBGL_DRIVERS_PATH=/opt/mesa-aurora-20261117/lib/dri
GBM_BACKENDS_PATH=/opt/mesa-aurora-20261117/lib/gbm
VK_DRIVER_FILES=/opt/mesa-aurora-20261117/share/vulkan/icd.d/asahi_icd.aarch64.json
VK_ICD_FILENAMES=/opt/mesa-aurora-20261117/share/vulkan/icd.d/asahi_icd.aarch64.json
ASAHI_M5_BRINGUP=1
