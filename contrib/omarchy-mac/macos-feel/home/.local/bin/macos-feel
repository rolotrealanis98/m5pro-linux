#!/usr/bin/env python3
"""macos-feel: the desktop half of the rolo.pointer panel's "macOS" profile.

  macos-feel desktop on      text size and browser wheel animation as on macOS
  macos-feel desktop off     put back what "on" changed (saved in ~/.local/state/macos-feel/)
  macos-feel status          what is set now and what the macOS profile wants
  macos-feel measure         side-by-side helper: pointer travel between two Enter presses

Pointer, scroll, wheel, gestures and cursor size live in the Pointer panel (rolo.pointer plugin,
~/.config/hypr/pointer-tuning.json); it runs "desktop on/off" when its profile changes.
Mapping and derivations: contrib/omarchy-mac/macos-feel/README.md (m5pro-linux repo).
"""

import json
import os
import re
import subprocess
import sys

HOME = os.path.expanduser("~")
POINTER_JSON = os.path.join(HOME, ".config/hypr/pointer-tuning.json")
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.join(HOME, ".local/state")), "macos-feel")
STATE = os.path.join(STATE_DIR, "before.json")
IFACE = "org.gnome.desktop.interface"
PANEL_W, PANEL_MM = 3456, 3456 / 254 * 25.4  # J716s: 254 ppi -> 345.6 mm wide
# Wheel steps animated in Chromium/Chrome/Electron only; GTK, Qt widgets and terminals jump, as
# AppKit does. Off for all of them so a notch behaves the same everywhere.
FLAG_FILES = ["chrome-flags.conf", "chromium-flags.conf", "electron-flags.conf"]
FLAG = "--disable-smooth-scrolling"

MACOS_SYSTEM_FONT_PT = 13      # NSFont.systemFontSize; FontSizeCategory "L" is the default size


def knobs():
    """Display scale and macOS "looks like" width from the Pointer panel's macOS profile."""
    fixed = {}
    try:
        fixed = json.load(open(POINTER_JSON, encoding="utf-8")).get("macos_fixed", {})
    except Exception:
        pass
    scale = float(fixed.get("display_scale", 2))
    looks = float(fixed.get("looks_like_width", 2246))
    scale = 2.0 if scale == 2 else round(scale * 120) / 120
    k = (PANEL_W / scale) / looks
    return scale, looks, k


def gget(key):
    out = subprocess.run(["gsettings", "get", IFACE, key], capture_output=True, text=True, check=True)
    return out.stdout.strip()


def gset(key, value):
    subprocess.run(["gsettings", "set", IFACE, key, str(value)], check=True)


def base_font_pt():
    m = re.search(r"([0-9.]+)'?$", gget("font-name"))
    return float(m.group(1)) if m else 11.0


def targets():
    scale, looks, k = knobs()
    # macOS 13 pt = 13 points; a Linux point is 96/72 logical px. Same physical size when
    # linux_pt = 13 * k * 72/96. GTK applies text-scaling-factor to its base font.
    linux_pt = MACOS_SYSTEM_FONT_PT * k * 72 / 96
    tsf = round(linux_pt / base_font_pt(), 4)
    return {"scale": scale, "looks_like_w": looks, "k": round(k, 4), "linux_ui_pt": round(linux_pt, 2),
            "text-scaling-factor": tsf}


def flag_path(name):
    return os.path.join(HOME, ".config", name)


def flag_present(name):
    p = flag_path(name)
    return os.path.exists(p) and FLAG in open(p, encoding="utf-8").read().split()


def desktop_on():
    t = targets()
    os.makedirs(STATE_DIR, exist_ok=True)
    if not os.path.exists(STATE):
        before = {
            "text-scaling-factor": gget("text-scaling-factor"),
            "flags_added": [],
        }
        json.dump(before, open(STATE, "w"), indent=2)
    before = json.load(open(STATE))
    gset("text-scaling-factor", t["text-scaling-factor"])
    for name in FLAG_FILES:
        if not flag_present(name):
            if not os.path.exists(flag_path(name)):
                before.setdefault("flags_created", []).append(name)
            with open(flag_path(name), "a", encoding="utf-8") as f:
                f.write(FLAG + "\n")
            if name not in before["flags_added"]:
                before["flags_added"].append(name)
    json.dump(before, open(STATE, "w"), indent=2)
    print(f"macos-feel desktop: on (text x{t['text-scaling-factor']} = {t['linux_ui_pt']} pt UI font, "
          f"browsers pick up {FLAG} at their next start)")


def desktop_off():
    if not os.path.exists(STATE):
        print("macos-feel desktop: already off")
        return
    before = json.load(open(STATE))
    gset("text-scaling-factor", before["text-scaling-factor"])
    for name in before.get("flags_added", []):
        p = flag_path(name)
        if os.path.exists(p):
            lines = open(p, encoding="utf-8").read().splitlines()
            kept = [line for line in lines if line.strip() != FLAG]
            if not kept and name in before.get("flags_created", []):
                os.remove(p)
                continue
            with open(p, "w", encoding="utf-8") as f:
                f.write("\n".join(kept) + ("\n" if kept else ""))
    os.remove(STATE)
    print("macos-feel desktop: off (previous text size and browser flags restored)")


def status():
    t = targets()
    print(json.dumps({"wanted": t, "now": {
        "text-scaling-factor": gget("text-scaling-factor"), "cursor-size": gget("cursor-size"),
        "font-name": gget("font-name"),
        "flags": {n: flag_present(n) for n in FLAG_FILES},
        "desktop_on": os.path.exists(STATE)}}, indent=2))


def cursorpos():
    out = subprocess.run(["hyprctl", "cursorpos"], capture_output=True, text=True, check=True).stdout
    x, y = (float(v) for v in out.strip().split(","))
    return x, y


def measure():
    scale, _, _ = knobs()
    mm_per_px = PANEL_MM / (PANEL_W / scale)
    print("Put the pointer at the start, press Enter; move; press Enter again. Ctrl+C to stop.")
    while True:
        input()
        x0, y0 = cursorpos()
        input()
        x1, y1 = cursorpos()
        d = ((x1 - x0) ** 2 + (y1 - y0) ** 2) ** 0.5
        print(f"pointer moved {d:.0f} logical px = {d * mm_per_px:.1f} mm on the glass")


def main():
    a = sys.argv[1:]
    if a[:2] == ["desktop", "on"]:
        desktop_on()
    elif a[:2] == ["desktop", "off"]:
        desktop_off()
    elif a[:1] == ["status"]:
        status()
    elif a[:1] == ["measure"]:
        measure()
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main()
