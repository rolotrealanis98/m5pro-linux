diff --git a/lib/helpers/ui/desktop_perf.dart b/lib/helpers/ui/desktop_perf.dart
new file mode 100644
index 000000000..6c2d01773
--- /dev/null
+++ b/lib/helpers/ui/desktop_perf.dart
@@ -0,0 +1,83 @@
+import 'dart:async';
+import 'dart:io';
+import 'dart:ui' as ui;
+
+import 'package:bluebubbles/helpers/backend/startup_tasks.dart';
+import 'package:bluebubbles/helpers/helpers.dart';
+import 'package:bluebubbles/helpers/ui/desktop_scale.dart';
+import 'package:bluebubbles/services/services.dart';
+import 'package:flutter/foundation.dart';
+import 'package:flutter/scheduler.dart';
+import 'package:flutter/widgets.dart';
+
+/// Desktop memory limits and startup diagnostics.
+///
+/// `BB_DIAG=1` prints `BBDIAG <name> <ms>` lines on stderr, timed from the `BB_T0` epoch-millisecond
+/// environment variable (set by the launcher; the process start otherwise). It also prints the display
+/// the engine sees. Nothing is printed without it.
+class DesktopPerf {
+  DesktopPerf._();
+
+  static final bool diag = Platform.environment['BB_DIAG'] == '1';
+  static final int _t0 =
+      int.tryParse(Platform.environment['BB_T0'] ?? '') ?? DateTime.now().millisecondsSinceEpoch;
+
+  /// Flutter keeps up to 100 MB (1000 images) of decoded bitmaps alive, which is where most of the RSS growth
+  /// while scrolling comes from. Everything reloads from disk, so a smaller cache costs little.
+  static const int defaultImageCacheMb = 48;
+  static const int defaultImageCacheCount = 300;
+
+  static void mark(String name) {
+    if (!diag) return;
+    stderr.writeln('BBDIAG $name ${DateTime.now().millisecondsSinceEpoch - _t0}');
+  }
+
+  static void init() {
+    if (!kIsDesktop) return;
+    final cache = PaintingBinding.instance.imageCache;
+    final mb = int.tryParse(Platform.environment['BB_IMAGE_CACHE_MB'] ?? '') ?? defaultImageCacheMb;
+    cache.maximumSizeBytes = mb * 1024 * 1024;
+    cache.maximumSize = defaultImageCacheCount;
+    mark('dart-main');
+  }
+
+  /// Every five seconds: frames produced, and build (UI thread) and raster (GPU thread) times. An idle app that
+  /// still counts frames has something animating; a scrolling app whose p50 build or raster time is over 8.3 ms
+  /// cannot reach 120 fps, and which of the two says where to look.
+  static void _frameStats() {
+    final builds = <int>[];
+    final rasters = <int>[];
+    SchedulerBinding.instance.addTimingsCallback((timings) {
+      for (final t in timings) {
+        builds.add(t.buildDuration.inMicroseconds);
+        rasters.add(t.rasterDuration.inMicroseconds);
+      }
+    });
+    String q(List<int> v, double p) =>
+        v.isEmpty ? '-' : (([...v]..sort())[((v.length - 1) * p).round()] / 1000).toStringAsFixed(1);
+    Timer.periodic(const Duration(seconds: 5), (_) {
+      stderr.writeln('BBDIAG frames t=${DateTime.now().millisecondsSinceEpoch - _t0} n=${builds.length} '
+          'build_ms=${q(builds, .5)}/${q(builds, .95)}/${q(builds, 1)} '
+          'raster_ms=${q(rasters, .5)}/${q(rasters, .95)}/${q(rasters, 1)}');
+      builds.clear();
+      rasters.clear();
+    });
+  }
+
+  static void afterRunApp() {
+    if (!diag) return;
+    _frameStats();
+    WidgetsBinding.instance.waitUntilFirstFrameRasterized.then((_) {
+      mark('first-frame');
+      final view = ui.PlatformDispatcher.instance.views.first;
+      final display = view.display;
+      stderr.writeln('BBDIAG display refreshRate=${display.refreshRate} dpr=${view.devicePixelRatio} '
+          'size=${view.physicalSize} engineTextScale=${ui.PlatformDispatcher.instance.textScaleFactor}');
+    });
+    stderr.writeln('BBDIAG scale ui=${DesktopScale.uiScale.toStringAsFixed(3)} font=${DesktopScale.fontScale} '
+        'gtkTextScale=${DesktopScale.gtkTextScale.value} gtkFont="${DesktopScale.gtkFont.value}" '
+        'gtkTextPx=${DesktopScale.gtkTextPx.toStringAsFixed(2)} bodyPx=${(DesktopScale.baseBodyPx * DesktopScale.uiScale * DesktopScale.fontScale).toStringAsFixed(2)} '
+        'bubblePx=${(15 * DesktopScale.uiScale * DesktopScale.fontScale).toStringAsFixed(2)}');
+    StartupTasks.uiReady.future.then((_) => mark('ui-ready'));
+  }
+}
