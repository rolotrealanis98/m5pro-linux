diff --git a/test/desktop_follow_test.dart b/test/desktop_follow_test.dart
new file mode 100644
index 000000000..f4b20d6fb
--- /dev/null
+++ b/test/desktop_follow_test.dart
@@ -0,0 +1,62 @@
+import 'package:bluebubbles/helpers/ui/desktop_scale.dart';
+import 'package:bluebubbles/services/ui/theme/omarchy_palette.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  group('DesktopScale', () {
+    test('Omarchy default text size (Liberation Sans 11 at 0.8182) is 12 px', () {
+      expect(DesktopScale.textPxFor('Liberation Sans 11', 0.8182), closeTo(12.0, 0.01));
+    });
+
+    test('auto scale makes the 14 px body text as large as the desktop text', () {
+      expect(DesktopScale.autoScaleFor('Liberation Sans 11', 0.8182), closeTo(12 / 14, 0.001));
+      expect(DesktopScale.autoScaleFor('Liberation Sans 11', 1.0), closeTo(14.667 / 14, 0.001));
+    });
+
+    test('auto scale is clamped', () {
+      expect(DesktopScale.autoScaleFor('Liberation Sans 6', 0.5), 0.6);
+      expect(DesktopScale.autoScaleFor('Liberation Sans 30', 2.0), 2.0);
+    });
+
+    test('family and size are parsed from a GTK font name', () {
+      expect(DesktopScale.familyOf('Liberation Sans 11'), 'Liberation Sans');
+      expect(DesktopScale.familyOf('Noto Sans 10.5'), 'Noto Sans');
+      expect(DesktopScale.familyOf('Cantarell'), 'Cantarell');
+      expect(DesktopScale.textPxFor('Cantarell', 1.0), closeTo(14.667, 0.01));
+    });
+  });
+
+  group('OmarchyPalette', () {
+    const colors = '''
+mode = "dark"
+accent = "#ff9f0a"
+background = "#1c1c1e"
+lighter_background = "#2c2c2e"
+foreground = "#f5f5f7"
+red = "#ff5f4a"
+broken = "not a color"
+''';
+
+    test('parses colors.toml', () {
+      final p = OmarchyPalette.parse(colors)!;
+      expect(p.dark, isTrue);
+      expect(p.accent, const Color(0xFFFF9F0A));
+      expect(p.background, const Color(0xFF1C1C1E));
+      expect(p.raised, const Color(0xFF2C2C2E));
+      expect(p.error, const Color(0xFFFF5F4A));
+    });
+
+    test('needs a background and a foreground', () {
+      expect(OmarchyPalette.parse('accent = "#ff9f0a"'), isNull);
+    });
+
+    test('recolors a theme and keeps its brightness', () {
+      final p = OmarchyPalette.parse(colors)!;
+      final themed = p.apply(ThemeData(brightness: Brightness.dark));
+      expect(themed.colorScheme.brightness, Brightness.dark);
+      expect(themed.colorScheme.primary, const Color(0xFFFF9F0A));
+      expect(themed.colorScheme.surface, const Color(0xFF1C1C1E));
+    });
+  });
+}
