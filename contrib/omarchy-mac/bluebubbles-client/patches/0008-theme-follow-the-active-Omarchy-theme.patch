@@ -681,9 +682,19 @@ class ThemesService {
   }
 
   ThemePair getStructsFromData(ThemeData light, ThemeData dark) {
+    if (Platform.isLinux && SettingsSvc.settings.followOmarchyTheme.value) {
+      final palette = OmarchyPalette.load();
+      if (palette != null) return ThemePair(light: palette.apply(light), dark: palette.apply(dark));
+    }
     return Platform.isWindows ? _applyWindowsAccent(light, dark) : ThemePair(light: light, dark: dark);
   }
 
+  /// Re-applies the themes, after the Omarchy palette (or the setting that follows it) changed.
+  void reloadFromSystem() {
+    final context = Get.context;
+    if (context != null && context.mounted) _loadTheme(context);
+  }
