diff --git a/lib/services/ui/theme/omarchy_palette.dart b/lib/services/ui/theme/omarchy_palette.dart
new file mode 100644
index 000000000..3825982c4
--- /dev/null
+++ b/lib/services/ui/theme/omarchy_palette.dart
@@ -0,0 +1,125 @@
+import 'dart:async';
+
+import 'package:bluebubbles/helpers/helpers.dart';
+import 'package:flutter/material.dart';
+import 'package:universal_io/io.dart';
+
+/// The active Omarchy theme's colors (`~/.local/state/omarchy/current/theme/colors.toml`), applied to the app's
+/// themes so Messages looks like the rest of the desktop. Omarchy rewrites that directory when the theme changes;
+/// [watch] reports it.
+class OmarchyPalette {
+  OmarchyPalette._(this._colors, this.dark);
+
+  final Map<String, Color> _colors;
+  final bool dark;
+
+  static String get _dir {
+    final state = Platform.environment['XDG_STATE_HOME'] ?? '${Platform.environment['HOME']}/.local/state';
+    return '$state/omarchy/current';
+  }
+
+  /// The current palette, or null when this is not an Omarchy session or the file cannot be read.
+  static OmarchyPalette? load() {
+    try {
+      final file = File('$_dir/theme/colors.toml');
+      if (!file.existsSync()) return null;
+      return parse(file.readAsStringSync());
+    } catch (_) {
+      return null;
+    }
+  }
+
+  /// Parses the `key = "#rrggbb"` lines of a colors.toml. Null without a background and foreground.
+  static OmarchyPalette? parse(String content) {
+    final colors = <String, Color>{};
+    var dark = true;
+    final line = RegExp(r'^\s*([A-Za-z0-9_]+)\s*=\s*"([^"]*)"');
+    for (final raw in content.split('\n')) {
+      final m = line.firstMatch(raw);
+      if (m == null) continue;
+      final key = m.group(1)!;
+      final value = m.group(2)!;
+      if (key == 'mode') {
+        dark = value != 'light';
+      } else if (RegExp(r'^#[0-9a-fA-F]{6}$').hasMatch(value)) {
+        colors[key] = Color(int.parse('FF${value.substring(1)}', radix: 16));
+      }
+    }
+    if (!colors.containsKey('background') || !colors.containsKey('foreground')) return null;
+    return OmarchyPalette._(colors, dark);
+  }
+
+  /// Calls [onChange] (debounced) when Omarchy switches theme.
+  static StreamSubscription<FileSystemEvent>? watch(void Function() onChange) {
+    try {
+      final dir = Directory(_dir);
+      if (!dir.existsSync()) return null;
+      Timer? debounce;
+      return dir.watch().listen((_) {
+        debounce?.cancel();
+        debounce = Timer(const Duration(milliseconds: 400), onChange);
+      });
+    } catch (_) {
+      return null;
+    }
+  }
+
+  Color? _first(List<String> keys) {
+    for (final k in keys) {
+      final c = _colors[k];
+      if (c != null) return c;
+    }
+    return null;
+  }
+
+  Color get background => _colors['background']!;
+  Color get foreground => _colors['foreground']!;
+  Color get accent => _first(['accent', 'blue']) ?? foreground;
+  Color get raised => _first(['lighter_background', 'lighter_bg', 'selection']) ?? background;
+  Color get sunken => _first(['dark_background', 'dark_bg']) ?? background;
+  Color get muted => _first(['dark_foreground', 'dark_fg', 'muted']) ?? foreground;
+  Color get outline => _first(['muted', 'selection']) ?? muted;
+  Color get error => _first(['red']) ?? const Color(0xFFFF453A);
+  Color get green => _first(['green']) ?? accent;
+
+  /// [theme] recolored with this palette. Brightness and typography stay the theme's own.
+  ThemeData apply(ThemeData theme) {
+    final scheme = theme.colorScheme.copyWith(
+      primary: accent,
+      onPrimary: background,
+      primaryContainer: raised,
+      onPrimaryContainer: foreground,
+      secondary: accent,
+      onSecondary: background,
+      secondaryContainer: raised,
+      onSecondaryContainer: foreground,
+      tertiary: green,
+      surface: background,
+      onSurface: foreground,
+      surfaceContainerHighest: raised,
+      surfaceVariant: raised,
+      onSurfaceVariant: muted,
+      outline: outline,
+      error: error,
+      inverseSurface: foreground,
+      onInverseSurface: background,
+      inversePrimary: accent,
+    );
+    return theme.copyWith(
+      colorScheme: scheme,
+      scaffoldBackgroundColor: background,
+      canvasColor: background,
+      cardColor: raised,
+      extensions: theme.extensions.values.map((e) => e is BubbleColors
+          ? e.copyWith(
+              iMessageBubbleColor: accent,
+              oniMessageBubbleColor: background,
+              smsBubbleColor: green,
+              onSmsBubbleColor: background,
+              receivedBubbleColor: raised,
+              onReceivedBubbleColor: foreground,
+            )
+          : e),
+    );
+  }
+}
