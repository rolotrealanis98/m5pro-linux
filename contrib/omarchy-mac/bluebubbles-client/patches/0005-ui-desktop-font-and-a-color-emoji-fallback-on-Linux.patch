 import 'dart:math';
 
 import 'package:bluebubbles/helpers/helpers.dart';
+import 'package:bluebubbles/helpers/ui/desktop_scale.dart';
 import 'package:bluebubbles/helpers/ui/system_ui_overlay_style_helpers.dart';
 import 'package:bluebubbles/services/services.dart';
 import 'package:bluebubbles/utils/window_effects.dart';
@@ -111,17 +112,31 @@ class BubbleText extends ThemeExtension<BubbleText> {
   }
 }
 
+/// Emoji font stack for TextStyles that name "Apple Color Emoji": on Linux the app never ships that font, and
+/// Flutter's own fallback picks a monochrome symbol font for many emoji (tofu boxes, flat hearts).
+const List<String> kEmojiFontFallback = ["Noto Color Emoji"];
+
 extension EmojiFontFallback on ThemeData {
-  /// Windows' own font fallback misses newer emoji (e.g. U+1FAEA), so name the emoji font explicitly. Apply to every
-  /// theme handed to a [Theme] widget, including per-chat themes resolved from [ThemeStruct]. No-op elsewhere.
-  ThemeData get withEmojiFallback => !Platform.isWindows
-      ? this
-      : copyWith(
-          textTheme: textTheme.apply(fontFamilyFallback: const ["Segoe UI Emoji"]),
-          extensions: extensions.values.map((e) => e is BubbleText
-              ? e.copyWith(bubbleText: e.bubbleText.apply(fontFamilyFallback: const ["Segoe UI Emoji"]))
-              : e),
-        );
+  /// Names the platform's color emoji font explicitly, because the engine's own fallback misses emoji: Windows lacks
+  /// newer ones (e.g. U+1FAEA) and Linux picks monochrome symbol fonts. On Linux this also applies the desktop's
+  /// interface font. Apply to every theme handed to a [Theme] widget, including per-chat themes resolved from
+  /// [ThemeStruct].
+  ThemeData get withEmojiFallback {
+    final List<String>? emoji = Platform.isWindows
+        ? const ["Segoe UI Emoji"]
+        : Platform.isLinux
+            ? kEmojiFontFallback
+            : null;
+    final String? family = DesktopScale.family;
+    if (emoji == null && family == null) return this;
+    return copyWith(
+      textTheme: textTheme.apply(fontFamily: family, fontFamilyFallback: emoji),
+      primaryTextTheme: primaryTextTheme.apply(fontFamily: family, fontFamilyFallback: emoji),
+      extensions: extensions.values.map((e) => e is BubbleText
+          ? e.copyWith(bubbleText: e.bubbleText.apply(fontFamily: family, fontFamilyFallback: emoji))
+          : e),
+    );
+  }
 }
 
