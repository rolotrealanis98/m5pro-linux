diff --git a/lib/helpers/ui/desktop_scale.dart b/lib/helpers/ui/desktop_scale.dart
new file mode 100644
index 000000000..5d9a5923b
--- /dev/null
+++ b/lib/helpers/ui/desktop_scale.dart
@@ -0,0 +1,143 @@
+import 'dart:io';
+import 'dart:math' as math;
+
+import 'package:bluebubbles/services/services.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:get/get.dart';
+
+/// Makes text and UI size follow the desktop (Omarchy) instead of a fixed phone-sized layout.
+///
+/// Omarchy has one text-size knob (`omarchy-display-text-size`) that sets the GTK
+/// `text-scaling-factor`, the interface font and the shell size together. The Linux runner reads
+/// them from GSettings, passes them as `--gtk-text-scale=` and `--gtk-font=` and pushes changes over
+/// the `bluebubbles/gtk-settings` channel. The Flutter engine already applies `text-scaling-factor`
+/// to text alone, which shrinks the type but not the widgets; this scales both together.
+class DesktopScale {
+  DesktopScale._();
+
+  /// GTK interface text size the app's base body text (Material `bodyMedium`, 14 logical px) is matched to.
+  static const double baseBodyPx = 14;
+
+  static const _channel = MethodChannel('bluebubbles/gtk-settings');
+
+  /// GTK `text-scaling-factor`, 1.0 when unknown.
+  static final RxDouble gtkTextScale = 1.0.obs;
+
+  /// GTK interface font name as `Family Size`, for example `Liberation Sans 11`. Empty when unknown.
+  static final RxString gtkFont = ''.obs;
+
+  static bool get enabled => Platform.isLinux;
+
+  static void init(List<String> arguments) {
+    if (!enabled) return;
+    for (final arg in arguments) {
+      if (arg.startsWith('--gtk-text-scale=')) {
+        gtkTextScale.value = double.tryParse(arg.substring('--gtk-text-scale='.length)) ?? 1.0;
+      } else if (arg.startsWith('--gtk-font=')) {
+        gtkFont.value = arg.substring('--gtk-font='.length);
+      }
+    }
+    _channel.setMethodCallHandler((call) async {
+      if (call.method != 'changed') return null;
+      final args = call.arguments as Map<Object?, Object?>;
+      gtkTextScale.value = (args['textScale'] as num?)?.toDouble() ?? gtkTextScale.value;
+      gtkFont.value = (args['font'] as String?) ?? gtkFont.value;
+      return null;
+    });
+  }
+
+  /// `Liberation Sans 11` -> `Liberation Sans`.
+  static String familyOf(String font) {
+    final match = RegExp(r'^(.*?)\s+\d+(\.\d+)?$').firstMatch(font.trim());
+    return (match?.group(1) ?? font).trim();
+  }
+
+  /// Interface font size in CSS pixels at 96 dpi with the text scaling factor applied: `Liberation Sans 11` at 0.8182
+  /// is 9 pt, 12 px. 11 pt when the font name has no size.
+  static double textPxFor(String font, double textScale) {
+    final match = RegExp(r'(\d+(\.\d+)?)$').firstMatch(font.trim());
+    final pt = double.tryParse(match?.group(1) ?? '') ?? 11;
+    return pt * textScale * 96 / 72;
+  }
+
+  /// UI scale that makes the app's body text ([baseBodyPx]) as large as the desktop's interface text.
+  static double autoScaleFor(String font, double textScale) =>
+      (textPxFor(font, textScale) / baseBodyPx).clamp(0.6, 2.0).toDouble();
+
+  static String get systemFamily => familyOf(gtkFont.value);
+
+  static double get gtkTextPx => textPxFor(gtkFont.value, gtkTextScale.value);
+
+  static double get autoUiScale => autoScaleFor(gtkFont.value, gtkTextScale.value);
+
+  /// BB_UI_SCALE and BB_FONT_SCALE override the settings, for measuring.
+  static double? get _envUiScale => double.tryParse(Platform.environment['BB_UI_SCALE'] ?? '');
+  static double? get _envFontScale => double.tryParse(Platform.environment['BB_FONT_SCALE'] ?? '');
+
+  /// The scale applied to the whole UI (layout and text together).
+  static double get uiScale {
+    if (!enabled) return 1.0;
+    final env = _envUiScale;
+    if (env != null) return env;
+    final chosen = SettingsSvc.settings.uiScale.value;
+    return chosen > 0 ? chosen : autoUiScale;
+  }
+
+  /// Extra text-only multiplier on top of [uiScale].
+  static double get fontScale {
+    if (!enabled) return 1.0;
+    return _envFontScale ?? SettingsSvc.settings.fontScale.value;
+  }
+
+  /// Font family for all text: the desktop's interface font, or null for the app's own.
+  static String? get family {
+    if (!enabled || !SettingsSvc.settings.useSystemFont.value) return null;
+    final f = systemFamily;
+    return f.isEmpty ? null : f;
+  }
+}
+
+/// Applies [DesktopScale] around the app: lays the child out at (window / scale) logical pixels and
+/// scales it back up, and replaces the engine's text-only scaling factor with the app's own.
+class DesktopScaleWrapper extends StatelessWidget {
+  const DesktopScaleWrapper({super.key, required this.child});
+
+  final Widget child;
+
+  @override
+  Widget build(BuildContext context) {
+    if (!DesktopScale.enabled) return child;
+    return Obx(() {
+      // Read every input here so this subtree rebuilds when any of them changes.
+      DesktopScale.gtkTextScale.value;
+      DesktopScale.gtkFont.value;
+      SettingsSvc.settings.uiScale.value;
+      final fontScale = DesktopScale.fontScale;
+      final scale = DesktopScale.uiScale;
+
+      return LayoutBuilder(builder: (context, constraints) {
+        final media = MediaQuery.of(context);
+        final width = constraints.maxWidth / scale;
+        final height = constraints.maxHeight / scale;
+        Widget inner = MediaQuery(
+          data: media.copyWith(
+            size: Size(width, height),
+            textScaler: TextScaler.linear(fontScale),
+            padding: media.padding / scale,
+            viewPadding: media.viewPadding / scale,
+            viewInsets: media.viewInsets / scale,
+          ),
+          child: child,
+        );
+        if ((scale - 1).abs() < 0.005) return inner;
+        // FittedBox lays its child out unconstrained and scales it to fill, with correct hit testing.
+        return FittedBox(
+          fit: BoxFit.fill,
+          alignment: Alignment.topLeft,
+          child: SizedBox(width: math.max(1, width), height: math.max(1, height), child: inner),
+        );
+      });
+    });
+  }
+}
