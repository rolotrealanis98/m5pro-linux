diff --git a/lib/helpers/ui/slim_profile.dart b/lib/helpers/ui/slim_profile.dart
new file mode 100644
index 000000000..0c6251743
--- /dev/null
+++ b/lib/helpers/ui/slim_profile.dart
@@ -0,0 +1,110 @@
+import 'package:bluebubbles/app/layouts/settings/widgets/layout/settings_section.dart';
+import 'package:bluebubbles/app/layouts/settings/widgets/search/searchable_setting_item.dart';
+import 'package:flutter/widgets.dart';
+
+/// `flutter build linux --dart-define=BB_SLIM=true` builds the slim profile: the settings a single desktop owner
+/// needs, with defaults that feel like a native Messages client. Nothing is removed from the app: hidden options keep
+/// their stored values and defaults, and a normal build is upstream's behaviour. The flag is a compile-time constant,
+/// so a normal build drops all of this.
+const bool kSlim = bool.fromEnvironment('BB_SLIM');
+
+class SlimProfile {
+  SlimProfile._();
+
+  /// Titles of settings tiles, switches and option lists that the slim build hides. Matched by exact title in
+  /// SettingsTile, SettingsSwitch and SettingsOptions, so a tile needs no edit at its call site.
+  static const Set<String> _hiddenTitles = {
+    // Desktop
+    'Launch on Startup',
+    'Show Startup Entry',
+    'Launch on Startup Minimized',
+    'Minimize to Tray',
+    'Actions',
+    // Appearance
+    'Theme Studio',
+    'App Skin',
+    'Colorful Avatars',
+    'Colorful Bubbles',
+    'Custom Avatar Colors',
+    'Custom Avatars',
+    // Chat list
+    'Show Sync Indicator in Chat List',
+    'Filtered Chat List',
+    'Unarchive Chats On New Message',
+    'Hide Dividers',
+    'Dense Conversation Tiles',
+    'Move Chat Creator Button to Header',
+    'Show Filters in Header',
+    'Show Custom Group Filters',
+    // Conversation
+    'Show Chat Name as Placeholder',
+    'Show Avatars in DM Chats',
+    'Message Options Order',
+    'Sync Group Chat Icons',
+    'Store Last Read Message',
+    'Hide Names in Reaction Details',
+    'Auto-open Keyboard',
+    'Swipe Message Box to Close Keyboard',
+    'Swipe Message Box to Open Keyboard',
+    'Hide Keyboard When Scrolling',
+    'Open Keyboard After Tapping Scroll To Bottom',
+    'Scroll To Bottom When Sending Messages',
+    // Attachments, advanced, notifications
+    'Only Auto-download Attachments on WiFi',
+    'High Performance Mode',
+    'Cancel Queued Messages on Failure',
+    'Send Delay',
+    'Maximum Group Avatar Count',
+    'Text Detection',
+    'Notify When Incremental Sync Complete',
+  };
+
+  /// Top-level settings entries hidden in the slim build.
+  static const Set<String> _hiddenTopLevel = {
+    'Custom Groups',
+    'Redacted Mode',
+    'Storage Analyzer',
+    'Developer Tools',
+    'Backup & Restore',
+    'Leave Us a Review',
+    'Join Our Discord',
+  };
+
+  static bool hides(String? title) => kSlim && title != null && _hiddenTitles.contains(title);
+
+  /// Drops the hidden top-level entries (and any section header left without entries).
+  static List<Widget> filterSettingItems(List<Widget> items) {
+    if (!kSlim) return items;
+    final out = <Widget>[];
+    for (final item in items) {
+      if (item is SearchableSettingItem && _hiddenTopLevel.contains(item.title)) continue;
+      if (item is SettingsSection && item.searchableSettingsItems != null) {
+        final kept = item.searchableSettingsItems!.where((i) => !_hiddenTopLevel.contains(i.title)).toList();
+        if (kept.isEmpty) {
+          // Drop the header placed just before an emptied section.
+          if (out.isNotEmpty && out.last is SearchableSettingItem) out.removeLast();
+          continue;
+        }
+        out.add(SettingsSection(backgroundColor: item.backgroundColor, searchableSettingsItems: kept));
+        continue;
+      }
+      out.add(item);
+    }
+    return out;
+  }
+
+  /// Defaults for a desktop that wants Messages-like behaviour. Only keys the user has never saved are seeded, so
+  /// nothing the owner changed is overwritten, and no account, server or Private API sending option is touched.
+  static void seedDefaults(Map<String, dynamic> stored) {
+    if (!kSlim) return;
+    const defaults = <String, dynamic>{
+      'statusIndicatorsOnChats': true,
+      'filterUnknownSenders': true,
+      'showDeliveryTimestamps': true,
+      'selectedActionIndices': [0],
+      'previewImageQuality': 1.0,
+      'replaceEmoticonsWithEmoji': true,
+    };
+    defaults.forEach((key, value) => stored.putIfAbsent(key, () => value));
+  }
+}
