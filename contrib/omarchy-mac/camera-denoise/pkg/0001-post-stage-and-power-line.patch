diff -ruN a/tests/test_post.c b/tests/test_post.c
--- a/tests/test_post.c
+++ b/tests/test_post.c
@@ -0,0 +1,346 @@
+// SPDX-License-Identifier: MIT
+/*
+ * Post stage: dark impulses go, noise drops (more at the corners, where the
+ * lens-shading gain makes it larger), edges and thin lines stay, and the NEON
+ * and scalar luma paths agree bit for bit.
+ */
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "../src/post/post.h"
+
+static uint32_t rng = 987654321u;
+static uint32_t rnd(void)
+{
+	rng = rng * 1664525u + 1013904223u;
+	return rng >> 8;
+}
+static double gauss(void)
+{
+	double u = (rnd() + 1) / 16777217.0, v = (rnd() + 1) / 16777217.0;
+	return sqrt(-2 * log(u)) * cos(6.283185307179586 * v);
+}
+static int clamp8(double v) { return v < 0 ? 0 : v > 255 ? 255 : (int)(v + 0.5); }
+
+struct img {
+	int w, h, sy, suv;
+	uint8_t *y, *uv;
+};
+
+static struct img alloc_img(int w, int h)
+{
+	struct img i = { w, h, w + 64, w + 32, NULL, NULL };
+	i.y = calloc((size_t)i.sy, h);
+	i.uv = calloc((size_t)i.suv, h / 2);
+	return i;
+}
+static void free_img(struct img *i) { free(i->y); free(i->uv); }
+static struct cdn_frame fr(struct img *i)
+{
+	return (struct cdn_frame){ i->y, i->uv, i->w, i->h, i->sy, i->suv };
+}
+static void copy_img(struct img *d, const struct img *s)
+{
+	memcpy(d->y, s->y, (size_t)s->sy * s->h);
+	memcpy(d->uv, s->uv, (size_t)s->suv * s->h / 2);
+}
+
+#define EDGE_STEP 80
+#define LINE_DROP 50
+#define LINE_X 100
+#define UEDGE 50
+
+/* clean scene: gradient, one vertical step edge, one 1 px dark line, a chroma step */
+static void truth(struct img *t)
+{
+	int W = t->w, H = t->h;
+	for (int y = 0; y < H; y++)
+		for (int x = 0; x < W; x++) {
+			int v = 60 + x / 8 + (x >= W / 2 ? EDGE_STEP : 0);
+			if (x == LINE_X && y >= H / 4 && y < 3 * H / 4)
+				v -= LINE_DROP;
+			t->y[(size_t)y * t->sy + x] = (uint8_t)v;
+		}
+	for (int y = 0; y < H / 2; y++)
+		for (int x = 0; x < W / 2; x++) {
+			t->uv[(size_t)y * t->suv + 2 * x] = (uint8_t)(128 + (x >= W / 4 ? UEDGE : 0));
+			t->uv[(size_t)y * t->suv + 2 * x + 1] = (uint8_t)(120 + (y >= H / 4 ? 30 : 0));
+		}
+}
+
+static double radius(int x, int y, int W, int H)
+{
+	double cx = (W - 1) / 2.0, cy = (H - 1) / 2.0;
+	return sqrt(((x - cx) * (x - cx) + (y - cy) * (y - cy)) / (cx * cx + cy * cy));
+}
+
+/* radial luma noise, blotchy radial chroma noise, 1.3% dark impulses */
+static void add_noise(struct img *n, const struct img *t, double impulse_rate)
+{
+	int W = t->w, H = t->h;
+	copy_img(n, t);
+	for (int y = 0; y < H; y++)
+		for (int x = 0; x < W; x++) {
+			double r = radius(x, y, W, H), sd = 1.5 + 5.5 * r * r * r;
+			n->y[(size_t)y * n->sy + x] = (uint8_t)clamp8(t->y[(size_t)y * t->sy + x] + gauss() * sd);
+			if ((rnd() & 0xffff) < impulse_rate * 65536) {
+				int drop = 60 + (int)(rnd() % 50);
+				int v = n->y[(size_t)y * n->sy + x] - drop;
+				n->y[(size_t)y * n->sy + x] = (uint8_t)(v < 0 ? 0 : v);
+			}
+		}
+	/* chroma: a 4x4-sample blotch field plus fine noise */
+	int cw = W / 2, ch = H / 2, bw = (cw + 3) / 4, bh = (ch + 3) / 4;
+	double *blob = malloc(sizeof(double) * 2 * bw * bh);
+	for (int i = 0; i < 2 * bw * bh; i++)
+		blob[i] = gauss();
+	for (int y = 0; y < ch; y++)
+		for (int x = 0; x < cw; x++) {
+			double r = radius(x * 2, y * 2, W, H), sd = 1.0 + 3.5 * r * r * r;
+			for (int c = 0; c < 2; c++) {
+				double v = 0.8 * blob[c * bw * bh + (y / 4) * bw + x / 4] * sd + 0.6 * gauss() * sd;
+				uint8_t *p = n->uv + (size_t)y * n->suv + 2 * x + c;
+				*p = (uint8_t)clamp8(*p + v);
+			}
+		}
+	free(blob);
+}
+
+/* RMS error against truth in the flat part of an annulus (no edge, no line) */
+static double rms_y(const struct img *a, const struct img *t, double r0, double r1, int skip_impulse, const struct img *noisy)
+{
+	double e = 0;
+	long n = 0;
+	for (int y = 0; y < t->h; y++)
+		for (int x = 0; x < t->w; x++) {
+			double r = radius(x, y, t->w, t->h);
+			if (r < r0 || r >= r1 || abs(x - t->w / 2) < 6 || abs(x - LINE_X) < 6 || x < 3 || x >= t->w - 3 || y < 3 || y >= t->h - 3)
+				continue;
+			int tv = t->y[(size_t)y * t->sy + x];
+			/* the noisy frame's own impulses are compared separately */
+			if (skip_impulse && tv - noisy->y[(size_t)y * noisy->sy + x] > 30)
+				continue;
+			double d = a->y[(size_t)y * a->sy + x] - tv;
+			e += d * d;
+			n++;
+		}
+	return sqrt(e / n);
+}
+
+static double rms_uv(const struct img *a, const struct img *t, double r0, double r1)
+{
+	double e = 0;
+	long n = 0;
+	for (int y = 4; y < t->h / 2 - 4; y++)
+		for (int x = 4; x < t->w / 2 - 4; x++) {
+			double r = radius(x * 2, y * 2, t->w, t->h);
+			if (r < r0 || r >= r1 || abs(x - t->w / 4) < 5 || abs(y - t->h / 4) < 5)
+				continue;
+			for (int c = 0; c < 2; c++) {
+				double d = (double)a->uv[(size_t)y * a->suv + 2 * x + c] - t->uv[(size_t)y * t->suv + 2 * x + c];
+				e += d * d;
+				n++;
+			}
+		}
+	return sqrt(e / n);
+}
+
+static double impulse_frac(const struct img *a, const struct img *t)
+{
+	long n = 0, bad = 0;
+	for (int y = 3; y < t->h - 3; y++)
+		for (int x = 3; x < t->w - 3; x++) {
+			if (abs(x - t->w / 2) < 4 || abs(x - LINE_X) < 4)
+				continue;
+			n++;
+			if (t->y[(size_t)y * t->sy + x] - a->y[(size_t)y * a->sy + x] > 30)
+				bad++;
+		}
+	return (double)bad / n;
+}
+
+static int fails;
+#define CHECK(cond, ...) do { if (!(cond)) { fprintf(stderr, "FAIL: " __VA_ARGS__); fprintf(stderr, "\n"); fails++; } } while (0)
+
+static int same(const struct img *a, const struct img *b)
+{
+	for (int y = 0; y < a->h; y++)
+		if (memcmp(a->y + (size_t)y * a->sy, b->y + (size_t)y * b->sy, a->w) ||
+		    (y < a->h / 2 && memcmp(a->uv + (size_t)y * a->suv, b->uv + (size_t)y * b->suv, a->w)))
+			return 0;
+	return 1;
+}
+
+static void test_noise_and_edges(void)
+{
+	const int W = 640, H = 360;
+	struct img t = alloc_img(W, H), n = alloc_img(W, H), o = alloc_img(W, H);
+	struct cdn_post_cfg cfg;
+	cdn_post_cfg_defaults(&cfg);
+	truth(&t);
+	add_noise(&n, &t, 0.013);
+	copy_img(&o, &n);
+	struct cdn_post *p = cdn_post_create(W, H, &cfg);
+	struct cdn_frame f = fr(&o);
+	CHECK(p != NULL, "create with defaults");
+	CHECK(cdn_post_process(p, &f) == 0, "process");
+
+	double fi = impulse_frac(&n, &t), fo = impulse_frac(&o, &t);
+	printf("dark impulses (>30 below truth): %.2f%% -> %.3f%% of pixels\n", fi * 100, fo * 100);
+	CHECK(fi > 0.010, "test frame should hold >1%% impulses (has %.2f%%)", fi * 100);
+	CHECK(fo < 0.0015, "impulses left %.3f%% (want < 0.15%%)", fo * 100);
+
+	static const double r0[3] = { 0, 0.6, 0.9 }, r1[3] = { 0.3, 0.9, 1.01 };
+	static const double want_y[3] = { 1.3, 2.0, 2.5 };
+	for (int i = 0; i < 3; i++) {
+		double a = rms_y(&n, &t, r0[i], r1[i], 1, &n), b = rms_y(&o, &t, r0[i], r1[i], 1, &n);
+		printf("luma rms vs truth, r %.1f-%.1f: %.2f -> %.2f (x%.2f)\n", r0[i], r1[i], a, b, a / b);
+		CHECK(a / b >= want_y[i], "luma noise ratio %.2f < %.2f at r %.1f-%.1f", a / b, want_y[i], r0[i], r1[i]);
+	}
+	for (int i = 0; i < 3; i++) {
+		double a = rms_uv(&n, &t, r0[i], r1[i]), b = rms_uv(&o, &t, r0[i], r1[i]);
+		printf("chroma rms vs truth, r %.1f-%.1f: %.2f -> %.2f (x%.2f)\n", r0[i], r1[i], a, b, a / b);
+		CHECK(a / b >= (i ? 1.5 : 1.3), "chroma noise ratio %.2f too low at r %.1f-%.1f", a / b, r0[i], r1[i]);
+	}
+
+	/* edges: mean contrast across the step, the thin line, and the chroma step */
+	double hi = 0, lo = 0, line = 0, side = 0, u_hi = 0, u_lo = 0;
+	int rows = 0;
+	for (int y = 40; y < H - 40; y++, rows++) {
+		hi += o.y[(size_t)y * o.sy + W / 2];
+		lo += o.y[(size_t)y * o.sy + W / 2 - 1];
+		if (y >= H / 4 + 4 && y < 3 * H / 4 - 4) {
+			line += o.y[(size_t)y * o.sy + LINE_X];
+			side += (o.y[(size_t)y * o.sy + LINE_X - 2] + o.y[(size_t)y * o.sy + LINE_X + 2]) / 2.0;
+		}
+	}
+	double step = (hi - lo) / rows;
+	printf("step edge contrast kept: %.1f of %d\n", step, EDGE_STEP);
+	CHECK(step > 0.9 * EDGE_STEP, "step edge softened to %.1f of %d", step, EDGE_STEP);
+	int lrows = 3 * H / 4 - 4 - (H / 4 + 4);
+	double ldepth = (side - line) / lrows;
+	printf("1 px dark line depth kept: %.1f of %d\n", ldepth, LINE_DROP);
+	CHECK(ldepth > 0.75 * LINE_DROP, "thin line faded to %.1f of %d", ldepth, LINE_DROP);
+	int ucols = 0;
+	for (int y = 10; y < H / 2 - 10; y++, ucols++) {
+		u_hi += o.uv[(size_t)y * o.suv + 2 * (W / 4)];
+		u_lo += o.uv[(size_t)y * o.suv + 2 * (W / 4 - 1)];
+	}
+	double ustep = (u_hi - u_lo) / ucols;
+	printf("chroma step contrast kept: %.1f of %d\n", ustep, UEDGE);
+	CHECK(ustep > 0.85 * UEDGE, "chroma edge softened to %.1f of %d", ustep, UEDGE);
+
+	/* stateless: the same input gives the same output */
+	struct img o2 = alloc_img(W, H);
+	copy_img(&o2, &n);
+	struct cdn_frame f2 = fr(&o2);
+	cdn_post_process(p, &f2);
+	CHECK(same(&o, &o2), "second run differs");
+	cdn_post_destroy(p);
+	free_img(&t); free_img(&n); free_img(&o); free_img(&o2);
+}
+
+static void test_stages_alone(void)
+{
+	const int W = 640, H = 360;
+	struct img t = alloc_img(W, H), n = alloc_img(W, H), o = alloc_img(W, H);
+	truth(&t);
+	add_noise(&n, &t, 0.013);
+
+	/* impulse only: luma changes only where a pixel was a dark outlier; chroma and the line are untouched */
+	struct cdn_post_cfg c;
+	cdn_post_cfg_defaults(&c);
+	c.luma = 0; c.chroma = 0;
+	copy_img(&o, &n);
+	struct cdn_post *p = cdn_post_create(W, H, &c);
+	struct cdn_frame f = fr(&o);
+	cdn_post_process(p, &f);
+	cdn_post_destroy(p);
+	long changed = 0;
+	for (int y = 0; y < H; y++)
+		for (int x = 0; x < W; x++)
+			changed += o.y[(size_t)y * o.sy + x] != n.y[(size_t)y * n.sy + x];
+	CHECK(changed < (long)(W * H * 0.02), "impulse-only changed %ld pixels", changed);
+	CHECK(impulse_frac(&o, &t) < 0.0015, "impulse-only left impulses");
+	CHECK(!memcmp(o.uv, n.uv, (size_t)o.suv * (H / 2)), "impulse-only touched chroma");
+
+	/* a 1 px dark line with no noise is exactly preserved by the impulse stage */
+	struct img clean = alloc_img(W, H), co = alloc_img(W, H);
+	truth(&clean);
+	copy_img(&co, &clean);
+	p = cdn_post_create(W, H, &c);
+	struct cdn_frame fc = fr(&co);
+	cdn_post_process(p, &fc);
+	cdn_post_destroy(p);
+	/* only the two end pixels of the line may go (an end pixel has one dark neighbour) */
+	long moved = 0, stray = 0;
+	for (int y = 0; y < H; y++)
+		for (int x = 0; x < W; x++)
+			if (clean.y[(size_t)y * clean.sy + x] != co.y[(size_t)y * co.sy + x]) {
+				moved++;
+				stray += !(x == LINE_X && (y == H / 4 || y == 3 * H / 4 - 1));
+			}
+	CHECK(stray == 0 && moved <= 2, "impulse stage altered a clean frame: %ld pixels, %ld not at the line ends", moved, stray);
+	CHECK(!memcmp(clean.uv, co.uv, (size_t)co.suv * (H / 2)), "impulse stage touched clean chroma");
+
+	/* chroma only leaves luma alone; luma only leaves chroma alone */
+	cdn_post_cfg_defaults(&c);
+	c.impulse = 0; c.luma = 0;
+	copy_img(&o, &n);
+	p = cdn_post_create(W, H, &c);
+	f = fr(&o);
+	cdn_post_process(p, &f);
+	cdn_post_destroy(p);
+	CHECK(!memcmp(o.y, n.y, (size_t)o.sy * H), "chroma-only touched luma");
+	CHECK(memcmp(o.uv, n.uv, (size_t)o.suv * (H / 2)), "chroma-only did nothing");
+	cdn_post_cfg_defaults(&c);
+	c.impulse = 0; c.chroma = 0;
+	copy_img(&o, &n);
+	p = cdn_post_create(W, H, &c);
+	f = fr(&o);
+	cdn_post_process(p, &f);
+	cdn_post_destroy(p);
+	CHECK(!memcmp(o.uv, n.uv, (size_t)o.suv * (H / 2)), "luma-only touched chroma");
+
+	/* disabled or empty config makes no stage */
+	cdn_post_cfg_defaults(&c);
+	c.enabled = false;
+	CHECK(cdn_post_create(W, H, &c) == NULL, "disabled config made a stage");
+	cdn_post_cfg_defaults(&c);
+	c.impulse = 0; c.luma = 0; c.chroma = 0;
+	CHECK(cdn_post_create(W, H, &c) == NULL, "all stages off made a stage");
+	free_img(&t); free_img(&n); free_img(&o); free_img(&clean); free_img(&co);
+}
+
+static void test_neon_scalar(int W, int H)
+{
+	struct img t = alloc_img(W, H), n = alloc_img(W, H), a = alloc_img(W, H), b = alloc_img(W, H);
+	struct cdn_post_cfg c;
+	cdn_post_cfg_defaults(&c);
+	truth(&t);
+	add_noise(&n, &t, 0.013);
+	copy_img(&a, &n);
+	copy_img(&b, &n);
+	struct cdn_post *p = cdn_post_create(W, H, &c);
+	struct cdn_frame fa = fr(&a), fb = fr(&b);
+	cdn_post_process_ex(p, &fa, false);
+	cdn_post_process_ex(p, &fb, true);
+	CHECK(same(&a, &b), "scalar and NEON differ at %dx%d", W, H);
+	CHECK(!same(&a, &n), "nothing changed at %dx%d", W, H);
+	printf("scalar == NEON at %dx%d: %s\n", W, H, same(&a, &b) ? "yes" : "NO");
+	cdn_post_destroy(p);
+	free_img(&t); free_img(&n); free_img(&a); free_img(&b);
+}
+
+int main(void)
+{
+	test_noise_and_edges();
+	test_stages_alone();
+	test_neon_scalar(640, 360);
+	test_neon_scalar(322, 182);	/* width not a multiple of 16: scalar tail */
+	test_neon_scalar(1920, 1080);
+	printf(fails ? "FAIL\n" : "PASS\n");
+	return fails != 0;
+}
diff -ruN a/tools/cdn-post-bench.c b/tools/cdn-post-bench.c
--- a/tools/cdn-post-bench.c
+++ b/tools/cdn-post-bench.c
@@ -0,0 +1,83 @@
+// SPDX-License-Identifier: MIT
+/*
+ * Per-frame cost of the post stage at one size, per stage and in total, on a
+ * synthetic noisy NV12 frame: cdn-post-bench [WIDTH HEIGHT [FRAMES]]
+ * Prints median / p95 / max milliseconds and the share of one core at 30 fps.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#include "../src/post/post.h"
+
+static double now_ms(void)
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return ts.tv_sec * 1e3 + ts.tv_nsec / 1e6;
+}
+
+static int cmp(const void *a, const void *b)
+{
+	double x = *(const double *)a, y = *(const double *)b;
+	return x < y ? -1 : x > y;
+}
+
+static void bench(const char *name, const struct cdn_post_cfg *cfg, int w, int h, int frames,
+		  const uint8_t *src, bool neon)
+{
+	size_t fs = (size_t)w * h * 3 / 2;
+	uint8_t *buf = malloc(fs);
+	struct cdn_post *p = cdn_post_create(w, h, cfg);
+	double *t = malloc(sizeof(double) * frames);
+
+	if (!p) {
+		printf("%-24s (no stage)\n", name);
+		return;
+	}
+	for (int i = -5; i < frames; i++) {
+		memcpy(buf, src, fs);	/* each frame is a fresh camera frame */
+		struct cdn_frame f = { buf, buf + (size_t)w * h, w, h, w, w };
+		double t0 = now_ms();
+		cdn_post_process_ex(p, &f, neon);
+		if (i >= 0)
+			t[i] = now_ms() - t0;
+	}
+	qsort(t, frames, sizeof(double), cmp);
+	printf("%-24s %s median %6.2f ms  p95 %6.2f  max %6.2f   %4.1f%% of one core at 30 fps\n",
+	       name, neon ? "NEON  " : "scalar", t[frames / 2], t[frames * 95 / 100], t[frames - 1],
+	       t[frames / 2] * 30 / 10.0);
+	cdn_post_destroy(p);
+	free(buf);
+	free(t);
+}
+
+int main(int argc, char **argv)
+{
+	int w = argc > 2 ? atoi(argv[1]) : 1920, h = argc > 2 ? atoi(argv[2]) : 1080;
+	int frames = argc > 3 ? atoi(argv[3]) : 200;
+	size_t fs = (size_t)w * h * 3 / 2;
+	uint8_t *src = malloc(fs);
+	uint32_t r = 1;
+
+	for (size_t i = 0; i < fs; i++) {
+		r = r * 1664525u + 1013904223u;
+		src[i] = (uint8_t)(60 + (i % w) / 16 + ((r >> 24) & 15));
+	}
+	struct cdn_post_cfg all, imp, luma, chroma;
+	cdn_post_cfg_defaults(&all);
+	imp = luma = chroma = all;
+	imp.luma = 0; imp.chroma = 0;
+	luma.impulse = 0; luma.chroma = 0;
+	chroma.impulse = 0; chroma.luma = 0;
+	printf("%dx%d NV12, %d frames\n", w, h, frames);
+	for (int n = 1; n >= 0; n--) {
+		bench("impulse only", &imp, w, h, frames, src, n);
+		bench("radial luma only", &luma, w, h, frames, src, n);
+		bench("chroma only", &chroma, w, h, frames, src, n);
+		bench("all three (defaults)", &all, w, h, frames, src, n);
+	}
+	free(src);
+	return 0;
+}
