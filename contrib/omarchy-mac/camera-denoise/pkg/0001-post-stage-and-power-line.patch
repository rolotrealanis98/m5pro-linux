 # framing-zoom-min = 1.0
 # framing-zoom-max = 2.0
 # framing-zoom-default = 1.0
+
+# The spatial post stage, after the temporal filter (on by default). Three steps:
+# a dark-impulse (black speck) remover, a luma denoise whose clip level rises
+# from the centre to the corners (lens-shading gain makes the corners noisier),
+# and a chroma denoise for coloured blotches. About 3 ms per 1080p frame, one core.
+# post = on
+# Luma levels below the neighbours that count as a speck; 0 = no speck removal
+# post-impulse = 24
+# Radial luma denoise: strength 0..1 (0 = off), clip level (how large a neighbour
+# difference still counts as noise) at the centre and at the corners, in luma levels.
+# Raise the corner level for a smoother edge, lower it to keep more detail.
+# post-luma = 1.0
+# post-luma-clip-center = 6
+# post-luma-clip-edge = 22
+# Chroma denoise: strength 0..1 (0 = off), clip levels in chroma levels
+# post-chroma = 1.0
+# post-chroma-clip-center = 8
+# post-chroma-clip-edge = 24
+
+# Camera anti-flicker, set before each stream: 50, 60, auto, or off (leave the
+# driver default, which is 50 Hz on apple-isp). The control then stays set for
+# apps that open /dev/video0 directly, until the driver reloads.
+# power-line = 60
