+int cdn_v4l2_set_power_line(const char *path, int hz)
+{
+	struct v4l2_queryctrl q = { .id = V4L2_CID_POWER_LINE_FREQUENCY };
+	struct v4l2_control c = { .id = V4L2_CID_POWER_LINE_FREQUENCY };
+	int fd, err = 0;
+
+	if (!path || !*path)
+		return -ENOENT;
+	if (hz == 50)
+		c.value = V4L2_CID_POWER_LINE_FREQUENCY_50HZ;
+	else if (hz == 60)
+		c.value = V4L2_CID_POWER_LINE_FREQUENCY_60HZ;
+	else if (hz == -1)
+		c.value = V4L2_CID_POWER_LINE_FREQUENCY_AUTO;
+	else
+		return -EINVAL;
+	fd = open(path, O_RDWR | O_NONBLOCK | O_CLOEXEC);
+	if (fd < 0)
+		return -errno;
+	if (ioctl(fd, VIDIOC_QUERYCTRL, &q) ||
+	    (q.flags & (V4L2_CTRL_FLAG_DISABLED | V4L2_CTRL_FLAG_READ_ONLY)))
+		err = -ENOTTY;
+	else if (c.value < q.minimum || c.value > q.maximum)
+		err = -ERANGE;
+	else if (ioctl(fd, VIDIOC_S_CTRL, &c))
+		err = -errno;
+	close(fd);
+	return err;
+}
+
 #define NT_STEP 4
 #define NT_BX 16
