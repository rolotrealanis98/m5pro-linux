#!/usr/bin/env python3
"""m5pro-auto-brightness: macOS-style "Automatically adjust brightness" for the J716s.

Panel backlight (apple-panel-bl) and keyboard backlight (kbd_backlight) follow the ambient light sensor
(aop_als, IIO in_illuminance_input). A manual change (brightness keys, slider) is learned as a multiplier
on the curve, so it shifts the curve instead of being fought. Paused while the panel is off or locked.
Inactivity (a hypridle child, so video/idle inhibitors are honoured): the keyboard light fades out after
kbd_idle_off_s, the panel dims after panel_idle_dim_s; both come back on the next input.

  m5pro-auto-brightness on|off|toggle|status|reset|run [--dry-run]
  m5pro-auto-brightness idle 0|1|2     (called by the hypridle child: 0 active, 1 keyboard off, 2 also dim)
"""
import glob, json, math, os, subprocess, sys, time, tomllib, signal, threading

HOME = os.path.expanduser("~")
CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME", HOME + "/.config"), "m5pro-auto-brightness/config.toml")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME", HOME + "/.local/state"), "m5pro-auto-brightness/state.json")
RUNDIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "m5pro-auto-brightness")
UNIT = "m5pro-auto-brightness.service"

DEFAULTS = {
    "poll_s": 0.5,             # loop period
    "tau_up_s": 5.0,           # lux smoothing when it gets brighter
    "tau_down_s": 12.0,        # ... when it gets darker (slower: passing shadows do nothing)
    "deadband_pct": 3.0,       # ignore target changes smaller than this (panel percent points)
    "ramp_pct_per_s": 3.0,     # panel ramp speed
    "min_pct": 3.0,            # never below this (after learning)
    "max_pct": 100.0,
    "ratio_min": 0.15,         # learned multiplier limits
    "ratio_max": 4.0,
    "learn": True,             # false: never learn, manual changes are simply overwritten when lux moves
    "settle_s": 2.0,           # a manual change counts after the value is still this long
    "grace_s": 6.0,            # after wake/unlock: no learning, no writes (the shell restores levels itself)
    # lux -> panel percent. Interpolated against log(lux+1). Conservative: bright enough for a lit room.
    "curve": [[0, 22], [3, 28], [10, 34], [30, 44], [100, 60], [300, 75], [1000, 90], [3000, 100]],
    "kbd_on_below_lux": 15.0,  # keyboard light turns on below this ...
    "kbd_off_above_lux": 50.0, # ... and off above this (hysteresis)
    "kbd_level_pct": 35.0,     # default level when on (learned from manual changes)
    "kbd_fade_s": 1.5,
    # inactivity (0 disables each): macOS "turn keyboard backlight off after inactivity" and the pre-sleep dim
    "kbd_idle_off_s": 30,      # keyboard light fades out after this many seconds without input
    "panel_idle_dim_s": 120,   # panel dims after this many seconds (Omarchy locks at idle.lock, default 300)
    "panel_idle_dim_factor": 0.5,  # dim to this fraction of the current level ...
    "panel_idle_dim_min_pct": 8.0, # ... but not below this
}


def log(*a):
    print(*a, flush=True)


def load_conf():
    c = dict(DEFAULTS)
    try:
        with open(CONF, "rb") as f:
            c.update(tomllib.load(f))
    except FileNotFoundError:
        pass
    return c


def rd(path):
    with open(path) as f:
        return f.read().strip()


def find_als():
    for d in sorted(glob.glob("/sys/bus/iio/devices/iio:device*")):
        try:
            if rd(d + "/name").endswith("als") and os.path.exists(d + "/in_illuminance_input"):
                return d + "/in_illuminance_input"
        except OSError:
            pass
    return None


def hypr_env():
    base = "/run/user/%d/hypr" % os.getuid()
    try:
        sigs = sorted(glob.glob(base + "/*"), key=os.path.getmtime)
    except OSError:
        sigs = []
    env = dict(os.environ)
    if sigs:
        env["HYPRLAND_INSTANCE_SIGNATURE"] = os.path.basename(sigs[-1])
    env.setdefault("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
    return env


def screen_awake():
    """True when a panel is lit and the session is not locked. Unknown counts as awake."""
    if os.environ.get("M5PRO_AB_NOPAUSE"):   # testing only
        return True
    env = hypr_env()
    try:
        out = subprocess.run(["hyprctl", "-j", "monitors"], env=env, capture_output=True, text=True, timeout=3)
        mons = json.loads(out.stdout)
    except Exception:
        return True
    lit = [m for m in mons if not m.get("disabled")]
    if lit and not any(m.get("dpmsStatus", True) for m in lit):
        return False
    for m in lit:
        if "LOCK" in (m.get("solitaryBlockedBy") or []):
            return False
    return True


class Dev:
    def __init__(self, cls, name):
        self.p = "/sys/class/%s/%s" % (cls, name)
        self.name = name
        self.max = int(rd(self.p + "/max_brightness"))

    def refresh(self):
        """The range can change at run time (m5pro-xdr widens the panel's); True when it did."""
        try:
            m = int(rd(self.p + "/max_brightness"))
        except (OSError, ValueError):
            return False
        if m > 0 and m != self.max:
            self.max = m
            return True
        return False

    def get(self):
        return int(rd(self.p + "/brightness"))

    def set(self, raw):
        raw = max(0, min(self.max, int(round(raw))))
        subprocess.run(["brightnessctl", "-q", "-d", self.name, "set", str(raw)], check=True, timeout=5,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return self.get()


def curve_pct(curve, lux):
    x = math.log(max(lux, 0.0) + 1.0)
    pts = [(math.log(l + 1.0), p) for l, p in curve]
    if x <= pts[0][0]:
        return pts[0][1]
    for (x0, y0), (x1, y1) in zip(pts, pts[1:]):
        if x <= x1:
            return y0 + (y1 - y0) * (x - x0) / (x1 - x0)
    return pts[-1][1]


def load_state():
    try:
        with open(STATE) as f:
            return json.load(f)
    except Exception:
        return {}


def save_state(st):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(st, f)
    os.replace(tmp, STATE)


SELF = os.path.realpath(__file__)


def idle_conf(c):
    """hypridle config with only our two listeners (no lock: Omarchy's shell owns locking)."""
    out = ["general {", "    ignore_dbus_inhibit = false", "    ignore_systemd_inhibit = false", "}"]
    for secs, lvl in ((c["kbd_idle_off_s"], 1), (c["panel_idle_dim_s"], 2)):
        if secs and secs > 0:
            out += ["listener {", "    timeout = %d" % int(secs),
                    "    on-timeout = %s idle %d" % (SELF, lvl), "    on-resume = %s idle 0" % SELF, "}"]
    return "\n".join(out) + "\n"


def run(dry):
    c = load_conf()
    als = find_als()
    if not als:
        log("no ambient light sensor (is aop_als loaded?)")
        return 1
    panel = Dev("backlight", "apple-panel-bl")
    try:
        kbd = Dev("leds", "kbd_backlight")
    except OSError:
        kbd = None
    st = load_state()
    ratio = float(st.get("ratio", 1.0))
    kbd_pct = float(st.get("kbd_level_pct", c["kbd_level_pct"]))
    os.makedirs(RUNDIR, exist_ok=True)
    stop = []
    wake_ev = threading.Event()
    signal.signal(signal.SIGTERM, lambda *a: (stop.append(1), wake_ev.set()))
    signal.signal(signal.SIGINT, lambda *a: (stop.append(1), wake_ev.set()))
    signal.signal(signal.SIGUSR1, lambda *a: wake_ev.set())   # `idle N` pokes us so input wakes without delay
    with open(RUNDIR + "/idle", "w") as f:
        f.write("0\n")
    with open(RUNDIR + "/pid", "w") as f:
        f.write("%d\n" % os.getpid())

    idle_child = [None, 0.0]      # hypridle Popen, earliest next start
    idle_on = (c["kbd_idle_off_s"] or 0) > 0 or (c["panel_idle_dim_s"] or 0) > 0

    def idle_child_check(t):
        p = idle_child[0]
        if not idle_on or (p is not None and p.poll() is None) or t < idle_child[1]:
            return
        if p is not None:
            log("hypridle exited (rc %s), restarting in 10 s" % p.returncode)
            idle_child[0], idle_child[1] = None, t + 10
            return
        conf = RUNDIR + "/hypridle.conf"
        with open(conf, "w") as f:
            f.write(idle_conf(c))
        try:
            idle_child[0] = subprocess.Popen(["hypridle", "-c", conf], env=hypr_env(),
                                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            log("inactivity: hypridle started (keyboard off after %ss, panel dim after %ss)"
                % (c["kbd_idle_off_s"], c["panel_idle_dim_s"]))
        except OSError as e:
            log("inactivity disabled: cannot start hypridle:", e)
        idle_child[1] = t + 10

    def idle_level():
        try:
            return max(0, min(2, int(rd(RUNDIR + "/idle"))))
        except (OSError, ValueError):
            return 0

    def read_lux():
        try:
            return float(rd(als))
        except (OSError, ValueError):
            return None

    hist, ll = [], None           # raw history for the median, smoothed log-lux
    paused, grace_until = False, 0.0
    cur = exp_p = panel.get()     # what we believe the panel is at / last value we know
    target = cur
    manual_since, manual_val = None, None
    k_exp = kbd.get() if kbd else 0
    k_want = None                 # auto decision: True = light on
    k_manual = False
    k_manual_since, k_manual_val = None, None
    k_ramp = None                 # (from, to, t0)
    hold = st.get("kbd_hold")     # a manual keyboard level survives a restart until the light crosses a threshold
    if kbd and isinstance(hold, dict) and "val" in hold and "want" in hold:
        k_manual, k_want = True, bool(hold["want"])
        try:
            if not dry and kbd.get() != int(hold["val"]):
                kbd.set(int(hold["val"]))
            k_exp = int(hold["val"])
        except Exception:
            pass
        log("keyboard manual restored: %d/%d" % (int(hold["val"]), kbd.max))
    wfail_until = 0.0
    idle_prev = 0
    ramps = {}                    # "panel"/"kbd" -> (dev, from, to, t0, dur): inactivity fades, ours alone
    p_rest = p_dim = None         # panel level before the dim / the dimmed level
    k_rest = None                 # keyboard level before it faded out
    k_watch = (0, 0.0)            # after a wake: keep the keyboard at this level until then (Omarchy's restore races us)
    last_t = time.monotonic()
    last_awake_check, last_status = 0.0, 0.0
    status = {}
    log("start dry_run=%s ratio=%.3f kbd_level=%.0f%% sensor=%s" % (dry, ratio, kbd_pct, als))

    def write_status(d):
        try:
            with open(RUNDIR + "/status.json.tmp", "w") as f:
                json.dump(d, f)
            os.replace(RUNDIR + "/status.json.tmp", RUNDIR + "/status.json")
        except OSError:
            pass

    def pct(raw, dev):
        return 100.0 * raw / dev.max

    while not stop:
        t = time.monotonic()
        dt = t - last_t
        last_t = t
        if dt > 5 * c["poll_s"] + 2:     # suspend/resume or a stall
            grace_until = t + c["grace_s"]
            manual_since = k_manual_since = None
            k_ramp = None
        if t - last_awake_check >= 2.0:
            last_awake_check = t
            aw = screen_awake()
            if not aw and not paused:
                log("paused (screen off or locked)")
                manual_since = k_manual_since = None
                k_ramp = None
            if aw and paused:
                log("resumed")
                grace_until = t + c["grace_s"]
            paused = not aw

        # --- ambient light, smoothed in log domain, median of 3 against single bad samples
        v = read_lux()
        if v is not None:
            hist = (hist + [v])[-3:]
            m = sorted(hist)[len(hist) // 2]
            x = math.log(m + 1.0)
            if ll is None:
                ll = x
            else:
                tau = c["tau_up_s"] if x > ll else c["tau_down_s"]
                ll += (x - ll) * (1 - math.exp(-dt / tau))
        lux_s = math.exp(ll) - 1.0 if ll is not None else None

        actual = panel.get()
        k_act = kbd.get() if kbd else 0
        if panel.refresh():
            # XDR range on/off: the same percentage means other nits now, and narrowing lowered the
            # level. Neither is a manual change; carry on from where the panel is.
            log("panel range now 0-%d" % panel.max)
            cur = exp_p = target = actual
            manual_since = None
            if p_rest is not None:
                p_rest, p_dim = min(p_rest, panel.max), min(p_dim, panel.max)

        # --- inactivity: 1 = keyboard light out, 2 = panel dimmed as well; any input = 0
        idle_child_check(t)
        lvl = idle_level()
        if lvl != idle_prev:
            log("inactivity: %s" % {0: "active", 1: "keyboard off", 2: "dim"}[lvl])
            if lvl > 0 and k_rest is None and kbd and k_act > 0 and not paused:
                k_rest = k_act
                ramps["kbd"] = (kbd, k_act, 0, t, c["kbd_fade_s"])
            if lvl == 2 and not paused and p_rest is None:
                goal = max(c["panel_idle_dim_min_pct"] / 100.0 * panel.max, actual * c["panel_idle_dim_factor"])
                if goal < actual - 1:
                    p_rest, p_dim = actual, int(round(goal))
                    ramps["panel"] = (panel, actual, p_dim, t, 1.0)
            if lvl == 0:
                if p_rest is not None:
                    # restore unless something else moved the panel away from our dimmed level meanwhile
                    if "panel" in ramps or abs(actual - p_dim) <= 4:
                        ramps["panel"] = (panel, actual, p_rest, t, 0.25)
                    p_rest = p_dim = None
                if k_rest is not None:
                    if k_act <= 2 or "kbd" in ramps:
                        ramps["kbd"] = (kbd, k_act, k_rest, t, 0.3)
                        k_watch = (k_rest, t + 5.0)
                    k_rest = None
            idle_prev = lvl
        for key, (dev, f0, g, t0, dur) in list(ramps.items()):
            frac = min(1.0, (t - t0) / max(dur, 0.05))
            if not dry:
                try:
                    v = dev.set(f0 + (g - f0) * frac)
                    if key == "panel":
                        cur = exp_p = target = v
                    else:
                        k_exp = v
                except Exception as e:
                    log("inactivity write failed:", e)
                    frac = 1.0
            if frac >= 1.0:
                del ramps[key]
        if kbd and t < k_watch[1] and "kbd" not in ramps and kbd.get() == 0 and k_watch[0] > 0 and not dry:
            try:
                k_exp = kbd.set(k_watch[0])     # Omarchy's wake restored the 0 it saved when the lock blanked
                log("keyboard restored again after the wake")
            except Exception:
                pass
        if lvl > 0 or ramps or t < k_watch[1]:
            # idle or fading: follow what is there, learn nothing, no lux writes
            actual = panel.get()
            cur = exp_p = target = actual
            manual_since = k_manual_since = None
            if kbd:
                k_exp = kbd.get()
                k_ramp = None
            if t - last_status >= 2.0:
                last_status = t
                write_status({"lux": None if lux_s is None else round(lux_s, 1), "panel_pct": round(pct(actual, panel), 1),
                              "idle": lvl, "paused": paused, "ratio": round(ratio, 3), "dry_run": dry,
                              "ts": int(time.time())})
            wake_ev.wait(0.04 if ramps else c["poll_s"])
            wake_ev.clear()
            continue

        in_grace = t < grace_until
        if paused or in_grace or lux_s is None:
            # follow whatever the shell/lock/wake logic does, learn nothing, write nothing
            cur = exp_p = actual
            target = actual if paused or in_grace else target
            if kbd:
                k_exp = k_act
                k_ramp = None
            if t - last_status >= 2.0:
                last_status = t
                write_status({"lux": None if lux_s is None else round(lux_s, 1), "panel_pct": round(pct(actual, panel), 1),
                              "paused": paused, "grace": in_grace, "ratio": round(ratio, 3), "dry_run": dry,
                              "ts": int(time.time())})
            wake_ev.wait(c["poll_s"])
            wake_ev.clear()
            continue

        # --- panel: manual change detection (tolerance 4 raw units ~ 0.7%)
        tol = 4
        if dry:
            cur = exp_p = actual
        elif manual_since is None and abs(actual - exp_p) > tol:
            manual_since, manual_val = t, actual
            log("manual panel change detected: %d -> %d raw" % (exp_p, actual))
        if manual_since is not None:
            if actual != manual_val:
                manual_since, manual_val = t, actual      # still being adjusted (key repeat)
            elif t - manual_since >= c["settle_s"]:
                p = pct(actual, panel)
                base = curve_pct(c["curve"], lux_s)
                if c["learn"] and base > 0:
                    ratio = min(c["ratio_max"], max(c["ratio_min"], p / base))
                    st["ratio"] = ratio
                    save_state(st)
                log("learned ratio %.3f (panel %.0f%% at %.1f lux, curve %.0f%%)" % (ratio, p, lux_s, base))
                cur = exp_p = target = actual
                manual_since = None
        if manual_since is None:
            pref = min(c["max_pct"], max(c["min_pct"], curve_pct(c["curve"], lux_s) * ratio))
            tp = pct(target, panel)
            if abs(pref - tp) >= c["deadband_pct"] or (pref in (c["max_pct"], c["min_pct"]) and abs(pref - tp) > 0.5):
                target = pref / 100.0 * panel.max
                if dry:
                    log("dry-run: lux %.1f -> target %.0f%% (panel now %.0f%%)" % (lux_s, pref, pct(actual, panel)))
            if not dry and abs(cur - target) > 1:
                step = c["ramp_pct_per_s"] / 100.0 * panel.max * max(dt, c["poll_s"])
                step = max(step, 1.0)
                nxt = cur + max(-step, min(step, target - cur))
                if t >= wfail_until:
                    try:
                        exp_p = panel.set(nxt)
                        cur = exp_p
                    except Exception as e:
                        wfail_until = t + 10
                        log("panel write failed (retry in 10 s):", e)

        # --- keyboard backlight
        if kbd:
            if k_want is None:
                k_want = lux_s < c["kbd_off_above_lux"] and lux_s < c["kbd_on_below_lux"]
            new_want = k_want
            if lux_s < c["kbd_on_below_lux"]:
                new_want = True
            elif lux_s > c["kbd_off_above_lux"]:
                new_want = False
            if new_want != k_want:
                k_want = new_want
                if k_manual:
                    log("keyboard: automatic again (light crossed the threshold)")
                    st.pop("kbd_hold", None)
                    save_state(st)
                k_manual = False
                log("keyboard auto: %s at %.1f lux" % ("on" if k_want else "off", lux_s))
            goal = round(kbd.max * kbd_pct / 100.0) if k_want else 0
            if dry:
                k_exp = k_act
            elif k_manual_since is None and k_ramp is None and abs(k_act - k_exp) > 2:
                k_manual_since, k_manual_val = t, k_act
            if k_manual_since is not None:
                if k_act != k_manual_val:
                    k_manual_since, k_manual_val = t, k_act
                elif t - k_manual_since >= c["settle_s"]:
                    k_manual = True
                    st["kbd_hold"] = {"val": int(k_act), "want": bool(k_want)}
                    save_state(st)
                    if c["learn"] and k_act > 0:
                        kbd_pct = 100.0 * k_act / kbd.max
                        st["kbd_level_pct"] = kbd_pct
                        save_state(st)
                    log("keyboard manual: %d/%d, held until the light crosses a threshold" % (k_act, kbd.max))
                    k_exp = k_act
                    k_manual_since = None
            elif not k_manual and not dry:
                if k_ramp is None and abs(k_act - goal) > 1 and abs(k_act - k_exp) <= 2:
                    k_ramp = (k_act, goal, t)
                if k_ramp:
                    f, g, t0 = k_ramp
                    frac = min(1.0, (t - t0) / max(c["kbd_fade_s"], 0.1))
                    try:
                        if t >= wfail_until:
                            k_exp = kbd.set(f + (g - f) * frac)
                    except Exception as e:
                        wfail_until = t + 10
                        log("keyboard write failed (retry in 10 s):", e)
                    if frac >= 1.0:
                        k_ramp = None
                        k_exp = kbd.get()

        if t - last_status >= 2.0:
            last_status = t
            status = {"lux": round(lux_s, 1), "panel_pct": round(pct(actual, panel), 1),
                      "target_pct": round(pct(target, panel), 1), "ratio": round(ratio, 3),
                      "kbd": k_act, "kbd_auto_on": bool(k_want), "kbd_manual": k_manual,
                      "paused": paused, "dry_run": dry, "ts": int(time.time())}
            write_status(status)
        wake_ev.wait(c["poll_s"])
        wake_ev.clear()
    if idle_child[0] is not None and idle_child[0].poll() is None:
        idle_child[0].terminate()
        try:
            idle_child[0].wait(3)
        except subprocess.TimeoutExpired:
            idle_child[0].kill()
    log("stop")
    return 0


def sc(*a):
    return subprocess.run(["systemctl", "--user", *a], capture_output=True, text=True)


def notify(msg):
    subprocess.run(["notify-send", "-a", "Auto brightness", "-t", "2500", "Auto brightness", msg],
                   capture_output=True)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "run":
        sys.exit(run("--dry-run" in sys.argv))
    if cmd == "idle":
        lvl = sys.argv[2] if len(sys.argv) > 2 else ""
        if lvl not in ("0", "1", "2"):
            print(__doc__); sys.exit(2)
        try:
            with open(RUNDIR + "/idle.tmp", "w") as f:
                f.write(lvl + "\n")
            os.replace(RUNDIR + "/idle.tmp", RUNDIR + "/idle")
            os.kill(int(rd(RUNDIR + "/pid")), signal.SIGUSR1)
        except (OSError, ValueError):
            pass
        sys.exit(0)
    active = sc("is-active", UNIT).stdout.strip() == "active"
    if cmd == "toggle":
        cmd = "off" if active else "on"
    if cmd == "on":
        r = sc("enable", "--now", UNIT)
        if r.returncode:
            print(r.stderr, file=sys.stderr); sys.exit(1)
        notify("On")
        print("on")
    elif cmd == "off":
        sc("disable", "--now", UNIT)
        notify("Off")
        print("off")
    elif cmd == "reset":
        try:
            os.remove(STATE)
        except FileNotFoundError:
            pass
        if active:
            sc("restart", UNIT)
        print("learned preference cleared")
    elif cmd == "status":
        print("service:", "on" if active else "off", "| enabled:", sc("is-enabled", UNIT).stdout.strip())
        try:
            print(rd(RUNDIR + "/status.json"))
        except OSError:
            pass
        print("state:", json.dumps(load_state()))
    else:
        print(__doc__); sys.exit(2)


if __name__ == "__main__":
    main()
