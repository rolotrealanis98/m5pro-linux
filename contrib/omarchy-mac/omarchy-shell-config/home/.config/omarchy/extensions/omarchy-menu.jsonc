{
  // Extend the Quickshell Omarchy menu with JSONC.
  //
  // IDs are object keys. The parent is inferred from the dotted id, so
  // "personal.notes" appears under "personal", and "personal" appears on the
  // root menu. Reuse an existing id to override/extend it.
  //
  // Fields:
  //   icon        Nerd Font glyph shown in the icon column.
  //   label       Visible row title.
  //   action      Shell command to run. If omitted, the row is a submenu.
  //   target      Existing submenu id to open. Use for links/aliases.
  //   provider    Name of a shell-defined runtime row source (e.g. "fonts").
  //   aliases     alternate `omarchy menu summon <name>` routes; also searchable.
  //   description Optional subtitle and extra search text.
  //   when        Shell condition; hide row when it fails.
  //   checked     Shell condition; append ✓ when it succeeds.
  //
  // Examples:
  // "personal": {"icon":"","label":"Personal"},
  // "personal.notes": {"icon":"󰎞","label":"Notes","action":"omarchy-launch-editor ~/notes"},
  // "personal.files": {"icon":"","label":"Files","action":"uwsm-app -- nautilus ~/Documents"},
  //
  // provider can only reference row sources the shell already defines (the
  // providers map in Menu.qml). Static submenus only need dotted ids.
  //
  // Example: replace the default About action by reusing the same id. Existing
  // fields are kept unless overridden.
  // "about": {"icon":"","label":"About","action":"omarchy-launch-or-focus-tui \"zsh -c 'fastfetch; read -k 1'\""},

  // Reboot to Windows once (plugin m5w.reboot-windows: confirm dialog, then pkexec /usr/local/sbin/m5w-windows)
  "system.reboot-windows": {"icon":"󰍲","label":"Reboot to Windows","description":"One time only, the next boot is Linux again","aliases":["windows","boot-windows"],"action":"omarchy-shell shell summon m5w.reboot-windows"}
,
  // Battery charge limit, from System. m5pro-charge-limit (m5pro-linux desktop-defaults) asks for the sudo password
  // in a floating terminal; the limit is kept in the SMC and restored at boot and on unplug.
  "system.battery-limit": {"icon":"󰂁","label":"Battery charge limit","aliases":["battery","charge-limit"],"description":"Keep the battery at 80 % to protect it"},
  "system.battery-limit.80": {"icon":"󰂁","label":"Limit to 80 %","description":"Charging stops at 80 % and resumes at 75 %","action":"m5pro-charge-limit 80"},
  "system.battery-limit.full": {"icon":"󰁹","label":"Charge to 100 % once","description":"Until you unplug or reboot, then back to the limit","action":"m5pro-charge-limit full"},
  "system.battery-limit.off": {"icon":"󰁹","label":"No limit","description":"Always charge to 100 %","action":"m5pro-charge-limit 100"},
  "system.battery-limit.status": {"icon":"󰋽","label":"Show charge limit","description":"Current limit and battery level","action":"omarchy-launch-floating-terminal-with-presentation m5pro-charge-limit"}
,
  // Touch ID (m5pro-linux touchid-omarchy). Setup > Security > Fingerprint opens the Touch ID panel
  // (plugin m5pro.touchid) instead of omarchy-setup-security-fingerprint, which swaps in Omarchy's
  // libfprint-git (sep-bio v4 only). Remove > Security > Fingerprint is hidden: it would delete every
  // print and drop fprintd; delete fingerprints one by one in the panel instead.
  "setup.security.fingerprint": {"icon":"󰈷","label":"Touch ID","description":"Add, test, name or delete fingerprints","aliases":["touchid"],"when":"omarchy-hw-fingerprint","action":"omarchy-shell shell summon m5pro.touchid"},
  "remove.security.fingerprint": {"when":"false"}
,
  // 1Password Touch ID (m5pro-linux touchid-omarchy/1password-launch): unlock 1Password from a fresh start
  // with Touch ID. The account password is sealed by the Secure Enclave (m5pro-1p-touchid setup).
  "setup.security.1password": {"icon":"󰌋","label":"1Password Touch ID","aliases":["1password"],"description":"Unlock 1Password with Touch ID after it starts"},
  "setup.security.1password.unlock": {"icon":"󰈷","label":"Unlock 1Password now","action":"m5pro-1p-touchid unlock"},
  "setup.security.1password.setup": {"icon":"󰌋","label":"Set up (save the account password)","action":"omarchy-launch-floating-terminal-with-presentation m5pro-1p-touchid setup"},
  "setup.security.1password.status": {"icon":"󰋽","label":"Status","action":"omarchy-launch-floating-terminal-with-presentation m5pro-1p-touchid status"},
  "setup.security.1password.forget": {"icon":"󰆴","label":"Remove the saved password","action":"m5pro-1p-touchid forget"}
,
  // Startup Disk (m5pro-linux contrib/omarchy-mac/startup-disk): no terminal, no password; one-time targets only.
  "system.reboot-macos": {"icon":"󰀵","label":"Reboot into macOS","description":"Once; the next restart comes back to Omarchy","aliases":["reboot to macos","reboot into macos","macos","boot macos"],"action":"omarchy-startup-disk reboot-macos"},
  "system.startup-disk": {"icon":"󰋊","label":"Startup Disk","aliases":["startup disk","boot disk"],"description":"Choose the next startup volume"},
  "system.startup-disk.macos-next": {"icon":"󰀵","label":"macOS at next restart","description":"Once, without restarting now","action":"omarchy-startup-disk next-macos"},
  "system.startup-disk.omarchy": {"icon":"󰣇","label":"Omarchy (cancel one-time boot)","description":"The next restart uses the default","action":"omarchy-startup-disk clear-next"},
  "system.startup-disk.status": {"icon":"󰋽","label":"Show startup disk","description":"Default and next boot","action":"omarchy-startup-disk status"},
  // Automatically adjust brightness (m5pro-linux contrib/omarchy-mac/auto-brightness): panel and keyboard backlight follow the
  // ambient light sensor; manual brightness keys are learned, not fought. Row shows a check mark while it is on.
  "system.auto-brightness": {"icon":"󰃠","label":"Automatically adjust brightness","aliases":["auto brightness","ambient light","adaptive brightness"],"description":"Screen and keyboard light follow the room light","checked":"systemctl --user is-active --quiet m5pro-auto-brightness.service","action":"m5pro-auto-brightness toggle"},
  "system.auto-brightness-reset": {"icon":"󰑓","label":"Reset learned brightness","description":"Forget your manual adjustments","action":"m5pro-auto-brightness reset"}
}
