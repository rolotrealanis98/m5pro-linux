diff --git a/dt/t6050-j716s.dts b/dt/t6050-j716s.dts
index 78994a9..fb2c60a 100644
--- a/dt/t6050-j716s.dts
+++ b/dt/t6050-j716s.dts
@@ -15,4 +15,68 @@
 / {
 	compatible = "apple,j716s", "apple,t6050", "apple,arm-platform";
 	model = "Apple MacBook Pro (16-inch, M5 Pro, 2026)";
+
+	aliases {
+		/* m1n1 dt_set_ipd(): fills apple,keyboard-layout-id/hid-country-code
+		 * from /arm-io/dockchannel-mtp/mtp-transport/keyboard kblang-calibration */
+		keyboard = &keyboard;
+	};
 };
+
+/*
+ * J716s is the full 18-core SKU: the runtime ADT lists cpu0-17, six per
+ * cluster, so unlike J714s nothing is fused off here.
+ *
+ * Built-in keyboard + trackpad (MTP): the same mtp-transport children as
+ * J714s (multi-touch CBOR, keyboard, stm, actuator, tp-accel). The trackpad
+ * needs apple/tpmtfw-j716s.bin extracted from the macOS restore bundle.
+ */
+&mtp {
+	status = "okay";
+};
+
+&mtp_mbox {
+	status = "okay";
+};
+
+&mtp_dart {
+	status = "okay";
+};
+
+&mtp_dockchannel {
+	status = "okay";
+};
+
+&mtp_hid {
+	multi-touch {
+		firmware-name = "apple/tpmtfw-j716s.bin";
+	};
+
+	keyboard: keyboard {
+		hid-country-code = <0>;
+		apple,keyboard-layout-id = <0>;
+	};
+
+	stm {
+	};
+
+	actuator {
+	};
+
+	/* ADT calls it tp-accel; the M2/M3 DTs use tp_accel. Which name the
+	 * firmware announces decides which node binds; the other is inert. */
+	tp-accel {
+	};
+
+	tp_accel {
+	};
+
+	/* an extra "mtp" interface exists on the M4 Air (GravityLinux PR #1) */
+	mtp {
+	};
+};
+
+/* SMC sensors: two fans (F0Ac/F1Ac) like J714s; keys not yet probed on J716s. */
+#include "hwmon-common.dtsi"
+#include "hwmon-fan-dual.dtsi"
+#include "hwmon-laptop.dtsi"
diff --git a/scripts/build-kernel.sh b/scripts/build-kernel.sh
index be933d2..6db02c8 100755
--- a/scripts/build-kernel.sh
+++ b/scripts/build-kernel.sh
@@ -28,7 +28,10 @@ if [ ! -d "$LINUX" ]; then
 fi
 
 GMAKE="$(command -v gmake || command -v make)"
-KMAKE=("$GMAKE" -C "$LINUX" ARCH=arm64 LLVM=1 -j"$JOBS")
+KMAKE=("$GMAKE" -C "$LINUX" ARCH=arm64 -j"$JOBS")
+# GCC=1 for hosts with gcc but no ld.lld (Asahi build boxes). Not LLVM=0:
+# the kernel treats any non-empty LLVM as LLVM=1.
+[ "${GCC:-0}" = 1 ] || KMAKE+=(LLVM=1)
 
 if [ "$(uname -s)" = Darwin ]; then
     # brew LLVM for clang/lld; brew gnu-sed's gnubin first because kernel
-- 
