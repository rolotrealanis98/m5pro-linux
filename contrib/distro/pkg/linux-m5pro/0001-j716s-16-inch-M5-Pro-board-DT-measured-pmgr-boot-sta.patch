 dt/t6050-j716s.dts                  |  64 +++++++
 scripts/build-kernel.sh             |   5 +-
 3 files changed, 343 insertions(+), 1 deletion(-)
 create mode 100644 dt/t6050-j716s-pmgr-boot-state.json

