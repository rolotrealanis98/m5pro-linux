# Distribution additions on top of the bring-up fragments (merged last).
CONFIG_LOCALVERSION="-m5pro"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_MODULES=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=m
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_FW_LOADER=y
CONFIG_DM_CRYPT=m
# Virtual input: /dev/uinput (ydotool, remappers, Steam Input) and /dev/uhid (Bluetooth LE HID)
CONFIG_INPUT_UINPUT=y
CONFIG_UHID=y
