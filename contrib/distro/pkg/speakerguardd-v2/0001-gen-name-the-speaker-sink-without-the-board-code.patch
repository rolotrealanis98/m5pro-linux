--- a/packaging/session/gen.py
+++ b/packaging/session/gen.py
@@ -38,6 +38,7 @@
 """
 import json
 import math
+import re
 import os
 import sys
 
@@ -174,6 +175,19 @@
     return [1.0 / (2.0 * math.sin((2 * k - 1) * math.pi / (2 * order))) for k in range(1, order // 2 + 1)]
 
 
+# A board code at the end of the device tree's model ("J716", "J413s"):
+# useful in the internal nodes' descriptions, noise in the speaker sink the
+# user picks in a volume menu.
+BOARD_CODE = re.compile(r"\s+J\d{3}[a-z]?$")
+
+
+def display_name(c):
+    """The user-facing name of the speakers: the model without its board
+    code ("MacBook Pro J716" -> "MacBook Pro"); the model itself when
+    stripping would leave nothing."""
+    return BOARD_CODE.sub("", c["name"]).strip() or c["name"]
+
+
 def voicing_conf(m, c, w):
     """One stereo chain, in unit-lane order, mapped to physical AUX ports
     with the same map as the protection input. Volume is handled by the
@@ -213,8 +227,8 @@
