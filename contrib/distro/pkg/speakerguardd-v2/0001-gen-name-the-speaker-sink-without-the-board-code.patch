From: Rolando Trevino <rolotrealanis@gmail.com>
Subject: [PATCH] gen: name the speaker sink without the board code

The voicing sink is the device users pick in a volume menu; the device tree's
model ("MacBook Pro J716") carries the board code, which means nothing there.
Use "MacBook Pro speakers" for that sink only; the internal protect, amp and
sense nodes keep the full model. Regenerates the committed per-machine files.
---
--- a/packaging/pipewire/sgv2-j316.conf
+++ b/packaging/pipewire/sgv2-j316.conf
@@ -131,8 +131,8 @@
     { name = libpipewire-module-filter-chain
        flags = [ nofail ]
        args = {
-           node.description = "MacBook Pro J316 speakers"
-           media.name = "MacBook Pro J316 speakers"
+           node.description = "MacBook Pro speakers"
+           media.name = "MacBook Pro speakers"
            filter.graph = {
                nodes = [ { type = lv2 name = voicing plugin = "https://aurora-silicon.org/lv2/sgv2#voicing-6ch" } ]
                inputs = [ "voicing:in_0" "voicing:in_1" ]
@@ -141,7 +141,7 @@
            }
            capture.props = {
                node.name = "sgv2.voicing.j316"
-               node.description = "MacBook Pro J316 speakers"
+               node.description = "MacBook Pro speakers"
                media.class = "Audio/Sink"
                audio.rate = 48000
                # Held at the PCM rate like the amps' sink: while the amps
