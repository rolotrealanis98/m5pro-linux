# Distribution additions on top of `defconfig asahi.config j716s.config j716s-gpu.config` (merged last).
# j716s.config builds the boot-path drivers in, so the kernel boots without modules; these make it a package kernel that
# mkinitcpio, systemd and the Omarchy desktop can use. Same set as contrib/distro/pkg/linux-m5pro/m5pro-distro.config,
# with the -ARCH release suffix that omarchy-pkgs' linux-aurora keeps (boot-bundle DTB discovery looks for /usr/lib/modules/*-ARCH).
CONFIG_LOCALVERSION="-ARCH"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_MODULES=y
CONFIG_MODULE_COMPRESS_NONE=y
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=m
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_FW_LOADER=y
CONFIG_DM_CRYPT=m
CONFIG_INPUT_UINPUT=y
CONFIG_UHID=y
