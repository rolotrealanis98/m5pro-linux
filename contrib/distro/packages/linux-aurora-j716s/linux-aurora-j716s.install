post_install() {
    echo ">>> linux-aurora-j716s: the ESP payload is NOT changed by installing this package."
    echo ">>> With m5pro-boot-cli the pacman hook builds a test payload and prints the plan (dry run):"
    echo ">>>   sudo m5pro-boot install latest --apply     # self-reverting test boot, then: m5pro-boot promote --apply"
}
post_upgrade() { post_install; }
