From c3031187161d4b04b52b6aff5c891fbd5c2d053e Mon Sep 17 00:00:00 2001
From: rolotrealanis98 <122947376+rolotrealanis98@users.noreply.github.com>
Date: Tue, 20 Oct 2026 08:11:16 -0400
Subject: [PATCH 09/12] hv: sprr: emulate S3_0_C11_C9_0 for T6050 SPTM

SPTM 26B5112a reads this register early in bootstrap (masks bits 41:20, a carveout base) and takes an UNDEF at guest EL1 when it is not patched to an hvc. Seed the shadow from the hardware value on T6050/T6051 (0x8000010b68a00000 on a J716s), where it is readable at EL2.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 proxyclient/m1n1/hv/sprr.py | 2 ++
 src/hv/hv_sprr.c            | 4 ++++
 src/hv/hv_sprr.h            | 1 +
 3 files changed, 7 insertions(+)

diff --git a/proxyclient/m1n1/hv/sprr.py b/proxyclient/m1n1/hv/sprr.py
index ccc72b3f..c60d0f31 100644
--- a/proxyclient/m1n1/hv/sprr.py
+++ b/proxyclient/m1n1/hv/sprr.py
@@ -263,6 +263,8 @@ HV_VREGS = [
     (3, 7, 15, 7, 3),
     (3, 7, 15, 9, 3),
     (3, 7, 3, 14, 1),
+    # T6050: carveout base SPTM reads in early bootstrap (UNDEF at guest EL1)
+    (3, 0, 11, 9, 0),
 ]
 
 # remap to register that can either be read from EL1 or is emulated
diff --git a/src/hv/hv_sprr.c b/src/hv/hv_sprr.c
index b37cf350..87ed6bfd 100644
--- a/src/hv/hv_sprr.c
+++ b/src/hv/hv_sprr.c
@@ -141,6 +141,10 @@ static void sprr_init_cpu(int i)
     cpu->shadow[HV_VREG_ACC_CTXR_B_CTL_EL2] = 0xc0000000009a02aa;
     cpu->shadow[HV_VREG_ACC_CTXR_C_CTL_EL2] = 0xc000000000aa026a;
     cpu->shadow[HV_VREG_ACC_CTXR_D_CTL_EL2] = 0xc000000000aa02a9;
+
+    /* T6050 SPTM reads a carveout base from here; only M5 Pro/Max have it, so pass it through */
+    if (chip_id == T6050 || chip_id == T6051)
+        cpu->shadow[HV_VREG_S3_0_C11_C9_0] = mrs(sys_reg(3, 0, 11, 9, 0));
 }
 
 void hv_sprr_init_secondary(int cpu)
diff --git a/src/hv/hv_sprr.h b/src/hv/hv_sprr.h
index 5372d9ec..b9c5c330 100644
--- a/src/hv/hv_sprr.h
+++ b/src/hv/hv_sprr.h
@@ -284,6 +284,7 @@ enum hv_vreg {
     HV_VREG_S3_7_C15_C7_3,
     HV_VREG_S3_7_C15_C9_3,
     HV_VREG_S3_7_C3_C14_1,
+    HV_VREG_S3_0_C11_C9_0,
 
     HV_VREG_MAX,
 };
